+bool PinnedTabContainerView::LayoutManager::IsChildVisibleInContainer(
+    const views::View* child) const {
+  if (!CanBeVisible(child)) {
+    return false;
+  }
+  auto drag_data = PinnedTabContainerView().GetVisualDataForDraggedView(*child);
+  if (drag_data && drag_data->should_hide) {
+    return false;
+  }
+  if (PinnedTabContainerView().collection_node_) {
+    if (const auto* controller =
+            PinnedTabContainerView().collection_node_->GetController()) {
+      if (const auto* tab_view = views::AsViewClass<TabView>(child)) {
+        if (!controller->IsTabInActiveSpace(tab_view->GetTabInterface())) {
+          return false;
+        }
+      } else if (const auto* split_view =
+                     views::AsViewClass<SplitTabView>(child)) {
+        if (const TabCollectionNode* split_node = split_view->collection_node();
+            split_node && !split_node->children().empty()) {
+          if (const auto* first_tab = views::AsViewClass<TabView>(
+                  split_node->children().front()->view())) {
+            if (!controller->IsTabInActiveSpace(first_tab->GetTabInterface())) {
+              return false;
+            }
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
