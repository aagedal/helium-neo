+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_spaces_tab_controller.h"
+
+#include <utility>
+
+#include "base/containers/map_util.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/helium_window_spaces_controller.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace helium_spaces {
+
+namespace {
+
+std::string FindValue(const std::map<std::string, std::string>& extra_data,
+                      const char* key) {
+  const std::string* const value = base::FindOrNull(extra_data, key);
+  return value ? *value : std::string();
+}
+
+// Carries a restored tab's space extra data until its controller is created.
+class RestoredSpaceState
+    : public content::WebContentsUserData<RestoredSpaceState> {
+ public:
+  ~RestoredSpaceState() override = default;
+
+  const std::string& space_id() const { return space_id_; }
+
+ private:
+  friend class content::WebContentsUserData<RestoredSpaceState>;
+
+  RestoredSpaceState(content::WebContents* contents, std::string space_id)
+      : content::WebContentsUserData<RestoredSpaceState>(*contents),
+        space_id_(std::move(space_id)) {}
+
+  const std::string space_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(RestoredSpaceState);
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumSpacesTabController);
+
+HeliumSpacesTabController::HeliumSpacesTabController(tabs::TabInterface& tab)
+    : tab_(tab),
+      scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {
+  content::WebContents* const contents = tab.GetContents();
+  if (const RestoredSpaceState* state =
+          RestoredSpaceState::FromWebContents(contents)) {
+    space_id_ = state->space_id();
+    contents->RemoveUserData(RestoredSpaceState::UserDataKey());
+  }
+
+  // Assign newly created tabs to the window's active space immediately so
+  // TabCollectionObserver and TabStripModelObserver (which can run before
+  // HeliumWindowSpacesController) already see the tab in the right Space.
+  if (space_id_.empty() && contents) {
+    Profile* const profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    if (!SessionRestore::IsRestoring(profile)) {
+      if (const HeliumWindowSpacesController* win_ctrl =
+              HeliumWindowSpacesController::From(
+                  tab.GetBrowserWindowInterface());
+          win_ctrl && !win_ctrl->active_space_id().empty()) {
+        space_id_ = win_ctrl->active_space_id();
+      }
+    }
+  }
+
+  tab_subscriptions_.push_back(tab.RegisterDidInsert(base::BindRepeating(
+      &HeliumSpacesTabController::OnDidInsert, base::Unretained(this))));
+}
+
+HeliumSpacesTabController::~HeliumSpacesTabController() = default;
+
+// static
+HeliumSpacesTabController* HeliumSpacesTabController::From(
+    tabs::TabInterface* tab) {
+  return tab ? Get(tab->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+const HeliumSpacesTabController* HeliumSpacesTabController::From(
+    const tabs::TabInterface* tab) {
+  return tab ? Get(const_cast<tabs::TabInterface*>(tab)
+                       ->GetUnownedUserDataHost())
+             : nullptr;
+}
+
+// static
+void HeliumSpacesTabController::StashRestoredState(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  const std::string space_id = FindValue(extra_data, kSpaceIdKey);
+  if (!space_id.empty()) {
+    RestoredSpaceState::CreateForWebContents(contents, space_id);
+  }
+}
+
+// static
+std::map<std::string, std::string>
+HeliumSpacesTabController::GetSessionExtraData(content::WebContents* contents) {
+  const HeliumSpacesTabController* const controller =
+      From(tabs::TabInterface::MaybeGetFromContents(contents));
+  if (!controller || controller->space_id().empty()) {
+    return {};
+  }
+  return {{kSpaceIdKey, controller->space_id()}};
+}
+
+void HeliumSpacesTabController::SetSpaceId(const std::string& space_id) {
+  if (space_id_ == space_id) {
+    return;
+  }
+  space_id_ = space_id;
+  PersistSessionData();
+}
+
+void HeliumSpacesTabController::OnDidInsert(tabs::TabInterface* tab) {
+  if (!space_id_.empty()) {
+    PersistSessionData();
+  }
+}
+
+void HeliumSpacesTabController::PersistSessionData() {
+  content::WebContents* const contents = tab_->GetContents();
+  if (!contents) {
+    return;
+  }
+  SessionService* const session_service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  if (!session_service) {
+    return;
+  }
+
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+
+  session_service->AddTabExtraData(window_id, tab_id, kSpaceIdKey, space_id_);
+}
+
+}  // namespace helium_spaces
