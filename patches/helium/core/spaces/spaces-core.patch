+
+#include "chrome/browser/ui/tabs/helium_spaces_service.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/tabs/helium_pins_service.h"
+#include "chrome/browser/ui/tabs/helium_pins_util.h"
+#include "chrome/browser/ui/tabs/helium_spaces_tab_controller.h"
+#include "chrome/browser/ui/tabs/helium_spaces_util.h"
+#include "chrome/browser/ui/tabs/pinned_tab_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace helium_spaces {
+
+HeliumSpacesService::HeliumSpacesService(Profile* profile, PrefService* prefs)
+    : profile_(profile), prefs_(prefs) {
+  if (prefs_) {
+    spaces_ = SpaceList::FromPref(prefs_->GetList(prefs::kHeliumSpaces));
+  }
+  const std::u16string default_name =
+      l10n_util::GetStringUTF16(IDS_HELIUM_DEFAULT_SPACE_NAME);
+  if (spaces_.EnsureDefaultSpace(default_name)) {
+    SaveSpaces();
+  }
+
+  if (prefs_) {
+    pref_change_registrar_.Init(prefs_);
+    pref_change_registrar_.Add(
+        prefs::kHeliumSpacesPinsPerSpace,
+        base::BindRepeating(&HeliumSpacesService::OnPinsPerSpacePrefChanged,
+                            base::Unretained(this)));
+  }
+}
+
+HeliumSpacesService::~HeliumSpacesService() = default;
+
+void HeliumSpacesService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void HeliumSpacesService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+const std::string& HeliumSpacesService::GetDefaultSpaceId() const {
+  return spaces_.front().id;
+}
+
+const Space* HeliumSpacesService::FindSpace(const std::string& id) const {
+  const auto it = spaces_.Find(id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+std::optional<size_t> HeliumSpacesService::GetSpaceIndex(
+    const std::string& id) const {
+  return spaces_.IndexOf(id);
+}
+
+bool HeliumSpacesService::PinsArePerSpace() const {
+  return !prefs_ || prefs_->GetBoolean(prefs::kHeliumSpacesPinsPerSpace);
+}
+
+std::string HeliumSpacesService::CreateSpace(const std::u16string& name,
+                                             const std::string& color,
+                                             const std::string& icon) {
+  std::u16string resolved_name(base::TrimWhitespace(name, base::TRIM_ALL));
+  if (resolved_name.empty()) {
+    resolved_name = l10n_util::GetStringFUTF16(
+        IDS_HELIUM_NEW_SPACE_DEFAULT_NAME,
+        base::NumberToString16(spaces_.size() + 1));
+  }
+
+  Space space{CreateSpaceId(), std::move(resolved_name), color, icon};
+  const std::string id = space.id;
+  spaces_.push_back(std::move(space));
+  SaveSpaces();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return id;
+}
+
+bool HeliumSpacesService::RenameSpace(const std::string& id,
+                                      const std::u16string& name) {
+  const auto it = spaces_.Find(id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  std::u16string trimmed(base::TrimWhitespace(name, base::TRIM_ALL));
+  if (trimmed.empty() || it->name == trimmed) {
+    return false;
+  }
+  it->name = std::move(trimmed);
+  SaveSpaces();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return true;
+}
+
+bool HeliumSpacesService::SetSpaceColor(const std::string& id,
+                                        const std::string& color) {
+  const auto it = spaces_.Find(id);
+  if (it == spaces_.end() || it->color == color) {
+    return false;
+  }
+  it->color = color;
+  SaveSpaces();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return true;
+}
+
+bool HeliumSpacesService::SetSpaceIcon(const std::string& id,
+                                       const std::string& icon) {
+  const auto it = spaces_.Find(id);
+  if (it == spaces_.end() || it->icon == icon) {
+    return false;
+  }
+  it->icon = icon;
+  SaveSpaces();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return true;
+}
+
+bool HeliumSpacesService::ReorderSpace(const std::string& id,
+                                       size_t new_index) {
+  if (!spaces_.Move(id, new_index)) {
+    return false;
+  }
+  SaveSpaces();
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return true;
+}
+
+bool HeliumSpacesService::CanDeleteSpace(const std::string& id) const {
+  return spaces_.size() > 1 && FindSpace(id) != nullptr;
+}
+
+std::string HeliumSpacesService::GetFallbackSpaceId(
+    const std::string& id) const {
+  const std::optional<size_t> index = GetSpaceIndex(id);
+  if (!index || spaces_.size() <= 1) {
+    return std::string();
+  }
+  return *index > 0 ? spaces_[*index - 1].id : spaces_[1].id;
+}
+
+bool HeliumSpacesService::HasTabsOrPinsInSpace(const std::string& id) const {
+  if (!profile_ || !FindSpace(id)) {
+    return false;
+  }
+
+  if (helium_pins::ArePersistentPinsEnabled(profile_)) {
+    if (helium_pins::HeliumPinsService* pins_service =
+            PinnedTabServiceFactory::GetForProfile(profile_)) {
+      if (pins_service->HasPinsInSpace(id)) {
+        return true;
+      }
+    }
+  }
+
+  bool found = false;
+  if (ProfileBrowserCollection* browsers =
+          ProfileBrowserCollection::GetForProfile(profile_)) {
+    browsers->ForEach([&](BrowserWindowInterface* browser) {
+      if (!HasSpaces(browser) || browser->IsDeleteScheduled()) {
+        return true;
+      }
+      TabStripModel* model = browser->GetTabStripModel();
+      for (int i = 0; i < model->count(); ++i) {
+        tabs::TabInterface* tab = model->GetTabAtIndex(i);
+        if (tab->IsPinned() && helium_pins::IsPersistentPin(tab)) {
+          continue;
+        }
+        if (GetTabSpaceId(tab) == id) {
+          found = true;
+          return false;
+        }
+      }
+      return true;
+    });
+  }
+  return found;
+}
+
+bool HeliumSpacesService::DeleteSpace(const std::string& id,
+                                      bool move_tabs_to_fallback) {
+  if (!CanDeleteSpace(id)) {
+    return false;
+  }
+
+  const std::string fallback_id = GetFallbackSpaceId(id);
+  if (fallback_id.empty()) {
+    return false;
+  }
+
+  if (profile_ && helium_pins::ArePersistentPinsEnabled(profile_)) {
+    if (helium_pins::HeliumPinsService* pins_service =
+            PinnedTabServiceFactory::GetForProfile(profile_)) {
+      pins_service->HandleSpaceDeleted(id, fallback_id, move_tabs_to_fallback);
+    }
+  }
+
+  std::vector<BrowserWindowInterface*> windows;
+  if (profile_) {
+    if (ProfileBrowserCollection* browsers =
+            ProfileBrowserCollection::GetForProfile(profile_)) {
+      browsers->ForEach([&](BrowserWindowInterface* browser) {
+        if (HasSpaces(browser) && !browser->IsDeleteScheduled()) {
+          windows.push_back(browser);
+        }
+        return true;
+      });
+    }
+  }
+
+  struct WindowCloseList {
+    raw_ptr<BrowserWindowInterface> browser;
+    std::vector<tabs::TabHandle> tabs;
+  };
+  std::vector<WindowCloseList> tabs_to_close;
+
+  if (move_tabs_to_fallback) {
+    for (BrowserWindowInterface* browser : windows) {
+      TabStripModel* model = browser->GetTabStripModel();
+      for (int i = 0; i < model->count(); ++i) {
+        tabs::TabInterface* tab = model->GetTabAtIndex(i);
+        if (tab->IsPinned() && helium_pins::IsPersistentPin(tab)) {
+          continue;
+        }
+        if (GetTabSpaceId(tab) == id) {
+          if (HeliumSpacesTabController* controller =
+                  HeliumSpacesTabController::From(tab)) {
+            controller->SetSpaceId(fallback_id);
+          }
+        }
+      }
+    }
+  } else {
+    // Collect tabs to close BEFORE erasing `id` from `spaces_`, because
+    // GetTabSpaceId() falls back to the default space once `id` is gone.
+    for (BrowserWindowInterface* browser : windows) {
+      TabStripModel* model = browser->GetTabStripModel();
+      WindowCloseList list{browser, {}};
+      for (int i = 0; i < model->count(); ++i) {
+        tabs::TabInterface* tab = model->GetTabAtIndex(i);
+        if (tab->IsPinned() && helium_pins::IsPersistentPin(tab)) {
+          continue;
+        }
+        if (GetTabSpaceId(tab) == id) {
+          list.tabs.push_back(tab->GetHandle());
+        }
+      }
+      if (!list.tabs.empty()) {
+        tabs_to_close.push_back(std::move(list));
+      }
+    }
+  }
+
+  const auto it = spaces_.Find(id);
+  if (it != spaces_.end()) {
+    spaces_.erase(it);
+  }
+  SaveSpaces();
+
+  for (Observer& observer : observers_) {
+    observer.OnSpaceDeleted(id, fallback_id);
+  }
+
+  if (!move_tabs_to_fallback) {
+    for (const WindowCloseList& list : tabs_to_close) {
+      if (list.browser->IsDeleteScheduled()) {
+        continue;
+      }
+      TabStripModel* model = list.browser->GetTabStripModel();
+      if (model->closing_all()) {
+        continue;
+      }
+      for (tabs::TabHandle handle : list.tabs) {
+        tabs::TabInterface* tab = handle.Get();
+        if (!tab) {
+          continue;
+        }
+        const int idx = model->GetIndexOfTab(tab);
+        if (idx != TabStripModel::kNoTab && model->count() > 1) {
+          model->CloseWebContentsAt(idx,
+                                    TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+        }
+      }
+    }
+  }
+
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged();
+  }
+  return true;
+}
+
+void HeliumSpacesService::Shutdown() {
+  pref_change_registrar_.RemoveAll();
+}
+
+void HeliumSpacesService::SaveSpaces() {
+  if (!prefs_) {
+    return;
+  }
+  prefs_->SetList(prefs::kHeliumSpaces, spaces_.ToPref());
+  prefs_->CommitPendingWrite();
+}
+
+void HeliumSpacesService::OnPinsPerSpacePrefChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnPinsPerSpaceChanged();
+  }
+}
