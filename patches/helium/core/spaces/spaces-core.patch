+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_SPACES_LIST_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_SPACES_LIST_H_
+
+#include <stddef.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+namespace helium_spaces {
+
+// An entry of the spaces list.
+struct Space {
+  std::string id;
+  std::u16string name;
+  // Color token or hex string used for space tinting.
+  std::string color;
+  // Optional icon identifier or emoji for sidebar presentation.
+  std::string icon;
+};
+
+// Returns a new, unique space id.
+std::string CreateSpaceId();
+
+// The ordered spaces of a profile, persisted in profile prefs. Always contains
+// at least one space after EnsureDefaultSpace().
+class SpaceList {
+ public:
+  using iterator = std::vector<Space>::iterator;
+  using const_iterator = std::vector<Space>::const_iterator;
+
+  SpaceList();
+  SpaceList(const SpaceList&);
+  SpaceList& operator=(const SpaceList&);
+  SpaceList(SpaceList&&);
+  SpaceList& operator=(SpaceList&&);
+  ~SpaceList();
+
+  static SpaceList FromPref(const base::ListValue& value);
+  base::ListValue ToPref() const;
+
+  // Guarantees at least one space exists. Returns true if a default space was
+  // created.
+  bool EnsureDefaultSpace(const std::u16string& default_name);
+
+  iterator Find(const std::string& id);
+  const_iterator Find(const std::string& id) const;
+  std::optional<size_t> IndexOf(const std::string& id) const;
+
+  iterator begin() { return spaces_.begin(); }
+  iterator end() { return spaces_.end(); }
+  const_iterator begin() const { return spaces_.begin(); }
+  const_iterator end() const { return spaces_.end(); }
+  bool empty() const { return spaces_.empty(); }
+  size_t size() const { return spaces_.size(); }
+  Space& operator[](size_t index) { return spaces_[index]; }
+  const Space& operator[](size_t index) const { return spaces_[index]; }
+  Space& front() { return spaces_.front(); }
+  const Space& front() const { return spaces_.front(); }
+
+  void push_back(Space space);
+  iterator insert(const_iterator position, Space space);
+  iterator erase(const_iterator position);
+  bool Move(const std::string& id, size_t new_index);
+
+ private:
+  std::vector<Space> spaces_;
+};
+
+}  // namespace helium_spaces
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_SPACES_LIST_H_
