+}  // namespace tabs
+
+namespace helium_spaces {
+
+// Persistent space assignment of a tab. Kept on the tab so it survives
+// discards, and mirrored into session extra data.
+class HeliumSpacesTabController {
+ public:
+  static constexpr char kSpaceIdKey[] = "helium.space_id";
+
+  explicit HeliumSpacesTabController(tabs::TabInterface& tab);
+  HeliumSpacesTabController(const HeliumSpacesTabController&) = delete;
+  HeliumSpacesTabController& operator=(const HeliumSpacesTabController&) =
+      delete;
+  ~HeliumSpacesTabController();
+
+  DECLARE_USER_DATA(HeliumSpacesTabController);
+
+  static HeliumSpacesTabController* From(tabs::TabInterface* tab);
+  static const HeliumSpacesTabController* From(const tabs::TabInterface* tab);
+
+  // Holds the space id from a restored tab's extra_data until the tab's
+  // controller is created.
+  static void StashRestoredState(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  // Returns the session extra data for the tab holding contents, or an empty
+  // map if it has no space id.
+  static std::map<std::string, std::string> GetSessionExtraData(
+      content::WebContents* contents);
+
+  tabs::TabInterface& tab() { return *tab_; }
+
+  const std::string& space_id() const { return space_id_; }
+
+  // Updates the tab's space id and persists it to SessionService.
+  void SetSpaceId(const std::string& space_id);
+
+ private:
+  void OnDidInsert(tabs::TabInterface* tab);
+  void PersistSessionData();
+
+  const raw_ref<tabs::TabInterface> tab_;
+  std::string space_id_;
+  std::vector<base::CallbackListSubscription> tab_subscriptions_;
+  ui::ScopedUnownedUserData<HeliumSpacesTabController>
+      scoped_unowned_user_data_;
+};
+
+}  // namespace helium_spaces
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_SPACES_TAB_CONTROLLER_H_
