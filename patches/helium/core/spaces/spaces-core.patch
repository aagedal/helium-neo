+
+BrowserWindowInterface* GetBrowserFromModel(const TabStripModel* model) {
+  if (!model || !model->delegate()) {
+    return nullptr;
+  }
+  return const_cast<TabStripModelDelegate*>(model->delegate())
+      ->GetBrowserWindowInterface();
+}
+
+}  // namespace
+
+bool HasSpaces(const BrowserWindowInterface* browser) {
+  const HeliumWindowSpacesController* controller =
+      HeliumWindowSpacesController::From(browser);
+  return controller && !controller->active_space_id().empty();
+}
+
+bool HasSpaces(const TabStripModel* model) {
+  return HasSpaces(GetBrowserFromModel(model));
+}
+
+std::string GetActiveSpaceId(const BrowserWindowInterface* browser) {
+  const HeliumWindowSpacesController* controller =
+      HeliumWindowSpacesController::From(browser);
+  return controller ? controller->active_space_id() : std::string();
+}
+
+std::string GetActiveSpaceId(const TabStripModel* model) {
+  return GetActiveSpaceId(GetBrowserFromModel(model));
+}
+
+std::string GetTabSpaceId(const tabs::TabInterface* tab) {
+  if (!tab) {
+    return std::string();
+  }
+
+  BrowserWindowInterface* const browser =
+      const_cast<tabs::TabInterface*>(tab)->GetBrowserWindowInterface();
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  HeliumSpacesService* const service =
+      profile ? HeliumSpacesServiceFactory::GetForProfile(profile) : nullptr;
+  if (!service) {
+    return std::string();
+  }
+
+  if (tab->IsPinned() && helium_pins::ArePersistentPinsEnabled(profile)) {
+    if (const helium_pins::HeliumPinsTabController* pin_ctrl =
+            helium_pins::GetPersistentPinController(
+                const_cast<tabs::TabInterface*>(tab))) {
+      if (const helium_pins::HeliumPinsService* pins_service =
+              PinnedTabServiceFactory::GetForProfile(profile)) {
+        const std::string pin_space =
+            pins_service->GetPinSpaceId(pin_ctrl->pin_id());
+        if (!pin_space.empty() && service->FindSpace(pin_space)) {
+          return pin_space;
+        }
+      }
+    }
+  }
+
+  if (const HeliumSpacesTabController* controller =
+          HeliumSpacesTabController::From(tab)) {
+    if (!controller->space_id().empty() &&
+        service->FindSpace(controller->space_id())) {
+      return controller->space_id();
+    }
+  }
+
+  return service->GetDefaultSpaceId();
+}
+
+bool IsTabVisibleInSpace(const TabStripModel* model,
+                         const tabs::TabInterface* tab,
+                         const std::string& space_id) {
+  if (!tab || space_id.empty()) {
+    return true;
+  }
+
+  Profile* const profile = model ? model->profile() : nullptr;
+  HeliumSpacesService* const service =
+      profile ? HeliumSpacesServiceFactory::GetForProfile(profile) : nullptr;
+  if (!service) {
+    return true;
+  }
+
+  if (tab->IsPinned()) {
+    if (!service->PinsArePerSpace()) {
+      return true;
+    }
+    if (helium_pins::ArePersistentPinsEnabled(profile)) {
+      if (const helium_pins::HeliumPinsTabController* pin_ctrl =
+              helium_pins::GetPersistentPinController(
+                  const_cast<tabs::TabInterface*>(tab))) {
+        if (const helium_pins::HeliumPinsService* pins_service =
+                PinnedTabServiceFactory::GetForProfile(profile)) {
+          if (pins_service->IsPinAllSpaces(pin_ctrl->pin_id())) {
+            return true;
+          }
+          const std::string pin_space =
+              pins_service->GetPinSpaceId(pin_ctrl->pin_id());
+          return (pin_space.empty() ? service->GetDefaultSpaceId()
+                                    : pin_space) == space_id;
+        }
+      }
+    }
+  }
+
+  return GetTabSpaceId(tab) == space_id;
+}
+
+bool IsTabInActiveSpace(const TabStripModel* model,
+                        const tabs::TabInterface* tab) {
+  const std::string active_space = GetActiveSpaceId(model);
+  if (active_space.empty()) {
+    return true;
+  }
+  return IsTabVisibleInSpace(model, tab, active_space);
+}
+
+bool IsTabInActiveSpace(const TabStripModel* model, int index) {
+  if (!model || !model->ContainsIndex(index)) {
+    return true;
+  }
+  return IsTabInActiveSpace(model, model->GetTabAtIndex(index));
+}
+
+bool IsTabGroupInActiveSpace(const TabStripModel* model,
+                             const tab_groups::TabGroupId& group_id) {
+  const std::string active_space = GetActiveSpaceId(model);
+  if (active_space.empty() || !model || !model->group_model() ||
+      !model->group_model()->ContainsTabGroup(group_id)) {
+    return true;
+  }
+  const gfx::Range range =
+      model->group_model()->GetTabGroup(group_id)->ListTabs();
+  if (range.is_empty()) {
+    return true;
+  }
+  return IsTabVisibleInSpace(
+      model, model->GetTabAtIndex(static_cast<int>(range.start())),
+      active_space);
+}
+
+bool IsGlobalPin(const tabs::TabInterface* tab) {
+  if (!tab || !tab->IsPinned()) {
+    return false;
+  }
+  BrowserWindowInterface* const browser =
+      const_cast<tabs::TabInterface*>(tab)->GetBrowserWindowInterface();
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (!profile || !helium_pins::ArePersistentPinsEnabled(profile)) {
+    return false;
+  }
+  const HeliumSpacesService* const spaces_service =
+      HeliumSpacesServiceFactory::GetForProfile(profile);
+  if (!spaces_service || !spaces_service->PinsArePerSpace()) {
+    return false;
+  }
+  const helium_pins::HeliumPinsTabController* const pin_ctrl =
+      helium_pins::GetPersistentPinController(
+          const_cast<tabs::TabInterface*>(tab));
+  const helium_pins::HeliumPinsService* const pins_service =
+      PinnedTabServiceFactory::GetForProfile(profile);
+  return pin_ctrl && pins_service &&
+         pins_service->IsPinAllSpaces(pin_ctrl->pin_id());
+}
+
+bool CanToggleGlobalPin(const TabStripModel* model,
+                        const tabs::TabInterface* tab) {
+  if (!model || !tab || !HasSpaces(model)) {
+    return false;
+  }
+  Profile* const profile = model->profile();
+  if (!profile || !helium_pins::ArePersistentPinsEnabled(profile)) {
+    return false;
+  }
+  const HeliumSpacesService* const spaces_service =
+      HeliumSpacesServiceFactory::GetForProfile(profile);
+  return spaces_service && spaces_service->PinsArePerSpace();
+}
+
+bool HasTabsInOtherSpaces(const TabStripModel* model,
+                          const std::set<tabs::TabInterface*>& closing) {
+  const std::string active_space = GetActiveSpaceId(model);
+  if (active_space.empty() || !model) {
+    return false;
+  }
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (closing.contains(tab) ||
+        IsTabVisibleInSpace(model, tab, active_space)) {
+      continue;
+    }
+    if (!tab->IsPinned() || !helium_pins::IsHibernated(tab->GetContents())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void PromptToDeleteSpace(BrowserWindowInterface* browser,
+                         const std::string& space_id) {
+  if (!browser) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  HeliumSpacesService* const service =
+      HeliumSpacesServiceFactory::GetForProfile(profile);
+  if (!service || !service->CanDeleteSpace(space_id)) {
+    return;
+  }
+
+  if (!service->HasTabsOrPinsInSpace(space_id)) {
+    service->DeleteSpace(space_id, /*move_tabs_to_fallback=*/false);
+    return;
+  }
+
+  const Space* const space = service->FindSpace(space_id);
+  const std::string fallback_id = service->GetFallbackSpaceId(space_id);
+  const Space* const fallback = service->FindSpace(fallback_id);
+  if (!space || !fallback) {
+    return;
+  }
+
+  auto run_delete = [](base::WeakPtr<BrowserWindowInterface> weak_browser,
+                       std::string target_id, bool move_tabs) {
+    if (!weak_browser) {
+      return;
+    }
+    if (HeliumSpacesService* svc = HeliumSpacesServiceFactory::GetForProfile(
+            weak_browser->GetProfile())) {
+      svc->DeleteSpace(target_id, move_tabs);
+    }
+  };
+
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* const dialog_model = builder.model();
+  auto dialog =
+      builder
+          .SetTitle(l10n_util::GetStringFUTF16(
+              IDS_HELIUM_DELETE_SPACE_DIALOG_TITLE, space->name))
+          .AddParagraph(ui::DialogModelLabel(l10n_util::GetStringFUTF16(
+              IDS_HELIUM_DELETE_SPACE_DIALOG_BODY, space->name,
+              fallback->name)))
+          .AddOkButton(
+              base::BindOnce(run_delete, browser->GetWeakPtr(), space_id,
+                             /*move_tabs=*/true),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringFUTF16(
+                      IDS_HELIUM_DELETE_SPACE_MOVE_BUTTON, fallback->name)))
+          .AddExtraButton(
+              base::BindRepeating(
+                  [](base::WeakPtr<BrowserWindowInterface> weak_browser,
+                     std::string target_id, ui::DialogModel* model,
+                     const ui::Event&) {
+                    if (weak_browser) {
+                      if (HeliumSpacesService* svc =
+                              HeliumSpacesServiceFactory::GetForProfile(
+                                  weak_browser->GetProfile())) {
+                        svc->DeleteSpace(target_id,
+                                         /*move_tabs_to_fallback=*/false);
+                      }
+                    }
+                    if (model && model->host()) {
+                      model->host()->Close();
+                    }
+                  },
+                  browser->GetWeakPtr(), space_id,
+                  base::Unretained(dialog_model)),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringUTF16(
+                      IDS_HELIUM_DELETE_SPACE_CLOSE_BUTTON)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+
+  chrome::ShowBrowserModal(browser, std::move(dialog));
+}
