+HeliumWindowSpacesController::HeliumWindowSpacesController(
+    BrowserWindowInterface* browser,
+    const std::string& restored_space_id)
+    : browser_(browser),
+      service_(browser && browser->GetType() ==
+                              BrowserWindowInterface::Type::TYPE_NORMAL &&
+                       !browser->GetProfile()->IsOffTheRecord()
+                   ? HeliumSpacesServiceFactory::GetForProfile(
+                         browser->GetProfile())
+                   : nullptr),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {
+  if (!service_) {
+    return;
+  }
+
+  if (!restored_space_id.empty() && service_->FindSpace(restored_space_id)) {
+    active_space_id_ = restored_space_id;
+    has_explicit_restored_space_ = true;
+  } else {
+    active_space_id_ = service_->GetDefaultSpaceId();
+  }
+
+  service_observation_.Observe(service_);
+  browser_->GetTabStripModel()->AddObserver(this);
+  PersistWindowSpace();
+}
+
+HeliumWindowSpacesController::~HeliumWindowSpacesController() {
+  if (service_ && browser_ && browser_->GetTabStripModel()) {
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  }
+}
+
+// static
+HeliumWindowSpacesController* HeliumWindowSpacesController::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+const HeliumWindowSpacesController* HeliumWindowSpacesController::From(
+    const BrowserWindowInterface* browser) {
+  return browser ? Get(const_cast<BrowserWindowInterface*>(browser)
+                           ->GetUnownedUserDataHost())
+                 : nullptr;
+}
+
+bool HeliumWindowSpacesController::SwitchToSpace(const std::string& space_id) {
+  if (!service_ || space_id.empty() || space_id == active_space_id_ ||
+      !service_->FindSpace(space_id)) {
+    return false;
+  }
+
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (tabs::TabInterface* current_active = model->GetActiveTab()) {
+    last_active_tabs_[active_space_id_] = current_active->GetHandle();
+  }
+
+  if (model->GetFocusedGroup().has_value()) {
+    model->ExitFocusMode(std::nullopt);
+  }
+
+  {
+    base::AutoReset<bool> guard(&updating_space_, true);
+    active_space_id_ = space_id;
+    PersistWindowSpace();
+    ActivateTabForSpace(space_id);
+  }
+
+  NotifyVisualStateChanged();
+  return true;
+}
+
+void HeliumWindowSpacesController::SwitchToNextSpace() {
+  if (!service_ || service_->spaces().size() < 2) {
+    return;
+  }
+  const auto index = service_->GetSpaceIndex(active_space_id_);
+  const size_t next = index ? (*index + 1) % service_->spaces().size() : 0;
+  SwitchToSpace(service_->spaces()[next].id);
+}
+
+void HeliumWindowSpacesController::SwitchToPreviousSpace() {
+  if (!service_ || service_->spaces().size() < 2) {
+    return;
+  }
+  const auto index = service_->GetSpaceIndex(active_space_id_);
+  const size_t count = service_->spaces().size();
+  const size_t prev = index ? (*index + count - 1) % count : 0;
+  SwitchToSpace(service_->spaces()[prev].id);
+}
+
+void HeliumWindowSpacesController::SwitchToSpaceAtIndex(size_t index) {
+  if (!service_ || index >= service_->spaces().size()) {
+    return;
+  }
+  SwitchToSpace(service_->spaces()[index].id);
+}
+
+void HeliumWindowSpacesController::MoveTabsToSpace(
+    const std::vector<tabs::TabInterface*>& tabs,
+    const std::string& target_space_id) {
+  if (!service_ || !service_->FindSpace(target_space_id) || tabs.empty()) {
+    return;
+  }
+
+  TabStripModel* const model = browser_->GetTabStripModel();
+
+  std::set<tabs::TabInterface*> expanded;
+  for (tabs::TabInterface* tab : tabs) {
+    if (!tab || model->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    expanded.insert(tab);
+    if (const std::optional<split_tabs::SplitTabId> split_id =
+            tab->GetSplit()) {
+      for (tabs::TabInterface* split_tab :
+           model->GetSplitData(*split_id)->ListTabs()) {
+        expanded.insert(split_tab);
+      }
+    }
+    if (const std::optional<tab_groups::TabGroupId> group_id =
+            tab->GetGroup();
+        group_id.has_value() && model->group_model() &&
+        model->group_model()->ContainsTabGroup(*group_id)) {
+      const gfx::Range range =
+          model->group_model()->GetTabGroup(*group_id)->ListTabs();
+      for (size_t i = range.start(); i < range.end(); ++i) {
+        expanded.insert(model->GetTabAtIndex(static_cast<int>(i)));
+      }
+    }
+  }
+
+  helium_pins::HeliumPinsService* const pins_service =
+      helium_pins::ArePersistentPinsEnabled(browser_->GetProfile())
+          ? PinnedTabServiceFactory::GetForProfile(browser_->GetProfile())
+          : nullptr;
+
+  bool moved_any = false;
+  for (tabs::TabInterface* tab : expanded) {
+    if (tab->IsPinned() && pins_service) {
+      if (helium_pins::HeliumPinsTabController* pin_controller =
+              helium_pins::GetPersistentPinController(tab)) {
+        pins_service->SetPinSpaceId(pin_controller->pin_id(), target_space_id);
+        moved_any = true;
+      }
+    }
+    if (HeliumSpacesTabController* space_controller =
+            HeliumSpacesTabController::From(tab)) {
+      if (space_controller->space_id() != target_space_id) {
+        space_controller->SetSpaceId(target_space_id);
+        moved_any = true;
+      }
+    }
+  }
+
+  if (!moved_any) {
+    return;
+  }
+
+  if (tabs::TabInterface* active = model->GetActiveTab();
+      active && !IsTabVisibleInSpace(model, active, active_space_id_)) {
+    base::AutoReset<bool> guard(&updating_space_, true);
+    ActivateTabForSpace(active_space_id_);
+  }
+
+  NotifyVisualStateChanged();
+}
+
+void HeliumWindowSpacesController::TogglePinAllSpaces(tabs::TabInterface* tab) {
+  if (!service_ || !tab ||
+      !helium_pins::ArePersistentPinsEnabled(browser_->GetProfile())) {
+    return;
+  }
+  helium_pins::HeliumPinsService* const pins_service =
+      PinnedTabServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!pins_service) {
+    return;
+  }
+
+  TabStripModel* const model = browser_->GetTabStripModel();
+  std::vector<tabs::TabInterface*> targets = {tab};
+  if (const std::optional<split_tabs::SplitTabId> split_id = tab->GetSplit()) {
+    targets = model->GetSplitData(*split_id)->ListTabs();
+  }
+
+  bool new_all_spaces = true;
+  if (!tab->IsPinned()) {
+    std::vector<int> indices;
+    for (tabs::TabInterface* member : targets) {
+      const int idx = model->GetIndexOfTab(member);
+      if (idx != TabStripModel::kNoTab) {
+        indices.push_back(idx);
+      }
+    }
+    if (indices.empty()) {
+      return;
+    }
+    std::ranges::sort(indices);
+    model->SetTabsPinned(indices, true);
+  } else {
+    helium_pins::HeliumPinsTabController* const pin_controller =
+        helium_pins::GetPersistentPinController(tab);
+    if (!pin_controller) {
+      return;
+    }
+    new_all_spaces = !pins_service->IsPinAllSpaces(pin_controller->pin_id());
+  }
+
+  for (tabs::TabInterface* member : targets) {
+    if (auto* member_pin = helium_pins::GetPersistentPinController(member)) {
+      if (!new_all_spaces && !active_space_id_.empty()) {
+        pins_service->SetPinSpaceId(member_pin->pin_id(), active_space_id_);
+      }
+      pins_service->SetPinAllSpaces(member_pin->pin_id(), new_all_spaces);
+    }
+  }
+  NotifyVisualStateChanged();
+}
+
+base::CallbackListSubscription
+HeliumWindowSpacesController::RegisterOnStateChanged(
+    StateChangedCallback callback) {
+  return state_changed_callbacks_.Add(std::move(callback));
+}
+
+void HeliumWindowSpacesController::NotifyVisualStateChanged() {
+  state_changed_callbacks_.Notify(this);
+}
+
+void HeliumWindowSpacesController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!service_ || tab_strip_model->closing_all()) {
+    return;
+  }
+
+  bool visual_changed = false;
+  if (change.type() == TabStripModelChange::kInserted) {
+    const auto* insert = change.GetInsert();
+    const bool window_was_empty =
+        static_cast<size_t>(tab_strip_model->count()) ==
+        insert->contents.size();
+    const bool is_restoring =
+        SessionRestore::IsRestoring(browser_->GetProfile());
+
+    if (window_was_empty && !has_explicit_restored_space_ && !is_restoring &&
+        !insert->contents.empty()) {
+      tabs::TabInterface* first_tab = insert->contents.front().tab;
+      if (!first_tab->IsPinned()) {
+        if (auto* tab_ctrl = HeliumSpacesTabController::From(first_tab);
+            tab_ctrl && !tab_ctrl->space_id().empty() &&
+            service_->FindSpace(tab_ctrl->space_id())) {
+          active_space_id_ = tab_ctrl->space_id();
+          PersistWindowSpace();
+          visual_changed = true;
+        }
+      }
+    }
+
+    for (const auto& inserted : insert->contents) {
+      tabs::TabInterface* tab = inserted.tab;
+      HeliumSpacesTabController* tab_ctrl =
+          HeliumSpacesTabController::From(tab);
+      if (!tab_ctrl) {
+        continue;
+      }
+
+      if (tab->IsPinned() &&
+          helium_pins::ArePersistentPinsEnabled(browser_->GetProfile())) {
+        if (auto* pin_ctrl = helium_pins::GetPersistentPinController(tab)) {
+          if (auto* pins_service = PinnedTabServiceFactory::GetForProfile(
+                  browser_->GetProfile())) {
+            std::string pin_space =
+                pins_service->GetPinSpaceId(pin_ctrl->pin_id());
+            if (pin_space.empty() || !service_->FindSpace(pin_space)) {
+              pin_space = service_->GetDefaultSpaceId();
+            }
+            if (tab_ctrl->space_id() != pin_space) {
+              tab_ctrl->SetSpaceId(pin_space);
+              visual_changed = true;
+            }
+            continue;
+          }
+        }
+      }
+
+      const bool has_valid_space =
+          !tab_ctrl->space_id().empty() &&
+          service_->FindSpace(tab_ctrl->space_id()) != nullptr;
+      if (!has_valid_space) {
+        const std::string resolved = ResolveInitialSpaceForTab(tab);
+        if (tab_ctrl->space_id() != resolved) {
+          tab_ctrl->SetSpaceId(resolved);
+          visual_changed = true;
+        }
+      } else {
+        // Keep tabs inserted into an existing split or group aligned with their
+        // sibling's Space.
+        std::string container_space;
+        if (const std::optional<split_tabs::SplitTabId> split_id =
+                tab->GetSplit()) {
+          for (tabs::TabInterface* member :
+               tab_strip_model->GetSplitData(*split_id)->ListTabs()) {
+            if (member == tab) {
+              continue;
+            }
+            const std::string member_space = GetTabSpaceId(member);
+            if (!member_space.empty() && service_->FindSpace(member_space)) {
+              container_space = member_space;
+              break;
+            }
+          }
+        } else if (const std::optional<tab_groups::TabGroupId> group_id =
+                       tab->GetGroup();
+                   group_id.has_value() && tab_strip_model->group_model() &&
+                   tab_strip_model->group_model()->ContainsTabGroup(
+                       *group_id)) {
+          const gfx::Range range =
+              tab_strip_model->group_model()->GetTabGroup(*group_id)->ListTabs();
+          for (size_t i = range.start(); i < range.end(); ++i) {
+            tabs::TabInterface* sibling =
+                tab_strip_model->GetTabAtIndex(static_cast<int>(i));
+            if (sibling == tab) {
+              continue;
+            }
+            const std::string sibling_space = GetTabSpaceId(sibling);
+            if (!sibling_space.empty() && service_->FindSpace(sibling_space)) {
+              container_space = sibling_space;
+              break;
+            }
+          }
+        }
+        if (!container_space.empty() && tab_ctrl->space_id() != container_space) {
+          tab_ctrl->SetSpaceId(container_space);
+          visual_changed = true;
+        } else if (!is_restoring && !window_was_empty && !tab->IsPinned() &&
+                   !tab_strip_model->delegate()->IsTabStripEditable() &&
+                   tab_ctrl->space_id() != active_space_id_) {
+          tab_ctrl->SetSpaceId(active_space_id_);
+          visual_changed = true;
+        }
+      }
+    }
+  }
+
+  if (selection.active_tab_changed() && selection.new_tab) {
+    if (!updating_space_ &&
+        !IsTabVisibleInSpace(tab_strip_model, selection.new_tab,
+                             active_space_id_)) {
+      const std::string tab_space = GetTabSpaceId(selection.new_tab);
+      if (!tab_space.empty() && service_->FindSpace(tab_space)) {
+        if (selection.old_tab) {
+          last_active_tabs_[active_space_id_] = selection.old_tab->GetHandle();
+        }
+        active_space_id_ = tab_space;
+        PersistWindowSpace();
+        visual_changed = true;
+      }
+    }
+    last_active_tabs_[active_space_id_] = selection.new_tab->GetHandle();
+  }
+
+  if (visual_changed) {
+    NotifyVisualStateChanged();
+  }
+}
+
+void HeliumWindowSpacesController::OnTabPinnedStateChanged(
+    tabs::TabInterface* tab,
+    int index) {
+  if (!service_ || !tab || active_space_id_.empty()) {
+    return;
+  }
+  // When unpinning a tab (e.g. a Global Pin created in another Space), keep it
+  // in the Space the user is currently viewing.
+  if (!tab->IsPinned()) {
+    if (auto* tab_ctrl = HeliumSpacesTabController::From(tab);
+        tab_ctrl && tab_ctrl->space_id() != active_space_id_) {
+      tab_ctrl->SetSpaceId(active_space_id_);
+    }
+  }
+  NotifyVisualStateChanged();
+}
+
+void HeliumWindowSpacesController::OnSpacesChanged() {
+  if (!service_) {
+    return;
+  }
+  if (!service_->FindSpace(active_space_id_)) {
+    SwitchToSpace(service_->GetDefaultSpaceId());
+    return;
+  }
+  NotifyVisualStateChanged();
+}
+
+void HeliumWindowSpacesController::OnSpaceDeleted(
+    const std::string& deleted_space_id,
+    const std::string& fallback_space_id) {
+  last_active_tabs_.erase(deleted_space_id);
+  if (active_space_id_ == deleted_space_id) {
+    SwitchToSpace(fallback_space_id);
+  } else {
+    NotifyVisualStateChanged();
+  }
+}
+
+void HeliumWindowSpacesController::OnPinsPerSpaceChanged() {
+  if (!service_) {
+    return;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (tabs::TabInterface* active = model->GetActiveTab();
+      active && !IsTabVisibleInSpace(model, active, active_space_id_)) {
+    base::AutoReset<bool> guard(&updating_space_, true);
+    ActivateTabForSpace(active_space_id_);
+  }
+  NotifyVisualStateChanged();
+}
+
+void HeliumWindowSpacesController::PersistWindowSpace() {
+  if (!browser_ || active_space_id_.empty()) {
+    return;
+  }
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!session_service || !browser_->GetSessionID().is_valid()) {
+    return;
+  }
+  session_service->AddWindowExtraData(browser_->GetSessionID(),
+                                      kActiveSpaceIdKey, active_space_id_);
+}
+
+void HeliumWindowSpacesController::ActivateTabForSpace(
+    const std::string& space_id) {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (tabs::TabInterface* target = FindTabToActivateInSpace(space_id)) {
+    const int idx = model->GetIndexOfTab(target);
+    if (idx != TabStripModel::kNoTab && idx != model->active_index()) {
+      model->ActivateTabAt(idx);
+    }
+    return;
+  }
+
+  chrome::AddTabAt(browser_, GURL(), /*index=*/-1, /*foreground=*/true);
+}
+
+tabs::TabInterface* HeliumWindowSpacesController::FindTabToActivateInSpace(
+    const std::string& space_id) const {
+  TabStripModel* const model = browser_->GetTabStripModel();
+
+  if (auto it = last_active_tabs_.find(space_id);
+      it != last_active_tabs_.end()) {
+    tabs::TabInterface* last = it->second.Get();
+    const int idx = last ? model->GetIndexOfTab(last) : TabStripModel::kNoTab;
+    if (idx != TabStripModel::kNoTab &&
+        IsTabVisibleInSpace(model, last, space_id) &&
+        !helium_pins::WouldShowHibernatedPin(*model, idx)) {
+      return last;
+    }
+  }
+
+  tabs::TabInterface* best_unpinned = nullptr;
+  tabs::TabInterface* best_loaded_pin = nullptr;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!IsTabVisibleInSpace(model, tab, space_id) ||
+        model->IsTabCollapsed(i) ||
+        helium_pins::WouldShowHibernatedPin(*model, i)) {
+      continue;
+    }
+    if (!tab->IsPinned()) {
+      if (!best_unpinned ||
+          tab->GetContents()->GetLastActiveTimeTicks() >
+              best_unpinned->GetContents()->GetLastActiveTimeTicks()) {
+        best_unpinned = tab;
+      }
+    } else if (!helium_pins::IsHibernated(tab->GetContents())) {
+      if (!best_loaded_pin ||
+          tab->GetContents()->GetLastActiveTimeTicks() >
+              best_loaded_pin->GetContents()->GetLastActiveTimeTicks()) {
+        best_loaded_pin = tab;
+      }
+    }
+  }
+
+  return best_unpinned ? best_unpinned : best_loaded_pin;
+}
+
+std::string HeliumWindowSpacesController::ResolveInitialSpaceForTab(
+    tabs::TabInterface* tab) const {
+  TabStripModel* const model = browser_->GetTabStripModel();
+
+  if (const std::optional<split_tabs::SplitTabId> split_id = tab->GetSplit()) {
+    for (tabs::TabInterface* member :
+         model->GetSplitData(*split_id)->ListTabs()) {
+      if (member == tab) {
+        continue;
+      }
+      const std::string member_space = GetTabSpaceId(member);
+      if (!member_space.empty() && service_->FindSpace(member_space)) {
+        return member_space;
+      }
+    }
+  }
+
+  if (const std::optional<tab_groups::TabGroupId> group_id = tab->GetGroup();
+      group_id.has_value() && model->group_model() &&
+      model->group_model()->ContainsTabGroup(*group_id)) {
+    const gfx::Range range =
+        model->group_model()->GetTabGroup(*group_id)->ListTabs();
+    for (size_t i = range.start(); i < range.end(); ++i) {
+      tabs::TabInterface* sibling = model->GetTabAtIndex(static_cast<int>(i));
+      if (sibling == tab) {
+        continue;
+      }
+      const std::string sibling_space = GetTabSpaceId(sibling);
+      if (!sibling_space.empty() && service_->FindSpace(sibling_space)) {
+        return sibling_space;
+      }
+    }
+  }
+
+  const int index = model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    if (tabs::TabInterface* opener = model->GetOpenerOfTabAt(index);
+        opener && !opener->IsPinned() &&
+        !IsTabVisibleInSpace(model, opener, active_space_id_)) {
+      const std::string opener_space = GetTabSpaceId(opener);
+      if (!opener_space.empty() && service_->FindSpace(opener_space)) {
+        return opener_space;
+      }
+    }
+  }
+
+  return active_space_id_;
+}
