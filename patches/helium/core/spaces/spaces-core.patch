+// Manages the ordered list of Spaces for a profile, persisted in profile prefs.
+class HeliumSpacesService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnSpacesChanged() {}
+    virtual void OnSpaceDeleted(const std::string& deleted_space_id,
+                                const std::string& fallback_space_id) {}
+    virtual void OnPinsPerSpaceChanged() {}
+  };
+
+  HeliumSpacesService(Profile* profile, PrefService* prefs);
+  HeliumSpacesService(const HeliumSpacesService&) = delete;
+  HeliumSpacesService& operator=(const HeliumSpacesService&) = delete;
+  ~HeliumSpacesService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const SpaceList& spaces() const { return spaces_; }
+  const std::string& GetDefaultSpaceId() const;
+  const Space* FindSpace(const std::string& id) const;
+  std::optional<size_t> GetSpaceIndex(const std::string& id) const;
+
+  bool PinsArePerSpace() const;
+
+  std::string CreateSpace(const std::u16string& name = {},
+                          const std::string& color = {},
+                          const std::string& icon = {});
+
+  bool RenameSpace(const std::string& id, const std::u16string& name);
+  bool SetSpaceColor(const std::string& id, const std::string& color);
+  bool SetSpaceIcon(const std::string& id, const std::string& icon);
+  bool ReorderSpace(const std::string& id, size_t new_index);
+
+  bool CanDeleteSpace(const std::string& id) const;
+  std::string GetFallbackSpaceId(const std::string& id) const;
+  bool HasTabsOrPinsInSpace(const std::string& id) const;
+  bool DeleteSpace(const std::string& id, bool move_tabs_to_fallback);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void SaveSpaces();
+  void OnPinsPerSpacePrefChanged();
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<PrefService> prefs_;
+  SpaceList spaces_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace helium_spaces
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_SPACES_SERVICE_H_
