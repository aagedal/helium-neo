+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_spaces_list.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+
+namespace helium_spaces {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kColorKey[] = "color";
+constexpr char kIconKey[] = "icon";
+
+}  // namespace
+
+std::string CreateSpaceId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+SpaceList::SpaceList() = default;
+SpaceList::SpaceList(const SpaceList&) = default;
+SpaceList& SpaceList::operator=(const SpaceList&) = default;
+SpaceList::SpaceList(SpaceList&&) = default;
+SpaceList& SpaceList::operator=(SpaceList&&) = default;
+SpaceList::~SpaceList() = default;
+
+// static
+SpaceList SpaceList::FromPref(const base::ListValue& value) {
+  SpaceList list;
+  for (const base::Value& entry : value) {
+    const base::DictValue* const dict = entry.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+
+    const std::string* const id = dict->FindString(kIdKey);
+    if (!id || id->empty() || list.Find(*id) != list.end()) {
+      continue;
+    }
+
+    Space space;
+    space.id = *id;
+    if (const std::string* const name = dict->FindString(kNameKey)) {
+      space.name = base::UTF8ToUTF16(*name);
+    }
+    if (const std::string* const color = dict->FindString(kColorKey)) {
+      space.color = *color;
+    }
+    if (const std::string* const icon = dict->FindString(kIconKey)) {
+      space.icon = *icon;
+    }
+    list.spaces_.push_back(std::move(space));
+  }
+  return list;
+}
+
+base::ListValue SpaceList::ToPref() const {
+  base::ListValue value;
+  for (const Space& space : spaces_) {
+    base::DictValue entry;
+    entry.Set(kIdKey, space.id);
+    entry.Set(kNameKey, base::UTF16ToUTF8(space.name));
+    if (!space.color.empty()) {
+      entry.Set(kColorKey, space.color);
+    }
+    if (!space.icon.empty()) {
+      entry.Set(kIconKey, space.icon);
+    }
+    value.Append(std::move(entry));
+  }
+  return value;
+}
+
+bool SpaceList::EnsureDefaultSpace(const std::u16string& default_name) {
+  if (!spaces_.empty()) {
+    return false;
+  }
+  spaces_.push_back({CreateSpaceId(), default_name, {}, {}});
+  return true;
+}
+
+SpaceList::iterator SpaceList::Find(const std::string& id) {
+  return std::ranges::find(spaces_, id, &Space::id);
+}
+
+SpaceList::const_iterator SpaceList::Find(const std::string& id) const {
+  return std::ranges::find(spaces_, id, &Space::id);
+}
+
+std::optional<size_t> SpaceList::IndexOf(const std::string& id) const {
+  const auto it = Find(id);
+  if (it == spaces_.end()) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(it - spaces_.begin());
+}
+
+void SpaceList::push_back(Space space) {
+  spaces_.push_back(std::move(space));
+}
+
+SpaceList::iterator SpaceList::insert(const_iterator position, Space space) {
+  return spaces_.insert(position, std::move(space));
+}
+
+SpaceList::iterator SpaceList::erase(const_iterator position) {
+  return spaces_.erase(position);
+}
+
+bool SpaceList::Move(const std::string& id, size_t new_index) {
+  const auto it = Find(id);
+  if (it == spaces_.end() || spaces_.size() < 2) {
+    return false;
+  }
+  const size_t old_index = static_cast<size_t>(it - spaces_.begin());
+  new_index = std::min(new_index, spaces_.size() - 1);
+  if (old_index == new_index) {
+    return false;
+  }
+  Space moved = std::move(*it);
+  spaces_.erase(it);
+  spaces_.insert(spaces_.begin() + new_index, std::move(moved));
+  return true;
+}
+
+}  // namespace helium_spaces
