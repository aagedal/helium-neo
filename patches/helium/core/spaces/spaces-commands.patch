+void SwitchToNextSpace(BrowserWindowInterface* browser) {
+  if (auto* ctrl = helium_spaces::HeliumWindowSpacesController::From(browser)) {
+    ctrl->SwitchToNextSpace();
+  }
+}
+
+void SwitchToPreviousSpace(BrowserWindowInterface* browser) {
+  if (auto* ctrl = helium_spaces::HeliumWindowSpacesController::From(browser)) {
+    ctrl->SwitchToPreviousSpace();
+  }
+}
+
+void SwitchToSpaceAtIndex(BrowserWindowInterface* browser, size_t index) {
+  if (auto* ctrl = helium_spaces::HeliumWindowSpacesController::From(browser)) {
+    ctrl->SwitchToSpaceAtIndex(index);
+  }
+}
+
+void CreateNewSpace(BrowserWindowInterface* browser) {
+  auto* ctrl = helium_spaces::HeliumWindowSpacesController::From(browser);
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser->GetProfile());
+  if (!ctrl || !service) {
+    return;
+  }
+  const std::string new_id = service->CreateSpace();
+  ctrl->SwitchToSpace(new_id);
+}
+
+void DeleteCurrentSpace(BrowserWindowInterface* browser) {
+  const std::string active_id = helium_spaces::GetActiveSpaceId(browser);
+  if (!active_id.empty()) {
+    helium_spaces::PromptToDeleteSpace(browser, active_id);
+  }
+}
