+      const size_t offset =
+          static_cast<size_t>(command_id - kFirstSpaceCommandId);
+      if (offset >= space_ids_.size()) {
+        return;
+      }
+      target_space_id = space_ids_[offset];
+    }
+
+    std::vector<tabs::TabInterface*> tabs;
+    if (tab_strip_->IsTabSelected(context_index_)) {
+      for (tabs::TabInterface* selected :
+           tab_strip_->selection_model().selected_tabs()) {
+        tabs.push_back(selected);
+      }
+    } else {
+      tabs.push_back(tab_strip_->GetTabAtIndex(context_index_));
+    }
+    ctrl->MoveTabsToSpace(tabs, target_space_id);
+  }
