+std::string HeliumPinsService::GetPinSpaceId(const std::string& id) const {
+  const auto it = pins_.Find(id);
+  return it == pins_.end() ? std::string() : it->space_id;
+}
+
+bool HeliumPinsService::IsPinAllSpaces(const std::string& id) const {
+  const auto it = pins_.Find(id);
+  return it != pins_.end() && it->all_spaces;
+}
+
+void HeliumPinsService::SetPinSpaceId(const std::string& id,
+                                      const std::string& space_id) {
+  const auto it = pins_.Find(id);
+  if (it == pins_.end()) {
+    return;
+  }
+  const std::string split = it->split;
+  std::vector<std::string> target_ids;
+  bool changed = false;
+  for (Pin& pin : pins_) {
+    if (pin.id == id || (!split.empty() && pin.split == split)) {
+      if (pin.space_id != space_id) {
+        pin.space_id = space_id;
+        changed = true;
+      }
+      target_ids.push_back(pin.id);
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  SavePins();
+
+  for (const std::string& target_id : target_ids) {
+    for (HeliumPinsTabController* copy : GetPinCopies(target_id)) {
+      if (auto* tab_ctrl =
+              helium_spaces::HeliumSpacesTabController::From(&copy->tab())) {
+        tab_ctrl->SetSpaceId(space_id);
+      }
+    }
+  }
+  for (BrowserWindowInterface* browser : GetSyncedBrowsers()) {
+    if (auto* win_ctrl =
+            helium_spaces::HeliumWindowSpacesController::From(browser)) {
+      win_ctrl->NotifyVisualStateChanged();
+    }
+  }
+}
+
+void HeliumPinsService::SetPinAllSpaces(const std::string& id,
+                                        bool all_spaces) {
+  const auto it = pins_.Find(id);
+  if (it == pins_.end()) {
+    return;
+  }
+  const std::string split = it->split;
+  bool changed = false;
+  for (Pin& pin : pins_) {
+    if (pin.id == id || (!split.empty() && pin.split == split)) {
+      if (pin.all_spaces != all_spaces) {
+        pin.all_spaces = all_spaces;
+        changed = true;
+      }
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  pins_.StablePartitionGlobalFirst();
+  SavePins();
+
+  for (BrowserWindowInterface* browser : GetSyncedBrowsers()) {
+    ScheduleReconcile(browser);
+    if (auto* win_ctrl =
+            helium_spaces::HeliumWindowSpacesController::From(browser)) {
+      win_ctrl->NotifyVisualStateChanged();
+    }
+  }
+}
+
+bool HeliumPinsService::HasPinsInSpace(const std::string& space_id) const {
+  if (space_id.empty()) {
+    return false;
+  }
+  const auto* spaces_service =
+      helium_spaces::HeliumSpacesServiceFactory::GetForProfile(profile_);
+  const std::string default_space =
+      spaces_service ? spaces_service->GetDefaultSpaceId() : std::string();
+  for (const Pin& pin : pins_) {
+    const std::string& effective_space =
+        pin.space_id.empty() ? default_space : pin.space_id;
+    if (!pin.all_spaces && effective_space == space_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HeliumPinsService::HasVisiblePinsInSpace(
+    const std::string& space_id) const {
+  if (space_id.empty()) {
+    return pins_.size() > 0;
+  }
+  const auto* spaces_service =
+      helium_spaces::HeliumSpacesServiceFactory::GetForProfile(profile_);
+  const std::string default_space =
+      spaces_service ? spaces_service->GetDefaultSpaceId() : std::string();
+  for (const Pin& pin : pins_) {
+    const std::string& effective_space =
+        pin.space_id.empty() ? default_space : pin.space_id;
+    if (pin.all_spaces || effective_space == space_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void HeliumPinsService::HandleSpaceDeleted(
+    const std::string& deleted_space_id,
+    const std::string& fallback_space_id,
+    bool move_to_fallback) {
+  if (deleted_space_id.empty()) {
+    return;
+  }
+
+  const auto* spaces_service =
+      helium_spaces::HeliumSpacesServiceFactory::GetForProfile(profile_);
+  const std::string default_space =
+      spaces_service ? spaces_service->GetDefaultSpaceId() : std::string();
+
+  std::vector<std::string> ids_to_remove;
+  bool changed = false;
+  for (Pin& pin : pins_) {
+    const std::string& effective_space =
+        pin.space_id.empty() ? default_space : pin.space_id;
+    if (effective_space != deleted_space_id) {
+      continue;
+    }
+    if (pin.all_spaces || move_to_fallback) {
+      pin.space_id = fallback_space_id;
+      changed = true;
+      for (HeliumPinsTabController* copy : GetPinCopies(pin.id)) {
+        if (auto* tab_ctrl =
+                helium_spaces::HeliumSpacesTabController::From(&copy->tab())) {
+          tab_ctrl->SetSpaceId(fallback_space_id);
+        }
+      }
+    } else {
+      ids_to_remove.push_back(pin.id);
+    }
+  }
+
+  if (changed) {
+    SavePins();
+  }
+  for (const std::string& id : ids_to_remove) {
+    UnpinEverywhere(id);
+  }
+}
