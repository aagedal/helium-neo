+  return std::ranges::find(pins_, id, &Pin::id);
+}
+
+bool PinList::StablePartitionGlobalFirst() {
+  std::vector<Pin> partitioned;
+  partitioned.reserve(pins_.size());
+  for (const Pin& pin : pins_) {
+    if (pin.all_spaces) {
+      partitioned.push_back(pin);
+    }
+  }
+  for (const Pin& pin : pins_) {
+    if (!pin.all_spaces) {
+      partitioned.push_back(pin);
+    }
+  }
+  bool changed = false;
+  for (size_t i = 0; i < pins_.size(); ++i) {
+    if (pins_[i].id != partitioned[i].id) {
+      changed = true;
+      break;
+    }
+  }
+  if (changed) {
+    pins_ = std::move(partitioned);
+  }
+  return changed;
+}
