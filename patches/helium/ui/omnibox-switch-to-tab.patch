+TEST_F(OmniboxEditModelPopupTest,
+       OpenNormalSelectionWithTabSwitchActionSwitchesToTab) {
+  ACMatches matches;
+  for (size_t i = 0; i < 3; ++i) {
+    AutocompleteMatch match(nullptr, 1000, false,
+                            omnibox::AutocompleteMatchType::kUrlWhatYouTyped);
+    match.keyword = u"match";
+    match.allowed_to_be_default_match = true;
+    matches.push_back(match);
+  }
+  const GURL url = GURL("https://example.com/");
+  matches[1].destination_url = url;
+  matches[1].provider =
+      controller()->autocomplete_controller()->search_provider();
+  matches[1].actions.push_back(base::MakeRefCounted<TabSwitchAction>(url));
+
+  matches[2].destination_url = GURL("https://webkit.example.com/");
+  matches[2].provider =
+      controller()->autocomplete_controller()->search_provider();
+  matches[2].extra_headers[kHeliumWebKitHeader] = "open";
+  matches[2].actions.push_back(
+      base::MakeRefCounted<TabSwitchAction>(matches[2].destination_url));
+
+  AutocompleteResult* result = &AutocompleteControllerPublishedResult();
+  result->AppendMatches(matches);
+  AutocompleteInput input(u"match", metrics::OmniboxEventProto::NTP,
+                          TestSchemeClassifier());
+  result->SortAndCull(input, /*template_url_service=*/nullptr,
+                      triggered_feature_service(), /*is_lens_active=*/false,
+                      /*can_show_contextual_suggestions=*/false,
+                      /*mia_enabled=*/false, /*is_incognito=*/false);
+  model()->OnPopupResultChanged();
+
+  model()->OpenSelection(
+      OmniboxPopupSelection(1, OmniboxPopupSelection::LineState::kNormal),
+      base::TimeTicks(), WindowOpenDisposition::kCurrentTab);
+  EXPECT_EQ(client()->last_log_disposition(),
+            WindowOpenDisposition::kSwitchToTab);
+
+  // Explicit non-current-tab dispositions keep opening a new copy.
+  model()->OpenSelection(
+      OmniboxPopupSelection(1, OmniboxPopupSelection::LineState::kNormal),
+      base::TimeTicks(), WindowOpenDisposition::kNewForegroundTab);
+  EXPECT_EQ(client()->last_log_disposition(),
+            WindowOpenDisposition::kNewForegroundTab);
+
+  // Explicit WebKit matches do not switch to an existing tab.
+  model()->OpenSelection(
+      OmniboxPopupSelection(2, OmniboxPopupSelection::LineState::kNormal),
+      base::TimeTicks(), WindowOpenDisposition::kCurrentTab);
+  EXPECT_EQ(client()->last_log_disposition(),
+            WindowOpenDisposition::kCurrentTab);
+}
