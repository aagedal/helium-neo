  private:
+  // The omnibox's marker is for Helium only; never send it to the site.
+  // Chromium can only remove a request header on a redirect, so a marked
+  // navigation that continues in Chromium starts over without it.
+  ThrottleCheckResult WithoutMarker(ThrottleCheckResult result,
+                                    bool redirect) {
+    auto* handle = navigation_handle();
+    if (result.action() != PROCEED ||
+        !handle->GetRequestHeaders().HasHeader(kWebKitRequestHeader)) {
+      return result;
+    }
+    if (redirect) {
+      handle->RemoveRequestHeader(kWebKitRequestHeader);
+      return result;
+    }
+    // Never start another navigation inside a NavigationThrottle callback.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> contents, const GURL& url,
+               ui::PageTransition transition) {
+              if (!contents)
+                return;
+              content::NavigationController::LoadURLParams params(url);
+              params.transition_type = transition;
+              contents->GetController().LoadURLWithParams(params);
+            },
+            handle->GetWebContents()->GetWeakPtr(), handle->GetURL(),
+            handle->GetPageTransition()));
+    return CANCEL_AND_IGNORE;
+  }
