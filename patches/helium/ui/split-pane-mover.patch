+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+constexpr int kHandleSize = 28;
+constexpr int kHandleIconSize = 16;
+constexpr int kHandleInset = 8;
+constexpr int kCornerRadius = 8;
+// Share of a pane's width and height, around its center, that swaps panes
+// rather than placing the dragged one beside it.
+constexpr float kSwapAreaStart = 0.3f;
+constexpr float kSwapAreaEnd = 0.7f;
+constexpr int kModifiers = ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                           ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN;
+constexpr int kRevealModifiers = ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN;
+
+// Marks where the dragged pane will go.
+class Indicator : public views::View {
+  METADATA_HEADER(Indicator, views::View)
+
+ public:
+  Indicator() = default;
+  Indicator(const Indicator&) = delete;
+  Indicator& operator=(const Indicator&) = delete;
+  ~Indicator() override = default;
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const SkColor color = GetColorProvider()->GetColor(ui::kColorSysPrimary);
+    gfx::RectF bounds(GetLocalBounds());
+    bounds.Inset(1);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(color, 0x40));
+    canvas->DrawRoundRect(bounds, kCornerRadius, flags);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(2);
+    flags.setColor(color);
+    canvas->DrawRoundRect(bounds, kCornerRadius, flags);
+  }
+};
+
+BEGIN_METADATA(Indicator)
+END_METADATA
+
+std::unique_ptr<views::Widget> CreatePopup(views::Widget* parent,
+                                           bool accept_events) {
+  auto widget = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.accept_events = accept_events;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.parent = parent->GetNativeView();
+  params.name = "SplitPaneMover";
+  widget->Init(std::move(params));
+  return widget;
+}
+
+}  // namespace
+
+// The grip shown in the corner of the pane under the pointer.
+class SplitPaneMover::Handle : public views::View {
+  METADATA_HEADER(Handle, views::View)
+
+ public:
+  explicit Handle(SplitPaneMover* mover) : mover_(mover) {
+    SetLayoutManager(std::make_unique<views::FillLayout>());
+    AddChildView(std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+        kHeliumDragIndicatorIcon, ui::kColorIcon, kHandleIconSize)));
+    SetBackground(views::CreateRoundedRectBackground(ui::kColorSysSurface,
+                                                     kCornerRadius));
+    SetBorder(views::CreateRoundedRectBorder(1, kCornerRadius,
+                                             ui::kColorSysDivider));
+    SetPreferredSize(gfx::Size(kHandleSize, kHandleSize));
+    // Only reachable with the pointer, so keep it out of the accessibility
+    // tree.
+    GetViewAccessibility().SetIsIgnored(true);
+  }
+  Handle(const Handle&) = delete;
+  Handle& operator=(const Handle&) = delete;
+  ~Handle() override = default;
+
+  // views::View:
+  ui::Cursor GetCursor(const ui::MouseEvent& event) override {
+    return ui::Cursor(ui::mojom::CursorType::kGrab);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    mover_->OnDragStarted();
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    gfx::Point point = event.location();
+    views::View::ConvertPointToScreen(this, &point);
+    mover_->OnDragged(point);
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    mover_->OnDragEnded(/*cancelled=*/false);
+  }
+
+  void OnMouseCaptureLost() override {
+    mover_->OnDragEnded(/*cancelled=*/true);
+  }
+
+ private:
+  const raw_ptr<SplitPaneMover> mover_;
+};
+
+BEGIN_METADATA(SplitPaneMover, Handle)
+END_METADATA
+
+SplitPaneMover::SplitPaneMover(MultiContentsView* multi_contents_view,
+                               TabStripModel* tab_strip_model)
+    : multi_contents_view_(multi_contents_view),
+      tab_strip_model_(tab_strip_model) {
+  StartMonitoring();
+}
+
+SplitPaneMover::~SplitPaneMover() = default;
+
+void SplitPaneMover::Reset() {
+  if (dragging_ && handle_widget_) {
+    // Ends the drag through OnDragEnded().
+    handle_widget_->ReleaseCapture();
+  }
+  dragging_ = false;
+  target_.reset();
+  HideIndicator();
+  handle_pane_.reset();
+  if (handle_widget_) {
+    handle_widget_->Hide();
+  }
+}
+
+void SplitPaneMover::OnEvent(const ui::Event& event) {
+  if (!multi_contents_view_->IsInSplitView()) {
+    Reset();
+    return;
+  }
+  int flags = event.flags();
+  if (event.IsKeyEvent()) {
+    const ui::KeyEvent* key = event.AsKeyEvent();
+    if (dragging_ && key->type() == ui::EventType::kKeyPressed &&
+        key->key_code() == ui::VKEY_ESCAPE) {
+      Reset();
+      return;
+    }
+    // The flags of a modifier's release may still include it.
+    if (key->type() == ui::EventType::kKeyReleased) {
+      switch (key->key_code()) {
+        case ui::VKEY_SHIFT:
+        case ui::VKEY_LSHIFT:
+        case ui::VKEY_RSHIFT:
+          flags &= ~ui::EF_SHIFT_DOWN;
+          break;
+        case ui::VKEY_LWIN:
+        case ui::VKEY_RWIN:
+          flags &= ~ui::EF_COMMAND_DOWN;
+          break;
+        default:
+          break;
+      }
+    }
+  }
+  UpdateHandle((flags & kModifiers) == kRevealModifiers);
+}
+
+void SplitPaneMover::StartMonitoring() {
+  views::Widget* widget = multi_contents_view_->GetWidget();
+  if (!widget || !widget->GetNativeWindow()) {
+    return;
+  }
+  event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget->GetNativeWindow(),
+      {ui::EventType::kMouseMoved, ui::EventType::kKeyPressed,
+       ui::EventType::kKeyReleased});
+}
+
+void SplitPaneMover::UpdateHandle(bool modifiers_down) {
+  if (dragging_) {
+    return;
+  }
+  handle_pane_ =
+      modifiers_down
+          ? PaneAt(display::Screen::Get()->GetCursorScreenPoint())
+          : std::nullopt;
+  if (!handle_pane_) {
+    if (handle_widget_) {
+      handle_widget_->Hide();
+    }
+    return;
+  }
+  if (!handle_widget_) {
+    handle_widget_ = CreatePopup(multi_contents_view_->GetWidget(),
+                                 /*accept_events=*/true);
+    handle_widget_->SetContentsView(std::make_unique<Handle>(this));
+  }
+  const gfx::Rect pane = PaneBoundsInScreen(*handle_pane_);
+  const int x = base::i18n::IsRTL()
+                    ? pane.right() - kHandleInset - kHandleSize
+                    : pane.x() + kHandleInset;
+  handle_widget_->SetBounds(
+      gfx::Rect(x, pane.y() + kHandleInset, kHandleSize, kHandleSize));
+  if (!handle_widget_->IsVisible()) {
+    handle_widget_->ShowInactive();
+  }
+}
+
+std::optional<size_t> SplitPaneMover::PaneAt(
+    const gfx::Point& point_in_screen) const {
+  const tabs::TabInterface* active = tab_strip_model_->GetActiveTab();
+  if (!active || !active->GetSplit()) {
+    return std::nullopt;
+  }
+  const size_t count = std::min(
+      tab_strip_model_->GetSplitData(*active->GetSplit())->ListTabs().size(),
+      multi_contents_view_->contents_container_views().size());
+  for (size_t pane = 0; pane < count; ++pane) {
+    if (PaneBoundsInScreen(pane).Contains(point_in_screen)) {
+      return pane;
+    }
+  }
+  return std::nullopt;
+}
+
+gfx::Rect SplitPaneMover::PaneBoundsInScreen(size_t pane) const {
+  return multi_contents_view_->contents_container_views()[pane]
+      ->GetBoundsInScreen();
+}
+
+std::optional<SplitPaneMover::Target> SplitPaneMover::TargetAt(
+    const gfx::Point& point_in_screen) const {
+  const std::optional<size_t> pane = PaneAt(point_in_screen);
+  if (!pane || pane == handle_pane_) {
+    return std::nullopt;
+  }
+  const gfx::Rect bounds = PaneBoundsInScreen(*pane);
+  if (bounds.IsEmpty()) {
+    return std::nullopt;
+  }
+  const float x = static_cast<float>(point_in_screen.x() - bounds.x()) /
+                  bounds.width();
+  const float y = static_cast<float>(point_in_screen.y() - bounds.y()) /
+                  bounds.height();
+  if (x >= kSwapAreaStart && x <= kSwapAreaEnd && y >= kSwapAreaStart &&
+      y <= kSwapAreaEnd) {
+    return Target{*pane, std::nullopt};
+  }
+  // The nearest edge. Like the panes, left and right follow the text
+  // direction.
+  const bool rtl = base::i18n::IsRTL();
+  const std::pair<float, split_tabs::SplitEdge> edges[] = {
+      {x, rtl ? split_tabs::SplitEdge::kRight : split_tabs::SplitEdge::kLeft},
+      {1 - x, rtl ? split_tabs::SplitEdge::kLeft : split_tabs::SplitEdge::kRight},
+      {y, split_tabs::SplitEdge::kTop},
+      {1 - y, split_tabs::SplitEdge::kBottom},
+  };
+  return Target{*pane, std::ranges::min(edges, {}, [](const auto& edge) {
+                         return edge.first;
+                       }).second};
+}
+
+void SplitPaneMover::OnDragStarted() {
+  dragging_ = handle_pane_.has_value();
+  target_.reset();
+}
+
+void SplitPaneMover::OnDragged(const gfx::Point& point_in_screen) {
+  if (!dragging_) {
+    return;
+  }
+  const std::optional<Target> target = TargetAt(point_in_screen);
+  if (target == target_) {
+    return;
+  }
+  target_ = target;
+  if (!target_) {
+    HideIndicator();
+    return;
+  }
+  gfx::Rect bounds = PaneBoundsInScreen(target_->pane);
+  if (target_->edge) {
+    const bool rtl = base::i18n::IsRTL();
+    switch (*target_->edge) {
+      case split_tabs::SplitEdge::kLeft:
+      case split_tabs::SplitEdge::kRight: {
+        const bool physical_left =
+            (*target_->edge == split_tabs::SplitEdge::kLeft) != rtl;
+        const int half = bounds.width() / 2;
+        bounds = gfx::Rect(physical_left ? bounds.x() : bounds.right() - half,
+                           bounds.y(), half, bounds.height());
+        break;
+      }
+      case split_tabs::SplitEdge::kTop:
+        bounds.set_height(bounds.height() / 2);
+        break;
+      case split_tabs::SplitEdge::kBottom:
+        bounds = gfx::Rect(bounds.x(), bounds.bottom() - bounds.height() / 2,
+                           bounds.width(), bounds.height() / 2);
+        break;
+    }
+  }
+  ShowIndicator(bounds);
+}
+
+void SplitPaneMover::OnDragEnded(bool cancelled) {
+  if (!dragging_) {
+    return;
+  }
+  dragging_ = false;
+  const std::optional<size_t> pane = handle_pane_;
+  const std::optional<Target> target = target_;
+  target_.reset();
+  HideIndicator();
+  handle_pane_.reset();
+  if (handle_widget_) {
+    handle_widget_->Hide();
+  }
+  if (cancelled || !pane || !target) {
+    return;
+  }
+  // Rearranging recreates the split, which resets this object; leave the
+  // handle's event first.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SplitPaneMover::Apply,
+                                weak_factory_.GetWeakPtr(), *pane, *target));
+}
+
+void SplitPaneMover::ShowIndicator(const gfx::Rect& bounds_in_screen) {
+  if (!indicator_widget_) {
+    indicator_widget_ = CreatePopup(multi_contents_view_->GetWidget(),
+                                    /*accept_events=*/false);
+    indicator_widget_->SetContentsView(std::make_unique<Indicator>());
+  }
+  indicator_widget_->SetBounds(bounds_in_screen);
+  if (!indicator_widget_->IsVisible()) {
+    indicator_widget_->ShowInactive();
+  }
+}
+
+void SplitPaneMover::HideIndicator() {
+  if (indicator_widget_) {
+    indicator_widget_->Hide();
+  }
+}
+
+void SplitPaneMover::Apply(size_t pane, const Target& target) {
+  const tabs::TabInterface* active = tab_strip_model_->GetActiveTab();
+  if (!active || !active->GetSplit()) {
+    return;
+  }
+  const split_tabs::SplitTabId split = *active->GetSplit();
+  const split_tabs::SplitTabData* data = tab_strip_model_->GetSplitData(split);
+  std::vector<tabs::TabInterface*> tabs = data->ListTabs();
+  if (pane >= tabs.size() || target.pane >= tabs.size() ||
+      pane == target.pane) {
+    return;
+  }
+  split_tabs::SplitLayoutTree tree = data->visual_data()->GetTree(tabs.size());
+  tabs::TabInterface* const moved = tabs[pane];
+  if (!target.edge) {
+    // Swap places; the layout stays.
+    std::swap(tabs[pane], tabs[target.pane]);
+  } else {
+    tree.RemovePane(pane);
+    tabs.erase(tabs.begin() + pane);
+    const size_t beside = target.pane > pane ? target.pane - 1 : target.pane;
+    const size_t position = tree.InsertPane(beside, *target.edge);
+    tabs.insert(tabs.begin() + position, moved);
+  }
+  if (tab_strip_model_->SetSplitPanes(split, tabs, std::move(tree))) {
+    tab_strip_model_->ActivateTabAt(tab_strip_model_->GetIndexOfTab(moved));
+  }
+}
