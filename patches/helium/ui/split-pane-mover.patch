+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_SPLIT_PANE_MOVER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_SPLIT_PANE_MOVER_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/split_tabs/split_layout_tree.h"
+#include "ui/events/event_observer.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+class MultiContentsView;
+class TabStripModel;
+
+namespace views {
+class EventMonitor;
+class Widget;
+}  // namespace views
+
+// Lets the user rearrange the panes of a split with the pointer. While Cmd+Shift
+// is held, the pane under the pointer shows a handle in its top-left corner.
+// Dragging the handle onto the edge of another pane moves the pane to that side
+// of it; dropping it in the middle of a pane swaps the two.
+class SplitPaneMover : public ui::EventObserver {
+ public:
+  SplitPaneMover(MultiContentsView* multi_contents_view,
+                 TabStripModel* tab_strip_model);
+  SplitPaneMover(const SplitPaneMover&) = delete;
+  SplitPaneMover& operator=(const SplitPaneMover&) = delete;
+  ~SplitPaneMover() override;
+
+  // Hides the handle, for example when the split ends.
+  void Reset();
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+ private:
+  class Handle;
+
+  // Where a dragged pane goes: beside `pane`, or in its place if `edge` is
+  // nullopt.
+  struct Target {
+    size_t pane = 0;
+    std::optional<split_tabs::SplitEdge> edge;
+
+    friend bool operator==(const Target&, const Target&) = default;
+  };
+
+  void StartMonitoring();
+  // Shows or hides the handle for the pane under the pointer.
+  void UpdateHandle(bool modifiers_down);
+  std::optional<size_t> PaneAt(const gfx::Point& point_in_screen) const;
+  gfx::Rect PaneBoundsInScreen(size_t pane) const;
+  std::optional<Target> TargetAt(const gfx::Point& point_in_screen) const;
+
+  // Called by the handle.
+  void OnDragStarted();
+  void OnDragged(const gfx::Point& point_in_screen);
+  void OnDragEnded(bool cancelled);
+
+  void ShowIndicator(const gfx::Rect& bounds_in_screen);
+  void HideIndicator();
+  // Moves or swaps the dragged pane.
+  void Apply(size_t pane, const Target& target);
+
+  const raw_ptr<MultiContentsView> multi_contents_view_;
+  const raw_ptr<TabStripModel> tab_strip_model_;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  std::unique_ptr<views::Widget> handle_widget_;
+  std::unique_ptr<views::Widget> indicator_widget_;
+  // The pane showing the handle.
+  std::optional<size_t> handle_pane_;
+  bool dragging_ = false;
+  std::optional<Target> target_;
+  base::WeakPtrFactory<SplitPaneMover> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_SPLIT_PANE_MOVER_H_
