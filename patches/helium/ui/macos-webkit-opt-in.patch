+
+std::string SiteLabel(const GURL& url) {
+  const std::string site =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          url, net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES);
+  return site.substr(0, site.find('.'));
+}
+
+// Prime Video on Amazon's own sites, e.g. amazon.de/gp/video or
+// amazon.de/-/en/gp/video, but not the rest of the shop.
+bool IsAmazonVideoUrl(const GURL& url) {
+  if (SiteLabel(url) != "amazon") {
+    return false;
+  }
+  std::string_view path = url.path();
+  if (path.starts_with("/-/")) {
+    const size_t next = path.find('/', 3);
+    path = next == std::string_view::npos ? std::string_view()
+                                          : path.substr(next);
+  }
+  return path.starts_with("/gp/video") || path.starts_with("/Amazon-Video") ||
+         path.starts_with("/Prime-Video");
+}
