+// The omnibox marks "Open ... in WebKit" with this header (see
+// kHeliumWebKitHeader in components/omnibox/browser/autocomplete_match.h).
+// Only browser-initiated navigations may carry it; the throttle removes it
+// before the request is sent.
+constexpr char kWebKitRequestHeader[] = "x-helium-webkit";
+
+enum class WebKitRequest { kNone, kOpen };
+
+WebKitRequest GetWebKitRequest(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || handle->IsRendererInitiated())
+    return WebKitRequest::kNone;
+  std::optional<std::string> value =
+      handle->GetRequestHeaders().GetHeader(kWebKitRequestHeader);
+  return value == "open" ? WebKitRequest::kOpen : WebKitRequest::kNone;
+}
+
+PrefService* StreamingPrefs(content::BrowserContext* context) {
+  PrefService* prefs = context ? user_prefs::UserPrefs::Get(context) : nullptr;
+  return prefs && prefs->FindPreference(helium::kWebKitStreamingAlwaysOpenPref)
+             ? prefs
+             : nullptr;
+}
+
+bool IsAlwaysOpenInWebKit(content::BrowserContext* context, const GURL& url) {
+  const char* service = StreamingService(url);
+  PrefService* prefs = service ? StreamingPrefs(context) : nullptr;
+  return prefs && prefs->GetList(helium::kWebKitStreamingAlwaysOpenPref)
+                      .contains(service);
+}
+
+void SetAlwaysOpenInWebKit(content::BrowserContext* context,
+                           const char* service,
+                           bool always) {
+  PrefService* prefs = StreamingPrefs(context);
+  if (!prefs || !service)
+    return;
+  ScopedListPrefUpdate update(prefs, helium::kWebKitStreamingAlwaysOpenPref);
+  base::Value value(service);
+  update->EraseValue(value);
+  if (always)
+    update->Append(std::move(value));
+}
