+void BuiltinProvider::AddHeliumWebKitMatch(const AutocompleteInput& input) {
+#if BUILDFLAG(IS_MAC)
+  PrefService* prefs = client_->GetPrefs();
+  if (client_->IsOffTheRecord() || !prefs) {
+    return;
+  }
+  const PrefService::Preference* always_open =
+      prefs->FindPreference(kHeliumWebKitAlwaysOpenPref);
+  if (!always_open || !always_open->GetValue()->is_list()) {
+    return;
+  }
+  const std::u16string& text = input.text();
+  if (text.empty() ||
+      std::ranges::any_of(text, [](char16_t c) {
+        return base::IsUnicodeWhitespace(c);
+      })) {
+    return;
+  }
+
+  // Either a URL on the service ("netflix.com/browse"), or a prefix of its
+  // host that the match completes inline ("netf" -> "netflix.com").
+  const GURL typed_url = url_formatter::FixupURL(base::UTF16ToUTF8(text),
+                                                 std::string());
+  std::string prefix = base::ToLowerASCII(base::UTF16ToUTF8(text));
+  if (prefix.starts_with("www.")) {
+    prefix = prefix.substr(4);
+  }
+  const bool can_complete = prefix.size() >= 4 &&
+                            prefix.find_first_of("/:?#") == std::string::npos;
+
+  const bool usable_url = typed_url.is_valid() &&
+                          typed_url.SchemeIsHTTPOrHTTPS() &&
+                          !typed_url.has_username() &&
+                          !typed_url.has_password() && !typed_url.has_port();
+  GURL::Replacements https;
+  https.SetSchemeStr("https");
+  for (const HeliumStreamingService& service : kHeliumStreamingServices) {
+    GURL destination;
+    std::u16string completion;
+    if (usable_url &&
+        ((service.site_label && SiteLabel(typed_url) == service.site_label) ||
+         (std::string_view(service.id) == "primevideo" &&
+          IsAmazonVideoUrl(typed_url)))) {
+      destination = typed_url.ReplaceComponents(https);
+    }
+    for (const char* host : service.hosts) {
+      if (!host || destination.is_valid()) {
+        continue;
+      }
+      if (usable_url && typed_url.DomainIs(host)) {
+        destination = typed_url.ReplaceComponents(https);
+      } else if (can_complete && std::string_view(host).starts_with(prefix) &&
+                 prefix != host) {
+        destination = GURL(base::StrCat({"https://", host, "/"}));
+        completion = base::UTF8ToUTF16(std::string_view(host).substr(
+            prefix.size()));
+      }
+    }
+    if (!destination.is_valid()) {
+      continue;
+    }
+    // The service already opens in WebKit.
+    if (always_open->GetValue()->GetList().contains(service.id)) {
+      return;
+    }
+
+    AutocompleteMatch match(this, kHeliumWebKitRelevance, false,
+                            omnibox::AutocompleteMatchType::kNavsuggest);
+    match.suggest_type = omnibox::TYPE_NAVIGATION;
+    match.destination_url = destination;
+    match.fill_into_edit = text + completion;
+    match.inline_autocompletion = completion;
+    match.allowed_to_be_default_match =
+        completion.empty() || !input.prevent_inline_autocomplete();
+    match.contents = base::StrCat({u"Open ", service.name, u" in WebKit"});
+    match.contents_class = {ACMatchClassification(0, ACMatchClassification::NONE)};
+    match.description =
+        u"Without WebKit, playback may fail or be lower quality";
+    match.description_class = {
+        ACMatchClassification(0, ACMatchClassification::DIM)};
+    match.extra_headers[kHeliumWebKitHeader] = "open";
+    matches_.push_back(std::move(match));
+    return;
+  }
+#endif  // BUILDFLAG(IS_MAC)
 }
 
