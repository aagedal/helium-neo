+// are available, so its absence also means "do not offer WebKit".
+constexpr char kHeliumWebKitAlwaysOpenPref[] =
+    "helium.webkit_streaming.always_open";
+
+// Above url-what-you-typed and history, so WebKit is the first suggestion.
+constexpr int kHeliumWebKitRelevance = 1500;
