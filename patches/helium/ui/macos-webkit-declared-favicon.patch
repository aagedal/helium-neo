+  void FindDeclaredFavicon() {
+    if (finding_declared_favicon_ || !controller_)
+      return;
+    finding_declared_favicon_ = true;
+    NSString* script =
+        @"(() => {"
+         "  const icons = [...document.querySelectorAll('link[rel][href]')]"
+         "    .filter(l => /(^|\\s)(icon|apple-touch-icon)(\\s|$)/i"
+         "      .test(l.rel))"
+         "    .map(l => {"
+         "      const m = /(\\d+)x\\d+/.exec(l.getAttribute('sizes') || '');"
+         "      const size = m ? +m[1] : 0;"
+         "      return {href: l.href,"
+         "              rank: [/apple-touch-icon/i.test(l.rel) ? 1 : 0,"
+         "                     /svg/i.test(l.type) ||"
+         "                         /\\.svg([?#]|$)/i.test(l.href) ? 1 : 0,"
+         "                     size >= 32 ? size : 10000 - size]};"
+         "    });"
+         "  icons.sort((a, b) => a.rank[0] - b.rank[0] ||"
+         "      a.rank[1] - b.rank[1] || a.rank[2] - b.rank[2]);"
+         "  return icons.length ? icons[0].href : '';"
