+std::vector<CommandBarView::Entry> CommandBarView::GetArchivedTabEntries(
+    const std::u16string& query,
+    const std::vector<std::pair<GURL, tabs::TabHandle>>& open_urls,
+    TemplateURLService* template_url_service) const {
+  ArchivedTabsService* archived_service =
+      ArchivedTabsServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!archived_service) {
+    return {};
+  }
+  const std::vector<std::u16string> terms =
+      base::SplitString(base::i18n::ToLower(query), base::kWhitespaceUTF16,
+                        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (terms.empty()) {
+    return {};
+  }
+
+  struct ScoredArchived {
+    raw_ptr<const ArchivedTabsService::ArchivedTab> tab;
+    int score = 0;
+  };
+  std::vector<ScoredArchived> matches;
+  for (const ArchivedTabsService::ArchivedTab& archived :
+       archived_service->archived_tabs()) {
+    const GURL stripped = AutocompleteMatch::GURLToStrippedGURL(
+        archived.url, input_, template_url_service, std::u16string(),
+        /*keep_search_intent_params=*/true);
+    if (std::ranges::contains(open_urls, stripped,
+                              &std::pair<GURL, tabs::TabHandle>::first)) {
+      continue;
+    }
+    const int score = ScoreTab(terms, archived.title, archived.url);
+    if (score > 0) {
+      matches.push_back({&archived, score});
+    }
+  }
+  std::ranges::sort(matches, [](const ScoredArchived& a,
+                                const ScoredArchived& b) {
+    if (a.score != b.score) {
+      return a.score > b.score;
+    }
+    return a.tab->archived_time > b.tab->archived_time;
+  });
+  if (matches.size() > kMaxArchivedTabsWithQuery) {
+    matches.resize(kMaxArchivedTabsWithQuery);
+  }
+
+  std::vector<Entry> entries;
+  entries.reserve(matches.size());
+  for (const ScoredArchived& scored : matches) {
+    const ArchivedTabsService::ArchivedTab& archived = *scored.tab;
+    Entry entry;
+    entry.archived_tab_id = archived.id;
+    entry.title = archived.title.empty() ? FormatUrlForDisplay(archived.url)
+                                         : archived.title;
+    entry.detail = FormatUrlForDisplay(archived.url);
+    entry.favicon_url = archived.url;
+    entry.icon = ui::ImageModel::FromVectorIcon(
+        vector_icons::kHistoryIcon, kColorOmniboxResultsIcon, kIconSize);
+    entry.action = l10n_util::GetStringUTF16(
+        IDS_HELIUM_COMMAND_BAR_RESTORE_ARCHIVED_TAB);
+    entry.always_show_action = true;
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
