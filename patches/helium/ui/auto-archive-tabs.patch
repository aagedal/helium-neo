+class ProfileBrowserCollection;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Automatically closes inactive tabs after a configurable number of days
+// (excluding pinned, active/visible, and audio/media-active tabs) and keeps
+// them in a persistent archived list so users can browse, search, and restore
+// them later.
+class ArchivedTabsService : public KeyedService,
+                            public BrowserCollectionObserver,
+                            public TabStripModelObserver {
+ public:
+  struct ArchivedTab {
+    ArchivedTab();
+    ArchivedTab(const ArchivedTab&);
+    ArchivedTab& operator=(const ArchivedTab&);
+    ArchivedTab(ArchivedTab&&);
+    ArchivedTab& operator=(ArchivedTab&&);
+    ~ArchivedTab();
+
+    int32_t id = 0;
+    GURL url;
+    std::u16string title;
+    base::Time archived_time;
+    base::Time last_active_time;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnArchivedTabsChanged() = 0;
+  };
+
+  static constexpr size_t kMaxArchivedTabs = 500;
+  static constexpr int kDefaultAutoArchiveDays = 7;
+
+  ArchivedTabsService(Profile* profile, PrefService* prefs);
+  ArchivedTabsService(const ArchivedTabsService&) = delete;
+  ArchivedTabsService& operator=(const ArchivedTabsService&) = delete;
+  ~ArchivedTabsService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Returns archived tabs ordered newest archived first.
+  const std::vector<ArchivedTab>& archived_tabs() const {
+    return archived_tabs_;
+  }
+
+  // Restores the archived tab with `id` into `browser` (or the most recent
+  // normal browser of this profile if `browser` is null) and removes it from
+  // the archived list. Returns true if an entry with `id` was found.
+  bool RestoreArchivedTab(
+      int32_t id,
+      BrowserWindowInterface* browser,
+      WindowOpenDisposition disposition =
+          WindowOpenDisposition::kNewForegroundTab);
+
+  // Permanently removes the archived tab with `id` without opening it.
+  bool RemoveArchivedTab(int32_t id);
+
+  // Clears all archived tabs.
+  void ClearArchivedTabs();
+
+  // Scans all normal browser windows of this profile and archives tabs whose
+  // inactivity exceeds the configured threshold. Returns the number of tabs
+  // archived.
+  size_t ArchiveInactiveTabsNow(base::Time now = base::Time::Now());
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  bool IsTrackedBrowser(BrowserWindowInterface* browser) const;
+  void TrackExistingBrowsers();
+  void TrackBrowser(BrowserWindowInterface* browser);
+
+  void RecordFallbackActiveTimeIfMissing(content::WebContents* contents,
+                                         base::Time now);
+  base::Time GetEffectiveLastActiveTime(content::WebContents* contents,
+                                        base::Time now);
+
+  bool IsSingleTabEligibleForAutoArchive(TabStripModel* tab_strip,
+                                         int index,
+                                         base::Time now,
+                                         base::TimeDelta max_inactivity);
+  bool CanAutoArchiveTab(TabStripModel* tab_strip,
+                         int index,
+                         base::Time now,
+                         base::TimeDelta max_inactivity);
+
+  void LoadFromPrefs();
+  void SaveToPrefs();
+  void NotifyObservers();
+  void AddArchivedEntry(const GURL& url,
+                        const std::u16string& title,
+                        base::Time archived_time,
+                        base::Time last_active_time);
+
+  void OnAutoArchivePrefChanged();
+  void ScheduleTimers(base::TimeDelta initial_delay);
+  void RunScheduledCheck();
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<PrefService> prefs_;
+
+  std::vector<ArchivedTab> archived_tabs_;
+  int32_t next_id_ = 1;
+
+  // Fallback timestamps for tabs whose WebContents::GetLastActiveTime() is
+  // null (e.g., newly opened background tabs that were never activated).
+  base::flat_map<content::WebContents*, base::Time> fallback_active_times_;
+
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  base::flat_set<raw_ptr<TabStripModel>> observed_tab_strips_;
+
+  PrefChangeRegistrar pref_change_registrar_;
+  base::OneShotTimer initial_check_timer_;
+  base::RepeatingTimer periodic_check_timer_;
+
+  base::ObserverList<Observer> observers_;
+};
+
+#endif  // CHROME_BROWSER_UI_TABS_ARCHIVED_TABS_SERVICE_H_
