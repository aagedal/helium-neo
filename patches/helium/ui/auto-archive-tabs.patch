+namespace {
+
+constexpr base::TimeDelta kInitialCheckDelay = base::Seconds(60);
+constexpr base::TimeDelta kPrefChangeCheckDelay = base::Seconds(5);
+constexpr base::TimeDelta kPeriodicCheckInterval = base::Minutes(15);
+
+constexpr char kKeyId[] = "id";
+constexpr char kKeyUrl[] = "url";
+constexpr char kKeyTitle[] = "title";
+constexpr char kKeyArchivedTime[] = "archived_time";
+constexpr char kKeyLastActiveTime[] = "last_active_time";
+
+GURL GetArchivableUrl(content::WebContents* contents) {
+  if (!contents) {
+    return GURL();
+  }
+#if BUILDFLAG(IS_MAC)
+  if (GURL webkit_url = helium::GetWebKitStreamingTabURL(contents);
+      webkit_url.is_valid()) {
+    return webkit_url;
+  }
+#endif
+  const GURL& committed = contents->GetLastCommittedURL();
+  return committed.is_valid() && !committed.is_empty()
+             ? committed
+             : contents->GetVisibleURL();
+}
+
+bool IsNewTabOrBlankUrl(const GURL& url) {
+  if (!url.is_valid() || url.is_empty() || url.IsAboutBlank()) {
+    return true;
+  }
+  if (url.spec() == chrome::kChromeUISplitViewNewTabPageURL) {
+    return true;
+  }
+  if (url.SchemeIs(content::kChromeUIScheme) &&
+      (url.host() == chrome::kChromeUINewTabHost ||
+       url.host() == chrome::kChromeUINewTabPageHost)) {
+    return true;
+  }
+  return false;
+}
+
+bool HasBlockingTabAlert(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  if (contents && contents->IsCurrentlyAudible()) {
+    return true;
+  }
+  const tabs::TabAlertController* alert_controller =
+      tabs::TabAlertController::From(tab);
+  if (!alert_controller) {
+    return false;
+  }
+  for (tabs::TabAlert alert : alert_controller->GetAllActiveAlerts()) {
+    switch (alert) {
+      case tabs::TabAlert::kAudioPlaying:
+      case tabs::TabAlert::kMediaRecording:
+      case tabs::TabAlert::kAudioRecording:
+      case tabs::TabAlert::kVideoRecording:
+      case tabs::TabAlert::kTabCapturing:
+      case tabs::TabAlert::kDesktopCapturing:
+      case tabs::TabAlert::kPipPlaying:
+      case tabs::TabAlert::kBluetoothConnected:
+      case tabs::TabAlert::kBluetoothScanActive:
+      case tabs::TabAlert::kUsbConnected:
+      case tabs::TabAlert::kHidConnected:
+      case tabs::TabAlert::kSerialConnected:
+      case tabs::TabAlert::kVrPresentingInHeadset:
+      case tabs::TabAlert::kGlicAccessing:
+      case tabs::TabAlert::kActorAccessing:
+      case tabs::TabAlert::kActorWaitingOnUser:
+        return true;
+      case tabs::TabAlert::kNone:
+      case tabs::TabAlert::kAudioMuting:
+      case tabs::TabAlert::kGlicSharing:
+      case tabs::TabAlert::kAiModeSharing:
+        break;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+ArchivedTabsService::ArchivedTab::ArchivedTab() = default;
+ArchivedTabsService::ArchivedTab::ArchivedTab(const ArchivedTab&) = default;
+ArchivedTabsService::ArchivedTab& ArchivedTabsService::ArchivedTab::operator=(
+    const ArchivedTab&) = default;
+ArchivedTabsService::ArchivedTab::ArchivedTab(ArchivedTab&&) = default;
+ArchivedTabsService::ArchivedTab& ArchivedTabsService::ArchivedTab::operator=(
+    ArchivedTab&&) = default;
+ArchivedTabsService::ArchivedTab::~ArchivedTab() = default;
+
+ArchivedTabsService::ArchivedTabsService(Profile* profile, PrefService* prefs)
+    : profile_(profile), prefs_(prefs) {
+  LoadFromPrefs();
+
+  if (profile_) {
+    if (ProfileBrowserCollection* collection =
+            ProfileBrowserCollection::GetForProfile(profile_)) {
+      browser_collection_observation_.Observe(collection);
+    }
+    TrackExistingBrowsers();
+  }
+
+  if (prefs_) {
+    pref_change_registrar_.Init(prefs_);
+    pref_change_registrar_.Add(
+        prefs::kHeliumAutoArchiveTabsAfterDays,
+        base::BindRepeating(&ArchivedTabsService::OnAutoArchivePrefChanged,
+                            base::Unretained(this)));
+    ScheduleTimers(kInitialCheckDelay);
+  }
+}
+
+ArchivedTabsService::~ArchivedTabsService() {
+  Shutdown();
+}
+
+void ArchivedTabsService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ArchivedTabsService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+bool ArchivedTabsService::RestoreArchivedTab(
+    int32_t id,
+    BrowserWindowInterface* browser,
+    WindowOpenDisposition disposition) {
+  auto it = std::ranges::find(archived_tabs_, id, &ArchivedTab::id);
+  if (it == archived_tabs_.end()) {
+    return false;
+  }
+
+  const GURL url = it->url;
+  archived_tabs_.erase(it);
+  SaveToPrefs();
+  NotifyObservers();
+
+  BrowserWindowInterface* target_browser = browser;
+  if (!target_browser && profile_) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* candidate) {
+          if (IsTrackedBrowser(candidate)) {
+            target_browser = candidate;
+            return false;
+          }
+          return true;
+        });
+  }
+
+  if (!target_browser || !url.is_valid()) {
+    return true;
+  }
+
+  NavigateParams params(target_browser, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = disposition;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+  if (target_browser->GetWindow()) {
+    target_browser->GetWindow()->Activate();
+  }
+  return true;
+}
+
+bool ArchivedTabsService::RemoveArchivedTab(int32_t id) {
+  const size_t erased =
+      std::erase_if(archived_tabs_, [id](const ArchivedTab& tab) {
+        return tab.id == id;
+      });
+  if (erased == 0) {
+    return false;
+  }
+  SaveToPrefs();
+  NotifyObservers();
+  return true;
+}
+
+void ArchivedTabsService::ClearArchivedTabs() {
+  if (archived_tabs_.empty()) {
+    return;
+  }
+  archived_tabs_.clear();
+  SaveToPrefs();
+  NotifyObservers();
+}
+
+size_t ArchivedTabsService::ArchiveInactiveTabsNow(base::Time now) {
+  if (!profile_ || !prefs_ || browser_shutdown::HasShutdownStarted()) {
+    return 0;
+  }
+
+  const int archive_after_days =
+      prefs_->GetInteger(prefs::kHeliumAutoArchiveTabsAfterDays);
+  if (archive_after_days <= 0) {
+    return 0;
+  }
+
+  const base::TimeDelta max_inactivity = base::Days(archive_after_days);
+  std::vector<std::pair<BrowserWindowInterface*, tabs::TabHandle>> candidates;
+
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (!IsTrackedBrowser(browser)) {
+          return true;
+        }
+        TabStripModel* tab_strip = browser->GetTabStripModel();
+        if (!tab_strip || tab_strip->count() <= 1 ||
+            tab_strip->closing_all() || !tab_strip->delegate() ||
+            !tab_strip->delegate()->IsTabStripEditable()) {
+          return true;
+        }
+
+        for (int i = 0; i < tab_strip->count(); ++i) {
+          if (CanAutoArchiveTab(tab_strip, i, now, max_inactivity)) {
+            candidates.emplace_back(browser,
+                                    tab_strip->GetTabAtIndex(i)->GetHandle());
+          }
+        }
+        return true;
+      });
+
+  size_t archived_count = 0;
+  for (const auto& [browser, handle] : candidates) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || !IsTrackedBrowser(browser)) {
+      continue;
+    }
+    TabStripModel* tab_strip = browser->GetTabStripModel();
+    if (!tab_strip || tab_strip->count() <= 1 || tab_strip->closing_all()) {
+      continue;
+    }
+    const int index = tab_strip->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab ||
+        !IsSingleTabEligibleForAutoArchive(tab_strip, index, now,
+                                           max_inactivity)) {
+      continue;
+    }
+
+    content::WebContents* contents = tab->GetContents();
+    const GURL url = GetArchivableUrl(contents);
+    std::u16string title = contents->GetTitle();
+    if (title.empty()) {
+      title = base::UTF8ToUTF16(url.spec());
+    }
+    const base::Time last_active = GetEffectiveLastActiveTime(contents, now);
+
+    AddArchivedEntry(url, title, now, last_active);
+    fallback_active_times_.erase(contents);
+    tab_strip->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+    ++archived_count;
+  }
+
+  if (archived_count > 0) {
+    SaveToPrefs();
+    NotifyObservers();
+  }
+  return archived_count;
+}
+
+void ArchivedTabsService::Shutdown() {
+  initial_check_timer_.Stop();
+  periodic_check_timer_.Stop();
+  pref_change_registrar_.Reset();
+  browser_collection_observation_.Reset();
+  for (TabStripModel* tab_strip : observed_tab_strips_) {
+    tab_strip->RemoveObserver(this);
+  }
+  observed_tab_strips_.clear();
+  fallback_active_times_.clear();
+}
+
+void ArchivedTabsService::OnBrowserCreated(BrowserWindowInterface* browser) {
+  TrackBrowser(browser);
+}
+
+void ArchivedTabsService::OnBrowserClosed(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return;
+  }
+  TabStripModel* tab_strip = browser->GetTabStripModel();
+  if (tab_strip && observed_tab_strips_.erase(tab_strip) > 0) {
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      if (content::WebContents* contents = tab_strip->GetWebContentsAt(i)) {
+        fallback_active_times_.erase(contents);
+      }
+    }
+    tab_strip->RemoveObserver(this);
+  }
+}
+
+void ArchivedTabsService::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  const base::Time now = base::Time::Now();
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& contents : change.GetInsert()->contents) {
+        RecordFallbackActiveTimeIfMissing(contents.contents, now);
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const auto& contents : change.GetRemove()->contents) {
+        fallback_active_times_.erase(contents.contents);
+      }
+      break;
+    case TabStripModelChange::kReplaced: {
+      const auto* replace = change.GetReplace();
+      fallback_active_times_.erase(replace->old_contents);
+      RecordFallbackActiveTimeIfMissing(replace->new_contents, now);
+      break;
+    }
+    case TabStripModelChange::kMoved:
+    case TabStripModelChange::kSelectionOnly:
+      break;
+  }
+
+  if (selection.active_tab_changed() && selection.new_contents) {
+    fallback_active_times_[selection.new_contents] = now;
+  }
+}
+
+bool ArchivedTabsService::IsTrackedBrowser(
+    BrowserWindowInterface* browser) const {
+  return browser && browser->GetProfile() == profile_ &&
+         browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !browser->IsDeleteScheduled();
+}
+
+void ArchivedTabsService::TrackExistingBrowsers() {
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        TrackBrowser(browser);
+        return true;
+      });
+}
+
+void ArchivedTabsService::TrackBrowser(BrowserWindowInterface* browser) {
+  if (!IsTrackedBrowser(browser)) {
+    return;
+  }
+  TabStripModel* tab_strip = browser->GetTabStripModel();
+  if (!tab_strip || !observed_tab_strips_.insert(tab_strip).second) {
+    return;
+  }
+  tab_strip->AddObserver(this);
+  const base::Time now = base::Time::Now();
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    RecordFallbackActiveTimeIfMissing(tab_strip->GetWebContentsAt(i), now);
+  }
+}
+
+void ArchivedTabsService::RecordFallbackActiveTimeIfMissing(
+    content::WebContents* contents,
+    base::Time now) {
+  if (!contents) {
+    return;
+  }
+  if (contents->GetLastActiveTime().is_null()) {
+    fallback_active_times_.try_emplace(contents, now);
+  }
+}
+
+base::Time ArchivedTabsService::GetEffectiveLastActiveTime(
+    content::WebContents* contents,
+    base::Time now) {
+  if (!contents) {
+    return now;
+  }
+  base::Time last_active = contents->GetLastActiveTime();
+  if (!last_active.is_null()) {
+    return last_active;
+  }
+  auto [it, inserted] = fallback_active_times_.try_emplace(contents, now);
+  return it->second;
+}
+
+bool ArchivedTabsService::IsSingleTabEligibleForAutoArchive(
+    TabStripModel* tab_strip,
+    int index,
+    base::Time now,
+    base::TimeDelta max_inactivity) {
+  tabs::TabInterface* tab = tab_strip->GetTabAtIndex(index);
+  if (!tab) {
+    return false;
+  }
+  if (tab->IsPinned() || tab->IsActivated() || tab->IsVisible() ||
+      tab_strip->IsTabInForeground(index)) {
+    return false;
+  }
+  content::WebContents* contents = tab->GetContents();
+  if (!contents || HasBlockingTabAlert(tab)) {
+    return false;
+  }
+  const GURL url = GetArchivableUrl(contents);
+  if (IsNewTabOrBlankUrl(url)) {
+    return false;
+  }
+  const base::Time last_active = GetEffectiveLastActiveTime(contents, now);
+  return now - last_active >= max_inactivity;
+}
+
+bool ArchivedTabsService::CanAutoArchiveTab(TabStripModel* tab_strip,
+                                            int index,
+                                            base::Time now,
+                                            base::TimeDelta max_inactivity) {
+  if (!IsSingleTabEligibleForAutoArchive(tab_strip, index, now,
+                                         max_inactivity)) {
+    return false;
+  }
+
+  // If the tab belongs to a split view, only archive it when every pane in the
+  // split is eligible so an active or recently used split isn't half-closed.
+  tabs::TabInterface* tab = tab_strip->GetTabAtIndex(index);
+  if (const std::optional<split_tabs::SplitTabId> split_id = tab->GetSplit();
+      split_id.has_value()) {
+    const split_tabs::SplitTabData* split_data =
+        tab_strip->GetSplitData(*split_id);
+    if (!split_data) {
+      return false;
+    }
+    for (tabs::TabInterface* sibling : split_data->ListTabs()) {
+      const int sibling_index = tab_strip->GetIndexOfTab(sibling);
+      if (sibling_index == TabStripModel::kNoTab ||
+          !IsSingleTabEligibleForAutoArchive(tab_strip, sibling_index, now,
+                                             max_inactivity)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+void ArchivedTabsService::LoadFromPrefs() {
+  archived_tabs_.clear();
+  next_id_ = 1;
+  if (!prefs_) {
+    return;
+  }
+
+  const base::ListValue& list = prefs_->GetList(prefs::kHeliumArchivedTabs);
+  int32_t max_id = 0;
+  for (const base::Value& value : list) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* url_str = dict->FindString(kKeyUrl);
+    if (!url_str) {
+      continue;
+    }
+    GURL url(*url_str);
+    if (!url.is_valid()) {
+      continue;
+    }
+
+    ArchivedTab tab;
+    tab.id = dict->FindInt(kKeyId).value_or(0);
+    if (tab.id <= 0) {
+      tab.id = ++max_id;
+    } else {
+      max_id = std::max(max_id, tab.id);
+    }
+    tab.url = std::move(url);
+    if (const std::string* title = dict->FindString(kKeyTitle)) {
+      tab.title = base::UTF8ToUTF16(*title);
+    }
+    if (tab.title.empty()) {
+      tab.title = base::UTF8ToUTF16(tab.url.spec());
+    }
+    if (const std::optional<double> archived_sec =
+            dict->FindDouble(kKeyArchivedTime)) {
+      tab.archived_time =
+          base::Time::FromSecondsSinceUnixEpoch(*archived_sec);
+    }
+    if (const std::optional<double> last_active_sec =
+            dict->FindDouble(kKeyLastActiveTime)) {
+      tab.last_active_time =
+          base::Time::FromSecondsSinceUnixEpoch(*last_active_sec);
+    }
+    archived_tabs_.push_back(std::move(tab));
+    if (archived_tabs_.size() >= kMaxArchivedTabs) {
+      break;
+    }
+  }
+  next_id_ = max_id + 1;
+}
+
+void ArchivedTabsService::SaveToPrefs() {
+  if (!prefs_) {
+    return;
+  }
+
+  ScopedListPrefUpdate update(prefs_, prefs::kHeliumArchivedTabs);
+  base::ListValue& list = update.Get();
+  list.clear();
+  for (const ArchivedTab& tab : archived_tabs_) {
+    base::DictValue dict;
+    dict.Set(kKeyId, tab.id);
+    dict.Set(kKeyUrl, tab.url.spec());
+    dict.Set(kKeyTitle, base::UTF16ToUTF8(tab.title));
+    dict.Set(kKeyArchivedTime, tab.archived_time.InSecondsFSinceUnixEpoch());
+    dict.Set(kKeyLastActiveTime,
+             tab.last_active_time.InSecondsFSinceUnixEpoch());
+    list.Append(std::move(dict));
+  }
+}
+
+void ArchivedTabsService::NotifyObservers() {
+  for (Observer& observer : observers_) {
+    observer.OnArchivedTabsChanged();
+  }
+}
+
+void ArchivedTabsService::AddArchivedEntry(const GURL& url,
+                                           const std::u16string& title,
+                                           base::Time archived_time,
+                                           base::Time last_active_time) {
+  // Replace any older archived entry for the exact same URL so the archive
+  // stays tidy and reflects the most recent archival timestamp.
+  std::erase_if(archived_tabs_, [&url](const ArchivedTab& existing) {
+    return existing.url == url;
+  });
+
+  ArchivedTab entry;
+  entry.id = next_id_++;
+  entry.url = url;
+  entry.title = title;
+  entry.archived_time = archived_time;
+  entry.last_active_time = last_active_time;
+  archived_tabs_.insert(archived_tabs_.begin(), std::move(entry));
+
+  if (archived_tabs_.size() > kMaxArchivedTabs) {
+    archived_tabs_.resize(kMaxArchivedTabs);
+  }
+}
+
+void ArchivedTabsService::OnAutoArchivePrefChanged() {
+  ScheduleTimers(kPrefChangeCheckDelay);
+}
+
+void ArchivedTabsService::ScheduleTimers(base::TimeDelta initial_delay) {
+  initial_check_timer_.Stop();
+  periodic_check_timer_.Stop();
+
+  if (!prefs_ ||
+      prefs_->GetInteger(prefs::kHeliumAutoArchiveTabsAfterDays) <= 0) {
+    return;
+  }
+
+  initial_check_timer_.Start(
+      FROM_HERE, initial_delay,
+      base::BindOnce(&ArchivedTabsService::RunScheduledCheck,
+                     base::Unretained(this)));
+  periodic_check_timer_.Start(
+      FROM_HERE, kPeriodicCheckInterval,
+      base::BindRepeating(&ArchivedTabsService::RunScheduledCheck,
+                          base::Unretained(this)));
+}
+
+void ArchivedTabsService::RunScheduledCheck() {
+  ArchiveInactiveTabsNow(base::Time::Now());
+}
