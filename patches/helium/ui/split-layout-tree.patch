+    tabs.insert(tabs.begin(), tab);
+    if (closing.active_pane && pane < *closing.active_pane) {
+      ++new_active_pane;
+    }
+  }
+  if (!SetSplitPanes(closing.id, tabs, std::move(closing.tree))) {
+    return;
+  }
+  // Show the pane that took the place of the closed one.
+  if (active_pane_closed) {
+    ActivateTabAt(
+        GetIndexOfTab(tabs[std::min(new_active_pane, tabs.size() - 1)]));
+  }
+}
