+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/split_tabs/split_layout_tree.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <utility>
+
+namespace split_tabs {
+
+namespace {
+
+constexpr int kSnapDistance = 8;
+// Serialized weights are fixed point, so they don't depend on the locale.
+constexpr double kWeightScale = 1000;
+constexpr size_t kMaxDepth = 16;
+
+double SaneWeight(double weight) {
+  return std::isfinite(weight) && weight > 0 ? std::clamp(weight, 1e-6, 1e6)
+                                             : 1;
+}
+
+double TotalWeight(const SplitLayoutNode& node) {
+  double total = 0;
+  for (const auto& child : node.children) {
+    total += child.weight;
+  }
+  return total;
+}
+
+void NormalizeNode(SplitLayoutNode& node) {
+  if (node.is_pane()) {
+    // Panes have no axis; keep one value so equal layouts compare equal.
+    node.axis = SplitAxis::kRow;
+    return;
+  }
+  std::vector<SplitLayoutNode> children;
+  for (auto& child : node.children) {
+    NormalizeNode(child);
+    const double weight = SaneWeight(child.weight);
+    if (!child.is_pane() && child.axis == node.axis) {
+      const double total = TotalWeight(child);
+      for (auto& grandchild : child.children) {
+        grandchild.weight = weight * grandchild.weight / total;
+        children.push_back(std::move(grandchild));
+      }
+    } else {
+      child.weight = weight;
+      children.push_back(std::move(child));
+    }
+  }
+  node.children = std::move(children);
+  if (node.children.size() == 1) {
+    SplitLayoutNode only = std::move(node.children.front());
+    only.weight = node.weight;
+    node = std::move(only);
+    return;
+  }
+  const double scale = node.children.size() / TotalWeight(node);
+  for (auto& child : node.children) {
+    child.weight *= scale;
+  }
+}
+
+struct PaneLocation {
+  SplitLayoutNode* node = nullptr;
+  // Null when `node` is the root.
+  SplitLayoutNode* parent = nullptr;
+  size_t index = 0;
+};
+
+bool FindPane(SplitLayoutNode& node,
+              size_t& remaining,
+              SplitLayoutNode* parent,
+              size_t index,
+              PaneLocation& location) {
+  if (node.is_pane()) {
+    if (remaining == 0) {
+      location = {&node, parent, index};
+      return true;
+    }
+    --remaining;
+    return false;
+  }
+  for (size_t i = 0; i < node.children.size(); ++i) {
+    if (FindPane(node.children[i], remaining, &node, i, location)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Finds the node with depth-first index `remaining`, for both const and
+// mutable trees.
+template <typename Node>
+Node* FindNode(Node& node, size_t& remaining) {
+  if (remaining == 0) {
+    return &node;
+  }
+  --remaining;
+  for (auto& child : node.children) {
+    if (Node* found = FindNode(child, remaining)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+void TransposeNode(SplitLayoutNode& node) {
+  if (node.is_pane()) {
+    return;
+  }
+  node.axis =
+      node.axis == SplitAxis::kRow ? SplitAxis::kColumn : SplitAxis::kRow;
+  for (auto& child : node.children) {
+    TransposeNode(child);
+  }
+}
+
+bool SameShape(const SplitLayoutNode& a, const SplitLayoutNode& b) {
+  if (a.children.size() != b.children.size()) {
+    return false;
+  }
+  if (a.is_pane()) {
+    return true;
+  }
+  if (a.axis != b.axis) {
+    return false;
+  }
+  for (size_t i = 0; i < a.children.size(); ++i) {
+    if (!SameShape(a.children[i], b.children[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void LayoutNode(const SplitLayoutNode& node,
+                SplitRect rect,
+                int divider_size,
+                size_t& next_node,
+                SplitLayoutBounds& bounds) {
+  const size_t id = next_node++;
+  if (node.is_pane()) {
+    bounds.panes.push_back(rect);
+    return;
+  }
+  const bool row = node.axis == SplitAxis::kRow;
+  const int extent = std::max(0, row ? rect.width : rect.height);
+  const int count = static_cast<int>(node.children.size());
+  const int gap = std::clamp(divider_size, 0, extent / (count - 1));
+  const int content = extent - gap * (count - 1);
+  const double total = TotalWeight(node);
+
+  std::vector<SplitRect> rects;
+  double cumulative = 0;
+  int previous_limit = 0;
+  for (int i = 0; i < count; ++i) {
+    cumulative += node.children[i].weight;
+    const int begin = previous_limit;
+    const int limit = i + 1 == count
+                          ? content
+                          : static_cast<int>(content * cumulative / total);
+    previous_limit = limit;
+    SplitRect child = rect;
+    if (row) {
+      child.x += begin + gap * i;
+      child.width = limit - begin;
+    } else {
+      child.y += begin + gap * i;
+      child.height = limit - begin;
+    }
+    rects.push_back(child);
+  }
+
+  for (int i = 0; i + 1 < count; ++i) {
+    const SplitRect& a = rects[i];
+    const SplitRect& b = rects[i + 1];
+    SplitDivider divider{.node = id,
+                         .index = static_cast<size_t>(i),
+                         .axis = node.axis};
+    if (row) {
+      divider.bounds = {a.x + a.width, rect.y, b.x - a.x - a.width,
+                        rect.height};
+      divider.first_size = a.width;
+      divider.second_size = b.width;
+    } else {
+      divider.bounds = {rect.x, a.y + a.height, rect.width,
+                        b.y - a.y - a.height};
+      divider.first_size = a.height;
+      divider.second_size = b.height;
+    }
+    bounds.dividers.push_back(divider);
+  }
+
+  for (int i = 0; i < count; ++i) {
+    LayoutNode(node.children[i], rects[i], divider_size, next_node, bounds);
+  }
+}
+
+void SerializeNode(const SplitLayoutNode& node, std::string& out) {
+  if (node.is_pane()) {
+    out += 'P';
+    return;
+  }
+  out += node.axis == SplitAxis::kRow ? 'R' : 'C';
+  out += '(';
+  for (size_t i = 0; i < node.children.size(); ++i) {
+    if (i) {
+      out += ',';
+    }
+    const long weight =
+        std::max(1L, std::lround(node.children[i].weight * kWeightScale));
+    out += std::to_string(weight);
+    out += ':';
+    SerializeNode(node.children[i], out);
+  }
+  out += ')';
+}
+
+class Parser {
+ public:
+  Parser(std::string_view text, size_t max_panes)
+      : text_(text), max_panes_(max_panes) {}
+
+  std::optional<SplitLayoutNode> Parse() {
+    SplitLayoutNode root;
+    if (!ParseNode(root, 0) || position_ != text_.size()) {
+      return std::nullopt;
+    }
+    return root;
+  }
+
+ private:
+  bool Consume(char c) {
+    if (position_ < text_.size() && text_[position_] == c) {
+      ++position_;
+      return true;
+    }
+    return false;
+  }
+
+  bool ParseWeight(double& weight) {
+    long value = 0;
+    size_t digits = 0;
+    while (position_ < text_.size() && text_[position_] >= '0' &&
+           text_[position_] <= '9' && digits < 9) {
+      value = value * 10 + (text_[position_] - '0');
+      ++position_;
+      ++digits;
+    }
+    if (!digits || !value) {
+      return false;
+    }
+    weight = value / kWeightScale;
+    return true;
+  }
+
+  bool ParseNode(SplitLayoutNode& node, size_t depth) {
+    if (depth > kMaxDepth) {
+      return false;
+    }
+    if (Consume('P')) {
+      return ++panes_ <= max_panes_;
+    }
+    if (Consume('R')) {
+      node.axis = SplitAxis::kRow;
+    } else if (Consume('C')) {
+      node.axis = SplitAxis::kColumn;
+    } else {
+      return false;
+    }
+    if (!Consume('(')) {
+      return false;
+    }
+    do {
+      SplitLayoutNode child;
+      if (!ParseWeight(child.weight) || !Consume(':') ||
+          !ParseNode(child, depth + 1)) {
+        return false;
+      }
+      node.children.push_back(std::move(child));
+    } while (Consume(','));
+    return node.children.size() >= 2 && Consume(')');
+  }
+
+  std::string_view text_;
+  size_t max_panes_;
+  size_t position_ = 0;
+  size_t panes_ = 0;
+};
+
+}  // namespace
+
+size_t CountPanes(const SplitLayoutNode& node) {
+  if (node.is_pane()) {
+    return 1;
+  }
+  size_t count = 0;
+  for (const auto& child : node.children) {
+    count += CountPanes(child);
+  }
+  return count;
+}
+
+SplitLayoutTree::SplitLayoutTree() : SplitLayoutTree(Linear(2, SplitAxis::kRow)) {}
+
+SplitLayoutTree::SplitLayoutTree(SplitLayoutNode root)
+    : root_(std::move(root)) {
+  Normalize();
+}
+
+SplitLayoutTree::SplitLayoutTree(const SplitLayoutTree&) = default;
+SplitLayoutTree::SplitLayoutTree(SplitLayoutTree&&) = default;
+SplitLayoutTree& SplitLayoutTree::operator=(const SplitLayoutTree&) = default;
+SplitLayoutTree& SplitLayoutTree::operator=(SplitLayoutTree&&) = default;
+SplitLayoutTree::~SplitLayoutTree() = default;
+
+// static
+SplitLayoutTree SplitLayoutTree::Linear(size_t pane_count, SplitAxis axis) {
+  SplitLayoutNode root{.axis = axis};
+  if (pane_count > 1) {
+    root.children.resize(pane_count);
+  }
+  return SplitLayoutTree(std::move(root));
+}
+
+// static
+std::optional<SplitLayoutTree> SplitLayoutTree::Parse(std::string_view text,
+                                                      size_t max_panes) {
+  std::optional<SplitLayoutNode> root = Parser(text, max_panes).Parse();
+  if (!root) {
+    return std::nullopt;
+  }
+  return SplitLayoutTree(std::move(*root));
+}
+
+std::string SplitLayoutTree::Serialize() const {
+  std::string out;
+  SerializeNode(root_, out);
+  return out;
+}
+
+size_t SplitLayoutTree::pane_count() const {
+  return CountPanes(root_);
+}
+
+void SplitLayoutTree::set_axis(SplitAxis axis) {
+  root_.axis = axis;
+  Normalize();
+}
+
+double SplitLayoutTree::first_fraction() const {
+  if (root_.is_pane()) {
+    return 1;
+  }
+  return root_.children.front().weight / TotalWeight(root_);
+}
+
+void SplitLayoutTree::set_first_fraction(double fraction) {
+  if (root_.is_pane() || !std::isfinite(fraction)) {
+    return;
+  }
+  fraction = std::clamp(fraction, 0.01, 0.99);
+  const double total = TotalWeight(root_);
+  const double rest = total - root_.children.front().weight;
+  root_.children.front().weight = total * fraction;
+  for (size_t i = 1; i < root_.children.size(); ++i) {
+    root_.children[i].weight *= total * (1 - fraction) / rest;
+  }
+  Normalize();
+}
+
+void SplitLayoutTree::Transpose() {
+  TransposeNode(root_);
+}
+
+bool SplitLayoutTree::HasSameShape(const SplitLayoutTree& other) const {
+  return SameShape(root_, other.root_);
+}
+
+void SplitLayoutTree::SetPaneCount(size_t pane_count) {
+  pane_count = std::max<size_t>(1, pane_count);
+  size_t count = this->pane_count();
+  while (count < pane_count) {
+    if (root_.is_pane()) {
+      root_ = Linear(2, SplitAxis::kRow).root_;
+    } else {
+      root_.children.push_back(SplitLayoutNode());
+    }
+    Normalize();
+    ++count;
+  }
+  while (count > pane_count) {
+    RemovePane(--count);
+  }
+}
+
+size_t SplitLayoutTree::InsertPane(size_t pane, SplitEdge edge) {
+  pane = std::min(pane, pane_count() - 1);
+  const SplitAxis axis = edge == SplitEdge::kLeft || edge == SplitEdge::kRight
+                             ? SplitAxis::kRow
+                             : SplitAxis::kColumn;
+  const bool before = edge == SplitEdge::kLeft || edge == SplitEdge::kTop;
+  size_t remaining = pane;
+  PaneLocation location;
+  FindPane(root_, remaining, nullptr, 0, location);
+
+  if (location.parent && location.parent->axis == axis) {
+    // Share the pane's space with its new neighbour.
+    location.node->weight /= 2;
+    SplitLayoutNode added{.weight = location.node->weight};
+    location.parent->children.insert(
+        location.parent->children.begin() + location.index + (before ? 0 : 1),
+        std::move(added));
+  } else {
+    SplitLayoutNode container{.axis = axis, .weight = location.node->weight};
+    container.children.resize(2);
+    *location.node = std::move(container);
+  }
+  Normalize();
+  return before ? pane : pane + 1;
+}
+
+SplitEdge SplitLayoutTree::EdgeBesidePane(size_t pane) const {
+  // Copy, since FindPane() needs a mutable tree.
+  SplitLayoutNode root = root_;
+  size_t remaining = std::min(pane, pane_count() - 1);
+  PaneLocation location;
+  FindPane(root, remaining, nullptr, 0, location);
+  return location.parent && location.parent->axis == SplitAxis::kColumn
+             ? SplitEdge::kBottom
+             : SplitEdge::kRight;
+}
+
+void SplitLayoutTree::EqualizeSiblings(size_t pane) {
+  if (pane >= pane_count()) {
+    return;
+  }
+  size_t remaining = pane;
+  PaneLocation location;
+  FindPane(root_, remaining, nullptr, 0, location);
+  if (location.parent) {
+    for (auto& sibling : location.parent->children) {
+      sibling.weight = 1;
+    }
+  }
+}
+
+void SplitLayoutTree::RemovePane(size_t pane) {
+  if (pane >= pane_count() || root_.is_pane()) {
+    return;
+  }
+  size_t remaining = pane;
+  PaneLocation location;
+  FindPane(root_, remaining, nullptr, 0, location);
+  location.parent->children.erase(location.parent->children.begin() +
+                                  location.index);
+  Normalize();
+}
+
+SplitLayoutBounds SplitLayoutTree::Calculate(SplitRect bounds,
+                                             int divider_size) const {
+  SplitLayoutBounds result;
+  size_t next_node = 0;
+  LayoutNode(root_, bounds, divider_size, next_node, result);
+  return result;
+}
+
+double SplitLayoutTree::DividerFraction(size_t node, size_t index) const {
+  size_t remaining = node;
+  const SplitLayoutNode* container = FindNode(root_, remaining);
+  if (!container || index + 1 >= container->children.size()) {
+    return 0.5;
+  }
+  const double first = container->children[index].weight;
+  return first / (first + container->children[index + 1].weight);
+}
+
+void SplitLayoutTree::ResizeDivider(size_t node,
+                                    size_t index,
+                                    int first_size,
+                                    int total_size,
+                                    int minimum_size) {
+  size_t remaining = node;
+  SplitLayoutNode* container = FindNode(root_, remaining);
+  if (!container || index + 1 >= container->children.size() ||
+      total_size <= 0) {
+    return;
+  }
+  const int minimum = std::clamp(minimum_size, 0, total_size / 2);
+  int start = std::clamp(first_size, minimum, total_size - minimum);
+  if (std::abs(start - total_size / 2) <= kSnapDistance) {
+    start = total_size / 2;
+  }
+  // Keep positive weights even when the window has almost no room left.
+  const double ratio =
+      std::clamp(static_cast<double>(start) / total_size, 0.01, 0.99);
+  SplitLayoutNode& first = container->children[index];
+  SplitLayoutNode& second = container->children[index + 1];
+  const double pair = first.weight + second.weight;
+  first.weight = pair * ratio;
+  second.weight = pair * (1 - ratio);
+}
+
+void SplitLayoutTree::Normalize() {
+  NormalizeNode(root_);
+  root_.weight = 1;
+}
+
