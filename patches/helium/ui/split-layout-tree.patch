+bool TabStripModel::SetSplitPanes(split_tabs::SplitTabId split_id,
+                                  const std::vector<tabs::TabInterface*>& tabs,
+                                  split_tabs::SplitLayoutTree tree) {
+  if (tabs.size() < 2 || tabs.size() > split_tabs::kMaxSplitPanes ||
+      tree.pane_count() != tabs.size()) {
+    return false;
+  }
+  for (tabs::TabInterface* tab : tabs) {
+    if (GetIndexOfTab(tab) == kNoTab ||
+        (tab->IsSplit() && tab->GetSplit() != split_id) ||
+        std::ranges::count(tabs, tab) != 1) {
+      return false;
+    }
+  }
+
+  if (ContainsSplit(split_id)) {
+    RemoveSplit(split_id);
+  }
+  {
+    ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+    std::vector<int> indices;
+    for (tabs::TabInterface* tab : tabs) {
+      indices.push_back(GetIndexOfTab(tab));
+    }
+    const int pivot_index = indices.front();
+    std::ranges::sort(indices);
+    AddToSplitImpl(split_id, indices, pivot_index,
+                   split_tabs::SplitTabVisualData(std::move(tree)),
+                   SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+  }
+  // The split keeps the tab strip order; move each tab to its pane.
+  const int first_index = GetIndexRangeOfSplit(split_id).start();
+  for (size_t pane = 0; pane < tabs.size(); ++pane) {
+    const int index = GetIndexOfTab(tabs[pane]);
+    const int target = first_index + static_cast<int>(pane);
+    if (index != target) {
+      MoveWebContentsAt(index, target, /*select_after_move=*/false);
+    }
+  }
+  return true;
+}
+
+bool TabStripModel::InsertTabIntoSplit(split_tabs::SplitTabId split_id,
+                                       int index,
+                                       size_t pane,
+                                       split_tabs::SplitEdge edge) {
+  if (!ContainsSplit(split_id) || !ContainsIndex(index) ||
+      GetTabAtIndex(index)->IsSplit()) {
+    return false;
+  }
+  const split_tabs::SplitTabData* data = GetSplitData(split_id);
+  std::vector<tabs::TabInterface*> tabs = data->ListTabs();
+  if (tabs.size() >= split_tabs::kMaxSplitPanes) {
+    return false;
+  }
+  split_tabs::SplitLayoutTree tree = data->visual_data()->GetTree(tabs.size());
+  // A pane added to a row or column gets an equal share of it, like the other
+  // panes there; one placed across it splits the pane it's placed on.
+  const bool extends_container = edge == tree.EdgeBesidePane(pane);
+  const size_t position = tree.InsertPane(pane, edge);
+  if (extends_container) {
+    tree.EqualizeSiblings(position);
+  }
+  tabs.insert(tabs.begin() + position, GetTabAtIndex(index));
+  return SetSplitPanes(split_id, tabs, std::move(tree));
+}
