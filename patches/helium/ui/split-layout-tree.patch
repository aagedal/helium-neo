+void TabStripModel::RebuildClosingSplit(ClosingSplit& closing) {
+  // Nothing was closed, for example while an unload handler runs.
+  if (ContainsSplit(closing.id)) {
+    return;
+  }
+  std::vector<tabs::TabInterface*> tabs;
+  bool active_pane_closed = false;
+  size_t new_active_pane = 0;
+  for (size_t pane = closing.panes.size(); pane-- > 0;) {
+    tabs::TabInterface* tab = closing.panes[pane].Get();
+    if (!tab || GetIndexOfTab(tab) == kNoTab || tab->IsSplit()) {
+      closing.tree.RemovePane(pane);
+      active_pane_closed |= closing.active_pane == pane;
+      continue;
