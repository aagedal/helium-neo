+#ifndef COMPONENTS_SPLIT_TABS_SPLIT_LAYOUT_TREE_H_
+#define COMPONENTS_SPLIT_TABS_SPLIT_LAYOUT_TREE_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// The arrangement of the panes of a split, as a tree like the containers of a
+// tiling window manager. This has no dependencies outside the standard library,
+// so it can be tested without a browser build.
+
+namespace split_tabs {
+
+// Direction in which a container places its children.
+enum class SplitAxis {
+  // Children side by side, from left to right.
+  kRow,
+  // Children stacked, from top to bottom.
+  kColumn,
+};
+
+// Side of a pane that another pane is placed on.
+enum class SplitEdge { kLeft, kRight, kTop, kBottom };
+
+struct SplitRect {
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+
+  friend bool operator==(const SplitRect&, const SplitRect&) = default;
+};
+
+// A node without children is a pane. Panes map to the tabs of the split in
+// reading (depth-first) order.
+struct SplitLayoutNode {
+  SplitAxis axis = SplitAxis::kRow;
+  // Size relative to the node's siblings.
+  double weight = 1;
+  std::vector<SplitLayoutNode> children;
+
+  bool is_pane() const { return children.empty(); }
+
+  friend bool operator==(const SplitLayoutNode&,
+                         const SplitLayoutNode&) = default;
+};
+
+// The gap between two neighbouring children of a container, where the user
+// drags to resize them.
+struct SplitDivider {
+  // Depth-first index of the container among all nodes.
+  size_t node = 0;
+  // The divider sits between children `index` and `index + 1`.
+  size_t index = 0;
+  // A row's dividers are vertical lines that move horizontally.
+  SplitAxis axis = SplitAxis::kRow;
+  SplitRect bounds;
+  // Sizes of the two children along `axis`, for resizing.
+  int first_size = 0;
+  int second_size = 0;
+};
+
+// Number of panes in and below `node`.
+size_t CountPanes(const SplitLayoutNode& node);
+
+struct SplitLayoutBounds {
+  std::vector<SplitRect> panes;
+  std::vector<SplitDivider> dividers;
+};
+
+class SplitLayoutTree {
+ public:
+  // Smallest size ResizeDivider() leaves a child by default.
+  static constexpr int kDefaultMinimumSize = 80;
+
+  // Two panes side by side.
+  SplitLayoutTree();
+  // Normalizes `root`; see Normalize().
+  explicit SplitLayoutTree(SplitLayoutNode root);
+  SplitLayoutTree(const SplitLayoutTree&);
+  SplitLayoutTree(SplitLayoutTree&&);
+  SplitLayoutTree& operator=(const SplitLayoutTree&);
+  SplitLayoutTree& operator=(SplitLayoutTree&&);
+  ~SplitLayoutTree();
+
+  // `pane_count` equal panes along `axis`.
+  static SplitLayoutTree Linear(size_t pane_count, SplitAxis axis);
+
+  // Reads Serialize() output. Returns nullopt for malformed input or more
+  // than `max_panes` panes.
+  static std::optional<SplitLayoutTree> Parse(std::string_view text,
+                                              size_t max_panes);
+
+  // A compact, locale independent encoding such as "R(1:P,1:C(1:P,1:P))".
+  std::string Serialize() const;
+
+  const SplitLayoutNode& root() const { return root_; }
+  size_t pane_count() const;
+
+  // The axis of the outermost container.
+  SplitAxis axis() const { return root_.axis; }
+  void set_axis(SplitAxis axis);
+  // Share of the first child of the outermost container.
+  double first_fraction() const;
+  void set_first_fraction(double fraction);
+
+  // Swaps rows and columns everywhere.
+  void Transpose();
+
+  // Whether both trees nest the same containers, ignoring sizes.
+  bool HasSameShape(const SplitLayoutTree& other) const;
+
+  // Adds panes after the last one, or removes panes from the end, until there
+  // are `pane_count`.
+  void SetPaneCount(size_t pane_count);
+
+  // Splits pane `pane` to place a new pane on its `edge`, and returns the new
+  // pane's index. The panes after it shift by one.
+  size_t InsertPane(size_t pane, SplitEdge edge);
+
+  // The edge of pane `pane` on which InsertPane() adds a sibling in the pane's
+  // container, rather than nesting a new container.
+  SplitEdge EdgeBesidePane(size_t pane) const;
+
+  // Gives pane `pane` and its siblings equal sizes.
+  void EqualizeSiblings(size_t pane);
+
+  // Removes pane `pane`, giving its space to its siblings.
+  void RemovePane(size_t pane);
+
+  // Splits the area into panes and the dividers between them. `divider_size`
+  // is the gap left between neighbouring children.
+  SplitLayoutBounds Calculate(SplitRect bounds, int divider_size) const;
+
+  // Share of child `index` of container `node` in the space it shares with
+  // the next child.
+  double DividerFraction(size_t node, size_t index) const;
+
+  // Moves divider `index` of container `node` so the first of its two children
+  // gets `first_size` of the `total_size` they share. Snaps to the middle and
+  // keeps both children at least `minimum_size`, or half of `total_size` if
+  // that is less.
+  void ResizeDivider(size_t node,
+                     size_t index,
+                     int first_size,
+                     int total_size,
+                     int minimum_size = kDefaultMinimumSize);
+
+  friend bool operator==(const SplitLayoutTree&,
+                         const SplitLayoutTree&) = default;
+
+ private:
+  // Removes containers with a single child, merges containers into parents
+  // with the same axis and rescales weights so siblings average 1.
+  void Normalize();
+
+  SplitLayoutNode root_;
+};
+
+}  // namespace split_tabs
+
+#endif  // COMPONENTS_SPLIT_TABS_SPLIT_LAYOUT_TREE_H_
