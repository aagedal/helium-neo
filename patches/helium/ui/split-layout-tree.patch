+SplitLayoutTree SplitLayoutTreeFromArrangement(
+    size_t count,
+    SplitTabLayout layout,
+    SplitTabArrangement arrangement,
+    double ratio,
+    const std::array<double, kMaxSplitPanes>& weights) {
+  count = std::min(count, kMaxSplitPanes);
+  if (count < 2) {
+    return SplitLayoutTree::Linear(count, SplitAxisForLayout(layout));
+  }
+  if (!std::isfinite(ratio)) {
+    ratio = 0.5;
+  }
+  ratio = std::clamp(ratio, 0.01, 0.99);
+  const size_t first_count = FirstSplitPaneCount(count, arrangement);
+  const auto group = [&](size_t first, size_t size, bool leading,
+                         double weight) {
+    SplitLayoutNode node{.weight = weight};
+    if (size == 1) {
+      return node;
+    }
+    node.axis = SplitPaneGroupIsVertical(layout, arrangement, leading)
+                    ? SplitAxis::kColumn
+                    : SplitAxis::kRow;
+    for (size_t i = first; i < first + size; ++i) {
+      node.children.push_back(SplitLayoutNode{.weight = weights[i]});
+    }
+    return node;
+  };
+  SplitLayoutNode root{.axis = SplitAxisForLayout(layout)};
+  root.children.push_back(group(0, first_count, true, ratio));
+  root.children.push_back(
+      group(first_count, count - first_count, false, 1 - ratio));
+  return SplitLayoutTree(std::move(root));
+}
