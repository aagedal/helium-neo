+// A split layout the user saved to apply to other splits. Only the arrangement
+// and sizes of the panes are kept, not their tabs.
+struct SplitLayoutTemplate {
+  std::u16string name;
+  split_tabs::SplitLayoutTree tree;
+};
+
+inline constexpr size_t kMaxSplitLayoutTemplates = 12;
+
+// The saved layouts, in the order they were saved.
+std::vector<SplitLayoutTemplate> GetSplitLayoutTemplates(
+    const PrefService& prefs);
+
+// Saves `tree` as `name`, replacing a layout saved under the same name.
+void SaveSplitLayoutTemplate(PrefService& prefs,
+                             std::u16string_view name,
+                             const split_tabs::SplitLayoutTree& tree);
+void RemoveSplitLayoutTemplate(PrefService& prefs, std::u16string_view name);
+
+// Asks for a name and saves `tree` under it.
+void ShowSaveSplitLayoutDialog(BrowserWindowInterface* browser,
+                               split_tabs::SplitLayoutTree tree);
+
+// A menu icon sketching the panes of `tree`.
+ui::ImageModel SplitLayoutIcon(const split_tabs::SplitLayoutTree& tree);
+
+#endif  // CHROME_BROWSER_UI_TABS_SPLIT_LAYOUT_TEMPLATES_H_
