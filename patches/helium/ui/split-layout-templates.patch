+namespace {
+
+constexpr char kNameKey[] = "name";
+constexpr char kLayoutKey[] = "layout";
+constexpr int kIconSize = 16;
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kSplitLayoutNameFieldId);
+
+class SplitLayoutIconSource : public gfx::CanvasImageSource {
+ public:
+  SplitLayoutIconSource(split_tabs::SplitLayoutTree tree, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(kIconSize, kIconSize)),
+        tree_(std::move(tree)),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    // Lay the panes out at four times the size, so that narrow ones keep their
+    // proportions, and draw them scaled down.
+    constexpr int kScale = 4;
+    const gfx::RectF frame(1, 2, 14, 12);
+    const split_tabs::SplitLayoutBounds bounds = tree_.Calculate(
+        {.width = static_cast<int>(frame.width()) * kScale,
+         .height = static_cast<int>(frame.height()) * kScale},
+        kScale);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    for (const split_tabs::SplitRect& pane : bounds.panes) {
+      gfx::RectF rect(pane.x, pane.y, pane.width, pane.height);
+      rect.Scale(1.0f / kScale);
+      rect.Offset(frame.OffsetFromOrigin());
+      canvas->DrawRoundRect(rect, 1, flags);
+    }
+  }
+
+ private:
+  const split_tabs::SplitLayoutTree tree_;
+  const SkColor color_;
+};
+
+std::u16string DefaultTemplateName(const PrefService& prefs) {
+  std::vector<std::u16string> names;
+  for (const SplitLayoutTemplate& saved : GetSplitLayoutTemplates(prefs)) {
+    names.push_back(saved.name);
+  }
+  for (int number = names.size() + 1;; ++number) {
+    std::u16string name = l10n_util::GetStringFUTF16(
+        IDS_HELIUM_SPLIT_LAYOUT_DEFAULT_NAME, base::NumberToString16(number));
+    if (!std::ranges::contains(names, name)) {
+      return name;
+    }
+  }
+}
+
+void SaveFromDialog(base::WeakPtr<Profile> profile,
+                    ui::DialogModel* dialog_model,
+                    const split_tabs::SplitLayoutTree& tree,
+                    const std::u16string& default_name) {
+  if (!profile) {
+    return;
+  }
+  std::u16string name;
+  base::TrimWhitespace(
+      dialog_model->GetTextfieldByUniqueId(kSplitLayoutNameFieldId)->text(),
+      base::TRIM_ALL, &name);
+  SaveSplitLayoutTemplate(*profile->GetPrefs(),
+                          name.empty() ? default_name : name, tree);
+}
+
+}  // namespace
+
+std::vector<SplitLayoutTemplate> GetSplitLayoutTemplates(
+    const PrefService& prefs) {
+  std::vector<SplitLayoutTemplate> templates;
+  for (const base::Value& entry :
+       prefs.GetList(prefs::kHeliumSplitLayoutTemplates)) {
+    const base::DictValue* dict = entry.GetIfDict();
+    const std::string* name = dict ? dict->FindString(kNameKey) : nullptr;
+    const std::string* layout = dict ? dict->FindString(kLayoutKey) : nullptr;
+    if (!name || !layout) {
+      continue;
+    }
+    std::optional<split_tabs::SplitLayoutTree> tree =
+        split_tabs::SplitLayoutTree::Parse(*layout, split_tabs::kMaxSplitPanes);
+    if (!tree || tree->pane_count() < 2) {
+      continue;
+    }
+    templates.push_back({base::UTF8ToUTF16(*name), std::move(*tree)});
+  }
+  return templates;
+}
+
+void SaveSplitLayoutTemplate(PrefService& prefs,
+                             std::u16string_view name,
+                             const split_tabs::SplitLayoutTree& tree) {
+  const std::string utf8_name = base::UTF16ToUTF8(name);
+  ScopedListPrefUpdate update(prefs, prefs::kHeliumSplitLayoutTemplates);
+  for (base::Value& entry : *update) {
+    base::DictValue* dict = entry.GetIfDict();
+    const std::string* saved_name =
+        dict ? dict->FindString(kNameKey) : nullptr;
+    if (saved_name && *saved_name == utf8_name) {
+      dict->Set(kLayoutKey, tree.Serialize());
+      return;
+    }
+  }
+  if (update->size() >= kMaxSplitLayoutTemplates) {
+    return;
+  }
+  update->Append(base::DictValue()
+                     .Set(kNameKey, utf8_name)
+                     .Set(kLayoutKey, tree.Serialize()));
+}
+
+void RemoveSplitLayoutTemplate(PrefService& prefs, std::u16string_view name) {
+  const std::string utf8_name = base::UTF16ToUTF8(name);
+  ScopedListPrefUpdate update(prefs, prefs::kHeliumSplitLayoutTemplates);
+  update->EraseIf([&](const base::Value& entry) {
+    const base::DictValue* dict = entry.GetIfDict();
+    const std::string* saved_name =
+        dict ? dict->FindString(kNameKey) : nullptr;
+    return saved_name && *saved_name == utf8_name;
+  });
+}
+
+void ShowSaveSplitLayoutDialog(BrowserWindowInterface* browser,
+                               split_tabs::SplitLayoutTree tree) {
+  Profile* profile = browser->GetProfile();
+  const std::u16string default_name =
+      DefaultTemplateName(*profile->GetPrefs());
+  ui::DialogModel::Builder builder;
+  builder.SetInternalName("SaveSplitLayoutDialog")
+      .SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_SAVE_SPLIT_LAYOUT_TITLE))
+      .AddOkButton(
+          base::BindOnce(&SaveFromDialog, profile->GetWeakPtr(),
+                         builder.model(), std::move(tree), default_name),
+          ui::DialogModel::Button::Params().SetLabel(
+              l10n_util::GetStringUTF16(IDS_HELIUM_SAVE_SPLIT_LAYOUT_BUTTON)))
+      .AddCancelButton(base::DoNothing())
+      .AddTextfield(kSplitLayoutNameFieldId, {}, default_name,
+                    ui::DialogModelTextfield::Params().SetAccessibleName(
+                        l10n_util::GetStringUTF16(
+                            IDS_HELIUM_SAVE_SPLIT_LAYOUT_NAME)))
+      .SetInitiallyFocusedField(kSplitLayoutNameFieldId);
+  chrome::ShowBrowserModal(browser, builder.Build());
+}
+
+ui::ImageModel SplitLayoutIcon(const split_tabs::SplitLayoutTree& tree) {
+  return ui::ImageModel::FromImageGenerator(
+      base::BindRepeating(
+          [](const split_tabs::SplitLayoutTree& tree,
+             const ui::ColorProvider* color_provider) {
+            // Without a color provider the icon is drawn black, for menus that
+            // tint it themselves.
+            const SkColor color =
+                color_provider ? color_provider->GetColor(ui::kColorMenuIcon)
+                               : SK_ColorBLACK;
+            return gfx::ImageSkia(
+                std::make_unique<SplitLayoutIconSource>(tree, color),
+                gfx::Size(kIconSize, kIconSize));
+          },
+          tree),
+      gfx::Size(kIconSize, kIconSize));
+}
