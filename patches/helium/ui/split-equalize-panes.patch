+// Number of panes `node` places side by side along `axis`.
+size_t CountTracks(const SplitLayoutNode& node, SplitAxis axis) {
+  size_t tracks = node.is_pane() ? 1 : 0;
+  for (const auto& child : node.children) {
+    const size_t child_tracks = CountTracks(child, axis);
+    tracks = node.axis == axis ? tracks + child_tracks
+                               : std::max(tracks, child_tracks);
+  }
+  return tracks;
+}
+
+void EqualizeTracks(SplitLayoutNode& node) {
+  for (auto& child : node.children) {
+    child.weight = CountTracks(child, node.axis);
+    EqualizeTracks(child);
+  }
+}
