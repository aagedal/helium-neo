+void MultiContentsView::EqualizeDivider(size_t divider, bool whole_container) {
+  if (!IsInSplitView()) {
+    return;
+  }
+  const std::vector<split_tabs::SplitDivider> dividers =
+      layout_tree_.Calculate({}, 0).dividers;
+  if (divider >= dividers.size()) {
+    return;
+  }
+  split_tabs::SplitLayoutTree tree = layout_tree_;
+  if (whole_container) {
+    tree.EqualizeContainer(dividers[divider].node);
+  } else {
+    tree.EqualizeDivider(dividers[divider].node, dividers[divider].index);
+  }
+  delegate_->ResizeSplitLayout(tree, /*done_resizing=*/true);
+}
