+void SplitLayoutTree::EqualizeDivider(size_t node, size_t index) {
+  size_t remaining = node;
+  SplitLayoutNode* container = FindNode(root_, remaining);
+  if (!container || index + 1 >= container->children.size()) {
+    return;
+  }
+  SplitLayoutNode& first = container->children[index];
+  SplitLayoutNode& second = container->children[index + 1];
+  first.weight = second.weight = (first.weight + second.weight) / 2;
+}
+
+void SplitLayoutTree::EqualizeContainer(size_t node) {
+  size_t remaining = node;
+  SplitLayoutNode* container = FindNode(root_, remaining);
+  if (!container) {
+    return;
+  }
+  for (auto& child : container->children) {
+    child.weight = 1;
+  }
+}
+
+void SplitLayoutTree::EqualizeAll() {
+  EqualizeTracks(root_);
+  Normalize();
+}
