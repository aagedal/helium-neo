+#if BUILDFLAG(ENABLE_PRINTING)
+void PdfBlobReady(const ArchiveTarget& target,
+                  scoped_refptr<base::RefCountedMemory> bytes,
+                  std::unique_ptr<content::BlobHandle> blob) {
+  if (!target.web_contents || !blob) {
+    return;
+  }
+  const GURL url("blob:" + url::Origin::Create(target.url).Serialize() + "/" +
+                 blob->GetUUID());
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+  storage::BlobURLLoaderFactory::Create(
+      blob->PassBlob(), url, remote.InitWithNewPipeAndPassReceiver());
+  DownloadToPath(target.web_contents.get(), url, target.path, target.url,
+                 base::MakeRefCounted<network::WrapperSharedURLLoaderFactory>(
+                     std::move(remote)));
+}
+
+void PdfPrinted(const ArchiveTarget& target,
+                bool restore_layout,
+                print_to_pdf::PdfPrintResult result,
+                scoped_refptr<base::RefCountedMemory> bytes) {
+  content::WebContents* web_contents = target.web_contents.get();
+  if (web_contents && restore_layout) {
+    web_contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+        kRefixScript, base::NullCallback(), ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+  if (!web_contents || result != print_to_pdf::PdfPrintResult::kPrintSuccess ||
+      !bytes) {
+    LOG(WARNING) << "Could not print page to PDF for the archive";
+    return;
+  }
+  if (std::optional<std::string> updated = AddArchiveProperties(
+          base::as_string_view(base::span(*bytes)), target)) {
+    bytes = base::MakeRefCounted<base::RefCountedString>(std::move(*updated));
+  } else {
+    LOG(WARNING) << "Could not add document properties to the archive";
+  }
+  // The blob is created from a span over `bytes`; keep them alive until it
+  // exists.
+  const auto data = base::span(*bytes);
+  web_contents->GetBrowserContext()->CreateMemoryBackedBlob(
+      data, "application/pdf",
+      base::BindOnce(&PdfBlobReady, target, std::move(bytes)));
+}
