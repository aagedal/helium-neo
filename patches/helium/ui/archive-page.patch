+// Query parameters that commonly carry sign-in tokens, keys or one-time codes.
+bool IsCredentialParameter(std::string_view name) {
+  const std::string lower = base::ToLowerASCII(name);
+  for (const char* part : {"token", "secret", "password", "passwd", "session",
+                           "signature", "credential", "apikey", "api_key",
+                           "auth", "otp", "jwt", "nonce"}) {
+    if (lower.find(part) != std::string::npos) {
+      return true;
+    }
+  }
+  for (const char* exact : {"code", "state", "key", "sig", "sid", "ticket",
+                            "pwd", "pass", "x-amz-credential",
+                            "x-goog-credential"}) {
+    if (lower == exact) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The address recorded in an archive: in its printed footer, its document
+// properties and, on macOS, its "Where from". The fragment, which can hold
+// OAuth tokens, and query parameters that look like credentials are left out;
+// other parameters, such as a video ID, still identify the page.
+GURL ArchiveAddress(const GURL& url) {
+  if (!url.is_valid()) {
+    return url;
+  }
+  GURL::Replacements replacements;
+  replacements.ClearUsername();
+  replacements.ClearPassword();
+  replacements.ClearRef();
+  std::string query;
+  if (url.has_query()) {
+    for (std::string_view parameter : base::SplitStringPiece(
+             url.query(), "&", base::KEEP_WHITESPACE,
+             base::SPLIT_WANT_NONEMPTY)) {
+      const std::string_view name =
+          parameter.substr(0, parameter.find('='));
+      if (!IsCredentialParameter(name)) {
+        query += (query.empty() ? "" : "&") + std::string(parameter);
+      }
+    }
+    if (query.empty()) {
+      replacements.ClearQuery();
+    } else {
+      replacements.SetQueryStr(query);
+    }
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+// A PDF text string: UTF-16BE with a byte order mark, hex encoded so that no
+// character needs escaping.
+std::string PdfText(std::u16string_view text) {
+  std::string out = "<FEFF";
+  for (char16_t c : text) {
+    base::StringAppendF(&out, "%04X", static_cast<unsigned>(c));
+  }
+  return out + ">";
+}
+
+// Parses the unsigned number at the start of `text`, after any whitespace.
+std::optional<size_t> PdfNumber(std::string_view text) {
+  const size_t start = text.find_first_not_of(" \t\r\n");
+  if (start == std::string_view::npos) {
+    return std::nullopt;
+  }
+  size_t value = 0;
+  size_t i = start;
+  for (; i < text.size() && base::IsAsciiDigit(text[i]); ++i) {
+    value = value * 10 + (text[i] - '0');
+  }
+  return i == start ? std::nullopt : std::optional<size_t>(value);
+}
+
+// Sets the PDF's document properties, as shown by Preview's inspector and
+// indexed by Spotlight: the page title, its address as the subject, its site
+// as a keyword, and the archive time. Appends an incremental update, so the
+// printed pages are untouched. Returns nullopt, keeping the original, if the
+// file does not end in a classic cross-reference table as Chromium's PDFs do.
+std::optional<std::string> AddArchiveProperties(std::string_view pdf,
+                                                const ArchiveTarget& target) {
+  const size_t startxref = pdf.rfind("startxref");
+  const size_t trailer = pdf.rfind("trailer", startxref);
+  if (startxref == std::string_view::npos ||
+      trailer == std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::optional<size_t> previous =
+      PdfNumber(pdf.substr(startxref + strlen("startxref")));
+  const std::string_view trailer_dict =
+      pdf.substr(trailer, startxref - trailer);
+  const size_t size_key = trailer_dict.find("/Size");
+  const size_t root_key = trailer_dict.find("/Root");
+  if (!previous || size_key == std::string_view::npos ||
+      root_key == std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::optional<size_t> size =
+      PdfNumber(trailer_dict.substr(size_key + strlen("/Size")));
+  const std::string_view root_value =
+      trailer_dict.substr(root_key + strlen("/Root"));
+  const size_t root_end = root_value.find('R');
+  if (!size || *size == 0 || root_end == std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::string root(base::TrimWhitespaceASCII(
+      root_value.substr(0, root_end + 1), base::TRIM_ALL));
+  // An update keeps the file identifier.
+  std::string id;
+  if (const size_t id_key = trailer_dict.find("/ID");
+      id_key != std::string_view::npos) {
+    const size_t open = trailer_dict.find('[', id_key);
+    const size_t close = trailer_dict.find(']', open);
+    if (open != std::string_view::npos && close != std::string_view::npos) {
+      id = " /ID " + std::string(trailer_dict.substr(open, close - open + 1));
+    }
+  }
+
+  const GURL address = ArchiveAddress(target.url);
+  std::u16string title = target.title;
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(address.host());
+  }
+  base::Time::Exploded utc;
+  target.time.UTCExplode(&utc);
+  const std::string date = base::StringPrintf(
+      "(D:%04d%02d%02d%02d%02d%02dZ)", utc.year, utc.month, utc.day_of_month,
+      utc.hour, utc.minute, utc.second);
+
+  std::string out(pdf);
+  if (!out.ends_with('\n')) {
+    out += '\n';
+  }
+  const size_t object = *size;
+  const size_t object_offset = out.size();
+  out += base::StringPrintf("%zu 0 obj\n<<", object) +
+         " /Title " + PdfText(title) +
+         " /Subject " + PdfText(base::UTF8ToUTF16(address.spec())) +
+         " /Keywords " + PdfText(base::UTF8ToUTF16(address.host())) +
+         " /Creator " + PdfText(u"Helium Neo") +
+         " /CreationDate " + date + " /ModDate " + date + " >>\nendobj\n";
+  const size_t xref_offset = out.size();
+  out += base::StringPrintf(
+      "xref\n0 1\n0000000000 65535 f \n%zu 1\n%010zu 00000 n \n"
+      "trailer\n<< /Size %zu /Root %s "
+      "/Info %zu 0 R /Prev %zu%s >>\nstartxref\n%zu\n%%%%EOF\n",
+      object, object_offset, object + 1, root.c_str(), object, *previous,
+      id.c_str(), xref_offset);
+  return out;
+}
