+#if BUILDFLAG(IS_MAC)
+// Runs on a blocking thread. Replaces the file's "Where from" in Finder.
+void SetWhereFrom(const base::FilePath& path, const GURL& address) {
+  base::apple::ScopedCFTypeRef<CFStringRef> value =
+      base::SysUTF8ToCFStringRef(address.spec());
+  const void* values[] = {value.get()};
+  base::apple::ScopedCFTypeRef<CFArrayRef> list(
+      CFArrayCreate(kCFAllocatorDefault, values, 1, &kCFTypeArrayCallBacks));
+  base::apple::ScopedCFTypeRef<CFDataRef> data(CFPropertyListCreateData(
+      kCFAllocatorDefault, list.get(), kCFPropertyListBinaryFormat_v1_0, 0,
+      nullptr));
+  if (!data) {
+    return;
+  }
+  if (setxattr(path.value().c_str(), "com.apple.metadata:kMDItemWhereFroms",
+               CFDataGetBytePtr(data.get()), CFDataGetLength(data.get()), 0,
+               0) != 0) {
+    LOG(WARNING) << "Could not record where the archive came from";
+  }
+}
