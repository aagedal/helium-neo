+// Saves the active tab into the archive folder as a PDF without prompting.
+// Pages, images and text are printed to PDF with their title, address and
+// date; a PDF document is saved as it is. Pages are first scrolled through, up
+// to a limit, so that content loaded on scroll is included, and bars that stay
+// on screen while scrolling print once instead of on every page. Printed PDFs
+// carry the page's title, address and archive time in their document
+// properties, and on macOS the address is the file's "Where from". The address
+// leaves out its fragment and parameters that look like sign-in tokens.
+// Progress and the result show in the downloads bubble.
+void ArchivePage(BrowserWindowInterface* browser);
+
+// Returns a file name like "2026-11-04 21.30.05 Title (example.com)" with
+// `extension` appended. Exposed for tests.
+base::FilePath::StringType ArchiveFileName(std::u16string_view title,
+                                           const GURL& url,
+                                           base::Time time,
+                                           std::string_view extension);
+
+}  // namespace helium
