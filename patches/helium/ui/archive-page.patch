+// Long articles fit in this many screens. Pages that keep growing as they
+// scroll stop here instead of scrolling forever.
+constexpr int kMaxScrollScreens = 30;
+// Time for scroll handlers and intersection observers to start loading.
+constexpr base::TimeDelta kScrollStepDelay = base::Milliseconds(200);
+constexpr base::TimeDelta kImageWaitTimeout = base::Seconds(3);
+constexpr base::TimeDelta kImagePollInterval = base::Milliseconds(100);
+
+// Remembers the scroll position and scrolls to the top. Returns the position.
+constexpr char16_t kStartScrollScript[] = uR"((() => {
+  const position = [scrollX, scrollY];
+  scrollTo({left: 0, top: 0, behavior: 'instant'});
+  return position;
+})())";
+// Scrolls down a screen. Returns true once the end of the page was shown.
+constexpr char16_t kScrollStepScript[] = uR"((() => {
+  const page = document.scrollingElement;
+  if (!page || scrollY + innerHeight >= page.scrollHeight - 1) {
+    return true;
+  }
+  scrollBy({top: innerHeight, behavior: 'instant'});
+  return false;
+})())";
+// Returns the number of images still loading. Images with loading="lazy" are
+// left out: printing loads those itself, and hidden ones never load.
+constexpr char16_t kPendingImagesScript[] =
+    uR"(Array.from(document.images).filter(
+        image => !image.complete && image.loading !== 'lazy').length)";
+
+// Prepares the print layout so bars that stay on screen while scrolling, such
+// as site headers, print once instead of covering content on every page. Only
+// printing changes: elements are marked and a print-only style sheet is
+// adopted. Small fixed bars near the top print once at the top of the first
+// page; lower ones, such as cookie notices, are left out. Sticky elements print
+// in place. Large fixed elements, such as app layouts and dialogs, are kept.
+constexpr char16_t kUnfixScript[] = uR"((() => {
+  const attribute = 'data-helium-archive';
+  for (const element of document.querySelectorAll('body *')) {
+    const position = getComputedStyle(element).position;
+    if (position === 'sticky') {
+      element.setAttribute(attribute, 'static');
+    } else if (position === 'fixed') {
+      const rect = element.getBoundingClientRect();
+      if (rect.width && rect.height && rect.height <= innerHeight * 0.4) {
+        element.setAttribute(attribute,
+                             rect.top < innerHeight / 2 ? 'top' : 'hide');
+      }
+    }
+  }
+  // Constructed style sheets are not blocked by the page's CSP.
+  const sheet = new CSSStyleSheet({media: 'print'});
+  sheet.replaceSync(`[${attribute}=static]{position:static!important}` +
+                    `[${attribute}=top]{position:absolute!important}` +
+                    `[${attribute}=hide]{display:none!important}`);
+  document.adoptedStyleSheets = [...document.adoptedStyleSheets, sheet];
+  globalThis.heliumArchiveSheet = sheet;
+  return true;
+})())";
+// Undoes kUnfixScript once the PDF is printed.
+constexpr char16_t kRefixScript[] = uR"((() => {
+  const sheet = globalThis.heliumArchiveSheet;
+  delete globalThis.heliumArchiveSheet;
+  if (sheet) {
+    document.adoptedStyleSheets =
+        document.adoptedStyleSheets.filter(other => other !== sheet);
+  }
+  for (const element of document.querySelectorAll('[data-helium-archive]')) {
+    element.removeAttribute('data-helium-archive');
+  }
+  return true;
+})())";
+
+// The page being archived. Saving stops if the tab moves to another page, or
+// another history entry, before the archive is made, so that the file never
+// holds a different page than its name and header say.
+struct ArchiveTarget {
+  base::WeakPtr<content::WebContents> web_contents;
+  GURL url;
+  int entry_id = 0;
+  base::FilePath path;
+  std::u16string title;
+  base::Time time;
+
+  content::WebContents* Get() const {
+    if (!web_contents || path.empty()) {
+      return nullptr;
+    }
+    content::NavigationEntry* entry =
+        web_contents->GetController().GetLastCommittedEntry();
+    if (!entry || entry->GetUniqueID() != entry_id ||
+        web_contents->GetLastCommittedURL() != url) {
+      LOG(WARNING) << "The page changed before it could be archived";
+      return nullptr;
+    }
+    return web_contents.get();
+  }
+};
