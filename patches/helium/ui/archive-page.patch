+// The download records its own address as "Where from": an internal blob:
+// address for a printed PDF, or the full address of a PDF document. Once it
+// is complete, record the archived page's address instead.
+class WhereFromUpdater : public download::DownloadItem::Observer {
+ public:
+  static void Watch(const GURL& address,
+                    download::DownloadItem* item,
+                    download::DownloadInterruptReason reason) {
+    if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+      return;
+    }
+    if (item->GetState() == download::DownloadItem::COMPLETE) {
+      Update(item, address);
+      return;
+    }
+    // Deletes itself when the download finishes or goes away.
+    new WhereFromUpdater(item, address);
+  }
+
+ private:
+  WhereFromUpdater(download::DownloadItem* item, const GURL& address)
+      : item_(item), address_(address) {
+    item_->AddObserver(this);
+  }
+  ~WhereFromUpdater() override { item_->RemoveObserver(this); }
+
+  static void Update(download::DownloadItem* item, const GURL& address) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&SetWhereFrom, item->GetTargetFilePath(), address));
+  }
+
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    switch (item->GetState()) {
+      case download::DownloadItem::COMPLETE:
+        Update(item, address_);
+        delete this;
+        return;
+      case download::DownloadItem::CANCELLED:
+      case download::DownloadItem::INTERRUPTED:
+        delete this;
+        return;
+      default:
+        return;
+    }
+  }
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    delete this;
+  }
+
+  const raw_ptr<download::DownloadItem> item_;
+  const GURL address_;
+};
+#endif  // BUILDFLAG(IS_MAC)
+
+void DownloadStarted(const std::string& guid,
+                     const GURL& page_url,
+                     download::DownloadItem* item,
+                     download::DownloadInterruptReason reason) {
+  if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+    ClearDownloadTargetPath(guid);
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  WhereFromUpdater::Watch(ArchiveAddress(page_url), item, reason);
+#endif
+}
+
+// Runs on a blocking thread. Creates the archive folder and returns a path in
+// it that does not exist yet, or an empty path on failure.
+base::FilePath PrepareArchivePath(const base::FilePath& directory,
+                                  const std::u16string& title,
+                                  const GURL& url,
+                                  base::Time time) {
+  if (!base::CreateDirectory(directory)) {
+    LOG(WARNING) << "Could not create archive folder " << directory;
+    return base::FilePath();
+  }
+  // Archives are always PDF files, whatever the server says the document is.
+  return base::GetUniquePath(
+      directory.Append(ArchiveFileName(title, url, time, "pdf")));
+}
+
+// Downloads `url` to `path` without prompting, so the result shows in the
+// downloads bubble. `factory` serves generated content such as a printed PDF.
+// `page_url` is the archived page, recorded as where the file came from.
+void DownloadToPath(
+    content::WebContents* web_contents,
+    const GURL& url,
+    const base::FilePath& path,
+    const GURL& page_url,
+    scoped_refptr<network::SharedURLLoaderFactory> factory = nullptr) {
+  constexpr auto kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("helium_page_archive", R"(
+      semantics {
+        sender: "Helium page archive"
+        description: "Saves the PDF document shown in the current tab, or a "
+                     "PDF printed from the current page, into the user's "
+                     "archive folder."
+        trigger: "User chooses Archive page."
+        data: "The URL of the current tab, with its cookies."
+        destination: WEBSITE
+      }
+      policy {
+        cookies_allowed: YES
+        cookies_store: "user"
+        setting: "Only runs when explicitly requested by the user."
+        policy_exception_justification: "User-initiated download."
+      })");
+  auto params =
+      content::DownloadRequestUtils::CreateDownloadForWebContentsMainFrame(
+          web_contents, url, kTrafficAnnotation);
+  // A path set on the parameters would make the download temporary, which
+  // keeps it out of the downloads bubble and history.
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  SetDownloadTargetPath(guid, path);
+  params->set_guid(guid);
+  params->set_prompt(false);
+  params->set_callback(base::BindOnce(&DownloadStarted, guid, page_url));
+  auto* download_manager =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext())
+          ->GetDownloadManager();
+  if (factory) {
+    download_manager->DownloadUrl(std::move(params), std::move(factory));
+  } else {
+    download_manager->DownloadUrl(std::move(params));
+  }
+}
