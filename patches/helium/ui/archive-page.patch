+namespace helium {
+
+// Saves the active tab into the archive folder without prompting. Web pages
+// become a single MHTML file, or a PDF when the "save as PDF" pref is on; other
+// documents (PDFs, images, text) keep their original bytes unless printed to
+// PDF. Web pages are first scrolled through, up to a limit, so that content
+// loaded on scroll is included. Progress and the result show in the downloads
+// bubble.
+void ArchivePage(BrowserWindowInterface* browser);
+
+// Returns a file name like "2026-11-04 21.30.05 Title (example.com)" with
+// `extension` appended. Exposed for tests.
+base::FilePath::StringType ArchiveFileName(std::u16string_view title,
+                                           const GURL& url,
+                                           base::Time time,
+                                           std::string_view extension);
+
+}  // namespace helium
