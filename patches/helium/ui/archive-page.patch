+
+constexpr size_t kMaxTitleBytes = 120;
+constexpr double kMicronsPerInch = 25400.0;
+constexpr double kPdfMarginInches = 0.4;
+
+// Long articles fit in this many screens. Pages that keep growing as they
+// scroll stop here instead of scrolling forever.
+constexpr int kMaxScrollScreens = 30;
+// Time for scroll handlers and intersection observers to start loading.
+constexpr base::TimeDelta kScrollStepDelay = base::Milliseconds(200);
+constexpr base::TimeDelta kImageWaitTimeout = base::Seconds(3);
+constexpr base::TimeDelta kImagePollInterval = base::Milliseconds(100);
+
+// Remembers the scroll position and scrolls to the top. Returns the position.
+constexpr char16_t kStartScrollScript[] = uR"((() => {
+  const position = [scrollX, scrollY];
+  scrollTo({left: 0, top: 0, behavior: 'instant'});
+  return position;
+})())";
+// Scrolls down a screen. Returns true once the end of the page was shown.
+constexpr char16_t kScrollStepScript[] = uR"((() => {
+  const page = document.scrollingElement;
+  if (!page || scrollY + innerHeight >= page.scrollHeight - 1) {
+    return true;
+  }
+  scrollBy({top: innerHeight, behavior: 'instant'});
+  return false;
+})())";
+// Returns the number of images still loading. Images with loading="lazy" are
+// left out: printing loads those itself, and hidden ones never load.
+constexpr char16_t kPendingImagesScript[] =
+    uR"(Array.from(document.images).filter(
+        image => !image.complete && image.loading !== 'lazy').length)";
+
+enum class Format {
+  // A single-file web archive of the rendered page.
+  kMhtml,
+  // The page printed to PDF.
+  kPdf,
+  // The document's own bytes, fetched again from its URL.
+  kOriginal,
+};
+
+std::string ExtensionFor(Format format,
+                         const GURL& url,
+                         const std::string& mime_type) {
+  switch (format) {
+    case Format::kMhtml:
+      return "mhtml";
+    case Format::kPdf:
+      return "pdf";
+    case Format::kOriginal:
+      break;
+  }
+  base::FilePath::StringType extension;
+  if (net::GetPreferredExtensionForMimeType(mime_type, &extension)) {
+    return base::FilePath(extension).AsUTF8Unsafe();
+  }
+  extension = base::FilePath::FromUTF8Unsafe(url.ExtractFileName()).Extension();
+  if (!extension.empty()) {
+    return base::FilePath(extension).AsUTF8Unsafe().substr(1);
+  }
+  return "bin";
+}
+
+// Runs on a blocking thread. Creates the archive folder and returns a path in
+// it that does not exist yet, or an empty path on failure.
+base::FilePath PrepareArchivePath(const base::FilePath& directory,
+                                  Format format,
+                                  const std::u16string& title,
+                                  const GURL& url,
+                                  const std::string& mime_type,
+                                  base::Time time) {
+  if (!base::CreateDirectory(directory)) {
+    LOG(WARNING) << "Could not create archive folder " << directory;
+    return base::FilePath();
+  }
+  return base::GetUniquePath(directory.Append(
+      ArchiveFileName(title, url, time, ExtensionFor(format, url, mime_type))));
+}
+
+// Downloads `url` to `path` without prompting, so the result shows in the
+// downloads bubble. `factory` serves generated content such as a printed PDF.
+void DownloadToPath(
+    content::WebContents* web_contents,
+    const GURL& url,
+    const base::FilePath& path,
+    scoped_refptr<network::SharedURLLoaderFactory> factory = nullptr) {
+  constexpr auto kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("helium_page_archive", R"(
+      semantics {
+        sender: "Helium page archive"
+        description: "Saves the document shown in the current tab, such as a "
+                     "PDF or image, or a PDF printed from the current page, "
+                     "into the user's archive folder."
+        trigger: "User chooses Archive page."
+        data: "The URL of the current tab, with its cookies."
+        destination: WEBSITE
+      }
+      policy {
+        cookies_allowed: YES
+        cookies_store: "user"
+        setting: "Only runs when explicitly requested by the user."
+        policy_exception_justification: "User-initiated download."
+      })");
+  auto params =
+      content::DownloadRequestUtils::CreateDownloadForWebContentsMainFrame(
+          web_contents, url, kTrafficAnnotation);
+  params->set_file_path(path);
+  params->set_prompt(false);
+  auto* download_manager =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext())
+          ->GetDownloadManager();
+  if (factory) {
+    download_manager->DownloadUrl(std::move(params), std::move(factory));
+  } else {
+    download_manager->DownloadUrl(std::move(params));
+  }
+}
+
+#if BUILDFLAG(ENABLE_PRINTING)
+void PdfBlobReady(base::WeakPtr<content::WebContents> web_contents,
+                  const GURL& page_url,
+                  const base::FilePath& path,
+                  scoped_refptr<base::RefCountedMemory> bytes,
+                  std::unique_ptr<content::BlobHandle> blob) {
+  if (!web_contents || !blob) {
+    return;
+  }
+  const GURL url("blob:" + url::Origin::Create(page_url).Serialize() + "/" +
+                 blob->GetUUID());
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+  storage::BlobURLLoaderFactory::Create(
+      blob->PassBlob(), url, remote.InitWithNewPipeAndPassReceiver());
+  DownloadToPath(web_contents.get(), url, path,
+                 base::MakeRefCounted<network::WrapperSharedURLLoaderFactory>(
+                     std::move(remote)));
+}
+
+void PdfPrinted(base::WeakPtr<content::WebContents> web_contents,
+                const GURL& page_url,
+                const base::FilePath& path,
+                print_to_pdf::PdfPrintResult result,
+                scoped_refptr<base::RefCountedMemory> bytes) {
+  if (!web_contents || result != print_to_pdf::PdfPrintResult::kPrintSuccess ||
+      !bytes) {
+    LOG(WARNING) << "Could not print page to PDF for the archive";
+    return;
+  }
+  // The blob is created from a span over `bytes`; keep them alive until it
+  // exists.
+  const auto data = base::span(*bytes);
+  web_contents->GetBrowserContext()->CreateMemoryBackedBlob(
+      data, "application/pdf",
+      base::BindOnce(&PdfBlobReady, web_contents, page_url, path,
+                     std::move(bytes)));
+}
+
+// Returns a locale whose region decides the paper size, e.g. A4 or Letter.
+std::string PaperLocale() {
+#if BUILDFLAG(IS_MAC)
+  // Paper size follows the region in System Settings, not the UI language.
+  base::apple::ScopedCFTypeRef<CFLocaleRef> locale(CFLocaleCopyCurrent());
+  if (CFStringRef country = base::apple::CFCast<CFStringRef>(
+          CFLocaleGetValue(locale.get(), kCFLocaleCountryCode))) {
+    return "und_" + base::SysCFStringRefToUTF8(country);
+  }
+#endif
+  return g_browser_process->GetApplicationLocale();
+}
+
+// Prints the page to PDF. Returns false if printing is unavailable.
+bool PrintToPdf(content::WebContents* web_contents,
+                const GURL& url,
+                const base::FilePath& path) {
+#if BUILDFLAG(ENABLE_PRINT_PREVIEW)
+  auto* manager = printing::PrintViewManager::FromWebContents(web_contents);
+#else
+  auto* manager = printing::PrintViewManagerBasic::FromWebContents(web_contents);
+#endif
+  if (!manager || !Profile::FromBrowserContext(web_contents->GetBrowserContext())
+                       ->GetPrefs()
+                       ->GetBoolean(prefs::kPrintingEnabled)) {
+    return false;
+  }
+  const gfx::Size paper =
+      printing::GetDefaultPaperSizeFromLocaleMicrons(PaperLocale());
+  // The header and footer record the page's title, URL and capture date.
+  auto params = print_to_pdf::GetPrintPagesParams(
+      url, /*landscape=*/false, /*display_header_footer=*/true,
+      /*print_background=*/true, /*scale=*/1.0,
+      paper.width() / kMicronsPerInch, paper.height() / kMicronsPerInch,
+      kPdfMarginInches, kPdfMarginInches, kPdfMarginInches, kPdfMarginInches,
+      std::nullopt, std::nullopt, /*prefer_css_page_size=*/false,
+      /*generate_tagged_pdf=*/true, /*generate_document_outline=*/true);
+  if (!std::holds_alternative<printing::mojom::PrintPagesParamsPtr>(params)) {
+    return false;
+  }
+  manager->PrintToPdf(
+      web_contents->GetPrimaryMainFrame(), "",
+      std::move(std::get<printing::mojom::PrintPagesParamsPtr>(params)),
+      base::BindOnce(&PdfPrinted, web_contents->GetWeakPtr(), url, path));
+  return true;
+}
+#endif  // BUILDFLAG(ENABLE_PRINTING)
+
+struct ScrollState {
+  content::GlobalRenderFrameHostId frame_id;
+  double x = 0;
+  double y = 0;
+  int screens = 0;
+  base::TimeTicks image_deadline;
+  base::OnceClosure done;
+};
+
+using ScriptCallback = void (*)(std::unique_ptr<ScrollState>, base::Value);
+
+// Runs `script` in the archived page and passes its result to `next`. Stops if
+// the tab navigated to another page in the meantime.
+void RunScrollScript(std::unique_ptr<ScrollState> state,
+                     std::u16string script,
+                     ScriptCallback next) {
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(state->frame_id);
+  if (!frame || !frame->IsInPrimaryMainFrame()) {
+    LOG(WARNING) << "The page changed before it could be archived";
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      script, base::BindOnce(next, std::move(state)),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void RunScrollScriptAfter(base::TimeDelta delay,
+                          std::unique_ptr<ScrollState> state,
+                          std::u16string script,
+                          ScriptCallback next) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&RunScrollScript, std::move(state), std::move(script),
+                     next),
+      delay);
+}
+
+void ScrollRestored(std::unique_ptr<ScrollState> state, base::Value result) {
+  std::move(state->done).Run();
+}
+
+void ImagesChecked(std::unique_ptr<ScrollState> state, base::Value result) {
+  if (result.GetIfDouble().value_or(0) > 0 &&
+      base::TimeTicks::Now() < state->image_deadline) {
+    RunScrollScriptAfter(kImagePollInterval, std::move(state),
+                         kPendingImagesScript, &ImagesChecked);
+    return;
+  }
+  const std::u16string restore = base::UTF8ToUTF16(base::StringPrintf(
+      "scrollTo({left: %f, top: %f, behavior: 'instant'})", state->x,
+      state->y));
+  RunScrollScript(std::move(state), restore, &ScrollRestored);
+}
+
+void Scrolled(std::unique_ptr<ScrollState> state, base::Value result) {
+  if (!result.GetIfBool().value_or(true) &&
+      ++state->screens < kMaxScrollScreens) {
+    RunScrollScriptAfter(kScrollStepDelay, std::move(state), kScrollStepScript,
+                         &Scrolled);
+    return;
+  }
+  state->image_deadline = base::TimeTicks::Now() + kImageWaitTimeout;
+  RunScrollScript(std::move(state), kPendingImagesScript, &ImagesChecked);
+}
+
+void ScrollStarted(std::unique_ptr<ScrollState> state, base::Value result) {
+  const base::ListValue* position = result.GetIfList();
+  if (!position || position->size() != 2) {
+    // Scripts cannot run in this page; save it as it is.
+    std::move(state->done).Run();
+    return;
+  }
+  state->x = (*position)[0].GetIfDouble().value_or(0);
+  state->y = (*position)[1].GetIfDouble().value_or(0);
+  RunScrollScriptAfter(kScrollStepDelay, std::move(state), kScrollStepScript,
+                       &Scrolled);
+}
+
+// Scrolls through the page a screen at a time so that content it loads on
+// scroll, such as lazy images, is in the archive. Then waits briefly for images
+// to finish loading, scrolls back and runs `done`.
+void LoadScrollContent(content::WebContents* web_contents,
+                       base::OnceClosure done) {
+  auto state = std::make_unique<ScrollState>();
+  state->frame_id = web_contents->GetPrimaryMainFrame()->GetGlobalId();
+  state->done = std::move(done);
+  RunScrollScript(std::move(state), kStartScrollScript, &ScrollStarted);
+}
+
+void SaveToPath(base::WeakPtr<content::WebContents> web_contents,
+                Format format,
+                const GURL& url,
+                const base::FilePath& path) {
+  if (!web_contents || path.empty()) {
+    return;
+  }
+  switch (format) {
+    case Format::kMhtml:
+      web_contents->SavePage(path, path.DirName(),
+                             content::SAVE_PAGE_TYPE_AS_MHTML);
+      return;
+    case Format::kPdf:
+#if BUILDFLAG(ENABLE_PRINTING)
+      if (PrintToPdf(web_contents.get(), url, path)) {
+        return;
+      }
+#endif
+      LOG(WARNING) << "Printing is unavailable; archiving as a web archive";
+      web_contents->SavePage(path.ReplaceExtension(FILE_PATH_LITERAL("mhtml")),
+                             path.DirName(), content::SAVE_PAGE_TYPE_AS_MHTML);
+      return;
+    case Format::kOriginal:
+      DownloadToPath(web_contents.get(), url, path);
+      return;
+  }
+}
+
+// Rendered archives keep only what the page has loaded, so first load the
+// content it loads on scroll.
+void LoadAndSaveToPath(base::WeakPtr<content::WebContents> web_contents,
+                       Format format,
+                       const GURL& url,
+                       const base::FilePath& path) {
+  if (!web_contents || path.empty()) {
+    return;
+  }
+  LoadScrollContent(web_contents.get(),
+                    base::BindOnce(&SaveToPath, web_contents, format, url,
+                                   path));
+}
+
+}  // namespace
+
+base::FilePath::StringType ArchiveFileName(std::u16string_view title,
+                                           const GURL& url,
+                                           base::Time time,
+                                           std::string_view extension) {
+  std::string host(url.host());
+  if (base::StartsWith(host, "www.")) {
+    host = host.substr(4);
+  }
+  std::string name = base::UTF16ToUTF8(
+      base::CollapseWhitespace(std::u16string(title), true));
+  if (name.size() > kMaxTitleBytes) {
+    base::TruncateUTF8ToByteSize(name, kMaxTitleBytes, &name);
+    name = std::string(base::TrimWhitespaceASCII(name, base::TRIM_TRAILING)) +
+           "…";
+  }
+  if (name.empty() || name == url.host()) {
+    name = host.empty() ? "Untitled" : host;
+  } else if (!host.empty()) {
+    name += " (" + host + ")";
+  }
+
+  base::Time::Exploded local;
+  time.LocalExplode(&local);
+  base::FilePath::StringType file_name =
+      base::FilePath::FromUTF8Unsafe(
+          base::StringPrintf("%04d-%02d-%02d %02d.%02d.%02d ", local.year,
+                             local.month, local.day_of_month, local.hour,
+                             local.minute, local.second) +
+          name + "." + std::string(extension))
+          .value();
+  base::i18n::ReplaceIllegalCharactersInPath(&file_name, '-');
+  return file_name;
+}
+
+void ArchivePage(BrowserWindowInterface* browser) {
+  content::WebContents* web_contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+
+  Profile* profile = browser->GetProfile();
+  base::FilePath directory =
+      profile->GetPrefs()->GetFilePath(prefs::kHeliumArchiveDirectory);
+  if (directory.empty()) {
+    directory = DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  }
+
+  const std::string mime_type = web_contents->GetContentsMimeType();
+  const bool web_page =
+      mime_type == "text/html" || mime_type == "application/xhtml+xml";
+  Format format = web_page ? Format::kMhtml : Format::kOriginal;
+  if (mime_type != "application/pdf" &&
+      profile->GetPrefs()->GetBoolean(prefs::kHeliumArchiveAsPdf)) {
+    format = Format::kPdf;
+  }
+  const GURL url = web_contents->GetLastCommittedURL();
+  // The entry's title is empty when the page has none, unlike
+  // WebContents::GetTitle(), which falls back to the URL.
+  content::NavigationEntry* entry =
+      web_contents->GetController().GetLastCommittedEntry();
+  std::u16string title = entry ? entry->GetTitle() : std::u16string();
+  // Documents such as images and PDFs are titled after their file, e.g.
+  // "photo.png (640×480)". Use the bare file name instead.
+  const base::FilePath url_file =
+      base::FilePath::FromUTF8Unsafe(url.ExtractFileName());
+  if (!web_page && !url_file.empty() &&
+      (title.empty() || base::StartsWith(title, url_file.AsUTF16Unsafe()))) {
+    title = url_file.RemoveFinalExtension().AsUTF16Unsafe();
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&PrepareArchivePath, directory, format, title, url,
+                     mime_type, base::Time::Now()),
+      base::BindOnce(web_page ? &LoadAndSaveToPath : &SaveToPath,
+                     web_contents->GetWeakPtr(), format, url));
+}
+
