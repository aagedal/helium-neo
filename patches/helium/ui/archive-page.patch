+// Paths set with helium::SetDownloadTargetPath(), by download GUID.
+base::flat_map<std::string, base::FilePath>& HeliumTargetPaths() {
+  static base::NoDestructor<base::flat_map<std::string, base::FilePath>> paths;
+  return *paths;
+}
+
+std::optional<base::FilePath> TakeHeliumTargetPath(const std::string& guid) {
+  auto it = HeliumTargetPaths().find(guid);
+  if (it == HeliumTargetPaths().end()) {
+    return std::nullopt;
+  }
+  base::FilePath path = std::move(it->second);
+  HeliumTargetPaths().erase(it);
+  return path;
+}
