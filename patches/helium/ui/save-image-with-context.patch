+TEST(ImageContextMetadataTest, AddsAndReplacesXmpInJpeg) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::JPEGCodec::Encode(Bitmap(), 90);
+  ASSERT_TRUE(encoded);
+  const std::string jpeg = ToString(*encoded);
+
+  ImageMetadataInfo info = InspectImageMetadata(jpeg);
+  EXPECT_EQ(XmpContainer::kJpeg, info.container);
+  EXPECT_FALSE(info.xmp);
+  EXPECT_FALSE(info.unsupported);
+
+  std::optional<std::string> with_xmp =
+      EmbedXmp(jpeg, XmpContainer::kJpeg, "<first/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ(jpeg.size() + 4 + 29 + 8, with_xmp->size());
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<first/>", info.xmp);
+  EXPECT_FALSE(info.unsupported);
+  EXPECT_FALSE(gfx::JPEGCodec::Decode(Bytes(*with_xmp)).empty());
+
+  // The JFIF segment stays first.
+  EXPECT_EQ(jpeg.substr(0, 20), with_xmp->substr(0, 20));
+
+  with_xmp = EmbedXmp(*with_xmp, XmpContainer::kJpeg, "<second/>");
+  ASSERT_TRUE(with_xmp);
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<second/>", info.xmp);
+  EXPECT_EQ(jpeg.size() + 4 + 29 + 9, with_xmp->size());
+  EXPECT_FALSE(gfx::JPEGCodec::Decode(Bytes(*with_xmp)).empty());
+
+  EXPECT_FALSE(EmbedXmp(jpeg, XmpContainer::kJpeg, std::string(70000, 'x')));
+}
