+namespace image_editor {
+
+// Where a saved image was found, recorded in its XMP metadata.
+struct ImageContext {
+  std::string page_url;
+  std::string page_title;
+  // Empty for images without an address of their own, such as data: URLs.
+  std::string image_url;
+  // When the image was saved, in ISO 8601 format.
+  std::string saved_at;
+  // The browser and its version.
+  std::string software;
+  // For the IPTC Source and the description, which photo apps show, when the
+  // image has neither.
+  std::string source;
+  std::string description;
+};
+
+// The image formats whose XMP metadata can be read and rewritten without
+// re-encoding the image.
+enum class XmpContainer { kNone, kJpeg, kPng, kWebP };
+
+struct ImageMetadataInfo {
+  XmpContainer container = XmpContainer::kNone;
+  // Whether the image carries Content Credentials (C2PA). Their signature
+  // covers the whole file, so any change makes them show as altered.
+  bool has_content_credentials = false;
+  // The image's XMP packet, if it has one.
+  std::optional<std::string> xmp;
+  // Whether the file can't be rewritten safely, for example because it is
+  // malformed or its XMP is compressed or split in two.
+  bool unsupported = false;
+};
+
+ImageMetadataInfo InspectImageMetadata(std::string_view file);
+
+// Returns an XMP packet holding everything in `existing` with `context` added.
+// `existing` is the image's XMP packet as parsed by data_decoder's XmlParser,
+// or nullptr when the image has none. Nothing in it is changed or removed: the
+// save is appended to the xmpMM:History and helium:SavedFrom lists, and
+// dc:source, dc:description and photoshop:Source are only filled in when the
+// image has none. Returns nullopt when `existing` isn't XMP.
+std::optional<std::string> AddImageContextToXmp(const ImageContext& context,
+                                                const base::Value* existing);
+
+// Returns `file` with its XMP packet replaced by `xmp`, or with `xmp` added
+// when it has none. Returns nullopt when the file can't hold it.
+std::optional<std::string> EmbedXmp(std::string_view file,
+                                    XmpContainer container,
+                                    std::string_view xmp);
+
+}  // namespace image_editor
+
+#endif  // CHROME_BROWSER_IMAGE_EDITOR_IMAGE_CONTEXT_METADATA_H_
