+// Parses XMP as the browser does, in an in-process data decoder.
+class ImageContextMetadataParserTest : public testing::Test {
+ protected:
+  std::optional<base::Value> Parse(const std::string& xml) {
+    base::test::TestFuture<data_decoder::DataDecoder::ValueOrError> future;
+    data_decoder::DataDecoder::ParseXmlIsolated(
+        xml,
+        data_decoder::mojom::XmlParser::WhitespaceBehavior::
+            kPreserveSignificant,
+        future.GetCallback());
+    data_decoder::DataDecoder::ValueOrError result = future.Take();
+    if (!result.has_value()) {
+      return std::nullopt;
+    }
+    return std::move(result.value());
+  }
+
+  // Returns the children of the element `path` leads to through child indices.
+  base::ListValue& Children(base::Value& root, std::vector<size_t> path) {
+    base::Value* node = &root;
+    for (size_t index : path) {
+      node = &(*node->GetDict().FindList("children"))[index];
+    }
+    return *node->GetDict().FindList("children");
+  }
+
+  // Leaves out whitespace between elements.
+  void RemoveWhitespace(base::Value& node) {
+    base::ListValue* children = node.GetDict().FindList("children");
+    if (!children) {
+      return;
+    }
+    children->EraseIf([](const base::Value& child) {
+      const std::string* text = child.GetDict().FindString("text");
+      return text && text->find_first_not_of(" \t\r\n") == std::string::npos;
+    });
+    for (base::Value& child : *children) {
+      RemoveWhitespace(child);
+    }
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+};
+
+TEST_F(ImageContextMetadataParserTest, KeepsEverythingInRealXmp) {
+  // As Photoshop writes it, with padding, a credit given as an attribute and
+  // an edit history.
+  const std::string original =
+      "<?xpacket begin=\"\xEF\xBB\xBF\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>\n"
+      "<x:xmpmeta xmlns:x=\"adobe:ns:meta/\" x:xmptk=\"Adobe XMP Core 9.1\">\n"
+      " <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n"
+      "  <rdf:Description rdf:about=\"\"\n"
+      "    xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n"
+      "    xmlns:photoshop=\"http://ns.adobe.com/photoshop/1.0/\"\n"
+      "    xmlns:xmpMM=\"http://ns.adobe.com/xap/1.0/mm/\"\n"
+      "    xmlns:stEvt=\"http://ns.adobe.com/xap/1.0/sType/ResourceEvent#\"\n"
+      "    photoshop:Credit=\"Agency &amp; Co\">\n"
+      "   <dc:title><rdf:Alt><rdf:li xml:lang=\"x-default\">Harbour at "
+      "dawn</rdf:li></rdf:Alt></dc:title>\n"
+      "   <dc:creator><rdf:Seq><rdf:li>A "
+      "Photographer</rdf:li></rdf:Seq></dc:creator>\n"
+      "   <dc:rights><rdf:Alt><rdf:li xml:lang=\"x-default\">\xC2\xA9 2026 A "
+      "Photographer</rdf:li></rdf:Alt></dc:rights>\n"
+      "   <xmpMM:History>\n"
+      "    <rdf:Seq>\n"
+      "     <rdf:li rdf:parseType=\"Resource\">\n"
+      "      <stEvt:action>saved</stEvt:action>\n"
+      "      <stEvt:when>2026-01-02T03:04:05+01:00</stEvt:when>\n"
+      "     </rdf:li>\n"
+      "    </rdf:Seq>\n"
+      "   </xmpMM:History>\n"
+      "  </rdf:Description>\n"
+      " </rdf:RDF>\n"
+      "</x:xmpmeta>\n" +
+      std::string(200, ' ') + "\n<?xpacket end=\"w\"?>";
+  std::optional<base::Value> parsed = Parse(original);
+  ASSERT_TRUE(parsed);
+  const std::optional<std::string> merged =
+      AddImageContextToXmp(Context(), &*parsed);
+  ASSERT_TRUE(merged);
+  std::optional<base::Value> reparsed = Parse(*merged);
+  ASSERT_TRUE(reparsed);
+  RemoveWhitespace(*parsed);
+  RemoveWhitespace(*reparsed);
+
+  // The image's description gains one history event and nothing else.
+  base::ListValue& rdf = Children(*reparsed, {0});
+  ASSERT_EQ(2u, rdf.size());
+  base::ListValue& history = Children(*reparsed, {0, 0, 3, 0});
+  ASSERT_EQ(2u, history.size());
+  const base::Value added = history[1].Clone();
+  history.erase(history.begin() + 1);
+  EXPECT_EQ(Children(*parsed, {0}).front(), rdf.front());
+  EXPECT_EQ(*parsed->GetDict().FindDict("attributes"),
+            *reparsed->GetDict().FindDict("attributes"));
+  EXPECT_EQ("rdf:li", *added.GetDict().FindString("tag"));
+
+  // The source, description and saved image record go in a new description,
+  // as the credit, title, creator and rights stay untouched.
+  const base::ListValue& description = Children(*reparsed, {0, 1});
+  ASSERT_EQ(4u, description.size());
+  EXPECT_EQ("dc:source", *description[0].GetDict().FindString("tag"));
+  EXPECT_EQ("dc:description", *description[1].GetDict().FindString("tag"));
+  EXPECT_EQ("photoshop:Source", *description[2].GetDict().FindString("tag"));
+  EXPECT_EQ("helium:SavedFrom", *description[3].GetDict().FindString("tag"));
+}
+
+TEST(ImageContextMetadataTest, AddsAndReplacesXmpInJpeg) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::JPEGCodec::Encode(Bitmap(), 90);
+  ASSERT_TRUE(encoded);
+  const std::string jpeg = ToString(*encoded);
+
+  ImageMetadataInfo info = InspectImageMetadata(jpeg);
+  EXPECT_EQ(XmpContainer::kJpeg, info.container);
+  EXPECT_FALSE(info.xmp);
+  EXPECT_FALSE(info.unsupported);
+
+  std::optional<std::string> with_xmp =
+      EmbedXmp(jpeg, XmpContainer::kJpeg, "<first/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ(jpeg.size() + 4 + 29 + 8, with_xmp->size());
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<first/>", info.xmp);
+  EXPECT_FALSE(info.unsupported);
+  EXPECT_FALSE(gfx::JPEGCodec::Decode(Bytes(*with_xmp)).empty());
+
+  // The JFIF segment stays first.
+  EXPECT_EQ(jpeg.substr(0, 20), with_xmp->substr(0, 20));
+
+  with_xmp = EmbedXmp(*with_xmp, XmpContainer::kJpeg, "<second/>");
+  ASSERT_TRUE(with_xmp);
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<second/>", info.xmp);
+  EXPECT_EQ(jpeg.size() + 4 + 29 + 9, with_xmp->size());
+  EXPECT_FALSE(gfx::JPEGCodec::Decode(Bytes(*with_xmp)).empty());
+
+  EXPECT_FALSE(EmbedXmp(jpeg, XmpContainer::kJpeg, std::string(70000, 'x')));
+}
+
+TEST(ImageContextMetadataTest, FindsContentCredentialsInJpeg) {
+  // SOI, an APP11 JUMBF segment with a C2PA manifest store, then SOS.
+  std::string jpeg = "\xFF\xD8\xFF\xEB";
+  const std::string payload = std::string("JP\0\x01", 4) + "jumb....c2pa";
+  jpeg += static_cast<char>(0);
+  jpeg += static_cast<char>(payload.size() + 2);
+  jpeg += payload;
+  jpeg += "\xFF\xDA";
+  EXPECT_TRUE(InspectImageMetadata(jpeg).has_content_credentials);
+}
+
+TEST(ImageContextMetadataTest, RejectsTruncatedJpeg) {
+  const std::string jpeg = "\xFF\xD8\xFF\xE1\x40\x00";
+  EXPECT_TRUE(InspectImageMetadata(jpeg).unsupported);
+  EXPECT_FALSE(EmbedXmp(jpeg, XmpContainer::kJpeg, "<x/>"));
+}
+
+TEST(ImageContextMetadataTest, AddsAndReplacesXmpInPng) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(Bitmap(), false);
+  ASSERT_TRUE(encoded);
+  const std::string png = ToString(*encoded);
+
+  ImageMetadataInfo info = InspectImageMetadata(png);
+  EXPECT_EQ(XmpContainer::kPng, info.container);
+  EXPECT_FALSE(info.xmp);
+
+  std::optional<std::string> with_xmp =
+      EmbedXmp(png, XmpContainer::kPng, "<first/>");
+  ASSERT_TRUE(with_xmp);
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<first/>", info.xmp);
+  EXPECT_FALSE(info.unsupported);
+  // The decoder checks chunk CRCs.
+  EXPECT_FALSE(gfx::PNGCodec::Decode(Bytes(*with_xmp)).empty());
+  // After the signature and the 25-byte header chunk.
+  EXPECT_EQ("iTXt", with_xmp->substr(8 + 25 + 4, 4));
+
+  with_xmp = EmbedXmp(*with_xmp, XmpContainer::kPng, "<second/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ("<second/>", InspectImageMetadata(*with_xmp).xmp);
+  EXPECT_EQ(png.size() + 12 + 22 + 9, with_xmp->size());
+  EXPECT_FALSE(gfx::PNGCodec::Decode(Bytes(*with_xmp)).empty());
+}
+
+TEST(ImageContextMetadataTest, LeavesCompressedPngXmpAlone) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(Bitmap(), false);
+  ASSERT_TRUE(encoded);
+  std::string png = ToString(*encoded);
+  // A compressed iTXt chunk; its CRC isn't checked when reading.
+  const std::string data =
+      std::string("XML:com.adobe.xmp\0\x01\0\0\0", 22) + "zz";
+  std::string chunk = std::string(3, '\0') + static_cast<char>(data.size()) +
+                      "iTXt" + data + std::string(4, '\0');
+  png.insert(8 + 25, chunk);
+  EXPECT_TRUE(InspectImageMetadata(png).unsupported);
+}
+
+TEST(ImageContextMetadataTest, AddsXmpToSimpleWebP) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::WebpCodec::Encode(Bitmap(), 80);
+  ASSERT_TRUE(encoded);
+  const std::string webp = ToString(*encoded);
+  ASSERT_EQ("VP8 ", webp.substr(12, 4));
+
+  ImageMetadataInfo info = InspectImageMetadata(webp);
+  EXPECT_EQ(XmpContainer::kWebP, info.container);
+  EXPECT_FALSE(info.xmp);
+
+  std::optional<std::string> with_xmp =
+      EmbedXmp(webp, XmpContainer::kWebP, "<first/>");
+  ASSERT_TRUE(with_xmp);
+  // A VP8X chunk with the XMP flag and the canvas size, minus one.
+  EXPECT_EQ(std::string("VP8X\x0A\0\0\0\x04\0\0\0\x07\0\0\x05\0\0", 18),
+            with_xmp->substr(12, 18));
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<first/>", info.xmp);
+  EXPECT_FALSE(info.unsupported);
+
+  with_xmp = EmbedXmp(*with_xmp, XmpContainer::kWebP, "<second/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ("<second/>", InspectImageMetadata(*with_xmp).xmp);
+  EXPECT_EQ(webp.size() + 18 + 8 + 10, with_xmp->size());
+
+  SkCodec::Result result;
+  std::unique_ptr<SkCodec> codec = SkWebpDecoder::Decode(
+      SkData::MakeWithCopy(with_xmp->data(), with_xmp->size()), &result);
+  ASSERT_TRUE(codec);
+  SkBitmap decoded;
+  decoded.allocPixels(codec->getInfo());
+  EXPECT_EQ(SkCodec::kSuccess,
+            codec->getPixels(codec->getInfo(), decoded.getPixels(),
+                             decoded.rowBytes()));
+}
+
+TEST(ImageContextMetadataTest, CarriesLosslessAlphaIntoExtendedWebP) {
+  // A VP8L header for a 3 by 2 image with alpha, without the image data.
+  const uint32_t bits = (3 - 1) | ((2 - 1) << 14) | (1 << 28);
+  std::string vp8l = "\x2F";
+  for (int shift = 0; shift < 32; shift += 8) {
+    vp8l += static_cast<char>(bits >> shift);
+  }
+  vp8l += '\0';
+  std::string webp = "RIFF";
+  const uint32_t size = static_cast<uint32_t>(4 + 8 + vp8l.size());
+  for (int shift = 0; shift < 32; shift += 8) {
+    webp += static_cast<char>(size >> shift);
+  }
+  webp += "WEBPVP8L";
+  webp += static_cast<char>(vp8l.size());
+  webp += std::string(3, '\0');
+  webp += vp8l;
+
+  const std::optional<std::string> with_xmp =
+      EmbedXmp(webp, XmpContainer::kWebP, "<x/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ(std::string("VP8X\x0A\0\0\0\x14\0\0\0\x02\0\0\x01\0\0", 18),
+            with_xmp->substr(12, 18));
+  EXPECT_EQ("VP8L", with_xmp->substr(30, 4));
+  EXPECT_EQ("<x/>", InspectImageMetadata(*with_xmp).xmp);
+}
+
+TEST(ImageContextMetadataTest, IgnoresOtherFormats) {
+  const ImageMetadataInfo gif = InspectImageMetadata("GIF89a....");
+  EXPECT_EQ(XmpContainer::kNone, gif.container);
+  EXPECT_FALSE(EmbedXmp("GIF89a....", XmpContainer::kNone, "<x/>"));
+}
