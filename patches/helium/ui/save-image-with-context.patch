+
+// Byte access.
+
+uint8_t U8(std::string_view data, size_t pos) {
+  return static_cast<uint8_t>(data[pos]);
+}
+
+uint32_t BE16(std::string_view data, size_t pos) {
+  return (U8(data, pos) << 8) | U8(data, pos + 1);
+}
+
+uint32_t BE32(std::string_view data, size_t pos) {
+  return (BE16(data, pos) << 16) | BE16(data, pos + 2);
+}
+
+uint32_t LE16(std::string_view data, size_t pos) {
+  return U8(data, pos) | (U8(data, pos + 1) << 8);
+}
+
+uint32_t LE32(std::string_view data, size_t pos) {
+  return LE16(data, pos) | (LE16(data, pos + 2) << 16);
+}
+
+void AppendBE16(std::string& out, uint32_t value) {
+  out += static_cast<char>(value >> 8);
+  out += static_cast<char>(value);
+}
+
+void AppendBE32(std::string& out, uint32_t value) {
+  AppendBE16(out, value >> 16);
+  AppendBE16(out, value);
+}
+
+void AppendLE24(std::string& out, uint32_t value) {
+  out += static_cast<char>(value);
+  out += static_cast<char>(value >> 8);
+  out += static_cast<char>(value >> 16);
+}
+
+void AppendLE32(std::string& out, uint32_t value) {
+  AppendLE24(out, value);
+  out += static_cast<char>(value >> 24);
+}
+
+// JPEG: XMP is an APP1 segment starting with this namespace. Content
+// Credentials are JUMBF boxes in APP11 segments.
+
+constexpr std::string_view kJpegXmpHeader("http://ns.adobe.com/xap/1.0/\0", 29);
+constexpr std::string_view kJpegExifHeader("Exif\0\0", 6);
+constexpr uint8_t kJpegApp0 = 0xE0;
+constexpr uint8_t kJpegApp1 = 0xE1;
+constexpr uint8_t kJpegApp11 = 0xEB;
+constexpr size_t kMaxJpegSegmentPayload = 0xFFFF - 2;
+
+struct JpegSegment {
+  size_t start;
+  size_t size;
+  uint8_t marker;
+  std::string_view payload;
+};
+
+// Returns the segments before the image data.
+std::optional<std::vector<JpegSegment>> JpegSegments(std::string_view file) {
+  if (file.size() < 4 || U8(file, 0) != 0xFF || U8(file, 1) != 0xD8) {
+    return std::nullopt;
+  }
+  std::vector<JpegSegment> segments;
+  size_t pos = 2;
+  while (true) {
+    if (pos >= file.size() || U8(file, pos) != 0xFF) {
+      return std::nullopt;
+    }
+    const size_t start = pos;
+    // Markers may be padded with fill bytes.
+    while (pos < file.size() && U8(file, pos) == 0xFF) {
+      ++pos;
+    }
+    if (pos >= file.size()) {
+      return std::nullopt;
+    }
+    const uint8_t marker = U8(file, pos++);
+    if (marker == 0xDA || marker == 0xD9) {
+      return segments;
+    }
+    if (marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7)) {
+      continue;
+    }
+    if (marker == 0x00 || pos + 2 > file.size()) {
+      return std::nullopt;
+    }
+    const size_t length = BE16(file, pos);
+    if (length < 2 || pos + length > file.size()) {
+      return std::nullopt;
+    }
+    segments.push_back({start, pos + length - start, marker,
+                        file.substr(pos + 2, length - 2)});
+    pos += length;
+  }
+}
+
+void InspectJpeg(std::string_view file, ImageMetadataInfo& info) {
+  const std::optional<std::vector<JpegSegment>> segments = JpegSegments(file);
+  if (!segments) {
+    info.unsupported = true;
+    return;
+  }
+  for (const JpegSegment& segment : *segments) {
+    if (segment.marker == kJpegApp1 &&
+        segment.payload.starts_with(kJpegXmpHeader)) {
+      if (info.xmp) {
+        info.unsupported = true;
+      }
+      info.xmp = std::string(segment.payload.substr(kJpegXmpHeader.size()));
+    } else if (segment.marker == kJpegApp11 &&
+               segment.payload.starts_with("JP") &&
+               segment.payload.find("c2pa") != std::string_view::npos) {
+      info.has_content_credentials = true;
+    }
+  }
+}
+
+std::optional<std::string> EmbedInJpeg(std::string_view file,
+                                       std::string_view xmp) {
+  const std::optional<std::vector<JpegSegment>> segments = JpegSegments(file);
+  if (!segments ||
+      kJpegXmpHeader.size() + xmp.size() > kMaxJpegSegmentPayload) {
+    return std::nullopt;
+  }
+  std::string segment = "\xFF\xE1";
+  AppendBE16(segment,
+             static_cast<uint32_t>(2 + kJpegXmpHeader.size() + xmp.size()));
+  segment += kJpegXmpHeader;
+  segment += xmp;
+
+  // Replace the XMP segment, or add one after the JFIF and Exif segments,
+  // which readers expect first.
+  size_t start = 2;
+  size_t end = 2;
+  bool leading = true;
+  for (const JpegSegment& existing : *segments) {
+    if (existing.marker == kJpegApp1 &&
+        existing.payload.starts_with(kJpegXmpHeader)) {
+      start = existing.start;
+      end = existing.start + existing.size;
+      break;
+    }
+    leading = leading && (existing.marker == kJpegApp0 ||
+                          (existing.marker == kJpegApp1 &&
+                           existing.payload.starts_with(kJpegExifHeader)));
+    if (leading) {
+      start = end = existing.start + existing.size;
+    }
+  }
+  std::string out(file.substr(0, start));
+  out += segment;
+  out += file.substr(end);
+  return out;
+}
+
+// PNG: XMP is an uncompressed iTXt chunk with this keyword. Content
+// Credentials are in a caBX chunk.
+
+constexpr std::string_view kPngSignature("\x89PNG\r\n\x1A\n", 8);
+constexpr std::string_view kPngXmpKeyword("XML:com.adobe.xmp\0", 18);
+constexpr uint32_t kMaxPngChunkLength = 0x7FFFFFFF;
+
+struct PngChunk {
+  size_t start;
+  size_t size;
+  std::string_view type;
+  std::string_view data;
+};
+
+std::optional<std::vector<PngChunk>> PngChunks(std::string_view file) {
+  if (!file.starts_with(kPngSignature)) {
+    return std::nullopt;
+  }
+  std::vector<PngChunk> chunks;
+  size_t pos = kPngSignature.size();
+  while (true) {
+    if (pos + 12 > file.size()) {
+      return std::nullopt;
+    }
+    const uint32_t length = BE32(file, pos);
+    if (length > kMaxPngChunkLength || length > file.size() - pos - 12) {
+      return std::nullopt;
+    }
+    chunks.push_back({pos, length + 12u, file.substr(pos + 4, 4),
+                      file.substr(pos + 8, length)});
+    pos += length + 12u;
+    if (chunks.back().type == "IEND") {
+      break;
+    }
+  }
+  if (chunks.front().type != "IHDR") {
+    return std::nullopt;
+  }
+  return chunks;
+}
+
+uint32_t Crc32(std::string_view data) {
+  static constexpr std::array<uint32_t, 256> kTable = [] {
+    std::array<uint32_t, 256> table{};
+    for (uint32_t n = 0; n < 256; ++n) {
+      uint32_t c = n;
+      for (int k = 0; k < 8; ++k) {
+        c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+      }
+      table[n] = c;
+    }
+    return table;
+  }();
+  uint32_t crc = 0xFFFFFFFFu;
+  for (char c : data) {
+    crc = kTable[(crc ^ static_cast<uint8_t>(c)) & 0xFF] ^ (crc >> 8);
+  }
+  return crc ^ 0xFFFFFFFFu;
+}
+
+void InspectPng(std::string_view file, ImageMetadataInfo& info) {
+  const std::optional<std::vector<PngChunk>> chunks = PngChunks(file);
+  if (!chunks) {
+    info.unsupported = true;
+    return;
+  }
+  for (const PngChunk& chunk : *chunks) {
+    if (chunk.type == "caBX") {
+      info.has_content_credentials = true;
+    }
+    if (chunk.type != "iTXt" || !chunk.data.starts_with(kPngXmpKeyword)) {
+      continue;
+    }
+    // Compression flag and method, then the language and translated keyword.
+    std::string_view rest = chunk.data.substr(kPngXmpKeyword.size());
+    if (info.xmp || rest.size() < 2 || rest[0] != 0) {
+      info.unsupported = true;
+      continue;
+    }
+    rest.remove_prefix(2);
+    const size_t language_end = rest.find('\0');
+    const size_t keyword_end = language_end == std::string_view::npos
+                                   ? std::string_view::npos
+                                   : rest.find('\0', language_end + 1);
+    if (keyword_end == std::string_view::npos) {
+      info.unsupported = true;
+      continue;
+    }
+    info.xmp = std::string(rest.substr(keyword_end + 1));
+  }
+}
+
+std::optional<std::string> EmbedInPng(std::string_view file,
+                                      std::string_view xmp) {
+  const std::optional<std::vector<PngChunk>> chunks = PngChunks(file);
+  std::string data(kPngXmpKeyword);
+  // Uncompressed, no language and no translated keyword.
+  data.append(4, '\0');
+  data += xmp;
+  if (!chunks || data.size() > kMaxPngChunkLength) {
+    return std::nullopt;
+  }
+  std::string chunk;
+  AppendBE32(chunk, static_cast<uint32_t>(data.size()));
+  chunk += "iTXt";
+  chunk += data;
+  AppendBE32(chunk, Crc32(chunk.substr(4)));
+
+  // Replace the XMP chunk, or add one after the header, before the image data
+  // as readers expect.
+  size_t start = chunks->front().size + kPngSignature.size();
+  size_t end = start;
+  for (const PngChunk& existing : *chunks) {
+    if (existing.type == "iTXt" && existing.data.starts_with(kPngXmpKeyword)) {
+      start = existing.start;
+      end = existing.start + existing.size;
+      break;
+    }
+  }
+  std::string out(file.substr(0, start));
+  out += chunk;
+  out += file.substr(end);
+  return out;
+}
+
+// WebP: XMP is an "XMP " chunk in the extended format, which a VP8X chunk
+// announces. Content Credentials are in a C2PA chunk.
+
+constexpr uint8_t kWebPXmpFlag = 0x04;
+constexpr uint8_t kWebPAlphaFlag = 0x10;
+constexpr size_t kWebPHeaderSize = 12;
+
+struct WebPChunk {
+  std::string_view fourcc;
+  std::string_view data;
+};
+
+std::optional<std::vector<WebPChunk>> WebPChunks(std::string_view file) {
+  if (file.size() < kWebPHeaderSize || !file.starts_with("RIFF") ||
+      file.substr(8, 4) != "WEBP") {
+    return std::nullopt;
+  }
+  const size_t end = static_cast<size_t>(LE32(file, 4)) + 8;
+  if (end > file.size()) {
+    return std::nullopt;
+  }
+  std::vector<WebPChunk> chunks;
+  size_t pos = kWebPHeaderSize;
+  while (pos < end) {
+    if (pos + 8 > end) {
+      return std::nullopt;
+    }
+    const size_t size = LE32(file, pos + 4);
+    if (size > end - pos - 8) {
+      return std::nullopt;
+    }
+    chunks.push_back({file.substr(pos, 4), file.substr(pos + 8, size)});
+    pos += 8 + size + (size & 1);
+  }
+  if (chunks.empty()) {
+    return std::nullopt;
+  }
+  return chunks;
+}
+
+void AppendWebPChunk(std::string& out,
+                     std::string_view fourcc,
+                     std::string_view data) {
+  out += fourcc;
+  AppendLE32(out, static_cast<uint32_t>(data.size()));
+  out += data;
+  if (data.size() & 1) {
+    out += '\0';
+  }
+}
+
+// Returns the VP8X chunk data a simple WebP needs to hold metadata.
+std::optional<std::string> WebPExtendedHeader(const WebPChunk& image) {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint8_t flags = kWebPXmpFlag;
+  if (image.fourcc == "VP8 ") {
+    // Frame tag, then the start code and the 14-bit dimensions.
+    if (image.data.size() < 10 || image.data.substr(3, 3) != "\x9D\x01\x2A") {
+      return std::nullopt;
+    }
+    width = LE16(image.data, 6) & 0x3FFF;
+    height = LE16(image.data, 8) & 0x3FFF;
+  } else if (image.fourcc == "VP8L") {
+    // Signature, then the 14-bit dimensions minus one and the alpha hint.
+    if (image.data.size() < 5 || U8(image.data, 0) != 0x2F) {
+      return std::nullopt;
+    }
+    const uint32_t bits = LE32(image.data, 1);
+    width = (bits & 0x3FFF) + 1;
+    height = ((bits >> 14) & 0x3FFF) + 1;
+    if ((bits >> 28) & 1) {
+      flags |= kWebPAlphaFlag;
+    }
+  } else {
+    return std::nullopt;
+  }
+  if (width == 0 || height == 0) {
+    return std::nullopt;
+  }
+  std::string header(1, static_cast<char>(flags));
+  header.append(3, '\0');
+  AppendLE24(header, width - 1);
+  AppendLE24(header, height - 1);
+  return header;
+}
+
+void InspectWebP(std::string_view file, ImageMetadataInfo& info) {
+  const std::optional<std::vector<WebPChunk>> chunks = WebPChunks(file);
+  if (!chunks) {
+    info.unsupported = true;
+    return;
+  }
+  for (const WebPChunk& chunk : *chunks) {
+    if (chunk.fourcc == "C2PA") {
+      info.has_content_credentials = true;
+    } else if (chunk.fourcc == "XMP ") {
+      if (info.xmp) {
+        info.unsupported = true;
+      }
+      info.xmp = std::string(chunk.data);
+    }
+  }
+}
+
+std::optional<std::string> EmbedInWebP(std::string_view file,
+                                       std::string_view xmp) {
+  const std::optional<std::vector<WebPChunk>> chunks = WebPChunks(file);
+  if (!chunks || file.size() + xmp.size() + 64 > 0xFFFFFFFFu) {
+    return std::nullopt;
+  }
+  std::string body = "WEBP";
+  if (chunks->front().fourcc == "VP8X") {
+    if (chunks->front().data.size() < 10) {
+      return std::nullopt;
+    }
+    std::string header(chunks->front().data);
+    header[0] = static_cast<char>(U8(header, 0) | kWebPXmpFlag);
+    AppendWebPChunk(body, "VP8X", header);
+  } else if (chunks->size() == 1) {
+    const std::optional<std::string> header =
+        WebPExtendedHeader(chunks->front());
+    if (!header) {
+      return std::nullopt;
+    }
+    AppendWebPChunk(body, "VP8X", *header);
+    AppendWebPChunk(body, chunks->front().fourcc, chunks->front().data);
+  } else {
+    return std::nullopt;
+  }
+  // The XMP chunk comes last, replacing any earlier one.
+  if (chunks->front().fourcc == "VP8X") {
+    for (size_t i = 1; i < chunks->size(); ++i) {
+      if ((*chunks)[i].fourcc != "XMP ") {
+        AppendWebPChunk(body, (*chunks)[i].fourcc, (*chunks)[i].data);
+      }
+    }
+  }
+  AppendWebPChunk(body, "XMP ", xmp);
+
+  std::string out = "RIFF";
+  AppendLE32(out, static_cast<uint32_t>(body.size()));
+  out += body;
+  // Keep anything after the RIFF data.
+  out += file.substr(static_cast<size_t>(LE32(file, 4)) + 8);
+  return out;
+}
+
+// XMP, as parsed by data_decoder's XmlParser.
+
+constexpr char kXmpMetaNamespace[] = "adobe:ns:meta/";
+constexpr char kRdfNamespace[] = "http://www.w3.org/1999/02/22-rdf-syntax-ns#";
+constexpr char kDcNamespace[] = "http://purl.org/dc/elements/1.1/";
+constexpr char kPhotoshopNamespace[] = "http://ns.adobe.com/photoshop/1.0/";
+constexpr char kXmpMMNamespace[] = "http://ns.adobe.com/xap/1.0/mm/";
+constexpr char kResourceEventNamespace[] =
+    "http://ns.adobe.com/xap/1.0/sType/ResourceEvent#";
+constexpr char kHeliumNamespace[] =
+    "https://github.com/aagedal/helium/ns/capture/1.0/";
+constexpr char kXmlNamespace[] = "http://www.w3.org/XML/1998/namespace";
+
+constexpr char kTypeKey[] = "type";
+constexpr char kTagKey[] = "tag";
+constexpr char kTextKey[] = "text";
+constexpr char kAttributesKey[] = "attributes";
+constexpr char kChildrenKey[] = "children";
+constexpr char kNamespacesKey[] = "namespaces";
+constexpr char kElementType[] = "element";
+
+// The namespace declarations in scope, innermost last.
+using Scope = std::vector<const base::DictValue*>;
+
+struct QualifiedName {
+  std::string_view ns;
+  std::string_view local;
+
+  bool Is(std::string_view other_ns, std::string_view other_local) const {
+    return ns == other_ns && local == other_local;
+  }
+};
+
+std::string_view LookUpNamespace(std::string_view prefix, const Scope& scope) {
+  for (auto it = scope.rbegin(); it != scope.rend(); ++it) {
+    if (*it) {
+      if (const std::string* uri = (*it)->FindString(prefix)) {
+        return *uri;
+      }
+    }
+  }
+  return prefix == "xml" ? kXmlNamespace : std::string_view();
+}
+
+// Unprefixed attributes have no namespace, while unprefixed elements are in
+// the default namespace.
+QualifiedName Resolve(std::string_view name,
+                      const Scope& scope,
+                      bool is_attribute) {
+  const size_t colon = name.find(':');
+  if (colon == std::string_view::npos) {
+    return {is_attribute ? std::string_view() : LookUpNamespace("", scope),
+            name};
+  }
+  return {LookUpNamespace(name.substr(0, colon), scope),
+          name.substr(colon + 1)};
+}
+
+bool IsElement(const base::Value& node) {
+  const base::DictValue* dict = node.GetIfDict();
+  const std::string* type = dict ? dict->FindString(kTypeKey) : nullptr;
+  return type && *type == kElementType && dict->FindString(kTagKey);
+}
+
+QualifiedName ElementName(const base::DictValue& element, Scope& scope) {
+  scope.push_back(element.FindDict(kNamespacesKey));
+  return Resolve(*element.FindString(kTagKey), scope, false);
+}
+
+// Returns the first child element named `ns`:`local`, with its namespaces
+// added to `scope`.
+base::DictValue* FindChild(base::DictValue& parent,
+                           std::string_view ns,
+                           std::string_view local,
+                           Scope& scope) {
+  base::ListValue* children = parent.FindList(kChildrenKey);
+  if (!children) {
+    return nullptr;
+  }
+  for (base::Value& child : *children) {
+    if (!IsElement(child)) {
+      continue;
+    }
+    if (ElementName(child.GetDict(), scope).Is(ns, local)) {
+      return &child.GetDict();
+    }
+    scope.pop_back();
+  }
+  return nullptr;
+}
+
+base::Value Text(std::string_view text) {
+  return base::Value(
+      base::DictValue().Set(kTypeKey, "text").Set(kTextKey, text));
+}
+
+base::Value Element(std::string_view tag,
+                    base::DictValue attributes,
+                    base::DictValue namespaces,
+                    base::ListValue children) {
+  base::DictValue element;
+  element.Set(kTypeKey, kElementType);
+  element.Set(kTagKey, tag);
+  if (!attributes.empty()) {
+    element.Set(kAttributesKey, std::move(attributes));
+  }
+  if (!namespaces.empty()) {
+    element.Set(kNamespacesKey, std::move(namespaces));
+  }
+  element.Set(kChildrenKey, std::move(children));
+  return base::Value(std::move(element));
+}
+
+void AddTextProperty(base::ListValue& properties,
+                     std::string_view tag,
+                     std::string_view value) {
+  if (!value.empty()) {
+    properties.Append(
+        Element(tag, {}, {}, base::ListValue().Append(Text(value))));
+  }
+}
+
+// List items are structures. Items added to an existing list declare the
+// namespaces they use, as the prefixes in the document may differ.
+base::Value ListItem(base::ListValue properties,
+                     base::DictValue namespaces,
+                     bool declare_namespaces) {
+  if (!declare_namespaces) {
+    namespaces = {};
+  } else {
+    namespaces.Set("rdf", kRdfNamespace);
+  }
+  return Element("rdf:li", base::DictValue().Set("rdf:parseType", "Resource"),
+                 std::move(namespaces), std::move(properties));
+}
+
+base::Value HistoryEvent(const ImageContext& context, bool declare_namespaces) {
+  base::ListValue properties;
+  AddTextProperty(properties, "stEvt:action", "saved");
+  AddTextProperty(properties, "stEvt:when", context.saved_at);
+  AddTextProperty(properties, "stEvt:softwareAgent", context.software);
+  AddTextProperty(properties, "stEvt:parameters",
+                  context.image_url.empty() ? "from " + context.page_url
+                                            : "from " + context.image_url +
+                                                  " on " + context.page_url);
+  return ListItem(std::move(properties),
+                  base::DictValue().Set("stEvt", kResourceEventNamespace),
+                  declare_namespaces);
+}
+
+base::Value SaveRecord(const ImageContext& context, bool declare_namespaces) {
+  base::ListValue properties;
+  AddTextProperty(properties, "helium:PageURL", context.page_url);
+  AddTextProperty(properties, "helium:PageTitle", context.page_title);
+  AddTextProperty(properties, "helium:ImageURL", context.image_url);
+  AddTextProperty(properties, "helium:SavedAt", context.saved_at);
+  return ListItem(std::move(properties),
+                  base::DictValue().Set("helium", kHeliumNamespace),
+                  declare_namespaces);
+}
+
+base::Value OrderedList(base::Value item) {
+  return Element("rdf:Seq", {}, {}, base::ListValue().Append(std::move(item)));
+}
+
+// A property of an rdf:Description element.
+struct Property {
+  bool found = false;
+  // The property's rdf:Seq, if it is an ordered list.
+  raw_ptr<base::DictValue> list = nullptr;
+};
+
+void FindProperty(base::DictValue& description,
+                  std::string_view ns,
+                  std::string_view local,
+                  Scope& scope,
+                  Property& property) {
+  if (property.found) {
+    return;
+  }
+  // Simple values can be attributes of the description.
+  if (const base::DictValue* attributes =
+          description.FindDict(kAttributesKey)) {
+    for (const auto [name, value] : *attributes) {
+      if (Resolve(name, scope, true).Is(ns, local)) {
+        property.found = true;
+        return;
+      }
+    }
+  }
+  const size_t depth = scope.size();
+  base::DictValue* element = FindChild(description, ns, local, scope);
+  if (!element) {
+    return;
+  }
+  property.found = true;
+  property.list = FindChild(*element, kRdfNamespace, "Seq", scope);
+  scope.resize(depth);
+}
+
+// Escapes text for XML, dropping characters XML can't hold.
+std::string Escape(std::string_view text, bool attribute) {
+  std::string out;
+  out.reserve(text.size());
+  for (size_t i = 0; i < text.size(); ++i) {
+    const char c = text[i];
+    // U+FFFE and U+FFFF.
+    if (text.substr(i, 2) == "\xEF\xBF" && i + 2 < text.size() &&
+        (U8(text, i + 2) == 0xBE || U8(text, i + 2) == 0xBF)) {
+      out += "\xEF\xBF\xBD";
+      i += 2;
+      continue;
+    }
+    switch (c) {
+      case '&':
+        out += "&amp;";
+        break;
+      case '<':
+        out += "&lt;";
+        break;
+      case '>':
+        out += "&gt;";
+        break;
+      case '"':
+        out += attribute ? "&quot;" : "\"";
+        break;
+      case '\t':
+        out += attribute ? "&#x9;" : "\t";
+        break;
+      case '\n':
+        out += attribute ? "&#xA;" : "\n";
+        break;
+      case '\r':
+        out += "&#xD;";
+        break;
+      default:
+        if (static_cast<uint8_t>(c) >= 0x20) {
+          out += c;
+        }
+    }
+  }
+  return out;
+}
+
+void Serialize(const base::Value& node, std::string& out) {
+  const base::DictValue* dict = node.GetIfDict();
+  const std::string* type = dict ? dict->FindString(kTypeKey) : nullptr;
+  if (!type) {
+    return;
+  }
+  if (*type != kElementType) {
+    // Text and CDATA.
+    if (const std::string* text = dict->FindString(kTextKey)) {
+      out += Escape(*text, false);
+    }
+    return;
+  }
+  const std::string* tag = dict->FindString(kTagKey);
+  if (!tag) {
+    return;
+  }
+  out += '<';
+  out += *tag;
+  if (const base::DictValue* namespaces = dict->FindDict(kNamespacesKey)) {
+    for (const auto [prefix, uri] : *namespaces) {
+      if (!uri.is_string()) {
+        continue;
+      }
+      out += prefix.empty() ? " xmlns" : " xmlns:" + prefix;
+      out += "=\"" + Escape(uri.GetString(), true) + '"';
+    }
+  }
+  if (const base::DictValue* attributes = dict->FindDict(kAttributesKey)) {
+    for (const auto [name, value] : *attributes) {
+      if (value.is_string()) {
+        out += ' ' + name + "=\"" + Escape(value.GetString(), true) + '"';
+      }
+    }
+  }
+  const base::ListValue* children = dict->FindList(kChildrenKey);
+  if (!children || children->empty()) {
+    out += "/>";
+    return;
+  }
+  out += '>';
+  for (const base::Value& child : *children) {
+    Serialize(child, out);
+  }
+  out += "</" + *tag + '>';
+}
+
+// Returns the rdf:RDF element of an XMP packet, with the namespaces in scope.
+base::DictValue* FindRdf(base::Value& root, Scope& scope) {
+  if (!IsElement(root)) {
+    return nullptr;
+  }
+  base::DictValue* rdf = &root.GetDict();
+  const QualifiedName root_name = ElementName(*rdf, scope);
+  if (root_name.Is(kXmpMetaNamespace, "xmpmeta") ||
+      root_name.Is(kXmpMetaNamespace, "xapmeta")) {
+    return FindChild(*rdf, kRdfNamespace, "RDF", scope);
+  }
+  return root_name.Is(kRdfNamespace, "RDF") ? rdf : nullptr;
+}
+
+// The text directly in `element`.
+std::string ElementText(const base::DictValue& element) {
+  std::string text;
+  if (const base::ListValue* children = element.FindList(kChildrenKey)) {
+    for (const base::Value& child : *children) {
+      if (!IsElement(child) && child.is_dict()) {
+        if (const std::string* part = child.GetDict().FindString(kTextKey)) {
+          text += *part;
+        }
+      }
+    }
+  }
+  return text;
+}
+
+// The value of a property as text: the default of alternatives, the items of
+// a list joined, or plain text.
+std::string PropertyText(base::DictValue& property, Scope& scope) {
+  const size_t depth = scope.size();
+  for (std::string_view type : {"Alt", "Seq", "Bag"}) {
+    base::DictValue* list = FindChild(property, kRdfNamespace, type, scope);
+    if (!list) {
+      continue;
+    }
+    std::vector<std::string> items;
+    for (base::Value& item : *list->EnsureList(kChildrenKey)) {
+      if (!IsElement(item)) {
+        continue;
+      }
+      const size_t item_depth = scope.size();
+      if (ElementName(item.GetDict(), scope).Is(kRdfNamespace, "li")) {
+        const std::string text = ElementText(item.GetDict());
+        const std::string* language =
+            item.GetDict().FindStringByDottedPath("attributes.xml:lang");
+        if (type == "Alt" && language && *language == "x-default") {
+          scope.resize(depth);
+          return text;
+        }
+        if (!text.empty()) {
+          items.push_back(text);
+        }
+      }
+      scope.resize(item_depth);
+    }
+    scope.resize(depth);
+    if (type == "Alt") {
+      return items.empty() ? std::string() : items.front();
+    }
+    std::string joined;
+    for (const std::string& item : items) {
+      joined += (joined.empty() ? "" : ", ") + item;
+    }
+    return joined;
+  }
+  return ElementText(property);
+}
+
+base::Value EmptyXmp() {
+  return Element(
+      "x:xmpmeta", {}, base::DictValue().Set("x", kXmpMetaNamespace),
+      base::ListValue().Append(Element(
+          "rdf:RDF", {}, base::DictValue().Set("rdf", kRdfNamespace), {})));
+}
+
+}  // namespace
+
+ImageMetadataInfo InspectImageMetadata(std::string_view file) {
+  ImageMetadataInfo info;
+  if (file.starts_with("\xFF\xD8")) {
+    info.container = XmpContainer::kJpeg;
+    InspectJpeg(file, info);
+  } else if (file.starts_with(kPngSignature)) {
+    info.container = XmpContainer::kPng;
+    InspectPng(file, info);
+  } else if (file.size() >= kWebPHeaderSize && file.starts_with("RIFF") &&
+             file.substr(8, 4) == "WEBP") {
+    info.container = XmpContainer::kWebP;
+    InspectWebP(file, info);
+  }
+  return info;
+}
+
+std::optional<std::string> AddImageContextToXmp(const ImageContext& context,
+                                                const base::Value* existing) {
+  base::Value root = existing ? existing->Clone() : EmptyXmp();
+  Scope scope;
+  base::DictValue* rdf = FindRdf(root, scope);
+  if (!rdf) {
+    return std::nullopt;
+  }
+  // Make sure the list exists before pointing into the tree.
+  if (!rdf->FindList(kChildrenKey)) {
+    rdf->Set(kChildrenKey, base::ListValue());
+  }
+
+  // Look for the properties in every description, as XMP may split them.
+  Property source;
+  Property description_property;
+  Property supplier;
+  Property history;
+  Property saved_from;
+  std::string about;
+  bool found_about = false;
+  for (base::Value& child : *rdf->FindList(kChildrenKey)) {
+    if (!IsElement(child)) {
+      continue;
+    }
+    base::DictValue& description = child.GetDict();
+    const size_t depth = scope.size();
+    if (ElementName(description, scope).Is(kRdfNamespace, "Description")) {
+      if (const base::DictValue* attributes =
+              description.FindDict(kAttributesKey);
+          attributes && !found_about) {
+        for (const auto [name, value] : *attributes) {
+          if (value.is_string() &&
+              Resolve(name, scope, true).Is(kRdfNamespace, "about")) {
+            about = value.GetString();
+            found_about = true;
+          }
+        }
+      }
+      FindProperty(description, kDcNamespace, "source", scope, source);
+      FindProperty(description, kDcNamespace, "description", scope,
+                   description_property);
+      FindProperty(description, kPhotoshopNamespace, "Source", scope, supplier);
+      FindProperty(description, kXmpMMNamespace, "History", scope, history);
+      FindProperty(description, kHeliumNamespace, "SavedFrom", scope,
+                   saved_from);
+    }
+    scope.resize(depth);
+  }
+
+  // Add to the lists the image has, then put the rest in a description of its
+  // own, so that nothing already there changes. Lists that aren't ordered
+  // lists are left alone.
+  if (history.list) {
+    history.list->EnsureList(kChildrenKey)->Append(HistoryEvent(context, true));
+  }
+  if (saved_from.list) {
+    saved_from.list->EnsureList(kChildrenKey)
+        ->Append(SaveRecord(context, true));
+  }
+  base::ListValue properties;
+  base::DictValue namespaces;
+  if (!source.found && !context.page_url.empty()) {
+    AddTextProperty(properties, "dc:source", context.page_url);
+    namespaces.Set("dc", kDcNamespace);
+  }
+  if (!description_property.found && !context.description.empty()) {
+    // A text in alternative languages, of which this is the default.
+    properties.Append(Element(
+        "dc:description", {}, {},
+        base::ListValue().Append(Element(
+            "rdf:Alt", {}, {},
+            base::ListValue().Append(Element(
+                "rdf:li", base::DictValue().Set("xml:lang", "x-default"), {},
+                base::ListValue().Append(Text(context.description))))))));
+    namespaces.Set("dc", kDcNamespace);
+  }
+  if (!supplier.found && !context.source.empty()) {
+    AddTextProperty(properties, "photoshop:Source", context.source);
+    namespaces.Set("photoshop", kPhotoshopNamespace);
+  }
+  if (!history.found) {
+    properties.Append(Element(
+        "xmpMM:History", {}, {},
+        base::ListValue().Append(OrderedList(HistoryEvent(context, false)))));
+    namespaces.Set("xmpMM", kXmpMMNamespace);
+    namespaces.Set("stEvt", kResourceEventNamespace);
+  }
+  if (!saved_from.found) {
+    properties.Append(Element(
+        "helium:SavedFrom", {}, {},
+        base::ListValue().Append(OrderedList(SaveRecord(context, false)))));
+    namespaces.Set("helium", kHeliumNamespace);
+  }
+  if (!properties.empty()) {
+    namespaces.Set("rdf", kRdfNamespace);
+    rdf->FindList(kChildrenKey)
+        ->Append(Element("rdf:Description",
+                         base::DictValue().Set("rdf:about", about),
+                         std::move(namespaces), std::move(properties)));
+  }
+
+  std::string out =
+      "<?xpacket begin=\"\xEF\xBB\xBF\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>";
+  Serialize(root, out);
+  out += "<?xpacket end=\"w\"?>";
+  return out;
+}
+
+ImageXmpSummary SummarizeXmp(const base::Value& existing) {
+  ImageXmpSummary summary;
+  base::Value root = existing.Clone();
+  Scope scope;
+  base::DictValue* rdf = FindRdf(root, scope);
+  if (!rdf) {
+    return summary;
+  }
+  struct Field {
+    std::string_view ns;
+    std::string_view local;
+    std::string ImageXmpSummary::* text;
+  };
+  static constexpr Field kFields[] = {
+      {kDcNamespace, "title", &ImageXmpSummary::title},
+      {kDcNamespace, "creator", &ImageXmpSummary::creator},
+      {kDcNamespace, "rights", &ImageXmpSummary::rights},
+      {kPhotoshopNamespace, "Credit", &ImageXmpSummary::credit},
+      {kPhotoshopNamespace, "Source", &ImageXmpSummary::source},
+      {kDcNamespace, "description", &ImageXmpSummary::description},
+  };
+  for (base::Value& child : *rdf->EnsureList(kChildrenKey)) {
+    if (!IsElement(child)) {
+      continue;
+    }
+    base::DictValue& description = child.GetDict();
+    const size_t depth = scope.size();
+    if (ElementName(description, scope).Is(kRdfNamespace, "Description")) {
+      for (const Field& field : kFields) {
+        std::string& text = summary.*field.text;
+        if (!text.empty()) {
+          continue;
+        }
+        if (const base::DictValue* attributes =
+                description.FindDict(kAttributesKey)) {
+          for (const auto [name, value] : *attributes) {
+            if (value.is_string() &&
+                Resolve(name, scope, true).Is(field.ns, field.local)) {
+              text = value.GetString();
+            }
+          }
+        }
+        const size_t property_depth = scope.size();
+        if (base::DictValue* property =
+                FindChild(description, field.ns, field.local, scope)) {
+          text = PropertyText(*property, scope);
+        }
+        scope.resize(property_depth);
+      }
+    }
+    scope.resize(depth);
+  }
+  return summary;
+}
+
+std::optional<std::string> EmbedXmp(std::string_view file,
+                                    XmpContainer container,
+                                    std::string_view xmp) {
+  switch (container) {
+    case XmpContainer::kJpeg:
+      return EmbedInJpeg(file, xmp);
+    case XmpContainer::kPng:
+      return EmbedInPng(file, xmp);
+    case XmpContainer::kWebP:
+      return EmbedInWebP(file, xmp);
+    case XmpContainer::kNone:
+      return std::nullopt;
+  }
+  NOTREACHED();
+}
