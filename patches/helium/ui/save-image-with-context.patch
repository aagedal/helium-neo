+
+void ShowImageContextBubble(base::WeakPtr<content::WebContents> web_contents,
+                            scoped_refptr<SavedImageContext> image) {
+  if (!web_contents || !image->ready) {
+    return;
+  }
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_contents.get());
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view) {
+    return;
+  }
+  // In frameless mode, a bubble anchored in the toolbar would reveal it.
+  const bool overlay = browser_view->IsZenModeEnabledForLayout();
+  views::BubbleAnchor anchor =
+      overlay
+          ? views::BubbleAnchor(browser_view)
+          : ToolbarButtonProvider::From(browser)->GetBubbleAnchor(std::nullopt);
+  auto bubble = std::make_unique<ImageContextBubble>(anchor, web_contents.get(),
+                                                     std::move(image));
+  auto* bubble_ptr = bubble.get();
+  if (overlay) {
+    bubble->set_overlay(true);
+    bubble->SetArrow(views::BubbleBorder::FLOAT);
+  }
+  views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  bubble_ptr->ShowForReason(LocationBarBubbleDelegateView::USER_GESTURE);
+}
