+TEST(ImageContextMetadataTest, AddsAndReplacesXmpInPng) {
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(Bitmap(), false);
+  ASSERT_TRUE(encoded);
+  const std::string png = ToString(*encoded);
+
+  ImageMetadataInfo info = InspectImageMetadata(png);
+  EXPECT_EQ(XmpContainer::kPng, info.container);
+  EXPECT_FALSE(info.xmp);
+
+  std::optional<std::string> with_xmp =
+      EmbedXmp(png, XmpContainer::kPng, "<first/>");
+  ASSERT_TRUE(with_xmp);
+  info = InspectImageMetadata(*with_xmp);
+  EXPECT_EQ("<first/>", info.xmp);
+  EXPECT_FALSE(info.unsupported);
+  // The decoder checks chunk CRCs.
+  EXPECT_FALSE(gfx::PNGCodec::Decode(Bytes(*with_xmp)).empty());
+  // After the signature and the 25-byte header chunk.
+  EXPECT_EQ("iTXt", with_xmp->substr(8 + 25 + 4, 4));
+
+  with_xmp = EmbedXmp(*with_xmp, XmpContainer::kPng, "<second/>");
+  ASSERT_TRUE(with_xmp);
+  EXPECT_EQ("<second/>", InspectImageMetadata(*with_xmp).xmp);
+  EXPECT_EQ(png.size() + 12 + 22 + 9, with_xmp->size());
+  EXPECT_FALSE(gfx::PNGCodec::Decode(Bytes(*with_xmp)).empty());
+}
