+          "xmlns:mm=\"http://ns.adobe.com/xap/1.0/mm/\" R:about=\"uuid:1\" "
+          "dc:source=\"Agency\">"
+          "<dc:creator><R:Seq><R:li>A Photographer</R:li></R:Seq></dc:creator>"
+          "<mm:History><R:Seq><R:li R:parseType=\"Resource\"/>"
+          "<rdf:li "
+          "xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" "
+          "xmlns:stEvt=\"http://ns.adobe.com/xap/1.0/sType/ResourceEvent#\" "
+          "rdf:parseType=\"Resource\">"
+          "<stEvt:action>saved</stEvt:action>"
+          "<stEvt:when>2026-11-13T18:00:00Z</stEvt:when>"
+          "<stEvt:softwareAgent>Helium Neo 0.21.3.1</stEvt:softwareAgent>"
+          "<stEvt:parameters>from https://cdn.example.com/photo.jpg on "
+          "https://example.com/article?a=1&amp;b=2</stEvt:parameters>"
+          "</rdf:li></R:Seq></mm:History></R:Description>"
+          // The rest goes in a description of its own, with the same subject.
+          "<rdf:Description "
+          "xmlns:dc=\"http://purl.org/dc/elements/1.1/\" "
+          "xmlns:helium=\"https://github.com/aagedal/helium/ns/capture/1.0/\" "
+          "xmlns:photoshop=\"http://ns.adobe.com/photoshop/1.0/\" "
+          "xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" "
+          "rdf:about=\"uuid:1\">"
+          "<dc:description><rdf:Alt><rdf:li xml:lang=\"x-default\">"
+          "Saved from example.com</rdf:li></rdf:Alt></dc:description>"
+          "<photoshop:Source>example.com / "
+          "https://example.com/article?a=1&amp;b=2</photoshop:Source>"
+          "<helium:SavedFrom><rdf:Seq><rdf:li rdf:parseType=\"Resource\">"
+          "<helium:PageURL>https://example.com/article?a=1&amp;b=2"
+          "</helium:PageURL>"
+          "<helium:PageTitle>An &lt;article&gt;</helium:PageTitle>"
+          "<helium:ImageURL>https://cdn.example.com/photo.jpg</helium:ImageURL>"
+          "<helium:SavedAt>2026-11-13T18:00:00Z</helium:SavedAt>"
+          "</rdf:li></rdf:Seq></helium:SavedFrom></rdf:Description>"
+          "</R:RDF></x:xmpmeta>" +
+          kPacketEnd,
+      *xmp);
+}
