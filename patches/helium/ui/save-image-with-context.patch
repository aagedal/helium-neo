+void RenderViewContextMenu::ExecSaveImageWithContext() {
+  RenderFrameHost* frame_host = GetRenderFrameHost();
+  if (!frame_host) {
+    return;
+  }
+  RecordDownloadSource(DOWNLOAD_INITIATED_BY_CONTEXT_MENU);
+  const GURL& url = params_.src_url;
+  net::NetworkTrafficAnnotationTag traffic_annotation =
+      net::DefineNetworkTrafficAnnotation("helium_save_image_with_context", R"(
+        semantics {
+          sender: "Save Image with Context Metadata"
+          description:
+            "Saves an image to the local file system, recording the page it "
+            "was saved from and its address in its metadata."
+          trigger:
+            "The user selects 'Save Image with Context Metadata' in the "
+            "context menu of an image."
+          data: "None."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: YES
+          cookies_store: "user"
+          setting:
+            "This feature cannot be disabled by settings. The request is made "
+            "only when the user chooses the context menu item."
+          policy_exception_justification: "Not implemented."
+        })");
+  // As "Save Image As", but without asking where.
+  auto dl_params =
+      frame_host->CreateDownloadUrlParameters(url, traffic_annotation);
+  content::Referrer referrer = CreateReferrer(url, params_);
+  dl_params->set_referrer(referrer.url);
+  dl_params->set_referrer_policy(
+      content::Referrer::ReferrerPolicyForUrlRequest(referrer.policy));
+  dl_params->set_referrer_encoding(params_.frame_charset);
+  dl_params->add_request_header(net::HttpRequestHeaders::kAccept,
+                                blink::network_utils::ImageAcceptHeader());
+  dl_params->set_prefer_cache(true);
+  dl_params->set_suggested_name(params_.suggested_filename);
+  dl_params->set_download_source(download::DownloadSource::CONTEXT_MENU);
+  sharing_hub::ScreenshotCapturedBubbleController::Get(embedder_web_contents_)
+      ->SaveImageWithContext(std::move(dl_params));
+}
