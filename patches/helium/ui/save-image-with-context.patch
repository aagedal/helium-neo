+
+// Leaves out user names and passwords.
+std::string AddressForRecord(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  GURL::Replacements replacements;
+  replacements.ClearUsername();
+  replacements.ClearPassword();
+  return url.ReplaceComponents(replacements).spec();
+}
+
+// A readable summary first, then the record, as screenshots have.
+std::string Describe(const SavedImageContext& image) {
+  const ImageContext& context = image.context;
+  const bool norwegian = image.language == ScreenshotTextLanguage::kNorwegian;
+  std::string description;
+  const std::string saved = ScreenshotDisplayDate(context.saved_at);
+  if (!saved.empty()) {
+    description += (norwegian ? "Lagret: " : "Saved: ") + saved + "\n";
+  }
+  if (!image.site.empty()) {
+    description += image.site + "\n";
+  }
+  if (!description.empty()) {
+    description += "\n";
+  }
+  description += "HELIUM NEO — SAVED IMAGE SOURCE RECORD\n\n";
+  const auto field = [&](std::string_view label, const std::string& value) {
+    description += std::string(label) + ": " +
+                   (value.empty() ? "Not supplied" : value) + "\n\n";
+  };
+  field("Page URL (observed)", context.page_url);
+  field("Page title (observed)", context.page_title);
+  field("Image URL (observed)", context.image_url);
+  field("Saved (UTC, computer clock)", context.saved_at);
+  return description;
+}
+
+struct DownloadedImage {
+  bool read = false;
+  ImageMetadataInfo info;
+};
+
+DownloadedImage InspectDownloadedImage(const base::FilePath& path) {
+  DownloadedImage image;
+  std::string file;
+  image.read = base::ReadFileToStringWithMaxSize(path, &file, kMaxImageSize);
+  if (image.read) {
+    image.info = image_editor::InspectImageMetadata(file);
+  }
+  return image;
+}
+
+// What UpdateSavedImage() does away from the UI thread.
+struct StoreTask {
+  base::FilePath path;
+  XmpContainer container = XmpContainer::kNone;
+  Location target = Location::kNowhere;
+  Location location = Location::kNowhere;
+  base::FilePath sidecar;
+  std::string original_file;
+  bool keep_original = false;
+  std::string image_xmp;
+  std::string sidecar_xmp;
+};
+
+struct StoreResult {
+  bool success = false;
+  Location location = Location::kNowhere;
+  base::FilePath sidecar;
+  std::string original_file;
+};
+
+// A free name for an XMP file next to `image`, as photo apps look for it.
+base::FilePath FreeSidecarPath(const base::FilePath& image) {
+  for (const base::FilePath& sidecar :
+       {image.ReplaceExtension(FILE_PATH_LITERAL("xmp")),
+        image.AddExtension(FILE_PATH_LITERAL("xmp"))}) {
+    if (!base::PathExists(sidecar)) {
+      return sidecar;
+    }
+  }
+  return base::FilePath();
+}
+
+StoreResult Store(StoreTask task) {
+  StoreResult result = {.location = task.location,
+                        .sidecar = task.sidecar,
+                        .original_file = std::move(task.original_file)};
+  const auto write_sidecar = [&] {
+    const base::FilePath sidecar =
+        result.sidecar.empty() ? FreeSidecarPath(task.path) : result.sidecar;
+    if (sidecar.empty() || !base::WriteFile(sidecar, task.sidecar_xmp)) {
+      return false;
+    }
+    result.sidecar = sidecar;
+    result.location = Location::kSidecar;
+    return true;
+  };
+  const auto remove_sidecar = [&] {
+    if (!result.sidecar.empty() && base::DeleteFile(result.sidecar)) {
+      result.sidecar.clear();
+    }
+  };
+
+  switch (task.target) {
+    case Location::kImage: {
+      std::string file;
+      if (!base::ReadFileToStringWithMaxSize(task.path, &file, kMaxImageSize)) {
+        return result;
+      }
+      if (task.keep_original && task.location != Location::kImage) {
+        result.original_file = file;
+      }
+      const std::optional<std::string> embedded =
+          image_editor::EmbedXmp(file, task.container, task.image_xmp);
+      if (!embedded) {
+        // Too much metadata for the format.
+        result.success = write_sidecar();
+        return result;
+      }
+      // Rewrite the file in place, which keeps its extended attributes, such
+      // as the addresses macOS shows under "Where from".
+      if (!base::WriteFile(task.path, *embedded)) {
+        return result;
+      }
+      remove_sidecar();
+      result.location = Location::kImage;
+      result.success = true;
+      return result;
+    }
+    case Location::kSidecar:
+      if (task.location == Location::kImage) {
+        // Only images with Content Credentials move out of the file. Put it
+        // back as it was downloaded.
+        if (result.original_file.empty() ||
+            !base::WriteFile(task.path, result.original_file)) {
+          return result;
+        }
+        result.original_file.clear();
+        result.location = Location::kNowhere;
+      }
+      result.success = write_sidecar();
+      return result;
+    case Location::kNowhere:
+      remove_sidecar();
+      result.location = Location::kNowhere;
+      result.success = result.sidecar.empty();
+      return result;
+  }
+  NOTREACHED();
+}
+
+void Stored(scoped_refptr<SavedImageContext> image,
+            base::OnceCallback<void(bool)> done,
+            StoreResult result) {
+  image->location = result.location;
+  image->sidecar = std::move(result.sidecar);
+  image->original_file = std::move(result.original_file);
+  image->ready = true;
+  std::move(done).Run(result.success);
+}
+
+void ShowMessage(base::WeakPtr<content::WebContents> web_contents,
+                 int message_id) {
+  if (web_contents) {
+    chrome::ShowWarningMessageBoxAsync(
+        web_contents->GetTopLevelNativeWindow(),
+        l10n_util::GetStringUTF16(IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT),
+        l10n_util::GetStringUTF16(message_id));
+  }
+}
+
+void FirstStored(base::WeakPtr<content::WebContents> web_contents,
+                 scoped_refptr<SavedImageContext> image,
+                 bool success) {
+  if (!success) {
+    ShowMessage(web_contents, IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT_FAILED);
+  } else if (image->location == Location::kNowhere) {
+    ShowMessage(web_contents, IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT_UNSUPPORTED);
+  }
+}
+
+void OwnXmpParsed(base::WeakPtr<content::WebContents> web_contents,
+                  scoped_refptr<SavedImageContext> image,
+                  data_decoder::DataDecoder::ValueOrError own_xmp) {
+  // XMP that can't be parsed is left alone, with the context in a sidecar.
+  if (own_xmp.has_value() &&
+      image_editor::AddImageContextToXmp(image->context, &own_xmp.value())) {
+    image->own_xmp = std::move(own_xmp.value());
+  }
+  UpdateSavedImage(image, base::BindOnce(&FirstStored, web_contents, image));
+}
+
+void Downloaded(base::WeakPtr<content::WebContents> web_contents,
+                scoped_refptr<SavedImageContext> image,
+                DownloadedImage downloaded) {
+  if (!downloaded.read) {
+    ShowMessage(web_contents, IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT_FAILED);
+    return;
+  }
+  image->info = std::move(downloaded.info);
+  if (!image->info.xmp) {
+    UpdateSavedImage(image, base::BindOnce(&FirstStored, web_contents, image));
+    return;
+  }
+  // The XMP comes from the web, so it's parsed in a sandboxed process.
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      *image->info.xmp,
+      data_decoder::mojom::XmlParser::WhitespaceBehavior::kPreserveSignificant,
+      base::BindOnce(&OwnXmpParsed, web_contents, image));
+}
+
+// Stores the context once the image is downloaded, then deletes itself.
+class SavedImageWatcher : public download::DownloadItem::Observer {
+ public:
+  static void Watch(download::DownloadItem* item,
+                    base::WeakPtr<content::WebContents> web_contents,
+                    scoped_refptr<SavedImageContext> image) {
+    auto* watcher =
+        new SavedImageWatcher(item, std::move(web_contents), std::move(image));
+    watcher->OnDownloadUpdated(item);
+  }
+
+  SavedImageWatcher(const SavedImageWatcher&) = delete;
+  SavedImageWatcher& operator=(const SavedImageWatcher&) = delete;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    switch (item->GetState()) {
+      case download::DownloadItem::IN_PROGRESS:
+        return;
+      case download::DownloadItem::COMPLETE:
+        image_->path = item->GetTargetFilePath();
+        image_->context.saved_at = base::TimeFormatAsIso8601(base::Time::Now());
+        image_->context.description = Describe(*image_);
+        base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(&InspectDownloadedImage, image_->path),
+            base::BindOnce(&Downloaded, web_contents_, image_));
+        break;
+      default:
+        // The download UI reports failed and cancelled downloads.
+        break;
+    }
+    Stop();
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override { Stop(); }
+
+ private:
+  SavedImageWatcher(download::DownloadItem* item,
+                    base::WeakPtr<content::WebContents> web_contents,
+                    scoped_refptr<SavedImageContext> image)
+      : item_(item),
+        web_contents_(std::move(web_contents)),
+        image_(std::move(image)) {
+    item_->AddObserver(this);
+  }
+  ~SavedImageWatcher() override = default;
+
+  void Stop() {
+    item_->RemoveObserver(this);
+    delete this;
+  }
+
+  const raw_ptr<download::DownloadItem> item_;
+  const base::WeakPtr<content::WebContents> web_contents_;
+  const scoped_refptr<SavedImageContext> image_;
+};
+
+void DownloadStarted(base::WeakPtr<content::WebContents> web_contents,
+                     scoped_refptr<SavedImageContext> image,
+                     download::DownloadItem* item,
+                     download::DownloadInterruptReason reason) {
+  if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+    helium::ClearDownloadTargetPath(image->download_guid);
+    return;
+  }
+  HeliumDownloadOverlay::SetExtraAction(
+      item, kEditIcon, l10n_util::GetStringUTF16(IDS_NEO_CAPTURE_EDIT_METADATA),
+      base::BindRepeating(&ShowImageContextBubble, web_contents, image));
+  SavedImageWatcher::Watch(item, std::move(web_contents), std::move(image));
+}
+
+}  // namespace
+
+SavedImageContext::SavedImageContext() = default;
+SavedImageContext::~SavedImageContext() = default;
+
+void SaveImageWithContext(
+    content::WebContents* web_contents,
+    std::unique_ptr<download::DownloadUrlParameters> params) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  const PrefService* prefs = profile->GetPrefs();
+  base::FilePath directory = prefs->GetFilePath(kSavedImageDirectoryPref);
+  if (directory.empty()) {
+    directory = DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  }
+
+  auto image = base::MakeRefCounted<SavedImageContext>();
+  ImageContext& context = image->context;
+  const GURL& page_url = web_contents->GetLastCommittedURL();
+  context.page_url = AddressForRecord(page_url);
+  context.page_title = base::UTF16ToUTF8(web_contents->GetTitle());
+  if (params->url().SchemeIsHTTPOrHTTPS()) {
+    context.image_url = AddressForRecord(params->url());
+  }
+  context.software =
+      "Helium Neo / Chromium " + std::string(version_info::GetVersionNumber());
+
+  // Name the site as screenshots do, as "Facebook" or "tv2.no".
+  image->site = ScreenshotPlatformName(page_url);
+  if (image->site.empty() && page_url.SchemeIsHTTPOrHTTPS()) {
+    image->site = page_url.host();
+    if (image->site.starts_with("www.")) {
+      image->site.erase(0, 4);
+    }
+  }
+  context.source = image->site.empty() ? context.page_url
+                                       : image->site + " / " + context.page_url;
+  image->language =
+      static_cast<ScreenshotTextLanguage>(GetScreenshotTextLanguage(prefs));
+  image->sidecar_for_other_formats = prefs->GetBoolean(kSavedImageSidecarPref);
+  image->embed_in_signed = prefs->GetBoolean(kSavedImageEmbedInSignedPref);
+
+  image->download_guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  helium::SetDownloadTargetDirectory(image->download_guid, directory);
+  params->set_guid(image->download_guid);
+  params->set_prompt(false);
+  params->set_callback(base::BindOnce(
+      &DownloadStarted, web_contents->GetWeakPtr(), std::move(image)));
+  profile->GetDownloadManager()->DownloadUrl(std::move(params));
+}
+
+void UpdateSavedImage(scoped_refptr<SavedImageContext> image,
+                      base::OnceCallback<void(bool)> done) {
+  const ImageMetadataInfo& info = image->info;
+  StoreTask task = {.path = image->path,
+                    .container = info.container,
+                    .location = image->location,
+                    .sidecar = image->sidecar,
+                    .original_file = image->original_file,
+                    .keep_original = info.has_content_credentials};
+  if (info.container == XmpContainer::kNone) {
+    task.target = image->sidecar_for_other_formats ? Location::kSidecar
+                                                   : Location::kNowhere;
+  } else if (info.unsupported || (info.xmp && !image->own_xmp) ||
+             (info.has_content_credentials && !image->embed_in_signed)) {
+    // Leave files that can't be rewritten safely alone, and keep Content
+    // Credentials intact unless asked not to.
+    task.target = Location::kSidecar;
+  } else {
+    task.target = Location::kImage;
+    task.image_xmp = *image_editor::AddImageContextToXmp(
+        image->context, image->own_xmp ? &*image->own_xmp : nullptr);
+  }
+  // The sidecar holds only the context; the image keeps its own metadata.
+  task.sidecar_xmp =
+      *image_editor::AddImageContextToXmp(image->context, nullptr);
+
+  image->ready = false;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Store, std::move(task)),
+      base::BindOnce(&Stored, std::move(image), std::move(done)));
+}
