+
+using Location = SavedImageContext::Location;
+
+constexpr int kContentWidth = 420;
+
+class ImageContextBubble : public LocationBarBubbleDelegateView,
+                           public ui::SelectFileDialog::Listener {
+  METADATA_HEADER(ImageContextBubble, LocationBarBubbleDelegateView)
+
+ public:
+  ImageContextBubble(views::BubbleAnchor anchor,
+                     content::WebContents* web_contents,
+                     scoped_refptr<SavedImageContext> image)
+      : LocationBarBubbleDelegateView(anchor, nullptr),
+        image_(std::move(image)),
+        web_contents_(web_contents->GetWeakPtr()) {
+    SetTitle(IDS_HELIUM_IMAGE_CONTEXT_TITLE);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+               static_cast<int>(ui::mojom::DialogButton::kCancel));
+    SetButtonLabel(ui::mojom::DialogButton::kOk,
+                   l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_UPDATE));
+    SetAcceptCallbackWithClose(base::BindRepeating(&ImageContextBubble::Update,
+                                                   base::Unretained(this)));
+    set_close_on_deactivate(false);
+    set_fixed_width(kContentWidth + 40);
+  }
+
+  ImageContextBubble(const ImageContextBubble&) = delete;
+  ImageContextBubble& operator=(const ImageContextBubble&) = delete;
+
+  ~ImageContextBubble() override {
+    if (folder_dialog_) {
+      folder_dialog_->ListenerDestroyed();
+    }
+  }
+
+  // Shows the bubble over the top right of the anchor, the browser window in
+  // frameless mode, instead of below a toolbar button that would reveal the
+  // toolbar.
+  void set_overlay(bool overlay) { overlay_ = overlay; }
+
+ private:
+  // LocationBarBubbleDelegateView:
+  gfx::Rect GetBubbleBounds() override {
+    gfx::Rect bounds = LocationBarBubbleDelegateView::GetBubbleBounds();
+    views::View* anchor = GetAnchorView();
+    if (!overlay_ || !anchor) {
+      return bounds;
+    }
+    constexpr int kOverlayInset = 16;
+    const gfx::Rect anchor_bounds = anchor->GetBoundsInScreen();
+    bounds.set_x(anchor_bounds.right() - bounds.width() - kOverlayInset);
+    bounds.set_y(anchor_bounds.y() + kOverlayInset);
+    return bounds;
+  }
+
+  bool ShouldShowCloseButton() const override { return true; }
+
+  void Init() override {
+    set_margins(gfx::Insets(20));
+    SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kStart);
+    const image_editor::ImageMetadataInfo& info = image_->info;
+    const image_editor::ImageXmpSummary own =
+        image_->own_xmp ? image_editor::SummarizeXmp(*image_->own_xmp)
+                        : image_editor::ImageXmpSummary();
+
+    // The image's own metadata, which is never changed.
+    AddHeading(IDS_HELIUM_IMAGE_CONTEXT_OWN_SECTION);
+    bool has_own = false;
+    for (const auto& [message_id, value] :
+         {std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_TITLE, own.title),
+          std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_CREATOR, own.creator),
+          std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_RIGHTS, own.rights),
+          std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_CREDIT, own.credit),
+          std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_SOURCE, own.source),
+          std::pair(IDS_HELIUM_IMAGE_CONTEXT_OWN_DESCRIPTION,
+                    own.description)}) {
+      if (!value.empty()) {
+        has_own = true;
+        AddText(
+            l10n_util::GetStringFUTF16(message_id, base::UTF8ToUTF16(value)),
+            4);
+      }
+    }
+    if (info.xmp && !image_->own_xmp) {
+      AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_UNREADABLE));
+    } else if (!has_own) {
+      AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_OWN_NONE));
+    }
+    if (info.has_content_credentials) {
+      AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_SIGNED));
+    }
+
+    // The context, of which the summary fields can be edited when the image
+    // had none of its own.
+    AddHeading(IDS_HELIUM_IMAGE_CONTEXT_ADDED_SECTION);
+    const image_editor::ImageContext& context = image_->context;
+    AddText(l10n_util::GetStringFUTF16(IDS_HELIUM_IMAGE_CONTEXT_PAGE,
+                                       base::UTF8ToUTF16(context.page_url)),
+            2)
+        ->SetSelectable(true);
+    if (!context.image_url.empty()) {
+      AddText(l10n_util::GetStringFUTF16(IDS_HELIUM_IMAGE_CONTEXT_IMAGE,
+                                         base::UTF8ToUTF16(context.image_url)),
+              2)
+          ->SetSelectable(true);
+    }
+    if (const std::string saved = ScreenshotDisplayDate(context.saved_at);
+        !saved.empty()) {
+      AddText(l10n_util::GetStringFUTF16(IDS_HELIUM_IMAGE_CONTEXT_SAVED,
+                                         base::UTF8ToUTF16(saved)));
+    }
+    if (own.source.empty()) {
+      source_ = AddField(IDS_HELIUM_IMAGE_CONTEXT_SOURCE_FIELD,
+                         std::make_unique<views::Textfield>(), 32);
+      source_->SetText(base::UTF8ToUTF16(context.source));
+    }
+    if (own.description.empty()) {
+      description_ = AddField(IDS_HELIUM_IMAGE_CONTEXT_DESCRIPTION_FIELD,
+                              std::make_unique<views::Textarea>(), 120);
+      description_->SetText(base::UTF8ToUTF16(context.description));
+    }
+    if (!own.source.empty() || !own.description.empty()) {
+      AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_KEPT));
+    }
+    switch (image_->location) {
+      case Location::kImage:
+        AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_IN_IMAGE));
+        break;
+      case Location::kSidecar:
+        AddText(l10n_util::GetStringFUTF16(
+            IDS_HELIUM_IMAGE_CONTEXT_IN_SIDECAR,
+            image_->sidecar.BaseName().LossyDisplayName()));
+        break;
+      case Location::kNowhere:
+        AddText(l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_NOWHERE));
+        break;
+    }
+
+    // Choices for this image, remembered for the next ones.
+    AddHeading(IDS_HELIUM_IMAGE_CONTEXT_OPTIONS_SECTION);
+    if (info.container == image_editor::XmpContainer::kNone) {
+      sidecar_ = AddCheckbox(IDS_HELIUM_IMAGE_CONTEXT_SIDECAR_OPTION,
+                             image_->sidecar_for_other_formats);
+    }
+    if (info.has_content_credentials) {
+      embed_in_signed_ = AddCheckbox(IDS_HELIUM_IMAGE_CONTEXT_EMBED_OPTION,
+                                     image_->embed_in_signed);
+    }
+    folder_label_ = AddText(std::u16string());
+    folder_label_->SetSelectable(true);
+    UpdateFolderLabel();
+    AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&ImageContextBubble::ChooseFolder,
+                            base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_CHANGE_FOLDER)));
+    status_ = AddText(std::u16string());
+    status_->SetVisible(false);
+  }
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override {
+    folder_dialog_ = nullptr;
+    if (PrefService* prefs = GetPrefs()) {
+      prefs->SetFilePath(kSavedImageDirectoryPref, file.path());
+    }
+    UpdateFolderLabel();
+    SizeToContents();
+  }
+
+  void FileSelectionCanceled() override { folder_dialog_ = nullptr; }
+
+  views::Label* AddText(const std::u16string& text, int max_lines = 0) {
+    auto* label = AddChildView(std::make_unique<views::Label>(text));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetMultiLine(true);
+    label->SetMaxLines(max_lines);
+    label->SetMaximumWidth(kContentWidth);
+    return label;
+  }
+
+  void AddHeading(int message_id) {
+    AddText(l10n_util::GetStringUTF16(message_id))
+        ->SetTextStyle(views::style::STYLE_EMPHASIZED);
+  }
+
+  views::Textfield* AddField(int message_id,
+                             std::unique_ptr<views::Textfield> field,
+                             int height) {
+    const std::u16string label = l10n_util::GetStringUTF16(message_id);
+    AddText(label);
+    field->GetViewAccessibility().SetName(label);
+    field->SetPreferredSize(gfx::Size(kContentWidth, height));
+    return AddChildView(std::move(field));
+  }
+
+  views::Checkbox* AddCheckbox(int message_id, bool checked) {
+    auto* checkbox = AddChildView(std::make_unique<views::Checkbox>(
+        l10n_util::GetStringUTF16(message_id)));
+    checkbox->SetMultiLine(true);
+    checkbox->SetMaxSize(gfx::Size(kContentWidth, 0));
+    checkbox->SetChecked(checked);
+    return checkbox;
+  }
+
+  PrefService* GetPrefs() {
+    return web_contents_
+               ? Profile::FromBrowserContext(web_contents_->GetBrowserContext())
+                     ->GetPrefs()
+               : nullptr;
+  }
+
+  void UpdateFolderLabel() {
+    PrefService* prefs = GetPrefs();
+    if (!prefs) {
+      return;
+    }
+    base::FilePath folder = prefs->GetFilePath(kSavedImageDirectoryPref);
+    if (folder.empty()) {
+      folder =
+          DownloadPrefs::FromBrowserContext(web_contents_->GetBrowserContext())
+              ->DownloadPath();
+    }
+    folder_label_->SetText(l10n_util::GetStringFUTF16(
+        IDS_HELIUM_IMAGE_CONTEXT_FOLDER, folder.LossyDisplayName()));
+  }
+
+  void ChooseFolder() {
+    PrefService* prefs = GetPrefs();
+    if (!prefs || folder_dialog_) {
+      return;
+    }
+    folder_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(web_contents_.get()));
+    folder_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_FOLDER,
+        l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_CHANGE_FOLDER),
+        prefs->GetFilePath(kSavedImageDirectoryPref), nullptr, 0,
+        base::FilePath::StringType(), web_contents_->GetTopLevelNativeWindow());
+  }
+
+  // Stores the edited context, closing the bubble once it's done.
+  bool Update() {
+    if (!image_->ready) {
+      return false;
+    }
+    if (source_) {
+      image_->context.source = base::UTF16ToUTF8(source_->GetText());
+    }
+    if (description_) {
+      image_->context.description = base::UTF16ToUTF8(description_->GetText());
+    }
+    PrefService* prefs = GetPrefs();
+    if (sidecar_) {
+      image_->sidecar_for_other_formats = sidecar_->GetChecked();
+      if (prefs) {
+        prefs->SetBoolean(kSavedImageSidecarPref, sidecar_->GetChecked());
+      }
+    }
+    if (embed_in_signed_) {
+      image_->embed_in_signed = embed_in_signed_->GetChecked();
+      if (prefs) {
+        prefs->SetBoolean(kSavedImageEmbedInSignedPref,
+                          embed_in_signed_->GetChecked());
+      }
+    }
+    SetButtonEnabled(ui::mojom::DialogButton::kOk, false);
+    status_->SetVisible(false);
+    UpdateSavedImage(image_, base::BindOnce(&ImageContextBubble::Updated,
+                                            weak_factory_.GetWeakPtr()));
+    return false;
+  }
+
+  void Updated(bool success) {
+    if (!success) {
+      SetButtonEnabled(ui::mojom::DialogButton::kOk, true);
+      status_->SetText(
+          l10n_util::GetStringUTF16(IDS_HELIUM_IMAGE_CONTEXT_UPDATE_FAILED));
+      status_->SetVisible(true);
+      SizeToContents();
+      return;
+    }
+    // Offer the updated file again, from the overlay it first showed in.
+    if (download::DownloadItem* item = GetDownload()) {
+      if (BrowserWindowInterface* browser =
+              GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+                  web_contents_.get())) {
+        if (BrowserView* browser_view =
+                BrowserView::GetBrowserViewForBrowser(browser)) {
+          HeliumDownloadOverlay::Show(browser_view, item);
+        }
+      }
+    }
+    GetWidget()->Close();
+  }
+
+  download::DownloadItem* GetDownload() {
+    if (!web_contents_) {
+      return nullptr;
+    }
+    download::DownloadItem* item =
+        web_contents_->GetBrowserContext()
+            ->GetDownloadManager()
+            ->GetDownloadByGuid(image_->download_guid);
+    return item && item->GetState() == download::DownloadItem::COMPLETE &&
+                   !item->GetFileExternallyRemoved()
+               ? item
+               : nullptr;
+  }
+
+  const scoped_refptr<SavedImageContext> image_;
+  const base::WeakPtr<content::WebContents> web_contents_;
+  bool overlay_ = false;
+  raw_ptr<views::Textfield> source_ = nullptr;
+  raw_ptr<views::Textfield> description_ = nullptr;
+  raw_ptr<views::Checkbox> sidecar_ = nullptr;
+  raw_ptr<views::Checkbox> embed_in_signed_ = nullptr;
+  raw_ptr<views::Label> folder_label_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  scoped_refptr<ui::SelectFileDialog> folder_dialog_;
+  base::WeakPtrFactory<ImageContextBubble> weak_factory_{this};
+};
