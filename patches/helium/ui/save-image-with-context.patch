+using image_editor::ImageContext;
+using image_editor::ImageMetadataInfo;
+using image_editor::XmpContainer;
+
+constexpr size_t kMaxImageSize = 256 * 1024 * 1024;
+
+struct Options {
+  // Whether images that can't hold metadata get a sidecar file.
+  bool sidecar_for_other_formats = false;
+  // Whether to add the context to images with Content Credentials.
+  bool embed_in_signed = false;
+  // The language of the description, as for screenshots.
+  ScreenshotTextLanguage language = ScreenshotTextLanguage::kEnglish;
+  // The platform or host the image was saved from, if any.
+  std::string site;
+};
+
+enum class Outcome { kEmbedded, kSidecar, kNoMetadata, kFailed };
+
+struct SavedImage {
+  bool read = false;
+  std::string file;
+  ImageMetadataInfo info;
+};
+
+// Leaves out user names and passwords.
+std::string AddressForRecord(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  GURL::Replacements replacements;
+  replacements.ClearUsername();
+  replacements.ClearPassword();
+  return url.ReplaceComponents(replacements).spec();
+}
+
+// A readable summary first, then the record, as screenshots have.
+std::string Describe(const ImageContext& context, const Options& options) {
+  const bool norwegian = options.language == ScreenshotTextLanguage::kNorwegian;
+  std::string description;
+  const std::string saved = ScreenshotDisplayDate(context.saved_at);
+  if (!saved.empty()) {
+    description += (norwegian ? "Lagret: " : "Saved: ") + saved + "\n";
+  }
+  if (!options.site.empty()) {
+    description += options.site + "\n";
+  }
+  if (!description.empty()) {
+    description += "\n";
+  }
+  description += "HELIUM NEO — SAVED IMAGE SOURCE RECORD\n\n";
+  const auto field = [&](std::string_view label, const std::string& value) {
+    description += std::string(label) + ": " +
+                   (value.empty() ? "Not supplied" : value) + "\n\n";
+  };
+  field("Page URL (observed)", context.page_url);
+  field("Page title (observed)", context.page_title);
+  field("Image URL (observed)", context.image_url);
+  field("Saved (UTC, computer clock)", context.saved_at);
+  return description;
+}
+
+SavedImage ReadImage(const base::FilePath& path) {
+  SavedImage image;
+  image.read =
+      base::ReadFileToStringWithMaxSize(path, &image.file, kMaxImageSize);
+  if (image.read) {
+    image.info = image_editor::InspectImageMetadata(image.file);
+  }
+  return image;
+}
+
+// Writes `xmp` to an XMP file next to `image`, named as photo apps look for it,
+// without replacing another file.
+Outcome WriteSidecar(const base::FilePath& image, const std::string& xmp) {
+  base::FilePath sidecar = image.ReplaceExtension(FILE_PATH_LITERAL("xmp"));
+  if (base::PathExists(sidecar)) {
+    sidecar = image.AddExtension(FILE_PATH_LITERAL("xmp"));
+  }
+  if (base::PathExists(sidecar)) {
+    return Outcome::kFailed;
+  }
+  return base::WriteFile(sidecar, xmp) ? Outcome::kSidecar : Outcome::kFailed;
+}
+
+Outcome EmbedInImage(const base::FilePath& path,
+                     const std::string& file,
+                     XmpContainer container,
+                     const std::string& xmp) {
+  const std::optional<std::string> embedded =
+      image_editor::EmbedXmp(file, container, xmp);
+  if (!embedded) {
+    return WriteSidecar(path, xmp);
+  }
+  // Rewrite the file in place, which keeps its extended attributes, such as
+  // the addresses macOS shows under "Where from".
+  return base::WriteFile(path, *embedded) ? Outcome::kEmbedded
+                                          : Outcome::kFailed;
+}
+
+void ShowOutcome(base::WeakPtr<content::WebContents> web_contents,
+                 Outcome outcome) {
+  if (outcome == Outcome::kEmbedded || outcome == Outcome::kSidecar ||
+      !web_contents) {
+    return;
+  }
+  chrome::ShowWarningMessageBoxAsync(
+      web_contents->GetTopLevelNativeWindow(),
+      l10n_util::GetStringUTF16(IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT),
+      l10n_util::GetStringUTF16(
+          outcome == Outcome::kNoMetadata
+              ? IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT_UNSUPPORTED
+              : IDS_HELIUM_SAVE_IMAGE_WITH_CONTEXT_FAILED));
+}
+
+void RunAndShowOutcome(base::WeakPtr<content::WebContents> web_contents,
+                       base::OnceCallback<Outcome()> task) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      std::move(task), base::BindOnce(&ShowOutcome, std::move(web_contents)));
+}
+
+void WriteContextSidecar(base::WeakPtr<content::WebContents> web_contents,
+                         const base::FilePath& path,
+                         const ImageContext& context) {
+  // The sidecar holds only the context; the image keeps its own metadata.
+  RunAndShowOutcome(
+      std::move(web_contents),
+      base::BindOnce(&WriteSidecar, path,
+                     *image_editor::AddImageContextToXmp(context, nullptr)));
+}
+
+void ExistingXmpParsed(base::WeakPtr<content::WebContents> web_contents,
+                       const base::FilePath& path,
+                       const ImageContext& context,
+                       std::string file,
+                       XmpContainer container,
+                       data_decoder::DataDecoder::ValueOrError existing) {
+  const std::optional<std::string> xmp =
+      existing.has_value()
+          ? image_editor::AddImageContextToXmp(context, &existing.value())
+          : std::nullopt;
+  if (!xmp) {
+    // The image's metadata can't be read, so leave the file as it is.
+    WriteContextSidecar(std::move(web_contents), path, context);
+    return;
+  }
+  RunAndShowOutcome(
+      std::move(web_contents),
+      base::BindOnce(&EmbedInImage, path, std::move(file), container, *xmp));
+}
+
+void ImageRead(base::WeakPtr<content::WebContents> web_contents,
+               const base::FilePath& path,
+               const ImageContext& context,
+               Options options,
+               SavedImage image) {
+  if (!image.read) {
+    ShowOutcome(std::move(web_contents), Outcome::kFailed);
+    return;
+  }
+  const ImageMetadataInfo& info = image.info;
+  if (info.container == XmpContainer::kNone) {
+    if (options.sidecar_for_other_formats) {
+      WriteContextSidecar(std::move(web_contents), path, context);
+    } else {
+      ShowOutcome(std::move(web_contents), Outcome::kNoMetadata);
+    }
+    return;
+  }
+  // Keep Content Credentials intact unless asked not to, and leave files that
+  // can't be rewritten safely alone.
+  if (info.unsupported ||
+      (info.has_content_credentials && !options.embed_in_signed)) {
+    WriteContextSidecar(std::move(web_contents), path, context);
+    return;
+  }
+  if (!info.xmp) {
+    RunAndShowOutcome(
+        std::move(web_contents),
+        base::BindOnce(&EmbedInImage, path, std::move(image.file),
+                       info.container,
+                       *image_editor::AddImageContextToXmp(context, nullptr)));
+    return;
+  }
+  // The XMP comes from the web, so it's parsed in a sandboxed process.
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      *info.xmp,
+      data_decoder::mojom::XmlParser::WhitespaceBehavior::kPreserveSignificant,
+      base::BindOnce(&ExistingXmpParsed, std::move(web_contents), path, context,
+                     std::move(image.file), info.container));
+}
+
+// Adds the context once the image is downloaded, then deletes itself.
+class SavedImageWatcher : public download::DownloadItem::Observer {
+ public:
+  static void Watch(download::DownloadItem* item,
+                    base::WeakPtr<content::WebContents> web_contents,
+                    ImageContext context,
+                    Options options) {
+    auto* watcher = new SavedImageWatcher(item, std::move(web_contents),
+                                          std::move(context), options);
+    watcher->OnDownloadUpdated(item);
+  }
+
+  SavedImageWatcher(const SavedImageWatcher&) = delete;
+  SavedImageWatcher& operator=(const SavedImageWatcher&) = delete;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    switch (item->GetState()) {
+      case download::DownloadItem::IN_PROGRESS:
+        return;
+      case download::DownloadItem::COMPLETE:
+        context_.saved_at = base::TimeFormatAsIso8601(base::Time::Now());
+        context_.description = Describe(context_, options_);
+        base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(&ReadImage, item->GetTargetFilePath()),
+            base::BindOnce(&ImageRead, web_contents_, item->GetTargetFilePath(),
+                           std::move(context_), options_));
+        break;
+      default:
+        // The download UI reports failed and cancelled downloads.
+        break;
+    }
+    Stop();
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override { Stop(); }
+
+ private:
+  SavedImageWatcher(download::DownloadItem* item,
+                    base::WeakPtr<content::WebContents> web_contents,
+                    ImageContext context,
+                    Options options)
+      : item_(item),
+        web_contents_(std::move(web_contents)),
+        context_(std::move(context)),
+        options_(options) {
+    item_->AddObserver(this);
+  }
+  ~SavedImageWatcher() override = default;
+
+  void Stop() {
+    item_->RemoveObserver(this);
+    delete this;
+  }
+
+  const raw_ptr<download::DownloadItem> item_;
+  const base::WeakPtr<content::WebContents> web_contents_;
+  ImageContext context_;
+  const Options options_;
+};
+
+void DownloadStarted(base::WeakPtr<content::WebContents> web_contents,
+                     ImageContext context,
+                     Options options,
+                     const std::string& guid,
+                     download::DownloadItem* item,
+                     download::DownloadInterruptReason reason) {
+  if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+    helium::ClearDownloadTargetPath(guid);
+    return;
+  }
+  SavedImageWatcher::Watch(item, std::move(web_contents), std::move(context),
+                           options);
+}
+
+}  // namespace
+
+void SaveImageWithContext(
+    content::WebContents* web_contents,
+    std::unique_ptr<download::DownloadUrlParameters> params) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  const PrefService* prefs = profile->GetPrefs();
+  base::FilePath directory = prefs->GetFilePath(kSavedImageDirectoryPref);
+  if (directory.empty()) {
+    directory = DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  }
+
+  ImageContext context;
+  context.page_url = AddressForRecord(web_contents->GetLastCommittedURL());
+  context.page_title = base::UTF16ToUTF8(web_contents->GetTitle());
+  if (params->url().SchemeIsHTTPOrHTTPS()) {
+    context.image_url = AddressForRecord(params->url());
+  }
+  context.software =
+      "Helium Neo / Chromium " + std::string(version_info::GetVersionNumber());
+
+  // Name the site as screenshots do, as "Facebook" or "tv2.no".
+  const GURL& page_url = web_contents->GetLastCommittedURL();
+  std::string site = ScreenshotPlatformName(page_url);
+  if (site.empty() && page_url.SchemeIsHTTPOrHTTPS()) {
+    site = page_url.host();
+    if (site.starts_with("www.")) {
+      site.erase(0, 4);
+    }
+  }
+  context.source =
+      site.empty() ? context.page_url : site + " / " + context.page_url;
+  const Options options = {
+      .sidecar_for_other_formats = prefs->GetBoolean(kSavedImageSidecarPref),
+      .embed_in_signed = prefs->GetBoolean(kSavedImageEmbedInSignedPref),
+      .language =
+          static_cast<ScreenshotTextLanguage>(GetScreenshotTextLanguage(prefs)),
+      .site = std::move(site)};
+
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  helium::SetDownloadTargetDirectory(guid, directory);
+  params->set_guid(guid);
+  params->set_prompt(false);
+  params->set_callback(base::BindOnce(&DownloadStarted,
+                                      web_contents->GetWeakPtr(),
+                                      std::move(context), options, guid));
+  profile->GetDownloadManager()->DownloadUrl(std::move(params));
+}
