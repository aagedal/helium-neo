+// An image saved with its context, which the metadata panel edits.
+struct SavedImageContext : public base::RefCounted<SavedImageContext> {
+  enum class Location { kNowhere, kImage, kSidecar };
+
+  SavedImageContext();
+  SavedImageContext(const SavedImageContext&) = delete;
+  SavedImageContext& operator=(const SavedImageContext&) = delete;
+
+  base::FilePath path;
+  std::string download_guid;
+  image_editor::ImageContext context;
+  image_editor::ImageMetadataInfo info;
+  // The image's own XMP, parsed, if it has XMP that could be read.
+  std::optional<base::Value> own_xmp;
+  // The platform or host the image was saved from, if any.
+  std::string site;
+  ScreenshotTextLanguage language = ScreenshotTextLanguage::kEnglish;
+  // Whether images that can't hold metadata get a sidecar file.
+  bool sidecar_for_other_formats = false;
+  // Whether to add the context to images with Content Credentials.
+  bool embed_in_signed = false;
+
+  // Where the context is stored.
+  Location location = Location::kNowhere;
+  // The sidecar file Helium wrote, if any.
+  base::FilePath sidecar;
+  // The file as downloaded, kept while the context is in an image with
+  // Content Credentials, so that they can be restored.
+  std::string original_file;
+  // Whether the image has been processed and isn't being updated.
+  bool ready = false;
+
+ private:
+  friend class base::RefCounted<SavedImageContext>;
+  ~SavedImageContext();
+};
+
+// Downloads the image `params` points to into the folder for saved images,
+// without asking where, then records the page it was saved from and its own
+// address in its XMP metadata. The image's own metadata is kept. Images whose
+// format can't hold metadata, or whose Content Credentials it would break, get
+// it in an XMP sidecar file instead, as the preferences say. The download
+// overlay then offers to edit it.
+void SaveImageWithContext(
+    content::WebContents* web_contents,
+    std::unique_ptr<download::DownloadUrlParameters> params);
+
+// Stores the context of `image` where its options say, replacing what was
+// stored before, then runs `done` with whether that succeeded.
+void UpdateSavedImage(scoped_refptr<SavedImageContext> image,
+                      base::OnceCallback<void(bool)> done);
+
+}  // namespace sharing_hub
