+TEST_F(ImageContextMetadataParserTest, KeepsEverythingInRealXmp) {
+  // As Photoshop writes it, with padding, a credit given as an attribute and
+  // an edit history.
+  const std::string original =
+      "<?xpacket begin=\"\xEF\xBB\xBF\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>\n"
+      "<x:xmpmeta xmlns:x=\"adobe:ns:meta/\" x:xmptk=\"Adobe XMP Core 9.1\">\n"
+      " <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n"
+      "  <rdf:Description rdf:about=\"\"\n"
+      "    xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n"
+      "    xmlns:photoshop=\"http://ns.adobe.com/photoshop/1.0/\"\n"
+      "    xmlns:xmpMM=\"http://ns.adobe.com/xap/1.0/mm/\"\n"
+      "    xmlns:stEvt=\"http://ns.adobe.com/xap/1.0/sType/ResourceEvent#\"\n"
+      "    photoshop:Credit=\"Agency &amp; Co\">\n"
+      "   <dc:title><rdf:Alt><rdf:li xml:lang=\"x-default\">Harbour at "
+      "dawn</rdf:li></rdf:Alt></dc:title>\n"
+      "   <dc:creator><rdf:Seq><rdf:li>A "
+      "Photographer</rdf:li></rdf:Seq></dc:creator>\n"
+      "   <dc:rights><rdf:Alt><rdf:li xml:lang=\"x-default\">\xC2\xA9 2026 A "
+      "Photographer</rdf:li></rdf:Alt></dc:rights>\n"
+      "   <xmpMM:History>\n"
+      "    <rdf:Seq>\n"
+      "     <rdf:li rdf:parseType=\"Resource\">\n"
+      "      <stEvt:action>saved</stEvt:action>\n"
+      "      <stEvt:when>2026-01-02T03:04:05+01:00</stEvt:when>\n"
+      "     </rdf:li>\n"
+      "    </rdf:Seq>\n"
+      "   </xmpMM:History>\n"
+      "  </rdf:Description>\n"
+      " </rdf:RDF>\n"
+      "</x:xmpmeta>\n" +
+      std::string(200, ' ') + "\n<?xpacket end=\"w\"?>";
+  std::optional<base::Value> parsed = Parse(original);
+  ASSERT_TRUE(parsed);
+  const std::optional<std::string> merged =
+      AddImageContextToXmp(Context(), &*parsed);
+  ASSERT_TRUE(merged);
+  std::optional<base::Value> reparsed = Parse(*merged);
+  ASSERT_TRUE(reparsed);
+  RemoveWhitespace(*parsed);
+  RemoveWhitespace(*reparsed);
+
+  // The image's description gains one history event and nothing else.
+  base::ListValue& rdf = Children(*reparsed, {0});
+  ASSERT_EQ(2u, rdf.size());
+  base::ListValue& history = Children(*reparsed, {0, 0, 3, 0});
+  ASSERT_EQ(2u, history.size());
+  const base::Value added = history[1].Clone();
+  history.erase(history.begin() + 1);
+  EXPECT_EQ(Children(*parsed, {0}).front(), rdf.front());
+  EXPECT_EQ(*parsed->GetDict().FindDict("attributes"),
+            *reparsed->GetDict().FindDict("attributes"));
+  EXPECT_EQ("rdf:li", *added.GetDict().FindString("tag"));
+
+  // The source, description and saved image record go in a new description,
+  // as the credit, title, creator and rights stay untouched.
+  const base::ListValue& description = Children(*reparsed, {0, 1});
+  ASSERT_EQ(4u, description.size());
+  EXPECT_EQ("dc:source", *description[0].GetDict().FindString("tag"));
+  EXPECT_EQ("dc:description", *description[1].GetDict().FindString("tag"));
+  EXPECT_EQ("photoshop:Source", *description[2].GetDict().FindString("tag"));
+  EXPECT_EQ("helium:SavedFrom", *description[3].GetDict().FindString("tag"));
+}
