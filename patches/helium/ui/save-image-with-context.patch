+// Directories set with helium::SetDownloadTargetDirectory(), by download GUID.
+base::flat_map<std::string, base::FilePath>& HeliumTargetDirectories() {
+  static base::NoDestructor<base::flat_map<std::string, base::FilePath>>
+      directories;
+  return *directories;
+}
+
+std::optional<base::FilePath> TakeHeliumTargetDirectory(
+    const std::string& guid) {
+  auto it = HeliumTargetDirectories().find(guid);
+  if (it == HeliumTargetDirectories().end()) {
+    return std::nullopt;
+  }
+  base::FilePath directory = std::move(it->second);
+  HeliumTargetDirectories().erase(it);
+  return directory;
+}
