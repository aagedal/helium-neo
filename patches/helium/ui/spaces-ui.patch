+  auto label = std::make_unique<views::Label>();
+  label->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  label->SetElideBehavior(gfx::ELIDE_TAIL);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetFontList(label->font_list()
+                         .DeriveWithSizeDelta(-1)
+                         .DeriveWithWeight(gfx::Font::Weight::MEDIUM));
+  label->SetEnabledColor(kColorTabForegroundActiveFrameActive);
+  active_space_label_ = expanded_container->AddChildView(std::move(label));
+
+  auto dots_row = std::make_unique<views::View>();
+  auto* box = dots_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      /*between_child_spacing=*/4));
+  box->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kCenter);
+  box->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  dots_row_ = expanded_container->AddChildView(std::move(dots_row));
+
+  expanded_container_ = AddChildView(std::move(expanded_container));
+
+  auto collapsed_wrapper = std::make_unique<views::View>();
+  auto* collapsed_box = collapsed_wrapper->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal));
+  collapsed_box->set_main_axis_alignment(
+      views::BoxLayout::MainAxisAlignment::kCenter);
+  collapsed_box->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  auto menu_button = std::make_unique<HeliumSpacesMenuButton>(browser_);
+  menu_button->SetOnMenuWillShowCallback(base::BindRepeating(
+      &HeliumSpacesSwitcherView::OnMenuWillShow, base::Unretained(this)));
+  menu_button->SetOnMenuClosedCallback(base::BindRepeating(
+      &HeliumSpacesSwitcherView::OnMenuClosed, base::Unretained(this)));
+  collapsed_button_ = collapsed_wrapper->AddChildView(std::move(menu_button));
+  AddChildView(std::move(collapsed_wrapper));
+
+  if (auto* ctrl =
+          helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+    spaces_state_subscription_ = ctrl->RegisterOnStateChanged(
+        base::BindRepeating(
+            [](HeliumSpacesSwitcherView* view,
+               helium_spaces::HeliumWindowSpacesController*) {
+              view->RebuildDots();
+            },
+            base::Unretained(this)));
+  }
+
+  OnCollapseStateChanged(state_controller_->GetCollapseState());
+  collapse_subscription_ = state_controller_->RegisterOnCollapseChanged(
+      base::BindRepeating(&HeliumSpacesSwitcherView::OnCollapseStateChanged,
+                          base::Unretained(this)));
+  RebuildDots();
+}
+
+HeliumSpacesSwitcherView::~HeliumSpacesSwitcherView() = default;
+
+gfx::Size HeliumSpacesSwitcherView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, collapsed_ ? kCollapsedHeight : kExpandedHeight);
+}
+
+gfx::Size HeliumSpacesSwitcherView::GetMinimumSize() const {
+  return CalculatePreferredSize({});
+}
+
+bool HeliumSpacesSwitcherView::IsPositionInWindowCaption(
+    const gfx::Point& point) const {
+  if (collapsed_) {
+    if (collapsed_button_ && collapsed_button_->GetVisible()) {
+      gfx::Point pt = point;
+      views::View::ConvertPointToTarget(this, collapsed_button_, &pt);
+      if (collapsed_button_->HitTestPoint(pt)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  if (dots_row_ && dots_row_->GetVisible()) {
+    for (views::View* child : dots_row_->children()) {
+      if (!child->GetVisible()) {
+        continue;
+      }
+      gfx::Point pt = point;
+      views::View::ConvertPointToTarget(this, child, &pt);
+      if (child->HitTestPoint(pt)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+void HeliumSpacesSwitcherView::ShowContextMenuForSpace(
+    views::View* source,
+    const std::string& space_id,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (!browser_ || !source || !source->GetWidget()) {
+    return;
+  }
+
+  OnMenuWillShow();
+  context_menu_model_ =
+      std::make_unique<HeliumSpaceContextMenuModel>(browser_, space_id);
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU,
+      base::BindRepeating(&HeliumSpacesSwitcherView::OnMenuClosed,
+                          base::Unretained(this)));
+  context_menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                                  gfx::Rect(point, gfx::Size()),
+                                  views::MenuAnchorPosition::kTopLeft,
+                                  source_type);
+}
+
+void HeliumSpacesSwitcherView::OnCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  collapsed_ = state != tabs::VerticalTabStripCollapseState::kExpanded;
+  expanded_container_->SetVisible(!collapsed_);
+  collapsed_button_->parent()->SetVisible(collapsed_);
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
+
+void HeliumSpacesSwitcherView::RebuildDots() {
+  dots_row_->RemoveAllChildViews();
+  std::u16string active_name;
+
+  if (browser_) {
+    if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+            browser_->GetProfile())) {
+      const std::string active_id = helium_spaces::GetActiveSpaceId(browser_);
+      const auto& spaces = service->spaces();
+      for (size_t i = 0; i < spaces.size(); ++i) {
+        const helium_spaces::Space& space = spaces[i];
+        const bool is_active = space.id == active_id;
+        if (is_active) {
+          active_name = space.name;
+        }
+        dots_row_->AddChildView(std::make_unique<SpaceCircleButton>(
+            this, browser_, space.id, space.name,
+            GetHeliumSpaceIcon(space.icon, i), is_active));
+      }
+    }
+    dots_row_->AddChildView(std::make_unique<AddSpaceButton>(browser_));
+  }
+
+  active_space_label_->SetText(active_name);
+  active_space_label_->SetTooltipText(active_name);
+  dots_row_->InvalidateLayout();
+  expanded_container_->InvalidateLayout();
+  InvalidateLayout();
+}
+
+void HeliumSpacesSwitcherView::OnMenuWillShow() {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (browser_view && browser_view->tab_strip_view()) {
+    expand_on_hover_lock_ =
+        browser_view->tab_strip_view()->GetExpandOnHoverLock(
+            ExpandOnHoverLockType::kKeepCurrentState);
+  }
+}
+
+void HeliumSpacesSwitcherView::OnMenuClosed() {
+  expand_on_hover_lock_.reset();
+}
