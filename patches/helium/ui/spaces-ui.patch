+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+
+namespace {
+
+constexpr HeliumSpaceIconOption kSpaceIcons[] = {
+    {"home", u"Home", &kHomeIcon},
+    {"work", u"Work", &kHomeRepairServiceIcon},
+    {"explore", u"Explore", &kExploreIcon},
+    {"star", u"Star", &kStarIcon},
+    {"rocket", u"Launch", &kRocketLaunchIcon},
+    {"globe", u"Web", &kGlobeIcon},
+    {"book", u"Reading", &kMenuBookIcon},
+    {"grid", u"Projects", &kGridViewIcon},
+    {"bolt", u"Focus", &kBoltIcon},
+    {"notes", u"Notes", &kNotesIcon},
+    {"music", u"Media", &kQueueMusicIcon},
+    {"schedule", u"Schedule", &kScheduleIcon},
+};
+
+class SpaceIconSubMenuModel : public ui::SimpleMenuModel,
+                              public ui::SimpleMenuModel::Delegate {
+ public:
+  SpaceIconSubMenuModel(BrowserWindowInterface* browser,
+                        std::string space_id,
+                        std::string current_icon_id,
+                        size_t fallback_index)
+      : ui::SimpleMenuModel(this),
+        browser_(browser),
+        space_id_(std::move(space_id)),
+        current_icon_id_(std::move(current_icon_id)),
+        fallback_index_(fallback_index) {
+    const auto options = GetHeliumSpaceIconOptions();
+    for (size_t i = 0; i < options.size(); ++i) {
+      const int cmd_id = kFirstIconCommandId + static_cast<int>(i);
+      AddCheckItem(cmd_id, options[i].label);
+      SetIconForCommandId(
+          cmd_id, ui::ImageModel::FromVectorIcon(*options[i].icon,
+                                                 ui::kColorMenuIcon, 16));
+    }
+  }
+  SpaceIconSubMenuModel(const SpaceIconSubMenuModel&) = delete;
+  SpaceIconSubMenuModel& operator=(const SpaceIconSubMenuModel&) = delete;
+  ~SpaceIconSubMenuModel() override = default;
+
+  bool IsCommandIdChecked(int command_id) const override {
+    const auto options = GetHeliumSpaceIconOptions();
+    const size_t idx = static_cast<size_t>(command_id - kFirstIconCommandId);
+    if (idx >= options.size()) {
+      return false;
+    }
+    if (!current_icon_id_.empty()) {
+      return current_icon_id_ == options[idx].id;
+    }
+    return idx == (fallback_index_ % options.size());
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (!browser_) {
+      return;
+    }
+    const auto options = GetHeliumSpaceIconOptions();
+    const size_t idx = static_cast<size_t>(command_id - kFirstIconCommandId);
+    if (idx >= options.size()) {
+      return;
+    }
+    if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+            browser_->GetProfile())) {
+      service->SetSpaceIcon(space_id_, options[idx].id);
+    }
+  }
+
+ private:
+  static constexpr int kFirstIconCommandId = 200;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::string space_id_;
+  std::string current_icon_id_;
+  size_t fallback_index_;
+};
+
+}  // namespace
+
+base::span<const HeliumSpaceIconOption> GetHeliumSpaceIconOptions() {
+  return kSpaceIcons;
+}
+
+const gfx::VectorIcon& GetHeliumSpaceIcon(const std::string& icon_id,
+                                          size_t fallback_index) {
+  const auto options = GetHeliumSpaceIconOptions();
+  if (!icon_id.empty()) {
+    for (const auto& option : options) {
+      if (icon_id == option.id) {
+        return *option.icon;
+      }
+    }
+  }
+  return *options[fallback_index % options.size()].icon;
+}
+
+HeliumSpacesMenuModel::HeliumSpacesMenuModel(BrowserWindowInterface* browser)
+    : ui::SimpleMenuModel(this), browser_(browser) {
+  if (!browser_) {
+    return;
+  }
+
+  active_space_id_ = helium_spaces::GetActiveSpaceId(browser_);
+  if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+          browser_->GetProfile())) {
+    int cmd_id = kFirstSpaceCommandId;
+    for (const helium_spaces::Space& space : service->spaces()) {
+      space_ids_.push_back(space.id);
+      AddCheckItem(cmd_id++, space.name);
+    }
+  }
+
+  if (!space_ids_.empty()) {
+    AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  AddItemWithStringId(IDC_HELIUM_NEW_SPACE, IDS_HELIUM_NEW_SPACE);
+  AddItemWithStringId(IDC_HELIUM_RENAME_SPACE, IDS_HELIUM_RENAME_SPACE);
+  AddItemWithStringId(IDC_HELIUM_DELETE_SPACE, IDS_HELIUM_DELETE_SPACE);
+}
+
+HeliumSpacesMenuModel::~HeliumSpacesMenuModel() = default;
+
+std::optional<size_t> HeliumSpacesMenuModel::GetSpaceIndexForCommand(
+    int command_id) const {
+  if (command_id < kFirstSpaceCommandId) {
+    return std::nullopt;
+  }
+  const size_t idx = static_cast<size_t>(command_id - kFirstSpaceCommandId);
+  if (idx >= space_ids_.size()) {
+    return std::nullopt;
+  }
+  return idx;
+}
+
+bool HeliumSpacesMenuModel::IsCommandIdChecked(int command_id) const {
+  const std::optional<size_t> idx = GetSpaceIndexForCommand(command_id);
+  return idx.has_value() && space_ids_[*idx] == active_space_id_;
+}
+
+bool HeliumSpacesMenuModel::IsCommandIdEnabled(int command_id) const {
+  if (!browser_) {
+    return false;
+  }
+  if (command_id == IDC_HELIUM_DELETE_SPACE) {
+    auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+        browser_->GetProfile());
+    return service && service->CanDeleteSpace(active_space_id_);
+  }
+  return true;
+}
+
+bool HeliumSpacesMenuModel::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator* accelerator) const {
+  if (!browser_) {
+    return false;
+  }
+  int mapped_command = command_id;
+  if (const std::optional<size_t> idx = GetSpaceIndexForCommand(command_id)) {
+    if (*idx >= 9) {
+      return false;
+    }
+    mapped_command = IDC_HELIUM_SWITCH_SPACE_1 + static_cast<int>(*idx);
+  }
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser_);
+  if (!window || !window->GetAcceleratorProvider()) {
+    return false;
+  }
+  return window->GetAcceleratorProvider()->GetAcceleratorForCommandId(
+      mapped_command, accelerator);
+}
+
+void HeliumSpacesMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  if (!browser_) {
+    return;
+  }
+  switch (command_id) {
+    case IDC_HELIUM_NEW_SPACE:
+      chrome::CreateNewSpace(browser_);
+      return;
+    case IDC_HELIUM_RENAME_SPACE:
+      chrome::RenameCurrentSpace(browser_);
+      return;
+    case IDC_HELIUM_DELETE_SPACE:
+      chrome::DeleteCurrentSpace(browser_);
+      return;
+    default:
+      break;
+  }
+
+  if (const std::optional<size_t> idx = GetSpaceIndexForCommand(command_id)) {
+    if (auto* ctrl =
+            helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+      ctrl->SwitchToSpace(space_ids_[*idx]);
+    }
+  }
+}
+
+HeliumSpaceContextMenuModel::HeliumSpaceContextMenuModel(
+    BrowserWindowInterface* browser,
+    std::string space_id)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      space_id_(std::move(space_id)) {
+  AddItemWithStringId(kRename, IDS_HELIUM_RENAME_SPACE);
+  if (browser_) {
+    if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+            browser_->GetProfile())) {
+      const helium_spaces::Space* space = service->FindSpace(space_id_);
+      const std::optional<size_t> idx = service->GetSpaceIndex(space_id_);
+      icon_submenu_ = std::make_unique<SpaceIconSubMenuModel>(
+          browser_, space_id_, space ? space->icon : std::string(),
+          idx.value_or(0));
+      AddSubMenuWithStringId(kChangeIcon, IDS_HELIUM_SPACE_CHANGE_ICON,
+                             icon_submenu_.get());
+    }
+  }
+  AddItemWithStringId(kMoveLeft, IDS_HELIUM_SPACE_MOVE_LEFT);
+  AddItemWithStringId(kMoveRight, IDS_HELIUM_SPACE_MOVE_RIGHT);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+  AddItemWithStringId(kDelete, IDS_HELIUM_SPACE_DELETE);
+}
+
+HeliumSpaceContextMenuModel::~HeliumSpaceContextMenuModel() = default;
+
+bool HeliumSpaceContextMenuModel::IsCommandIdEnabled(int command_id) const {
+  if (!browser_) {
+    return false;
+  }
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return false;
+  }
+  const std::optional<size_t> idx = service->GetSpaceIndex(space_id_);
+  if (!idx.has_value()) {
+    return false;
+  }
+  switch (command_id) {
+    case kRename:
+    case kChangeIcon:
+      return true;
+    case kMoveLeft:
+      return *idx > 0;
+    case kMoveRight:
+      return *idx + 1 < service->spaces().size();
+    case kDelete:
+      return service->CanDeleteSpace(space_id_);
+    default:
+      return false;
+  }
+}
+
+void HeliumSpaceContextMenuModel::ExecuteCommand(int command_id,
+                                                 int event_flags) {
+  if (!browser_) {
+    return;
+  }
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  const std::optional<size_t> idx = service->GetSpaceIndex(space_id_);
+  if (!idx.has_value()) {
+    return;
+  }
+  switch (command_id) {
+    case kRename:
+      helium_spaces::PromptToRenameSpace(browser_, space_id_);
+      break;
+    case kMoveLeft:
+      if (*idx > 0) {
+        service->ReorderSpace(space_id_, *idx - 1);
+      }
+      break;
+    case kMoveRight:
+      if (*idx + 1 < service->spaces().size()) {
+        service->ReorderSpace(space_id_, *idx + 1);
+      }
+      break;
+    case kDelete:
+      helium_spaces::PromptToDeleteSpace(browser_, space_id_);
+      break;
+    default:
+      break;
+  }
+}
