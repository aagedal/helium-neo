+class SpaceDotButton : public views::Button,
+                       public views::ContextMenuController {
+  METADATA_HEADER(SpaceDotButton, views::Button)
+
+ public:
+  SpaceDotButton(HeliumSpacesSwitcherView* owner,
+                 BrowserWindowInterface* browser,
+                 std::string space_id,
+                 const std::u16string& name,
+                 bool is_active)
+      : views::Button(base::BindRepeating(&SpaceDotButton::OnPressed,
+                                          base::Unretained(this))),
+        owner_(owner),
+        browser_(browser),
+        space_id_(std::move(space_id)),
+        is_active_(is_active) {
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    set_context_menu_controller(this);
+
+    views::InkDrop::Install(this, std::make_unique<views::InkDropHost>(this));
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kButtonCornerRadius);
+    ConfigureToolbarInkdropForRefresh2023(
+        this, kColorTabBackgroundInactiveHoverFrameActive,
+        kColorTabBackgroundActiveFrameActive);
+  }
+  SpaceDotButton(const SpaceDotButton&) = delete;
+  SpaceDotButton& operator=(const SpaceDotButton&) = delete;
+  ~SpaceDotButton() override = default;
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kDotButtonSize, kDotButtonSize);
+  }
+
+  void OnThemeChanged() override {
+    views::Button::OnThemeChanged();
+    ConfigureToolbarInkdropForRefresh2023(
+        this, kColorTabBackgroundInactiveHoverFrameActive,
+        kColorTabBackgroundActiveFrameActive);
+    SchedulePaint();
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    SchedulePaint();
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+
+    const bool window_active =
+        !GetWidget() || GetWidget()->ShouldPaintAsActive();
+    const SkColor base_color = color_provider->GetColor(
+        window_active ? kColorTabForegroundActiveFrameActive
+                      : kColorTabForegroundActiveFrameInactive);
+
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    const float radius = is_active_ ? 3.5f : (hovered ? 3.0f : 2.6f);
+    const uint8_t alpha = is_active_ ? 0xF0 : (hovered ? 0xB8 : 0x60);
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(SkColorSetA(base_color, alpha));
+    canvas->DrawCircle(gfx::PointF(GetLocalBounds().CenterPoint()), radius,
+                       flags);
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    owner_->ShowContextMenuForSpace(source, space_id_, point, source_type);
+  }
+
+ private:
+  void OnPressed() {
+    if (auto* ctrl =
+            helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+      ctrl->SwitchToSpace(space_id_);
+    }
+  }
+
+  raw_ptr<HeliumSpacesSwitcherView> owner_;
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::string space_id_;
+  bool is_active_;
+};
