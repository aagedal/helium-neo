+class SpaceCircleButton : public views::Button,
+                          public views::ContextMenuController {
+  METADATA_HEADER(SpaceCircleButton, views::Button)
+
+ public:
+  SpaceCircleButton(HeliumSpacesSwitcherView* owner,
+                    BrowserWindowInterface* browser,
+                    std::string space_id,
+                    const std::u16string& name,
+                    const gfx::VectorIcon& icon,
+                    bool is_active)
+      : views::Button(base::BindRepeating(&SpaceCircleButton::OnPressed,
+                                          base::Unretained(this))),
+        owner_(owner),
+        browser_(browser),
+        space_id_(std::move(space_id)),
+        icon_(icon),
+        is_active_(is_active) {
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    set_context_menu_controller(this);
+
+    views::InkDrop::Install(this, std::make_unique<views::InkDropHost>(this));
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCircleCornerRadius);
+    ConfigureToolbarInkdropForRefresh2023(
+        this, kColorTabBackgroundInactiveHoverFrameActive,
+        kColorTabBackgroundActiveFrameActive);
+  }
+  SpaceCircleButton(const SpaceCircleButton&) = delete;
+  SpaceCircleButton& operator=(const SpaceCircleButton&) = delete;
+  ~SpaceCircleButton() override = default;
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kCircleButtonSize, kCircleButtonSize);
+  }
+
+  void OnThemeChanged() override {
+    views::Button::OnThemeChanged();
+    ConfigureToolbarInkdropForRefresh2023(
+        this, kColorTabBackgroundInactiveHoverFrameActive,
+        kColorTabBackgroundActiveFrameActive);
+    SchedulePaint();
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    SchedulePaint();
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+
+    const bool window_active =
+        !GetWidget() || GetWidget()->ShouldPaintAsActive();
+    const SkColor base_color = color_provider->GetColor(
+        window_active ? kColorTabForegroundActiveFrameActive
+                      : kColorTabForegroundActiveFrameInactive);
+
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    const gfx::Rect bounds = GetLocalBounds();
+    const gfx::PointF center(bounds.CenterPoint());
+
+    if (is_active_) {
+      cc::PaintFlags fill_flags;
+      fill_flags.setAntiAlias(true);
+      fill_flags.setStyle(cc::PaintFlags::kFill_Style);
+      fill_flags.setColor(SkColorSetA(base_color, 0x24));
+      canvas->DrawCircle(center, kCircleCornerRadius - 0.5f, fill_flags);
+
+      cc::PaintFlags ring_flags;
+      ring_flags.setAntiAlias(true);
+      ring_flags.setStyle(cc::PaintFlags::kStroke_Style);
+      ring_flags.setStrokeWidth(1.0f);
+      ring_flags.setColor(SkColorSetA(base_color, 0x52));
+      canvas->DrawCircle(center, kCircleCornerRadius - 1.0f, ring_flags);
+    }
+
+    const int icon_size = is_active_ ? kActiveIconSize : kInactiveIconSize;
+    const uint8_t icon_alpha = is_active_ ? 0xFF : (hovered ? 0xCC : 0x73);
+    const SkColor icon_color = SkColorSetA(base_color, icon_alpha);
+
+    canvas->Save();
+    canvas->Translate(gfx::Vector2d((bounds.width() - icon_size) / 2,
+                                    (bounds.height() - icon_size) / 2));
+    gfx::PaintVectorIcon(canvas, *icon_, icon_size, icon_color);
+    canvas->Restore();
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    owner_->ShowContextMenuForSpace(source, space_id_, point, source_type);
+  }
+
+ private:
+  void OnPressed() {
+    if (auto* ctrl =
+            helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+      ctrl->SwitchToSpace(space_id_);
+    }
+  }
+
+  raw_ptr<HeliumSpacesSwitcherView> owner_;
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::string space_id_;
+  raw_ref<const gfx::VectorIcon> icon_;
+  bool is_active_;
+};
