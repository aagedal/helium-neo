+
+class BrowserWindowInterface;
+
+// Synchronizes the dynamic list of Spaces at the bottom of the macOS main
+// menu bar's "Spaces" menu with the active browser window.
+class HeliumSpacesMenuBridge {
+ public:
+  explicit HeliumSpacesMenuBridge(NSMenuItem* menu_item);
+  HeliumSpacesMenuBridge(const HeliumSpacesMenuBridge&) = delete;
+  HeliumSpacesMenuBridge& operator=(const HeliumSpacesMenuBridge&) = delete;
+  ~HeliumSpacesMenuBridge();
+
+  // Updates the active browser window that commands in this menu target.
+  // Passing nullptr clears the dynamic Space items.
+  void SetBrowser(BrowserWindowInterface* browser);
+
+ private:
+  NSMutableArray* DynamicMenuItems();
+  void RebuildMenu();
+  void OnDynamicItemChosen(NSMenuItem* item);
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  NSMenuItem* __weak menu_item_;
+  HeliumSpacesMenuListener* __strong menu_listener_;
+  std::map<NSMenuItem*, std::string> item_to_space_id_;
