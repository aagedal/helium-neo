+
+void PinnedTabContainerView::OnPaint(gfx::Canvas* canvas) {
+  TabCollectionZOrderManager::OnPaint(canvas);
+
+  if (orientation_ != TabStripOrientation::kVertical || !collection_node_) {
+    return;
+  }
+
+  int global_bottom = -1;
+  int space_top = std::numeric_limits<int>::max();
+  for (const views::View* child : collection_node_->GetDirectChildren()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    if (IsPinnedChildGlobal(child)) {
+      global_bottom = std::max(global_bottom, child->bounds().bottom());
+    } else {
+      space_top = std::min(space_top, child->bounds().y());
+    }
+  }
+
+  if (global_bottom < 0 || space_top == std::numeric_limits<int>::max() ||
+      space_top <= global_bottom + kTabPadding) {
+    return;
+  }
+
+  const auto* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+
+  const gfx::Insets insets = GetInsets();
+  const int line_left = insets.left() + 4;
+  const int line_right = width() - insets.right() - 4;
+  if (line_right <= line_left) {
+    return;
+  }
+
+  const int divider_y = (global_bottom + space_top) / 2;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(false);
+  flags.setColor(color_provider->GetColor(kColorToolbarContentAreaSeparator));
+  canvas->DrawRect(gfx::Rect(line_left, divider_y, line_right - line_left, 1),
+                   flags);
+}
