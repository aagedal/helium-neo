+
+#include "chrome/browser/ui/views/tabs/shared/helium_spaces_menu_model.h"
+
+#include <utility>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/helium_spaces_service.h"
+#include "chrome/browser/ui/tabs/helium_spaces_service_factory.h"
+#include "chrome/browser/ui/tabs/helium_spaces_util.h"
+#include "chrome/browser/ui/tabs/helium_window_spaces_controller.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/accelerators/accelerator.h"
+
+HeliumSpacesMenuModel::HeliumSpacesMenuModel(BrowserWindowInterface* browser)
+    : ui::SimpleMenuModel(this), browser_(browser) {
+  if (!browser_) {
+    return;
+  }
+
+  active_space_id_ = helium_spaces::GetActiveSpaceId(browser_);
+  if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+          browser_->GetProfile())) {
+    int cmd_id = kFirstSpaceCommandId;
+    for (const helium_spaces::Space& space : service->spaces()) {
+      space_ids_.push_back(space.id);
+      AddCheckItem(cmd_id++, space.name);
+    }
+  }
+
+  if (!space_ids_.empty()) {
+    AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  AddItemWithStringId(IDC_HELIUM_NEW_SPACE, IDS_HELIUM_NEW_SPACE);
+  AddItemWithStringId(IDC_HELIUM_RENAME_SPACE, IDS_HELIUM_RENAME_SPACE);
+  AddItemWithStringId(IDC_HELIUM_DELETE_SPACE, IDS_HELIUM_DELETE_SPACE);
+}
+
+HeliumSpacesMenuModel::~HeliumSpacesMenuModel() = default;
+
+bool HeliumSpacesMenuModel::IsCommandIdChecked(int command_id) const {
+  if (command_id < kFirstSpaceCommandId) {
+    return false;
+  }
+  const size_t idx = static_cast<size_t>(command_id - kFirstSpaceCommandId);
+  return idx < space_ids_.size() && space_ids_[idx] == active_space_id_;
+}
+
+bool HeliumSpacesMenuModel::IsCommandIdEnabled(int command_id) const {
+  if (!browser_) {
+    return false;
+  }
+  if (command_id == IDC_HELIUM_DELETE_SPACE) {
+    auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+        browser_->GetProfile());
+    return service && service->CanDeleteSpace(active_space_id_);
+  }
+  return true;
+}
+
+bool HeliumSpacesMenuModel::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator* accelerator) const {
+  if (!browser_) {
+    return false;
+  }
+  int mapped_command = command_id;
+  if (command_id >= kFirstSpaceCommandId) {
+    const size_t idx = static_cast<size_t>(command_id - kFirstSpaceCommandId);
+    if (idx >= 9) {
+      return false;
+    }
+    mapped_command = IDC_HELIUM_SWITCH_SPACE_1 + static_cast<int>(idx);
+  }
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser_);
+  if (!window || !window->GetAcceleratorProvider()) {
+    return false;
+  }
+  return window->GetAcceleratorProvider()->GetAcceleratorForCommandId(
+      mapped_command, accelerator);
+}
+
+void HeliumSpacesMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  if (!browser_) {
+    return;
+  }
+  if (command_id >= kFirstSpaceCommandId) {
+    const size_t idx = static_cast<size_t>(command_id - kFirstSpaceCommandId);
+    if (idx < space_ids_.size()) {
+      if (auto* ctrl =
+              helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+        ctrl->SwitchToSpace(space_ids_[idx]);
+      }
+    }
+    return;
+  }
+
+  switch (command_id) {
+    case IDC_HELIUM_NEW_SPACE:
+      chrome::CreateNewSpace(browser_);
+      break;
+    case IDC_HELIUM_RENAME_SPACE:
+      chrome::RenameCurrentSpace(browser_);
+      break;
+    case IDC_HELIUM_DELETE_SPACE:
+      chrome::DeleteCurrentSpace(browser_);
+      break;
+    default:
+      break;
+  }
+}
+
+HeliumSpaceContextMenuModel::HeliumSpaceContextMenuModel(
+    BrowserWindowInterface* browser,
+    std::string space_id)
+    : ui::SimpleMenuModel(this),
+      browser_(browser),
+      space_id_(std::move(space_id)) {
+  AddItemWithStringId(kRename, IDS_HELIUM_RENAME_SPACE);
+  AddItemWithStringId(kMoveLeft, IDS_HELIUM_SPACE_MOVE_LEFT);
+  AddItemWithStringId(kMoveRight, IDS_HELIUM_SPACE_MOVE_RIGHT);
+  AddSeparator(ui::NORMAL_SEPARATOR);
+  AddItemWithStringId(kDelete, IDS_HELIUM_SPACE_DELETE);
+}
+
+HeliumSpaceContextMenuModel::~HeliumSpaceContextMenuModel() = default;
+
+bool HeliumSpaceContextMenuModel::IsCommandIdEnabled(int command_id) const {
+  if (!browser_) {
+    return false;
+  }
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return false;
+  }
+  const std::optional<size_t> idx = service->GetSpaceIndex(space_id_);
+  if (!idx.has_value()) {
+    return false;
+  }
+  switch (command_id) {
+    case kRename:
+      return true;
+    case kMoveLeft:
+      return *idx > 0;
+    case kMoveRight:
+      return *idx + 1 < service->spaces().size();
+    case kDelete:
+      return service->CanDeleteSpace(space_id_);
+    default:
+      return false;
+  }
+}
+
+void HeliumSpaceContextMenuModel::ExecuteCommand(int command_id,
+                                                 int event_flags) {
+  if (!browser_) {
+    return;
+  }
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  const std::optional<size_t> idx = service->GetSpaceIndex(space_id_);
+  if (!idx.has_value()) {
+    return;
+  }
+  switch (command_id) {
+    case kRename:
+      helium_spaces::PromptToRenameSpace(browser_, space_id_);
+      break;
+    case kMoveLeft:
+      if (*idx > 0) {
+        service->ReorderSpace(space_id_, *idx - 1);
+      }
+      break;
+    case kMoveRight:
+      if (*idx + 1 < service->spaces().size()) {
+        service->ReorderSpace(space_id_, *idx + 1);
+      }
+      break;
+    case kDelete:
+      helium_spaces::PromptToDeleteSpace(browser_, space_id_);
+      break;
+    default:
+      break;
+  }
+}
