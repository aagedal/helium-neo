+namespace {
+constexpr int kButtonSize = 28;
+constexpr float kCornerRadius = 8.0f;
+}  // namespace
+
+HeliumSpacesMenuButton::HeliumSpacesMenuButton(BrowserWindowInterface* browser)
+    : views::Button(
+          base::BindRepeating(&HeliumSpacesMenuButton::OnButtonPressed,
+                              base::Unretained(this))),
+      browser_(browser) {
+  SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_SPACES_BUTTON_ACCNAME));
+
+  views::InkDrop::Install(this, std::make_unique<views::InkDropHost>(this));
+  views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                kCornerRadius);
+  ConfigureToolbarInkdropForRefresh2023(
+      this, kColorTabBackgroundInactiveHoverFrameActive,
+      kColorTabBackgroundActiveFrameActive);
+
+  if (auto* ctrl =
+          helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+    spaces_state_subscription_ = ctrl->RegisterOnStateChanged(
+        base::BindRepeating(
+            [](HeliumSpacesMenuButton* button,
+               helium_spaces::HeliumWindowSpacesController*) {
+              button->UpdateFromSpacesState();
+            },
+            base::Unretained(this)));
+  }
+
+  UpdateFromSpacesState();
+}
+
+HeliumSpacesMenuButton::~HeliumSpacesMenuButton() = default;
+
+void HeliumSpacesMenuButton::SetOnMenuWillShowCallback(
+    base::RepeatingClosure callback) {
+  on_menu_will_show_ = std::move(callback);
+}
+
+void HeliumSpacesMenuButton::SetOnMenuClosedCallback(
+    base::RepeatingClosure callback) {
+  on_menu_closed_ = std::move(callback);
+}
+
+gfx::Size HeliumSpacesMenuButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kButtonSize, kButtonSize);
+}
+
+void HeliumSpacesMenuButton::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  ConfigureToolbarInkdropForRefresh2023(
+      this, kColorTabBackgroundInactiveHoverFrameActive,
+      kColorTabBackgroundActiveFrameActive);
+  SchedulePaint();
+}
+
+void HeliumSpacesMenuButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+
+  const bool window_active =
+      !GetWidget() || GetWidget()->ShouldPaintAsActive();
+  const SkColor base_color = color_provider->GetColor(
+      window_active ? kColorTabForegroundActiveFrameActive
+                    : kColorTabForegroundActiveFrameInactive);
+
+  const gfx::Rect bounds = GetContentsBounds();
+  const float center_y = bounds.CenterPoint().y();
+
+  // Show up to 3 dots horizontally. When there is only 1 Space, render a
+  // subtle 3-dot menu icon; when there are multiple Spaces, highlight the
+  // dot corresponding to the active Space.
+  const size_t dot_count =
+      space_count_ <= 1 ? 3u : std::min<size_t>(space_count_, 3u);
+  size_t highlighted_slot = 0;
+  if (space_count_ > 1) {
+    if (space_count_ <= 3) {
+      highlighted_slot = active_index_;
+    } else if (active_index_ == 0) {
+      highlighted_slot = 0;
+    } else if (active_index_ + 1 >= space_count_) {
+      highlighted_slot = 2;
+    } else {
+      highlighted_slot = 1;
+    }
+  }
+
+  constexpr float kDotSpacing = 6.0f;
+  const float total_width = (dot_count - 1) * kDotSpacing;
+  const float start_x = bounds.CenterPoint().x() - total_width / 2.0f;
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+
+  for (size_t i = 0; i < dot_count; ++i) {
+    const bool is_active = space_count_ > 1 && i == highlighted_slot;
+    const float radius = is_active ? 2.6f : 1.9f;
+    const uint8_t alpha = is_active ? 0xEE : (space_count_ <= 1 ? 0x99 : 0x66);
+    flags.setColor(SkColorSetA(base_color, alpha));
+    canvas->DrawCircle(gfx::PointF(start_x + i * kDotSpacing, center_y), radius,
+                       flags);
+  }
+}
+
+void HeliumSpacesMenuButton::OnButtonPressed(const ui::Event& event) {
+  if (!browser_ || !GetWidget()) {
+    return;
+  }
+
+  if (on_menu_will_show_) {
+    on_menu_will_show_.Run();
+  }
+
+  menu_model_ = std::make_unique<HeliumSpacesMenuModel>(browser_);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::COMBOBOX,
+      base::BindRepeating(&HeliumSpacesMenuButton::OnMenuClosed,
+                          base::Unretained(this)));
+
+  const ui::mojom::MenuSourceType source_type =
+      event.IsKeyEvent() ? ui::mojom::MenuSourceType::kKeyboard
+                         : ui::mojom::MenuSourceType::kMouse;
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void HeliumSpacesMenuButton::OnMenuClosed() {
+  if (on_menu_closed_) {
+    on_menu_closed_.Run();
+  }
+}
+
+void HeliumSpacesMenuButton::UpdateFromSpacesState() {
+  space_count_ = 1;
+  active_index_ = 0;
+  std::u16string active_name;
+
+  if (browser_) {
+    if (auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+            browser_->GetProfile())) {
+      const std::string active_id = helium_spaces::GetActiveSpaceId(browser_);
+      space_count_ = std::max<size_t>(1u, service->spaces().size());
+      if (const std::optional<size_t> idx = service->GetSpaceIndex(active_id)) {
+        active_index_ = *idx;
+      }
+      if (const helium_spaces::Space* space = service->FindSpace(active_id)) {
+        active_name = space->name;
+      }
+    }
+  }
+
+  if (!active_name.empty()) {
+    SetTooltipText(l10n_util::GetStringFUTF16(IDS_HELIUM_SPACES_BUTTON_TOOLTIP,
+                                              active_name));
+  } else {
+    SetTooltipText(l10n_util::GetStringUTF16(IDS_HELIUM_SPACES_BUTTON_ACCNAME));
+  }
+  SchedulePaint();
+}
+
+BEGIN_METADATA(HeliumSpacesMenuButton)
+END_METADATA
