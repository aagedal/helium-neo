+void PromptToRenameSpace(BrowserWindowInterface* browser,
+                         const std::string& space_id) {
+  if (!browser) {
+    return;
+  }
+  HeliumSpacesService* const service =
+      HeliumSpacesServiceFactory::GetForProfile(browser->GetProfile());
+  const Space* const space = service ? service->FindSpace(space_id) : nullptr;
+  if (!space) {
+    return;
+  }
+
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* const dialog_model = builder.model();
+  auto dialog =
+      builder
+          .SetTitle(
+              l10n_util::GetStringUTF16(IDS_HELIUM_RENAME_SPACE_DIALOG_TITLE))
+          .AddTextfield(
+              kRenameSpaceTextfieldId,
+              l10n_util::GetStringUTF16(IDS_HELIUM_RENAME_SPACE_LABEL),
+              space->name)
+          .SetInitiallyFocusedField(kRenameSpaceTextfieldId)
+          .AddOkButton(
+              base::BindOnce(
+                  [](base::WeakPtr<BrowserWindowInterface> weak_browser,
+                     std::string target_id, ui::DialogModel* model) {
+                    if (!weak_browser || !model) {
+                      return;
+                    }
+                    ui::DialogModelTextfield* textfield =
+                        model->GetTextfieldByUniqueId(kRenameSpaceTextfieldId);
+                    if (!textfield) {
+                      return;
+                    }
+                    if (HeliumSpacesService* svc =
+                            HeliumSpacesServiceFactory::GetForProfile(
+                                weak_browser->GetProfile())) {
+                      svc->RenameSpace(target_id, textfield->text());
+                    }
+                  },
+                  browser->GetWeakPtr(), space_id,
+                  base::Unretained(dialog_model)),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringUTF16(
+                      IDS_HELIUM_RENAME_SPACE_CONFIRM_BUTTON)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+
   chrome::ShowBrowserModal(browser, std::move(dialog));
 }
 
