+HeliumSpacesMenuButton::HeliumSpacesMenuButton(BrowserWindowInterface* browser)
+    : views::Button(
+          base::BindRepeating(&HeliumSpacesMenuButton::OnButtonPressed,
+                              base::Unretained(this))),
+      browser_(browser) {
+  SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_SPACES_BUTTON_ACCNAME));
+
+  views::InkDrop::Install(this, std::make_unique<views::InkDropHost>(this));
+  views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                kCornerRadius);
+  ConfigureToolbarInkdropForRefresh2023(
+      this, kColorTabBackgroundInactiveHoverFrameActive,
+      kColorTabBackgroundActiveFrameActive);
+
+  if (auto* ctrl =
+          helium_spaces::HeliumWindowSpacesController::From(browser_)) {
+    spaces_state_subscription_ = ctrl->RegisterOnStateChanged(
+        base::BindRepeating(
+            [](HeliumSpacesMenuButton* button,
+               helium_spaces::HeliumWindowSpacesController*) {
+              button->UpdateFromSpacesState();
+            },
+            base::Unretained(this)));
+  }
+
+  UpdateFromSpacesState();
+}
+
+HeliumSpacesMenuButton::~HeliumSpacesMenuButton() = default;
