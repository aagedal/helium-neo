+
+#include "chrome/browser/ui/cocoa/helium_spaces_menu_bridge.h"
+
+#import <Cocoa/Cocoa.h>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/helium_spaces_service.h"
+#include "chrome/browser/ui/tabs/helium_spaces_service_factory.h"
+#include "chrome/browser/ui/tabs/helium_spaces_util.h"
+#include "chrome/browser/ui/tabs/helium_window_spaces_controller.h"
+#include "ui/gfx/mac/menu_text_elider_mac.h"
+
+namespace {
+
+void RemoveMenuItems(NSArray* menu_items) {
+  NSMenu* menu = [[menu_items firstObject] menu];
+  for (NSMenuItem* item in menu_items) {
+    [menu removeItem:item];
+  }
+}
+
+}  // namespace
+
+@interface HeliumSpacesMenuListener : NSObject <NSMenuDelegate>
+- (instancetype)initWithSelectCallback:
+                    (base::RepeatingCallback<void(NSMenuItem*)>)selectCallback
+                       rebuildCallback:
+                           (base::RepeatingClosure)rebuildCallback;
+- (IBAction)selectSpace:(id)sender;
+@end
+
+@implementation HeliumSpacesMenuListener {
+  base::RepeatingCallback<void(NSMenuItem*)> _selectCallback;
+  base::RepeatingClosure _rebuildCallback;
+}
+
+- (instancetype)initWithSelectCallback:
+                    (base::RepeatingCallback<void(NSMenuItem*)>)selectCallback
+                       rebuildCallback:
+                           (base::RepeatingClosure)rebuildCallback {
+  if ((self = [super init])) {
+    _selectCallback = std::move(selectCallback);
+    _rebuildCallback = std::move(rebuildCallback);
+  }
+  return self;
+}
+
+- (void)menuNeedsUpdate:(NSMenu*)menu {
+  _rebuildCallback.Run();
+}
+
+- (IBAction)selectSpace:(id)sender {
+  _selectCallback.Run(sender);
+}
+@end
+
+HeliumSpacesMenuBridge::HeliumSpacesMenuBridge(NSMenuItem* menu_item)
+    : menu_item_(menu_item) {
+  menu_listener_ = [[HeliumSpacesMenuListener alloc]
+      initWithSelectCallback:base::BindRepeating(
+                                 &HeliumSpacesMenuBridge::OnDynamicItemChosen,
+                                 base::Unretained(this))
+             rebuildCallback:base::BindRepeating(
+                                 &HeliumSpacesMenuBridge::RebuildMenu,
+                                 base::Unretained(this))];
+  [menu_item_.submenu setDelegate:menu_listener_];
+}
+
+HeliumSpacesMenuBridge::~HeliumSpacesMenuBridge() {
+  [menu_item_.submenu setDelegate:nil];
+  RemoveMenuItems(DynamicMenuItems());
+}
+
+void HeliumSpacesMenuBridge::SetBrowser(BrowserWindowInterface* browser) {
+  browser_ = browser ? browser->GetWeakPtr() : nullptr;
+  RebuildMenu();
+}
+
+NSMutableArray* HeliumSpacesMenuBridge::DynamicMenuItems() {
+  NSMenu* menu = menu_item_.submenu;
+  NSMutableArray* array =
+      [[NSMutableArray alloc] initWithCapacity:[menu numberOfItems]];
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.target == menu_listener_) {
+      [array addObject:item];
+    }
+  }
+  return array;
+}
+
+void HeliumSpacesMenuBridge::RebuildMenu() {
+  RemoveMenuItems(DynamicMenuItems());
+  item_to_space_id_.clear();
+
+  if (!browser_ || !helium_spaces::HasSpaces(browser_.get())) {
+    return;
+  }
+
+  auto* service = helium_spaces::HeliumSpacesServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+
+  NSMenu* menu = menu_item_.submenu;
+  if (!menu) {
+    return;
+  }
+
+  const std::string active_space_id =
+      helium_spaces::GetActiveSpaceId(browser_.get());
+  const auto& spaces = service->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    const helium_spaces::Space& space = spaces[i];
+    NSString* title =
+        base::SysUTF16ToNSString(gfx::ElideMenuItemTitle(space.name));
+    NSString* key_equivalent =
+        i < 9 ? [NSString stringWithFormat:@"%zu", i + 1] : @"";
+    NSMenuItem* item = [[NSMenuItem alloc] initWithTitle:title
+                                                  action:@selector(selectSpace:)
+                                           keyEquivalent:key_equivalent];
+    if (i < 9) {
+      item.keyEquivalentModifierMask =
+          NSEventModifierFlagControl | NSEventModifierFlagOption;
+    }
+    item.target = menu_listener_;
+    item.state = (space.id == active_space_id) ? NSControlStateValueOn
+                                               : NSControlStateValueOff;
+    item_to_space_id_[item] = space.id;
+    [menu addItem:item];
+  }
+}
+
+void HeliumSpacesMenuBridge::OnDynamicItemChosen(NSMenuItem* item) {
+  if (!browser_) {
+    return;
+  }
+  auto it = item_to_space_id_.find(item);
+  if (it == item_to_space_id_.end()) {
+    return;
+  }
+  if (auto* ctrl =
+          helium_spaces::HeliumWindowSpacesController::From(browser_.get())) {
+    ctrl->SwitchToSpace(it->second);
+  }
+}
