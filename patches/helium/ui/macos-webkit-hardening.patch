+// logins instead of handing them to a later profile at the same path, which
+// the old path-derived identifier did.
+constexpr base::FilePath::CharType kStoreIdFile[] =
+    FILE_PATH_LITERAL("Helium WebKit Store");
+
+struct StoreId {
+  std::string id;
+  bool created = false;
+};
+
+bool ReadStoreId(const base::FilePath& file, std::string* id) {
+  if (!base::ReadFileToStringWithMaxSize(file, id, 64))
+    return false;
+  *id = std::string(base::TrimWhitespaceASCII(*id, base::TRIM_ALL));
+  return base::Uuid::ParseCaseInsensitive(*id).is_valid();
+}
+
+// Blocking.
+StoreId LoadOrCreateStoreId(const base::FilePath& profile_path) {
+  const base::FilePath file = profile_path.Append(kStoreIdFile);
+  StoreId result;
+  if (ReadStoreId(file, &result.id))
+    return result;
+  result.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  result.created = true;
+  // FLAG_CREATE fails if another task created the file first; use that one.
+  base::File out(file, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+  if (!out.IsValid()) {
+    std::string existing;
+    if (ReadStoreId(file, &existing))
+      return {existing, false};
+    out = base::File(file,
+                     base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+  }
+  if (!out.IsValid() || !out.WriteAtCurrentPosAndCheck(
+                            base::as_byte_span(result.id))) {
+    LOG(WARNING) << "Could not save the WebKit store identifier";
+  }
+  return result;
+}
