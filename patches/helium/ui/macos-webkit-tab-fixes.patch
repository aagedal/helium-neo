+  // The tab shows the WebKit site's icon. Chromium's blank page underneath
+  // downloads and decodes it in its sandboxed renderer, as it does for its own
+  // favicons, and it is shown on that page's entry.
+  void UpdateFavicon(content::NavigationEntry& entry) {
+    const GURL page = url();
+    if (!IsWebKitPageURL(page))
+      return;
+    const GURL icon = page.GetWithEmptyPath().Resolve("/favicon.ico");
+    if (icon != favicon_url_) {
+      favicon_url_ = icon;
+      favicon_ = gfx::Image();
+      web_contents()->DownloadImage(
+          icon, /*is_favicon=*/true, /*preferred_size=*/gfx::Size(),
+          /*max_bitmap_size=*/64, /*bypass_cache=*/false,
+          base::BindOnce(&StreamingTab::FaviconDownloaded,
+                         activation_factory_.GetWeakPtr()));
+    }
+    if (!favicon_.IsEmpty()) {
+      entry.GetFavicon().valid = true;
+      entry.GetFavicon().url = favicon_url_;
+      entry.GetFavicon().image = favicon_;
+    }
+  }
+  void FaviconDownloaded(int id,
+                         int http_status_code,
+                         const GURL& image_url,
+                         const std::vector<SkBitmap>& bitmaps,
+                         const std::vector<gfx::Size>& sizes) {
+    if (image_url != favicon_url_ || bitmaps.empty())
+      return;
+    // The smallest bitmap that is sharp at 2x, else the largest one.
+    const SkBitmap* best = nullptr;
+    for (const SkBitmap& bitmap : bitmaps) {
+      if (bitmap.width() <= 0 || bitmap.width() != bitmap.height())
+        continue;
+      if (!best ||
+          (best->width() < 32 ? bitmap.width() > best->width()
+                              : bitmap.width() >= 32 &&
+                                    bitmap.width() < best->width())) {
+        best = &bitmap;
+      }
+    }
+    if (!best)
+      return;
+    // Favicons are 16 DIP wide.
+    favicon_ = gfx::Image(gfx::ImageSkia::CreateFromBitmap(
+        *best, best->width() / 16.0f));
+    NavigationChanged();
+  }
