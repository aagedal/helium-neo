+size_t SplitLayoutTree::InsertPaneAtEdge(SplitEdge edge) {
+  const SplitAxis axis = edge == SplitEdge::kLeft || edge == SplitEdge::kRight
+                             ? SplitAxis::kRow
+                             : SplitAxis::kColumn;
+  const bool before = edge == SplitEdge::kLeft || edge == SplitEdge::kTop;
+  const size_t count = pane_count();
+  SplitLayoutNode added;
+  if (!root_.is_pane() && root_.axis == axis) {
+    added.weight = TotalWeight(root_) / root_.children.size();
+    root_.children.insert(before ? root_.children.begin() : root_.children.end(),
+                          std::move(added));
+  } else {
+    SplitLayoutNode rest = std::move(root_);
+    rest.weight = count;
+    SplitLayoutNode root{.axis = axis};
+    if (before) {
+      root.children.push_back(std::move(added));
+      root.children.push_back(std::move(rest));
+    } else {
+      root.children.push_back(std::move(rest));
+      root.children.push_back(std::move(added));
+    }
+    root_ = std::move(root);
+  }
+  Normalize();
+  return before ? 0 : count;
+}
