+std::optional<size_t> SplitLayoutTree::PaneBeside(size_t pane,
+                                                  SplitEdge edge) const {
+  constexpr int kSize = 1 << 16;
+  const std::vector<SplitRect> panes =
+      Calculate({.width = kSize, .height = kSize}, 0).panes;
+  if (pane >= panes.size()) {
+    return std::nullopt;
+  }
+  const SplitRect& from = panes[pane];
+  const bool across_x = edge == SplitEdge::kLeft || edge == SplitEdge::kRight;
+  std::optional<size_t> best;
+  int best_shared = 0;
+  for (size_t i = 0; i < panes.size(); ++i) {
+    const SplitRect& to = panes[i];
+    bool touches = false;
+    switch (edge) {
+      case SplitEdge::kLeft:
+        touches = to.x + to.width == from.x;
+        break;
+      case SplitEdge::kRight:
+        touches = to.x == from.x + from.width;
+        break;
+      case SplitEdge::kTop:
+        touches = to.y + to.height == from.y;
+        break;
+      case SplitEdge::kBottom:
+        touches = to.y == from.y + from.height;
+        break;
+    }
+    const int shared =
+        across_x ? std::min(from.y + from.height, to.y + to.height) -
+                       std::max(from.y, to.y)
+                 : std::min(from.x + from.width, to.x + to.width) -
+                       std::max(from.x, to.x);
+    if (touches && shared > best_shared) {
+      best = i;
+      best_shared = shared;
+    }
+  }
+  return best;
+}
