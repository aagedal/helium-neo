+void FocusSplitPane(BrowserWindowInterface* browser,
+                    split_tabs::SplitEdge edge) {
+  TabStripModel* const tab_strip_model = browser->GetTabStripModel();
+  const tabs::TabInterface* const active = tab_strip_model->GetActiveTab();
+  if (!active || !active->GetSplit()) {
+    return;
+  }
+  const split_tabs::SplitTabData* data =
+      tab_strip_model->GetSplitData(*active->GetSplit());
+  const std::vector<tabs::TabInterface*> panes = data->ListTabs();
+  const size_t pane =
+      tab_strip_model->active_index() - data->GetIndexRange().start();
+  // Panes are laid out in reading order, so right to left text mirrors them.
+  if (base::i18n::IsRTL() && edge == split_tabs::SplitEdge::kLeft) {
+    edge = split_tabs::SplitEdge::kRight;
+  } else if (base::i18n::IsRTL() && edge == split_tabs::SplitEdge::kRight) {
+    edge = split_tabs::SplitEdge::kLeft;
+  }
+  if (const std::optional<size_t> next =
+          data->visual_data()->GetTree(panes.size()).PaneBeside(pane, edge)) {
+    tab_strip_model->ActivateTabAt(
+        tab_strip_model->GetIndexOfTab(panes[*next]),
+        TabStripUserGestureDetails(
+            TabStripUserGestureDetails::GestureType::kKeyboard));
+  }
+}
