+void TabStripModel::RemoveTabFromSplit(int index) {
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  tabs::TabInterface* const tab = GetTabAtIndex(index);
+  const std::optional<split_tabs::SplitTabId> split = tab->GetSplit();
+  if (!split) {
+    return;
+  }
+  const split_tabs::SplitTabData* data = GetSplitData(*split);
+  std::vector<tabs::TabInterface*> panes = data->ListTabs();
+  const size_t pane = index - data->GetIndexRange().start();
+  const int last_index = data->GetIndexRange().end() - 1;
+  split_tabs::SplitLayoutTree tree =
+      data->visual_data()->GetTree(panes.size());
+  const bool was_active = index == active_index();
+
+  RemoveSplit(*split);
+  MoveWebContentsAt(GetIndexOfTab(tab), last_index,
+                    /*select_after_move=*/false);
+  panes.erase(panes.begin() + pane);
+  if (panes.size() >= 2) {
+    tree.RemovePane(pane);
+    SetSplitPanes(*split, panes, std::move(tree));
+  }
+  // Keep showing the rest of the split.
+  if (was_active) {
+    ActivateTabAt(GetIndexOfTab(panes[std::min(pane, panes.size() - 1)]));
+  }
+}
