+gfx::Rect ScreenshotCapturedBubble::GetBubbleBounds() {
+  gfx::Rect bounds = LocationBarBubbleDelegateView::GetBubbleBounds();
+  views::View* anchor = GetAnchorView();
+  if (!overlay_ || !anchor) {
+    return bounds;
+  }
+  constexpr int kOverlayInset = 16;
+  const gfx::Rect anchor_bounds = anchor->GetBoundsInScreen();
+  bounds.set_x(anchor_bounds.right() - bounds.width() - kOverlayInset);
+  bounds.set_y(anchor_bounds.y() + kOverlayInset);
+  return bounds;
+}
