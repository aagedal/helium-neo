+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_TAB_SWITCHER_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_TAB_SWITCHER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserView;
+
+// An overlay in the middle of the browser window that lists the tabs Ctrl+Tab
+// cycles through while its modifier is held, like the macOS app switcher. The
+// active tab is highlighted, with the previous tabs in the cycle to its left
+// and the next ones to its right. Tabs still switch on every press; the
+// overlay shows where the cycle is, and clicking a tab in it switches to that
+// tab right away. BrowserView owns it and deletes it when the modifier is
+// released.
+class TabSwitcher : public TabStripModelObserver {
+ public:
+  explicit TabSwitcher(BrowserView* browser_view);
+  TabSwitcher(const TabSwitcher&) = delete;
+  TabSwitcher& operator=(const TabSwitcher&) = delete;
+  ~TabSwitcher() override;
+
+  // Shows the active tab. The overlay appears after a short delay, so tapping
+  // the shortcut once switches tabs without flashing it.
+  void Update();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+ private:
+  class Bubble;
+
+  void Show();
+  void Refresh();
+  // Switches to the clicked tab and ends the cycle. Deletes `this`.
+  void ActivateTab(tabs::TabHandle handle);
+
+  const raw_ptr<BrowserView> browser_view_;
+  base::OneShotTimer show_timer_;
+  // Deletes itself after its widget closes.
+  base::WeakPtr<Bubble> bubble_;
+  base::WeakPtrFactory<TabSwitcher> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_TAB_SWITCHER_H_
