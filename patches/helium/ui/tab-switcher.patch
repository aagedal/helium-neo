+// Hosts the cards in a bubble centered over the browser window.
+class TabSwitcher::Bubble : public views::BubbleDialogDelegate {
+ public:
+  Bubble(BrowserView* browser_view,
+         base::RepeatingCallback<void(tabs::TabHandle)> activate)
+      : views::BubbleDialogDelegate(browser_view, views::BubbleBorder::FLOAT),
+        activate_(std::move(activate)) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetShowCloseButton(false);
+    SetShowTitle(false);
+    SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_TAB_SWITCHER_TITLE));
+    set_margins(gfx::Insets(kPadding));
+    set_corner_radius(kCornerRadius);
+    set_adjust_if_offscreen(false);
+    set_close_on_deactivate(false);
+    SetCanActivate(false);
+    SetBackgroundColor(kColorOmniboxResultsBackground);
+
+    auto contents = std::make_unique<views::View>();
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+    cards_ = contents->AddChildView(std::make_unique<views::View>());
+    cards_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+        kCardSpacing));
+    footer_ = contents->AddChildView(std::make_unique<views::Label>());
+    footer_->SetEnabledColor(kColorOmniboxResultsTextDimmed);
+    footer_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetContentsView(std::move(contents));
+  }
+  Bubble(const Bubble&) = delete;
+  Bubble& operator=(const Bubble&) = delete;
+  ~Bubble() override = default;
+
+  void Show() {
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        this, base::BindOnce(&Bubble::OnClosed, base::Unretained(this)));
+    widget_->ShowInactive();
+  }
+
+  void Close() {
+    if (widget_) {
+      widget_->Close();
+    }
+  }
+
+  // Shows the tabs in the cycle around the active one.
+  void SetTabs(TabStripModel* model) {
+    size_t position = 0;
+    const std::vector<int> order = model->GetTabCycleOrder(position);
+    if (position >= order.size() ||
+        std::ranges::any_of(order, [model](int index) {
+          return !model->ContainsIndex(index);
+        })) {
+      return;
+    }
+    cards_->RemoveAllChildViews();
+
+    const int fitting_tabs = std::max(
+        1, (GetAnchorView()->width() - 2 * (kWindowMargin + kPadding)) /
+               (kCardWidth + kCardSpacing));
+    const size_t visible = std::min(
+        {order.size(), kMaxVisibleTabs, static_cast<size_t>(fitting_tabs)});
+    // Keep the active tab in the middle until the window reaches an end of the
+    // cycle.
+    const size_t first =
+        std::min(position - std::min(position, visible / 2),
+                 order.size() - visible);
+    for (size_t i = first; i < first + visible; ++i) {
+      tabs::TabInterface* tab = model->GetTabAtIndex(order[i]);
+      cards_->AddChildView(std::make_unique<Card>(
+          tab, i == position,
+          base::BindRepeating(activate_, tab->GetHandle())));
+    }
+
+    tabs::TabInterface* active = model->GetTabAtIndex(order[position]);
+    const std::u16string host =
+        url_formatter::FormatUrlForDisplayOmitSchemePathAndTrivialSubdomains(
+            TabUIHelper::From(active)->GetVisibleURL());
+    std::u16string footer = l10n_util::GetStringFUTF16(
+        IDS_HELIUM_TAB_SWITCHER_POSITION, base::NumberToString16(position + 1),
+        base::NumberToString16(order.size()));
+    if (!host.empty()) {
+      footer = host + u"  ·  " + footer;
+    }
+    footer_->SetText(footer);
+
+    if (widget_) {
+      SizeToContents();
+      // Highlight the card that is now under a resting pointer.
+      widget_->LayoutRootViewIfNecessary();
+      widget_->SynthesizeMouseMoveEvent();
+    }
+  }
+
+  base::WeakPtr<Bubble> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+  // views::BubbleDialogDelegate:
+  gfx::Rect GetBubbleBounds() override {
+    gfx::Rect bounds = views::BubbleDialogDelegate::GetBubbleBounds();
+    if (views::View* anchor = GetAnchorView()) {
+      bounds.set_origin(anchor->GetBoundsInScreen().CenterPoint() -
+                        gfx::Vector2d(bounds.width() / 2, bounds.height() / 2));
+    }
+    return bounds;
+  }
+
+ private:
+  void OnClosed(views::Widget::ClosedReason reason) {
+    // The delegate must outlive the widget, so delete both after the close
+    // finishes.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                  this);
+  }
+
+  base::RepeatingCallback<void(tabs::TabHandle)> activate_;
+  raw_ptr<views::View> cards_ = nullptr;
+  raw_ptr<views::Label> footer_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<Bubble> weak_factory_{this};
+};
+
+TabSwitcher::TabSwitcher(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  browser_view_->browser()->GetTabStripModel()->AddObserver(this);
+}
+
+TabSwitcher::~TabSwitcher() {
+  if (bubble_) {
+    bubble_->Close();
+  }
+}
+
+void TabSwitcher::Update() {
+  if (bubble_) {
+    Refresh();
+  } else if (!show_timer_.IsRunning()) {
+    show_timer_.Start(FROM_HERE, kShowDelay,
+                      base::BindOnce(&TabSwitcher::Show,
+                                     base::Unretained(this)));
+  }
+}
+
+void TabSwitcher::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kSelectionOnly) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kReplaced) {
+    Refresh();
+    return;
+  }
+  // Tabs were added, closed or moved, so the cycle starts over. Deletes
+  // `this`.
+  browser_view_->StopTabCycling();
+}
+
+void TabSwitcher::OnTabChangedAt(tabs::TabInterface* tab,
+                                 TabChangeType change_type) {
+  if (change_type == TabChangeType::kAll) {
+    Refresh();
+  }
+}
+
+void TabSwitcher::Show() {
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  if (model->count() < 2 || !browser_view_->GetWidget() ||
+      !browser_view_->GetWidget()->IsVisible()) {
+    return;
+  }
+  // The bubble closes asynchronously, so a click can still reach it after
+  // `this` is gone.
+  auto* bubble = new Bubble(browser_view_,
+                            base::BindRepeating(&TabSwitcher::ActivateTab,
+                                                weak_factory_.GetWeakPtr()));
+  bubble_ = bubble->GetWeakPtr();
+  bubble->SetTabs(model);
+  bubble->Show();
+}
+
+void TabSwitcher::Refresh() {
+  if (bubble_) {
+    bubble_->SetTabs(browser_view_->browser()->GetTabStripModel());
+  }
+}
+
+void TabSwitcher::ActivateTab(tabs::TabHandle handle) {
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  tabs::TabInterface* tab = handle.Get();
+  const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  // Ends MRU cycling first, so the switch counts as a normal activation.
+  // Deletes `this`.
+  browser_view_->StopTabCycling();
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index, TabStripUserGestureDetails(
+                                    TabStripUserGestureDetails::GestureType::
+                                        kMouse));
+  }
+}
