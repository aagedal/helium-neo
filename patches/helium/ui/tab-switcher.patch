+constexpr base::TimeDelta kShowDelay = base::Milliseconds(120);
+constexpr size_t kMaxVisibleTabs = 7;
+constexpr int kWindowMargin = 32;
+constexpr int kCornerRadius = 16;
+constexpr int kPadding = 10;
+constexpr int kCardWidth = 112;
+constexpr int kCardSpacing = 4;
+constexpr int kCardCornerRadius = 10;
+constexpr int kFaviconSize = 24;
+constexpr int kTileSize = 44;
+constexpr int kTileCornerRadius = 10;
+
+// A tab in the switcher: its favicon on a tile, with the title below. The
+// pointer highlights it, and clicking it switches to the tab.
+class Card : public views::Button {
+  METADATA_HEADER(Card, views::Button)
+
+ public:
+  Card(tabs::TabInterface* tab, bool selected, PressedCallback pressed)
+      : views::Button(std::move(pressed)), selected_(selected) {
+    TabUIHelper* helper = TabUIHelper::From(tab);
+
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(10, 6), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    // The modifier is still held while clicking, and macOS turns Ctrl+click
+    // into a right click.
+    SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                             ui::EF_RIGHT_MOUSE_BUTTON);
+    // The overlay can't take focus; the shortcut keeps driving it.
+    SetFocusBehavior(FocusBehavior::NEVER);
+
+    auto* tile = AddChildView(std::make_unique<views::ImageView>());
+    tile->SetImage(helper->GetFavicon());
+    tile->SetImageSize({kFaviconSize, kFaviconSize});
+    tile->SetPreferredSize(gfx::Size(kTileSize, kTileSize));
+    tile->SetBackground(views::CreateRoundedRectBackground(
+        kColorOmniboxResultsBackgroundHovered, kTileCornerRadius));
+    tile->SetCanProcessEventsWithinSubtree(false);
+
+    title_ = AddChildView(std::make_unique<views::Label>(helper->GetTitle()));
+    title_->SetMultiLine(true);
+    title_->SetMaxLines(2);
+    title_->SetMaximumWidth(kCardWidth - 12);
+    title_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    title_->SetCanProcessEventsWithinSubtree(false);
+
+    GetViewAccessibility().SetName(helper->GetTitle());
+    SetPreferredSize(gfx::Size(kCardWidth, GetHeightForWidth(kCardWidth)));
+    UpdateColors();
+  }
+  Card(const Card&) = delete;
+  Card& operator=(const Card&) = delete;
+  ~Card() override = default;
+
+  // views::Button:
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateColors();
+  }
+
+ private:
+  void UpdateColors() {
+    const bool highlighted =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    if (selected_) {
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorOmniboxResultsBackgroundSelected, kCardCornerRadius));
+    } else if (highlighted) {
+      // A translucent fill, so the tile still stands out from the card.
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorOmniboxResultsBackgroundHoverOverlay, kCardCornerRadius));
+    } else {
+      SetBackground(nullptr);
+    }
+    title_->SetEnabledColor(selected_      ? kColorOmniboxResultsTextSelected
+                            : highlighted ? kColorOmniboxText
+                                          : kColorOmniboxResultsTextDimmed);
+  }
+
+  const bool selected_;
+  raw_ptr<views::Label> title_ = nullptr;
+};
+
+BEGIN_METADATA(Card)
+END_METADATA
