+std::vector<int> TabStripModel::GetTabCycleOrder(
+    size_t& active_position) const {
+  if (!mru_cycle_list_.empty()) {
+    active_position = mru_cycle_position_;
+    return mru_cycle_list_;
+  }
+
+  // Skip the tabs SelectRelativeTab() skips.
+  const std::optional<tab_groups::TabGroupId> focused_group =
+      GetFocusedGroup();
+  std::vector<int> order;
+  active_position = 0;
+  for (int i = 0; i < count(); ++i) {
+    if (i == active_index()) {
+      active_position = order.size();
+    } else if (IsTabCollapsed(i) ||
+               (focused_group.has_value() &&
+                !tabs::TabStripModelSelectionState::IsTabValidInFocusedGroup(
+                    GetTabAtIndex(i), focused_group))) {
+      continue;
+    }
+    order.push_back(i);
+  }
+  return order;
 }
 
