+// A handle that drags the file once the pointer moves past the drag threshold.
+class DragHandle : public views::ImageButton {
+  METADATA_HEADER(DragHandle, views::ImageButton)
+
+ public:
+  explicit DragHandle(base::RepeatingClosure start_drag)
+      : views::ImageButton(PressedCallback()),
+        start_drag_(std::move(start_drag)) {
+    views::ConfigureVectorImageButton(this);
+    views::SetImageFromVectorIconWithColor(
+        this, kHeliumDragIndicatorIcon, kButtonIconSize,
+        views::IconColors(ui::kColorIcon, ui::kColorIconDisabled));
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    views::ImageButton::OnMousePressed(event);
+    drag_start_ = event.location();
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (ExceededDragThreshold(event.location() - drag_start_)) {
+      // May delete `this`.
+      start_drag_.Run();
+    }
+    return true;
+  }
+
+ private:
+  base::RepeatingClosure start_drag_;
+  gfx::Point drag_start_;
+};
+
+BEGIN_METADATA(DragHandle)
+END_METADATA
