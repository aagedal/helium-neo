+// static
+void HeliumDownloadOverlay::Show(BrowserView* browser_view,
+                                 download::DownloadItem* item) {
+  CHECK_EQ(item->GetState(), download::DownloadItem::COMPLETE);
+  if (auto it = Overlays().find(browser_view); it != Overlays().end()) {
+    it->second->Close();
+  }
+  auto* overlay = new HeliumDownloadOverlay(browser_view, item);
+  Overlays()[browser_view] = overlay;
+  overlay->widget_ = views::BubbleDialogDelegate::CreateBubble(
+      overlay, base::BindOnce(&HeliumDownloadOverlay::OnClosed,
+                              overlay->weak_factory_.GetWeakPtr()));
+  overlay->widget_->ShowInactive();
+  overlay->close_timer_.Start(
+      FROM_HERE, kCloseDelay,
+      base::BindOnce(&HeliumDownloadOverlay::Close,
+                     overlay->weak_factory_.GetWeakPtr()));
+}
+
+HeliumDownloadOverlay::HeliumDownloadOverlay(BrowserView* browser_view,
+                                             download::DownloadItem* item)
+    : views::BubbleDialogDelegate(browser_view, views::BubbleBorder::FLOAT),
+      browser_view_(browser_view),
+      item_(item) {
+  item_->AddObserver(this);
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  SetShowCloseButton(false);
+  SetShowTitle(false);
+  set_margins(gfx::Insets::TLBR(10, 12, 10, 8));
+  set_corner_radius(kCornerRadius);
+  set_adjust_if_offscreen(false);
+  set_close_on_deactivate(false);
+  SetCanActivate(false);
+
+  const std::u16string file_name =
+      item_->GetFileNameToReportUser().LossyDisplayName();
+  SetTitle(file_name);
+
+  auto contents = std::make_unique<OverlayContents>(base::BindRepeating(
+      &HeliumDownloadOverlay::SetHovered, weak_factory_.GetWeakPtr()));
+  auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  icon_view_ = contents->AddChildView(std::make_unique<views::ImageView>());
+  icon_view_->SetImageSize({kFileIconSize, kFileIconSize});
+
+  auto* name =
+      contents->AddChildView(std::make_unique<views::Label>(file_name));
+  name->SetElideBehavior(gfx::ELIDE_MIDDLE);
+  name->SetMaximumWidthSingleLine(kMaxNameWidth);
+  name->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 0, 0, 4));
+
+  auto* open =
+      contents->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+          base::BindRepeating(&HeliumDownloadOverlay::Open,
+                              weak_factory_.GetWeakPtr()),
+          kOpenInNewIcon, kButtonIconSize));
+  open->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_DOWNLOAD_BUBBLE_OPEN_QUICK_ACTION));
+  open->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+      IDS_DOWNLOAD_BUBBLE_OPEN_QUICK_ACTION_ACCESSIBILITY, file_name));
+
+  auto* show =
+      contents->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+          base::BindRepeating(&HeliumDownloadOverlay::ShowInFolder,
+                              weak_factory_.GetWeakPtr()),
+          vector_icons::kFolderOpenIcon, kButtonIconSize));
+  show->SetTooltipText(l10n_util::GetStringUTF16(
+      IDS_DOWNLOAD_BUBBLE_SHOW_IN_FOLDER_QUICK_ACTION));
+  show->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+      IDS_DOWNLOAD_BUBBLE_SHOW_IN_FOLDER_QUICK_ACTION_ACCESSIBILITY,
+      file_name));
+
+  auto* drag =
+      contents->AddChildView(std::make_unique<DragHandle>(base::BindRepeating(
+          &HeliumDownloadOverlay::StartDrag, weak_factory_.GetWeakPtr())));
+  drag->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_DOWNLOAD_OVERLAY_DRAG));
+  drag->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+      IDS_HELIUM_DOWNLOAD_OVERLAY_DRAG_ACCESSIBILITY, file_name));
+
+  SetContentsView(std::move(contents));
+
+  IconManager* icon_manager = g_browser_process->icon_manager();
+  const float scale =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view_->GetWidget()->GetNativeView())
+          .device_scale_factor();
+  if (gfx::Image* image = icon_manager->LookupIconFromFilepath(
+          item_->GetTargetFilePath(), IconLoader::LARGE, scale);
+      image && !image->IsEmpty()) {
+    OnFileIconLoaded(*image);
+  } else {
+    icon_manager->LoadIcon(
+        item_->GetTargetFilePath(), IconLoader::LARGE, scale,
+        base::BindOnce(&HeliumDownloadOverlay::OnFileIconLoaded,
+                       weak_factory_.GetWeakPtr()),
+        &icon_tracker_);
+  }
+}
+
+HeliumDownloadOverlay::~HeliumDownloadOverlay() {
+  if (item_) {
+    item_->RemoveObserver(this);
+  }
+  if (auto it = Overlays().find(browser_view_);
+      it != Overlays().end() && it->second == this) {
+    Overlays().erase(it);
+  }
+}
+
+gfx::Rect HeliumDownloadOverlay::GetBubbleBounds() {
+  gfx::Rect bounds = views::BubbleDialogDelegate::GetBubbleBounds();
+  views::View* anchor = GetAnchorView();
+  if (!anchor) {
+    return bounds;
+  }
+  // Near the Downloads folder in the Dock.
+  const gfx::Rect anchor_bounds = anchor->GetBoundsInScreen();
+  bounds.set_x(anchor_bounds.right() - bounds.width() - kWindowInset);
+  bounds.set_y(anchor_bounds.bottom() - bounds.height() - kWindowInset);
+  return bounds;
+}
+
+void HeliumDownloadOverlay::OnDownloadUpdated(download::DownloadItem* item) {
+  // The file was removed, renamed or opened from elsewhere.
+  if (item->GetState() != download::DownloadItem::COMPLETE ||
+      item->GetFileExternallyRemoved()) {
+    Close();
+  }
+}
+
+void HeliumDownloadOverlay::OnDownloadDestroyed(download::DownloadItem* item) {
+  item_->RemoveObserver(this);
+  item_ = nullptr;
+  Close();
+}
+
+void HeliumDownloadOverlay::Open() {
+  if (item_) {
+    item_->OpenDownload();
+  }
+  Close();
+}
+
+void HeliumDownloadOverlay::ShowInFolder() {
+  if (item_) {
+    item_->ShowDownloadInShell();
+  }
+  Close();
+}
+
+void HeliumDownloadOverlay::StartDrag() {
+  if (!item_ || !widget_ ||
+      item_->GetState() != download::DownloadItem::COMPLETE) {
+    return;
+  }
+  if (file_icon_.IsEmpty()) {
+    file_icon_ =
+        gfx::Image(DefaultIcon().Rasterize(icon_view_->GetColorProvider()));
+  }
+  close_timer_.Stop();
+  base::WeakPtr<HeliumDownloadOverlay> weak_this = weak_factory_.GetWeakPtr();
+  // Returns when the drag ends.
+  DragDownloadItem(item_, &file_icon_, widget_->GetNativeView());
+  if (weak_this) {
+    weak_this->Close();
+  }
+}
+
+void HeliumDownloadOverlay::SetHovered(bool hovered) {
+  if (hovered) {
+    close_timer_.Stop();
+  } else {
+    close_timer_.Start(FROM_HERE, kCloseDelay,
+                       base::BindOnce(&HeliumDownloadOverlay::Close,
+                                      weak_factory_.GetWeakPtr()));
+  }
+}
+
+void HeliumDownloadOverlay::OnFileIconLoaded(gfx::Image icon) {
+  if (icon.IsEmpty()) {
+    icon_view_->SetImage(DefaultIcon());
+    return;
+  }
+  file_icon_ = icon;
+  icon_view_->SetImage(ui::ImageModel::FromImage(icon));
+}
+
+void HeliumDownloadOverlay::Close() {
+  close_timer_.Stop();
+  if (widget_) {
+    widget_->Close();
+  }
+}
+
+void HeliumDownloadOverlay::OnClosed(views::Widget::ClosedReason reason) {
+  // The delegate must outlive the widget, so delete both after the close
+  // finishes.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                this);
+}
