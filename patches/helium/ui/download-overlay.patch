+// A card in the bottom right corner of the browser window for a finished
+// download, with buttons to open the file, show it in Finder and drag it into
+// another app. It replaces the partial download bubble, which is anchored in
+// the toolbar and reveals it in frameless mode. It closes after a few seconds
+// unless the pointer is over it.
+class HeliumDownloadOverlay : public views::BubbleDialogDelegate,
+                              public download::DownloadItem::Observer {
+ public:
+  // Shows the overlay for `item`, which must be complete, in place of the one
+  // already shown in the window.
+  static void Show(BrowserView* browser_view, download::DownloadItem* item);
+
+  HeliumDownloadOverlay(const HeliumDownloadOverlay&) = delete;
+  HeliumDownloadOverlay& operator=(const HeliumDownloadOverlay&) = delete;
+  ~HeliumDownloadOverlay() override;
+
+  // views::BubbleDialogDelegate:
+  gfx::Rect GetBubbleBounds() override;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override;
+  void OnDownloadDestroyed(download::DownloadItem* item) override;
+
+ private:
+  HeliumDownloadOverlay(BrowserView* browser_view,
+                        download::DownloadItem* item);
+
+  void Open();
+  void ShowInFolder();
+  void StartDrag();
+  void SetHovered(bool hovered);
+  void OnFileIconLoaded(gfx::Image icon);
+  void Close();
+  void OnClosed(views::Widget::ClosedReason reason);
+
+  const raw_ptr<BrowserView> browser_view_;
+  raw_ptr<download::DownloadItem> item_;
+  raw_ptr<views::ImageView> icon_view_ = nullptr;
+  gfx::Image file_icon_;
+  base::OneShotTimer close_timer_;
+  base::CancelableTaskTracker icon_tracker_;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<HeliumDownloadOverlay> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_DOWNLOAD_BUBBLE_HELIUM_DOWNLOAD_OVERLAY_H_
