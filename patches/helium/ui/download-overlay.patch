+bool DownloadToolbarUIController::ShowHeliumOverlay() {
+  std::vector<DownloadUIModel::DownloadUIModelPtr> models =
+      bubble_controller_->PeekPartialView();
+  if (models.empty()) {
+    return false;
+  }
+  for (const DownloadUIModel::DownloadUIModelPtr& model : models) {
+    if (model->GetState() != download::DownloadItem::COMPLETE ||
+        model->IsDangerous() || model->IsInsecure() ||
+        !model->GetDownloadItem()) {
+      return false;
+    }
+  }
+  // Count the overlay as the partial view, so it follows the same limits.
+  bubble_controller_->GetPartialView();
+  HeliumDownloadOverlay::Show(browser_view_, models.front()->GetDownloadItem());
+  return true;
+}
