+constexpr int kWindowInset = 16;
+constexpr int kCornerRadius = 12;
+constexpr int kFileIconSize = 32;
+constexpr int kButtonIconSize = 18;
+constexpr int kMaxNameWidth = 220;
+constexpr base::TimeDelta kCloseDelay = base::Seconds(6);
