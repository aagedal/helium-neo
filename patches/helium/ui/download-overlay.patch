+ui::ImageModel DefaultIcon() {
+  return ui::ImageModel::FromVectorIcon(vector_icons::kDraftIcon,
+                                        ui::kColorIcon, kFileIconSize);
+}
+
+// The overlay shown in each window.
+base::flat_map<BrowserView*, HeliumDownloadOverlay*>& Overlays() {
+  static base::NoDestructor<
+      base::flat_map<BrowserView*, HeliumDownloadOverlay*>>
+      overlays;
+  return *overlays;
+}
+
+// Reports when the pointer enters or leaves the overlay, including its
+// buttons.
+class OverlayContents : public views::View {
+  METADATA_HEADER(OverlayContents, views::View)
+
+ public:
+  explicit OverlayContents(base::RepeatingCallback<void(bool)> on_hover)
+      : on_hover_(std::move(on_hover)) {
+    SetNotifyEnterExitOnChild(true);
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    on_hover_.Run(true);
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    on_hover_.Run(false);
+  }
+
+ private:
+  base::RepeatingCallback<void(bool)> on_hover_;
+};
