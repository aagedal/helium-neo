+void HeliumPinsService::ReconcilePaneSettings(BrowserWindowInterface* browser) {
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    const auto it = pins_.Find(controller->pin_id());
+    if (it == pins_.end() || it->pane_settings.empty()) {
+      continue;
+    }
+
+    content::WebContents* const contents = controller->tab().GetContents();
+    std::map<std::string, std::string> settings;
+    tabs::PaneSettings::PopulateExtraData(contents, &settings);
+    if (settings != it->pane_settings) {
+      tabs::PaneSettings::RestoreFromExtraData(contents, it->pane_settings);
+    }
+  }
+}
+
+void HeliumPinsService::OnPaneSettingsChanged(content::WebContents* contents) {
+  if (applying_changes_) {
+    return;
+  }
+
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(contents);
+  if (!tab || !tab->IsPinned()) {
+    return;
+  }
+
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  HeliumPinsTabController* const controller =
+      HeliumPinsTabController::From(tab);
+  if (!browser || !IsSyncedBrowser(browser) || !controller) {
+    return;
+  }
+
+  const auto it = pins_.Find(controller->pin_id());
+  if (it == pins_.end()) {
+    return;
+  }
+
+  std::map<std::string, std::string> settings;
+  tabs::PaneSettings::PopulateExtraData(contents, &settings);
+  if (settings == it->pane_settings) {
+    return;
+  }
+
+  it->pane_settings = std::move(settings);
+  SavePins();
+  ScheduleReconcileOthers(browser);
+}
