+size_t PaneCount(MultiContentsView& view, TabStripModel& model) {
+  const tabs::TabInterface* active = model.GetActiveTab();
+  if (!active) {
+    return 0;
+  }
+  const size_t panes =
+      active->GetSplit()
+          ? model.GetSplitData(*active->GetSplit())->ListTabs().size()
+          : 1;
+  return std::min(panes, view.contents_container_views().size());
+}
