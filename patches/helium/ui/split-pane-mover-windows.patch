+  tabs::TabInterface* const active = model.GetActiveTab();
+  const std::optional<split_tabs::SplitTabId> split = active->GetSplit();
+  const int index =
+      split ? model.GetSplitData(*split)->GetIndexRange().end()
+            : model.active_index() + 1;
+  const int inserted = model.InsertDetachedTabAt(
