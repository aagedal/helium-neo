+void SplitPaneMover::MoveToWindow(size_t pane, const Target& target) {
+  // The window may have closed since the drop.
+  BrowserView* const other = target.window.get();
+  const std::vector<BrowserWindowInterface*> windows =
+      GetAllBrowserWindowInterfaces();
+  if (std::ranges::none_of(windows, [other](BrowserWindowInterface* window) {
+        return BrowserView::GetBrowserViewForBrowser(window) == other;
+      })) {
+    return;
+  }
+  TabStripModel* const model = other->browser()->GetTabStripModel();
+  if (!model->GetActiveTab() ||
+      target.pane >= PaneCount(*other->multi_contents_view(), *model)) {
+    return;
+  }
+  tabs::TabInterface* tab = tab_strip_model_->GetActiveTab();
+  if (!tab) {
+    return;
+  }
+  if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+    const std::vector<tabs::TabInterface*> panes =
+        tab_strip_model_->GetSplitData(*split)->ListTabs();
+    if (pane >= panes.size()) {
+      return;
+    }
+    tab = panes[pane];
+  }
+  if (tab->IsSplit()) {
+    tab_strip_model_->RemoveTabFromSplit(tab_strip_model_->GetIndexOfTab(tab));
+  }
+  std::unique_ptr<tabs::TabModel> detached =
+      tab_strip_model_->DetachTabAtForInsertion(
+          tab_strip_model_->GetIndexOfTab(tab));
+  // Moving the window's last tab closes it, along with this object.
+  PlaceTab(std::move(detached), *model, target.pane, target.edge);
+  other->GetWidget()->Activate();
+}
