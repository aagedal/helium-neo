+// Hosts the overlay contents in a bubble centered over the browser window.
+class CommandBarView::Bubble : public views::BubbleDialogDelegate {
+ public:
+  Bubble(BrowserWindowInterface* browser, views::View* anchor_view, Mode mode)
+      : views::BubbleDialogDelegate(anchor_view, views::BubbleBorder::FLOAT),
+        browser_(browser),
+        mode_(mode) {
+    current_ = this;
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetShowCloseButton(false);
+    SetShowTitle(false);
+    set_margins(gfx::Insets::VH(8, 8));
+    set_corner_radius(kCornerRadius);
+    set_adjust_if_offscreen(false);
+    SetBackgroundColor(kColorOmniboxResultsBackground);
+    set_fixed_width(std::clamp(
+        anchor_view->width() - 2 * kHorizontalWindowMargin, kMinWidth,
+        kMaxWidth));
+    contents_ = SetContentsView(std::make_unique<CommandBarView>(browser, mode));
+    SetTitle(std::u16string(contents_->textfield()->GetPlaceholderText()));
+  }
+  Bubble(const Bubble&) = delete;
+  Bubble& operator=(const Bubble&) = delete;
+  ~Bubble() override {
+    if (current_ == this) {
+      current_ = nullptr;
+    }
+  }
+
+  static Bubble* current() { return current_; }
+  BrowserWindowInterface* browser() const { return browser_; }
+  Mode mode() const { return mode_; }
+
+  void Show() {
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        this, base::BindOnce(&Bubble::OnClosed, base::Unretained(this)));
+    widget_->Show();
+  }
+
+  void Close() {
+    if (current_ == this) {
+      current_ = nullptr;
+    }
+    if (widget_) {
+      widget_->Close();
+    }
+  }
+
+  // views::BubbleDialogDelegate:
+  gfx::Rect GetBubbleBounds() override {
+    gfx::Rect bounds = views::BubbleDialogDelegate::GetBubbleBounds();
+    views::View* anchor = GetAnchorView();
+    if (!anchor) {
+      return bounds;
+    }
+    // Keep the top edge fixed so the overlay grows downwards as results
+    // arrive.
+    const gfx::Rect anchor_bounds = anchor->GetBoundsInScreen();
+    bounds.set_x(anchor_bounds.CenterPoint().x() - bounds.width() / 2);
+    bounds.set_y(anchor_bounds.y() +
+                 std::max(48, anchor_bounds.height() / 6));
+    return bounds;
+  }
+
+  views::View* GetInitiallyFocusedView() override {
+    return contents_->textfield();
+  }
+
+ private:
+  void OnClosed(views::Widget::ClosedReason reason) {
+    if (current_ == this) {
+      current_ = nullptr;
+    }
+    // The delegate must outlive the widget, so delete both after the close
+    // finishes.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                  this);
+  }
+
+  static inline Bubble* current_ = nullptr;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const Mode mode_;
+  raw_ptr<CommandBarView> contents_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+};
+
+// static
+bool CommandBarView::MaybeShow(BrowserWindowInterface* browser, Mode mode) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      !browser->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumCommandBar)) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget()) {
+    return false;
+  }
+
+  if (Bubble* current = Bubble::current()) {
+    const bool same = current->browser() == browser && current->mode() == mode;
+    current->Close();
+    if (same) {
+      return true;
+    }
+  }
+
+  (new Bubble(browser, browser_view, mode))->Show();
+  return true;
+}
