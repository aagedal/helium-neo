+content::WebContents* GetActiveContents(BrowserWindowInterface* browser) {
+  return browser->GetTabStripModel()->GetActiveWebContents();
+}
+
+bool IsActive(const CommandBarCommand& command,
+              BrowserWindowInterface* browser) {
+  switch (command.state) {
+    case State::kNone:
+      return false;
+    case State::kPrefEnabled:
+      return browser->GetProfile()->GetPrefs()->GetBoolean(
+          command.state_pref);
+    case State::kTabPinned: {
+      TabStripModel* tab_strip = browser->GetTabStripModel();
+      return tab_strip->active_index() != TabStripModel::kNoTab &&
+             tab_strip->IsTabPinned(tab_strip->active_index());
+    }
+    case State::kTabMuted: {
+      content::WebContents* contents = GetActiveContents(browser);
+      return contents && contents->IsAudioMuted();
+    }
+  }
+}
+
+}  // namespace
+
+base::span<const CommandBarCommand> GetCommandBarCommands() {
+  return kCommands;
+}
+
+bool IsCommandBarCommandAvailable(const CommandBarCommand& command,
+                                  BrowserWindowInterface* browser) {
+  if (command.command_id) {
+    return chrome::IsCommandEnabled(browser, command.command_id);
+  }
+  return command.toggle_pref != nullptr;
+}
+
+std::u16string GetCommandBarCommandLabel(const CommandBarCommand& command,
+                                         BrowserWindowInterface* browser) {
+  return l10n_util::GetStringUTF16(
+      command.active_label_id && IsActive(command, browser)
+          ? command.active_label_id
+          : command.label_id);
+}
+
+std::u16string GetCommandBarCommandShortcut(const CommandBarCommand& command,
+                                            BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  ui::Accelerator accelerator;
+  if (!command.command_id || !browser_view ||
+      !browser_view->GetAccelerator(command.command_id, &accelerator)) {
+    return std::u16string();
+  }
+  return accelerator.GetShortcutText();
+}
+
+int ScoreCommandBarCommand(const CommandBarCommand& command,
+                           const std::u16string& label,
+                           const std::vector<std::u16string>& terms) {
+  const std::u16string lower_label = base::i18n::ToLower(label);
+  const std::vector<std::u16string> label_words =
+      base::SplitString(lower_label, u" -", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY);
+  const std::vector<std::u16string> keywords = base::SplitString(
+      base::UTF8ToUTF16(command.keywords), u" ", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  const auto has_prefix = [](const std::vector<std::u16string>& words,
+                             const std::u16string& term) {
+    return std::ranges::any_of(words, [&](const std::u16string& word) {
+      return word.starts_with(term);
+    });
+  };
+
+  int score = 0;
+  for (const auto& term : terms) {
+    if (has_prefix(label_words, term)) {
+      score += 3;
+    } else if (has_prefix(keywords, term)) {
+      score += 2;
+    } else if (lower_label.find(term) != std::u16string::npos) {
+      score += 1;
+    } else {
+      return 0;
+    }
+  }
+  return score;
+}
+
+void RunCommandBarCommand(const CommandBarCommand& command,
+                          BrowserWindowInterface* browser) {
+  if (command.command_id) {
+    chrome::ExecuteCommand(browser, command.command_id);
+    return;
+  }
+  PrefService* prefs = browser->GetProfile()->GetPrefs();
+  prefs->SetBoolean(command.toggle_pref,
+                    !prefs->GetBoolean(command.toggle_pref));
+}
