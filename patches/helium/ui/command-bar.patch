+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMANDS_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMANDS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/raw_ptr_exclusion.h"
+
+class BrowserWindowInterface;
+
+namespace gfx {
+struct VectorIcon;
+}  // namespace gfx
+
+// A browser feature that can be run from the search overlay.
+struct CommandBarCommand {
+  // Decides which label describes the command right now.
+  enum class State {
+    kNone,
+    // `state_pref` is true.
+    kPrefEnabled,
+    // The active tab is pinned.
+    kTabPinned,
+    // The active tab is muted.
+    kTabMuted,
+  };
+
+  // The browser command to run, or 0 to toggle `toggle_pref` instead.
+  int command_id = 0;
+  // A boolean profile pref the command flips when `command_id` is 0.
+  const char* toggle_pref = nullptr;
+  int label_id = 0;
+  // Replaces `label_id` while `state` holds, e.g. "Unpin tab".
+  int active_label_id = 0;
+  State state = State::kNone;
+  const char* state_pref = nullptr;
+  // Space-separated English words that also find the command.
+  const char* keywords = "";
+  // Points at a static icon; the commands live in a constant table.
+  RAW_PTR_EXCLUSION const gfx::VectorIcon* icon = nullptr;
+};
+
+// All commands in display order.
+base::span<const CommandBarCommand> GetCommandBarCommands();
+
+// Whether `command` can run in `browser` right now.
+bool IsCommandBarCommandAvailable(const CommandBarCommand& command,
+                                  BrowserWindowInterface* browser);
+
+// The label for `command` in its current state.
+std::u16string GetCommandBarCommandLabel(const CommandBarCommand& command,
+                                         BrowserWindowInterface* browser);
+
+// The keyboard shortcut for `command`, or an empty string.
+std::u16string GetCommandBarCommandShortcut(const CommandBarCommand& command,
+                                            BrowserWindowInterface* browser);
+
+// Scores how well `terms` (lowercase) match `label` and `command`'s keywords.
+// Every term must match. Returns 0 for no match.
+int ScoreCommandBarCommand(const CommandBarCommand& command,
+                           const std::u16string& label,
+                           const std::vector<std::u16string>& terms);
+
+void RunCommandBarCommand(const CommandBarCommand& command,
+                          BrowserWindowInterface* browser);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMANDS_H_
