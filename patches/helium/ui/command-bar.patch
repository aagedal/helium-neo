+CommandBarView::CommandBarView(BrowserWindowInterface* browser, Mode mode)
+    : browser_(browser), mode_(mode) {
+  Profile* profile = browser_->GetProfile();
+  scheme_classifier_ =
+      std::make_unique<ChromeAutocompleteSchemeClassifier>(profile);
+  autocomplete_controller_ = std::make_unique<AutocompleteController>(
+      std::make_unique<ChromeAutocompleteProviderClient>(profile),
+      AutocompleteControllerConfig{
+          .provider_types = AutocompleteClassifier::DefaultOmniboxProviders()});
+  autocomplete_controller_->AddObserver(this);
+
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  auto* input_row = AddChildView(std::make_unique<views::BoxLayoutView>());
+  input_row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  input_row->SetInsideBorderInsets(gfx::Insets::VH(10, 12));
+  input_row->SetBetweenChildSpacing(12);
+  input_row->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  input_icon_ = input_row->AddChildView(std::make_unique<views::ImageView>());
+  input_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kSearchIcon, kColorOmniboxResultsIcon, 20));
+
+  std::u16string placeholder;
+  if (const TemplateURL* default_search =
+          TemplateURLServiceFactory::GetForProfile(profile)
+              ->GetDefaultSearchProvider()) {
+    placeholder = l10n_util::GetStringFUTF16(
+        IDS_HELIUM_COMMAND_BAR_PLACEHOLDER, default_search->short_name());
+  }
+
+  textfield_ = input_row->AddChildView(std::make_unique<views::Textfield>());
+  textfield_->set_controller(this);
+  textfield_->SetBorder(views::NullBorder());
+  textfield_->SetBackgroundEnabled(false);
+  textfield_->SetFontList(gfx::FontList().DeriveWithSizeDelta(7));
+  textfield_->SetTextColorId(kColorOmniboxText);
+  textfield_->SetPlaceholderTextColorId(kColorOmniboxTextDimmed);
+  textfield_->SetPlaceholderText(placeholder);
+  textfield_->GetViewAccessibility().SetName(placeholder);
+  input_row->SetFlexForView(textfield_, 1);
+
+  // A chip naming the site a bang or keyword search goes to, aligned with
+  // the input text.
+  auto* engine_row = AddChildView(std::make_unique<views::BoxLayoutView>());
+  engine_row->SetInsideBorderInsets(gfx::Insets::TLBR(0, 44, 8, 12));
+  engine_row->SetMainAxisAlignment(views::BoxLayout::MainAxisAlignment::kStart);
+  engine_row_ = engine_row;
+  auto* engine_chip =
+      engine_row->AddChildView(std::make_unique<views::BoxLayoutView>());
+  engine_chip->SetInsideBorderInsets(gfx::Insets::VH(4, 10));
+  engine_chip->SetBetweenChildSpacing(8);
+  engine_chip->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  engine_chip->SetBackground(views::CreateRoundedRectBackground(
+      kColorOmniboxResultsBackgroundSelected, kRowCornerRadius));
+  engine_icon_ =
+      engine_chip->AddChildView(std::make_unique<views::ImageView>());
+  engine_icon_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  engine_label_ = engine_chip->AddChildView(std::make_unique<views::Label>());
+  engine_label_->SetEnabledColor(kColorOmniboxResultsTextSelected);
+  engine_host_ = engine_chip->AddChildView(std::make_unique<views::Label>());
+  engine_host_->SetEnabledColor(kColorOmniboxResultsTextDimmedSelected);
+  engine_host_->SetFontList(engine_host_->font_list().DeriveWithSizeDelta(-1));
+  engine_row_->SetVisible(false);
+
+  separator_ = AddChildView(std::make_unique<views::Separator>());
+  separator_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 4)));
+
+  results_ = AddChildView(std::make_unique<views::BoxLayoutView>());
+  static_cast<views::BoxLayoutView*>(results_.get())
+      ->SetOrientation(views::BoxLayout::Orientation::kVertical);
+
+  if (mode_ == Mode::kCurrentTab) {
+    if (content::WebContents* contents =
+            browser_->GetTabStripModel()->GetActiveWebContents()) {
+      const GURL& url = contents->GetLastCommittedURL();
+      if (!IsNewTabPageUrl(url)) {
+        textfield_->SetText(base::UTF8ToUTF16(url.spec()));
+        textfield_->SelectAll(/*reversed=*/false);
+      }
+    }
+  }
+  user_text_ = textfield_->GetText();
+
+  RebuildEntries();
+}
+
+CommandBarView::~CommandBarView() {
+  autocomplete_controller_->RemoveObserver(this);
+}
+
+void CommandBarView::RemovedFromWidget() {
+  // Results that arrive after the overlay closed must not touch the browser,
+  // which may be closing too.
+  autocomplete_controller_->RemoveObserver(this);
+  autocomplete_controller_->Stop(AutocompleteStopReason::kInteraction);
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  just_deleted_text_ = deleting_;
+  deleting_ = false;
+  user_text_ = new_contents;
+  user_edited_ = true;
+  user_moved_selection_ = false;
+  StartQuery();
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  // Remember deletions so they don't bring back inline autocompletion.
+  deleting_ = key_event.key_code() == ui::VKEY_BACK ||
+              key_event.key_code() == ui::VKEY_DELETE;
+
+  const bool control = key_event.IsControlDown();
+  switch (key_event.key_code()) {
+    case ui::VKEY_UP:
+    case ui::VKEY_DOWN:
+    case ui::VKEY_N:
+    case ui::VKEY_P: {
+      const bool is_arrow = key_event.key_code() == ui::VKEY_UP ||
+                            key_event.key_code() == ui::VKEY_DOWN;
+      if ((!is_arrow && !control) || entries_.empty()) {
+        return false;
+      }
+      const bool down = key_event.key_code() == ui::VKEY_DOWN ||
+                        key_event.key_code() == ui::VKEY_N;
+      size_t index;
+      if (!selected_index_) {
+        index = down ? 0 : entries_.size() - 1;
+      } else if (down) {
+        index = (*selected_index_ + 1) % entries_.size();
+      } else {
+        index = (*selected_index_ + entries_.size() - 1) % entries_.size();
+      }
+      user_moved_selection_ = true;
+      SetSelectedIndex(index);
+      return true;
+    }
+    case ui::VKEY_RETURN:
+      if (selected_index_) {
+        OpenEntry(*selected_index_, DispositionForFlags(key_event.flags()));
+      } else if (mode_ == Mode::kNewTab && user_text_.empty()) {
+        OpenNewTabPage();
+      } else {
+        Dismiss();
+      }
+      return true;
+    case ui::VKEY_ESCAPE:
+      Dismiss();
+      return true;
+    default:
+      return false;
+  }
+}
+
+void CommandBarView::OnResultChanged(AutocompleteController* controller,
+                                     bool default_match_changed) {
+  RebuildEntries();
+}
+
+bool CommandBarView::IsCommandQuery() const {
+  return user_edited_ &&
+         base::TrimWhitespace(user_text_, base::TRIM_LEADING).starts_with(u">");
+}
+
+void CommandBarView::StartQuery() {
+  const std::u16string text(
+      base::TrimWhitespace(user_text_, base::TRIM_LEADING));
+  if (text.empty() || IsCommandQuery()) {
+    bang_keyword_.clear();
+    bare_bang_ = false;
+    autocomplete_controller_->Stop(AutocompleteStopReason::kClobbered);
+    RebuildEntries();
+    return;
+  }
+
+  GURL current_url;
+  if (content::WebContents* contents =
+          browser_->GetTabStripModel()->GetActiveWebContents()) {
+    current_url = contents->GetLastCommittedURL();
+  }
+  const auto page_classification =
+      mode_ == Mode::kNewTab
+          ? metrics::OmniboxEventProto::INSTANT_NTP_WITH_OMNIBOX_AS_STARTING_FOCUS
+          : metrics::OmniboxEventProto::OTHER;
+  // A bang anywhere in the text searches that site, like keyword mode in the
+  // address bar: the query is rewritten as "<bang> <rest of the text>".
+  std::u16string remaining;
+  const std::u16string keyword = base::i18n::ToLower(
+      AutocompleteInput::SplitKeywordFromInput(text, /*trim_leading_whitespace=*/
+                                               true, &remaining));
+  const TemplateURL* bang =
+      keyword.starts_with(u'!')
+          ? TemplateURLServiceFactory::GetForProfile(browser_->GetProfile())
+                ->GetTemplateURLForKeyword(keyword)
+          : nullptr;
+  const bool in_keyword_mode = bang && bang->bang_id() > 0;
+  bang_keyword_ = in_keyword_mode ? keyword : std::u16string();
+  bare_bang_ = in_keyword_mode &&
+               base::TrimWhitespace(remaining, base::TRIM_ALL).empty();
+  const std::u16string query_text =
+      in_keyword_mode ? base::StrCat({keyword, u" ", remaining}) : text;
+
+  input_ = AutocompleteInput(
+      query_text, query_text.size(), page_classification, *scheme_classifier_,
+      base::FeatureList::IsEnabled(omnibox::kDefaultTypedNavigationsToHttps));
+  if (mode_ == Mode::kCurrentTab) {
+    input_.set_current_url(current_url);
+  }
+  input_.set_in_keyword_mode(in_keyword_mode);
+  input_.set_prevent_inline_autocomplete(just_deleted_text_ ||
+                                         in_keyword_mode);
+  // Lets "keyword query" and bangs search with that engine, as when the
+  // user presses space after a keyword in the address bar.
+  input_.set_allow_exact_keyword_match(true);
+  autocomplete_controller_->Start(input_);
+}
+
+void CommandBarView::RebuildEntries() {
+  std::optional<std::string> selected_key;
+  if (user_moved_selection_ && selected_index_ &&
+      *selected_index_ < entries_.size()) {
+    selected_key = GetEntryKey(entries_[*selected_index_]);
+  }
+
+  entries_.clear();
+  const std::u16string query(
+      base::TrimWhitespace(user_text_, base::TRIM_ALL));
+  std::vector<ScoredTab> tabs =
+      GetTabs(user_edited_ ? query : std::u16string());
+
+  if (IsCommandQuery()) {
+    entries_ = GetCommandEntries(query.substr(1), kMaxCommandEntries,
+                                 /*min_term_score=*/1);
+    RebuildRows();
+    RestoreSelection(selected_key);
+    return;
+  }
+
+  if (!user_edited_ || query.empty()) {
+    // Without a query, list recently used tabs.
+    for (const ScoredTab& scored : tabs) {
+      if (entries_.size() == kMaxTabsWithoutQuery) {
+        break;
+      }
+      entries_.push_back(CreateTabEntry(scored.tab.Get()));
+    }
+    RebuildRows();
+    SetSelectedIndex(std::nullopt);
+    return;
+  }
+
+  // Autocomplete matches that open a page that is already open in a tab
+  // switch to that tab instead.
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+  std::vector<std::pair<GURL, tabs::TabHandle>> open_urls;
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != browser_->GetProfile()) {
+      continue;
+    }
+    TabStripModel* tab_strip = window->GetTabStripModel();
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+      if (window == browser_.get() && tab == tab_strip->GetActiveTab()) {
+        continue;
+      }
+      open_urls.emplace_back(
+          AutocompleteMatch::GURLToStrippedGURL(
+              tab->GetContents()->GetLastCommittedURL(), input_,
+              template_url_service, std::u16string(),
+              /*keep_search_intent_params=*/true),
+          tab->GetHandle());
+    }
+  }
+
+  std::vector<Entry> match_entries;
+  std::optional<Entry> default_entry;
+  const TemplateURL* bang =
+      bang_keyword_.empty()
+          ? nullptr
+          : template_url_service->GetTemplateURLForKeyword(bang_keyword_);
+  if (bare_bang_ && bang) {
+    default_entry = CreateBangHomeEntry(*bang);
+  }
+  const AutocompleteResult& result = autocomplete_controller_->result();
+  for (const AutocompleteMatch& match : result) {
+    // A bare bang has nothing to search for.
+    if (default_entry && bare_bang_ &&
+        AutocompleteMatch::IsSearchType(match.type)) {
+      continue;
+    }
+    Entry entry;
+    if (!AutocompleteMatch::IsSearchType(match.type)) {
+      const GURL stripped =
+          match.stripped_destination_url.is_valid()
+              ? match.stripped_destination_url
+              : AutocompleteMatch::GURLToStrippedGURL(
+                    match.destination_url, input_, template_url_service,
+                    std::u16string(), /*keep_search_intent_params=*/true);
+      auto it = std::ranges::find(open_urls, stripped,
+                                  &std::pair<GURL, tabs::TabHandle>::first);
+      if (it != open_urls.end() && it->second.Get()) {
+        entry = CreateTabEntry(it->second.Get());
+        std::erase_if(tabs, [&](const ScoredTab& scored) {
+          return scored.tab == it->second;
+        });
+      }
+    }
+    if (!entry.tab.Get()) {
+      if (!match.destination_url.is_valid()) {
+        continue;
+      }
+      entry = CreateMatchEntry(match);
+    }
+    if (&match == result.default_match() && !default_entry) {
+      entry.is_default_match = true;
+      default_entry = std::move(entry);
+    } else {
+      match_entries.push_back(std::move(entry));
+    }
+  }
+  // A tab can appear through several matches; keep its first one.
+  std::vector<tabs::TabHandle> seen_tabs;
+  if (default_entry && default_entry->tab.Get()) {
+    seen_tabs.push_back(default_entry->tab);
+  }
+  std::erase_if(match_entries, [&](const Entry& entry) {
+    if (!entry.tab.Get()) {
+      return false;
+    }
+    if (std::ranges::contains(seen_tabs, entry.tab)) {
+      return true;
+    }
+    seen_tabs.push_back(entry.tab);
+    return false;
+  });
+  std::erase_if(tabs, [&](const ScoredTab& scored) {
+    return std::ranges::contains(seen_tabs, scored.tab);
+  });
+  if (tabs.size() > kMaxTabsWithQuery) {
+    tabs.resize(kMaxTabsWithQuery);
+  }
+
+  // Tabs whose title or host matches every term are listed before a default
+  // search, so typing part of a tab's name and pressing Enter switches to it.
+  // A default URL match stays first, as in the address bar.
+  const size_t term_count =
+      base::SplitString(query, base::kWhitespaceUTF16, base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY)
+          .size();
+  const bool tabs_first =
+      !tabs.empty() && tabs.front().score >= static_cast<int>(3 * term_count) &&
+      (!default_entry ||
+       (default_entry->match &&
+        AutocompleteMatch::IsSearchType(default_entry->match->type)));
+
+  if (!tabs_first && default_entry) {
+    entries_.push_back(std::move(*default_entry));
+    default_entry.reset();
+  }
+  for (const ScoredTab& scored : tabs) {
+    entries_.push_back(CreateTabEntry(scored.tab.Get()));
+  }
+  if (default_entry) {
+    entries_.push_back(std::move(*default_entry));
+  }
+  for (Entry& entry : match_entries) {
+    entries_.push_back(std::move(entry));
+  }
+  // When Enter would switch to a tab, offer opening its page in a new tab
+  // right below.
+  if (!entries_.empty()) {
+    if (tabs::TabInterface* tab = entries_.front().tab.Get()) {
+      entries_.insert(entries_.begin() + 1, CreateReopenTabEntry(tab));
+    }
+  }
+  std::vector<Entry> commands;
+  if (query.size() >= kMinCommandQueryLength) {
+    commands = GetCommandEntries(query, kMaxCommandsWithQuery,
+                                 kMinCommandTermScoreWithQuery);
+  }
+  if (entries_.size() + commands.size() > kMaxEntries) {
+    entries_.resize(kMaxEntries - commands.size());
+  }
+  for (Entry& entry : commands) {
+    entries_.push_back(std::move(entry));
+  }
+
+  RebuildRows();
+  RestoreSelection(selected_key);
+}
+
+void CommandBarView::RestoreSelection(const std::optional<std::string>& key) {
+  std::optional<size_t> selection;
+  if (!entries_.empty()) {
+    selection = 0;
+  }
+  if (key) {
+    for (size_t i = 0; i < entries_.size(); ++i) {
+      if (GetEntryKey(entries_[i]) == *key) {
+        selection = i;
+        break;
+      }
+    }
+  }
+  SetSelectedIndex(selection);
+}
+
+void CommandBarView::RebuildRows() {
+  ++generation_;
+  favicon_tracker_.TryCancelAll();
+  rows_.clear();
+  results_->RemoveAllChildViews();
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    rows_.push_back(results_->AddChildView(std::make_unique<RowView>(
+        entries_[i],
+        base::BindRepeating(
+            [](CommandBarView* view, size_t index, const ui::Event& event) {
+              view->OpenEntry(index, view->DispositionForFlags(event.flags()));
+            },
+            base::Unretained(this), i),
+        base::BindRepeating(
+            [](CommandBarView* view, size_t index) {
+              if (view->selected_index_ != index) {
+                view->user_moved_selection_ = true;
+                view->SetSelectedIndex(index);
+              }
+            },
+            base::Unretained(this), i))));
+  }
+  separator_->SetVisible(!entries_.empty());
+  FetchFavicons();
+  if (views::Widget* widget = GetWidget()) {
+    widget->widget_delegate()->AsBubbleDialogDelegate()->SizeToContents();
+  }
+}
+
+void CommandBarView::SetSelectedIndex(std::optional<size_t> index) {
+  selected_index_ = index;
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    rows_[i]->SetSelected(index == i);
+  }
+  UpdateEngineChip();
+
+  // The input icon mirrors what Enter does.
+  const bool switches_tab = index && *index < entries_.size() &&
+                            entries_[*index].tab.Get();
+  input_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      IsCommandQuery() ? vector_icons::kKeyboardIcon
+      : switches_tab   ? omnibox::kTabIcon
+                       : vector_icons::kSearchIcon,
+      kColorOmniboxResultsIcon, 20));
+  ApplyInlineAutocompletion();
+}
+
+void CommandBarView::UpdateEngineChip() {
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+  const TemplateURL* engine = nullptr;
+  const AutocompleteMatch* match = nullptr;
+  if (selected_index_ && *selected_index_ < entries_.size() &&
+      entries_[*selected_index_].match) {
+    match = &*entries_[*selected_index_].match;
+    if (AutocompleteMatch::IsSearchType(match->type)) {
+      engine = match->GetTemplateURL(template_url_service);
+    }
+  }
+  // A typed bang decides where the search goes, whatever is selected.
+  if (!bang_keyword_.empty()) {
+    if (const TemplateURL* bang =
+            template_url_service->GetTemplateURLForKeyword(bang_keyword_)) {
+      engine = bang;
+    }
+  }
+  if (engine == template_url_service->GetDefaultSearchProvider()) {
+    engine = nullptr;
+  }
+
+  const bool was_visible = engine_row_->GetVisible();
+  engine_row_->SetVisible(engine);
+  if (!engine) {
+    engine_keyword_.clear();
+    engine_favicon_tracker_.TryCancelAll();
+  } else if (engine->keyword() != engine_keyword_) {
+    engine_keyword_ = engine->keyword();
+    const bool is_ai = engine->bang_id() > 0 &&
+                       engine->bang_category() == Bangs::BANG_CATEGORY_AI;
+    engine_label_->SetText(l10n_util::GetStringFUTF16(
+        is_ai ? IDS_OMNIBOX_SELECTED_KEYWORD_ASK_TEXT
+              : IDS_HELIUM_COMMAND_BAR_SEARCH_WITH,
+        engine->short_name()));
+    const GURL home = GURL(engine->url()).GetWithEmptyPath();
+    std::string host(home.host());
+    if (host.starts_with("www.")) {
+      host.erase(0, 4);
+    }
+    engine_host_->SetText(base::UTF8ToUTF16(host));
+    engine_host_->SetVisible(!host.empty());
+    engine_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        vector_icons::kSearchIcon, kColorOmniboxResultsIcon, kIconSize));
+
+    engine_favicon_tracker_.TryCancelAll();
+    if (favicon::FaviconService* favicon_service =
+            FaviconServiceFactory::GetForProfile(
+                browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS)) {
+      auto callback = base::BindOnce(&CommandBarView::OnEngineFaviconFetched,
+                                     weak_factory_.GetWeakPtr());
+      if (engine->favicon_url().is_valid()) {
+        favicon_service->GetFaviconImage(engine->favicon_url(),
+                                         std::move(callback),
+                                         &engine_favicon_tracker_);
+      } else {
+        favicon_service->GetFaviconImageForPageURL(
+            home, std::move(callback), &engine_favicon_tracker_);
+      }
+    }
+  }
+
+  if (was_visible != engine_row_->GetVisible()) {
+    if (views::Widget* widget = GetWidget()) {
+      widget->widget_delegate()->AsBubbleDialogDelegate()->SizeToContents();
+    }
+  }
+}
+
+void CommandBarView::OnEngineFaviconFetched(
+    const favicon_base::FaviconImageResult& result) {
+  if (!result.image.IsEmpty()) {
+    engine_icon_->SetImage(ui::ImageModel::FromImage(result.image));
+  }
+}
+
+void CommandBarView::ApplyInlineAutocompletion() {
+  if (!user_edited_) {
+    return;
+  }
+  std::u16string inline_autocompletion;
+  if (selected_index_ == 0 && !entries_.empty() &&
+      entries_[0].is_default_match && entries_[0].match &&
+      !just_deleted_text_ &&
+      textfield_->GetCursorPosition() >= user_text_.size()) {
+    inline_autocompletion = entries_[0].match->inline_autocompletion;
+  }
+  const std::u16string text = user_text_ + inline_autocompletion;
+  if (textfield_->GetText() == text) {
+    return;
+  }
+  textfield_->SetText(text);
+  textfield_->SetSelectedRange(gfx::Range(text.size(), user_text_.size()));
+}
+
+void CommandBarView::OpenEntry(size_t index,
+                               WindowOpenDisposition disposition) {
+  if (index >= entries_.size()) {
+    return;
+  }
+  // Copy, since opening may rebuild or destroy this view.
+  const Entry entry = entries_[index];
+  if (tabs::TabInterface* tab = entry.tab.Get()) {
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    if (window) {
+      TabStripModel* tab_strip = window->GetTabStripModel();
+      tab_strip->ActivateTab(
+          tab, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kKeyboard));
+      if (window != browser_.get()) {
+        window->GetWindow()->Activate();
+      }
+    }
+    Dismiss();
+    return;
+  }
+  if (entry.command) {
+    // Run once the overlay has closed, so commands that move focus, such as
+    // find in page, keep it.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<BrowserWindowInterface> browser,
+               const CommandBarCommand* command) {
+              if (browser) {
+                RunCommandBarCommand(*command, browser.get());
+              }
+            },
+            browser_->GetWeakPtr(), entry.command.get()));
+    Dismiss();
+    return;
+  }
+  if (entry.match) {
+    autocomplete_controller_->Stop(AutocompleteStopReason::kInteraction);
+    OpenMatch(*entry.match, disposition);
+  }
+  Dismiss();
+}
+
+void CommandBarView::OpenMatch(const AutocompleteMatch& match,
+                               WindowOpenDisposition disposition) {
+  if (!match.destination_url.is_valid()) {
+    return;
+  }
+
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+  if (TemplateURL* template_url = match.GetTemplateURL(template_url_service);
+      template_url && ui::PageTransitionTypeIncludingQualifiersIs(
+                          match.transition, ui::PAGE_TRANSITION_KEYWORD)) {
+    template_url_service->IncrementUsageCount(template_url);
+  }
+
+  std::string extra_headers;
+  for (const auto& header : match.extra_headers) {
+    base::StrAppend(&extra_headers,
+                    {header.first, ": ", header.second, "\r\n"});
+  }
+
+  const ui::PageTransition transition = ui::PageTransitionFromInt(
+      match.transition | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  const bool typed_without_scheme = input_.added_default_scheme_to_typed_url();
+  const bool typed_with_http_scheme =
+      input_.typed_url_had_http_scheme() &&
+      match.type == omnibox::AutocompleteMatchType::kUrlWhatYouTyped;
+
+  // Go through the location bar so navigations get the same handling as
+  // address bar navigations.
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser_);
+  if (LocationBar* location_bar = window ? window->GetLocationBar() : nullptr) {
+    location_bar->set_navigation_params(LocationBar::NavigationParams{
+        .destination_url = match.destination_url,
+        .disposition = disposition,
+        .transition = transition,
+        .match_selection_timestamp = base::TimeTicks::Now(),
+        .url_typed_without_scheme = typed_without_scheme,
+        .url_typed_with_http_scheme = typed_with_http_scheme,
+        .extra_headers = extra_headers,
+    });
+    chrome::OpenCurrentURL(browser_);
+    return;
+  }
+
+  NavigateParams params(browser_, match.destination_url, transition);
+  params.disposition = disposition;
+  params.is_using_https_as_default_scheme = typed_without_scheme;
+  params.url_typed_with_http_scheme = typed_with_http_scheme;
+  params.extra_headers = extra_headers;
+  Navigate(&params);
+}
+
+void CommandBarView::OpenNewTabPage() {
+  BrowserWindowInterface* browser = browser_;
+  Dismiss();
+  chrome::NewTab(browser, NewTabTypes::kNewTabCommand);
+}
+
+void CommandBarView::Dismiss() {
+  if (views::Widget* widget = GetWidget()) {
+    widget->Close();
+  }
+}
+
+WindowOpenDisposition CommandBarView::DispositionForFlags(
+    int event_flags) const {
+  return ui::DispositionFromEventFlags(
+      event_flags, mode_ == Mode::kNewTab
+                       ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                       : WindowOpenDisposition::CURRENT_TAB);
+}
+
+std::vector<CommandBarView::ScoredTab> CommandBarView::GetTabs(
+    const std::u16string& query) const {
+  const std::vector<std::u16string> terms =
+      base::SplitString(base::i18n::ToLower(query), base::kWhitespaceUTF16,
+                        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+
+  std::vector<ScoredTab> tabs;
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != browser_->GetProfile()) {
+      continue;
+    }
+    TabStripModel* tab_strip = window->GetTabStripModel();
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+      if (window == browser_.get() && tab == tab_strip->GetActiveTab()) {
+        continue;
+      }
+      content::WebContents* contents = tab->GetContents();
+      const GURL& url = contents->GetLastCommittedURL();
+      int score = 1;
+      if (!terms.empty()) {
+        score = ScoreTab(terms, contents->GetTitle(), url);
+      } else if (IsNewTabPageUrl(url)) {
+        score = 0;
+      }
+      if (score > 0) {
+        tabs.push_back({tab->GetHandle(), score, contents->GetLastActiveTime()});
+      }
+    }
+  }
+  std::ranges::sort(tabs, [](const ScoredTab& a, const ScoredTab& b) {
+    if (a.score != b.score) {
+      return a.score > b.score;
+    }
+    return a.last_active > b.last_active;
+  });
+  return tabs;
+}
+
+CommandBarView::Entry CommandBarView::CreateTabEntry(
+    tabs::TabInterface* tab) const {
+  Entry entry;
+  entry.tab = tab->GetHandle();
+  content::WebContents* contents = tab->GetContents();
+  const GURL& url = contents->GetLastCommittedURL();
+  entry.title = contents->GetTitle();
+  if (entry.title.empty()) {
+    entry.title = FormatUrlForDisplay(url);
+  }
+  entry.detail = FormatUrlForDisplay(url);
+
+  gfx::Image favicon;
+  if (auto* driver =
+          favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    favicon = driver->GetFavicon();
+  }
+  entry.icon = favicon.IsEmpty()
+                   ? ui::ImageModel::FromVectorIcon(
+                         omnibox::kTabIcon, kColorOmniboxResultsIcon, kIconSize)
+                   : ui::ImageModel::FromImage(favicon);
+  entry.action =
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_SWITCH_TO_TAB);
+  entry.always_show_action = true;
+  return entry;
+}
+
+CommandBarView::Entry CommandBarView::CreateMatchEntry(
+    const AutocompleteMatch& match) const {
+  Entry entry;
+  entry.match = match;
+  if (AutocompleteMatch::IsSearchType(match.type)) {
+    entry.title = match.contents;
+    entry.detail = match.description;
+  } else {
+    entry.title = match.description.empty() ? match.contents
+                                            : match.description;
+    entry.detail = match.description.empty() ? std::u16string()
+                                             : match.contents;
+    entry.favicon_url = match.destination_url;
+  }
+
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+  entry.icon = ui::ImageModel::FromVectorIcon(
+      match.GetVectorIcon(/*is_bookmark=*/false,
+                          match.GetTemplateURL(template_url_service)),
+      kColorOmniboxResultsIcon, kIconSize);
+  const bool is_search = AutocompleteMatch::IsSearchType(match.type);
+  if (mode_ == Mode::kNewTab) {
+    entry.action = l10n_util::GetStringUTF16(
+        is_search ? IDS_HELIUM_COMMAND_BAR_SEARCH_IN_NEW_TAB
+                  : IDS_HELIUM_COMMAND_BAR_OPEN_IN_NEW_TAB);
+  } else {
+    entry.action = l10n_util::GetStringUTF16(
+        is_search ? IDS_HELIUM_COMMAND_BAR_SEARCH : IDS_HELIUM_COMMAND_BAR_OPEN);
+  }
+  return entry;
+}
+
+CommandBarView::Entry CommandBarView::CreateBangHomeEntry(
+    const TemplateURL& bang) const {
+  AutocompleteMatch match(nullptr, 0, false,
+                          omnibox::AutocompleteMatchType::kNavsuggest);
+  match.destination_url = GURL(bang.url()).GetWithEmptyPath();
+  match.transition = ui::PAGE_TRANSITION_TYPED;
+  match.contents = FormatUrlForDisplay(match.destination_url);
+  match.description = bang.short_name();
+
+  Entry entry = CreateMatchEntry(match);
+  entry.is_default_match = true;
+  return entry;
+}
+
+CommandBarView::Entry CommandBarView::CreateReopenTabEntry(
+    tabs::TabInterface* tab) const {
+  content::WebContents* contents = tab->GetContents();
+  AutocompleteMatch match(nullptr, 0, false,
+                          omnibox::AutocompleteMatchType::kHistoryUrl);
+  match.destination_url = contents->GetLastCommittedURL();
+  match.transition = ui::PAGE_TRANSITION_TYPED;
+  match.contents = FormatUrlForDisplay(match.destination_url);
+  match.description = contents->GetTitle();
+
+  // Lead with the address so the row reads differently from the tab above.
+  Entry entry = CreateMatchEntry(match);
+  entry.title = match.contents;
+  entry.detail = match.description;
+  entry.always_show_action = true;
+  return entry;
+}
+
+std::vector<CommandBarView::Entry> CommandBarView::GetCommandEntries(
+    const std::u16string& query,
+    size_t max_entries,
+    int min_term_score) const {
+  const std::vector<std::u16string> terms =
+      base::SplitString(base::i18n::ToLower(query), base::kWhitespaceUTF16,
+                        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::vector<std::pair<int, Entry>> scored;
+  for (const CommandBarCommand& command : GetCommandBarCommands()) {
+    if (!IsCommandBarCommandAvailable(command, browser_)) {
+      continue;
+    }
+    Entry entry;
+    entry.command = &command;
+    entry.title = GetCommandBarCommandLabel(command, browser_);
+    int score = 1;
+    if (!terms.empty()) {
+      score = ScoreCommandBarCommand(command, entry.title, terms);
+      if (score < min_term_score * static_cast<int>(terms.size())) {
+        continue;
+      }
+    }
+    entry.shortcut = GetCommandBarCommandShortcut(command, browser_);
+    entry.icon = ui::ImageModel::FromVectorIcon(
+        *command.icon, kColorOmniboxResultsIcon, kIconSize);
+    entry.action = l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_RUN);
+    scored.emplace_back(score, std::move(entry));
+  }
+  std::ranges::stable_sort(scored, std::ranges::greater(),
+                           &std::pair<int, Entry>::first);
+
+  std::vector<Entry> entries;
+  for (auto& [score, entry] : scored) {
+    if (entries.size() == max_entries) {
+      break;
+    }
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
+
+std::string CommandBarView::GetEntryKey(const Entry& entry) const {
+  if (entry.command) {
+    return base::StrCat(
+        {"command:", base::NumberToString(entry.command->label_id)});
+  }
+  if (entry.tab.Get()) {
+    return base::StrCat({"tab:", base::NumberToString(entry.tab.raw_value())});
+  }
+  if (entry.match) {
+    return base::StrCat({"url:", entry.match->destination_url.spec()});
+  }
+  return std::string();
+}
+
+void CommandBarView::FetchFavicons() {
+  favicon::FaviconService* favicon_service =
+      FaviconServiceFactory::GetForProfile(browser_->GetProfile(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicon_service) {
+    return;
+  }
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    if (!entries_[i].favicon_url.is_valid()) {
+      continue;
+    }
+    favicon_service->GetFaviconImageForPageURL(
+        entries_[i].favicon_url,
+        base::BindOnce(&CommandBarView::OnFaviconFetched,
+                       weak_factory_.GetWeakPtr(), i, generation_),
+        &favicon_tracker_);
+  }
+}
+
+void CommandBarView::OnFaviconFetched(
+    size_t index,
+    int generation,
+    const favicon_base::FaviconImageResult& result) {
+  if (generation != generation_ || index >= rows_.size() ||
+      result.image.IsEmpty()) {
+    return;
+  }
+  entries_[index].icon = ui::ImageModel::FromImage(result.image);
+  rows_[index]->SetIcon(entries_[index].icon);
+}
