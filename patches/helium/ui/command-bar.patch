+// The contents of a large search overlay centered over the browser window.
+// When enabled, it replaces the integrated address bar for the new tab and
+// focus address bar commands, and suggests open tabs alongside the regular
+// autocomplete results.
+class CommandBarView : public views::View,
+                       public views::TextfieldController,
+                       public AutocompleteController::Observer {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
+  enum class Mode {
+    // Results open in a new tab. Dismissing the overlay creates nothing.
+    kNewTab,
+    // Results replace the current tab, which starts with its URL selected.
+    kCurrentTab,
+  };
+
+  // Shows the overlay for `browser` if the user enabled it. If it is already
+  // showing in `mode`, it is closed instead. Returns false if the caller should
+  // fall back to the default command behavior.
+  static bool MaybeShow(BrowserWindowInterface* browser, Mode mode);
+
+  CommandBarView(BrowserWindowInterface* browser, Mode mode);
+  CommandBarView(const CommandBarView&) = delete;
+  CommandBarView& operator=(const CommandBarView&) = delete;
+  ~CommandBarView() override;
+
+  views::Textfield* textfield() { return textfield_; }
+
+  // views::View:
+  void RemovedFromWidget() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+
+ private:
+  class Bubble;
+  class RowView;
+
+  struct Entry {
+    Entry();
+    Entry(const Entry&);
+    Entry& operator=(const Entry&);
+    ~Entry();
+
+    // Set when the entry switches to an open tab.
+    tabs::TabHandle tab;
+    // Set when the entry opens an autocomplete match.
+    std::optional<AutocompleteMatch> match;
+    // Whether this is the autocomplete result's default match.
+    bool is_default_match = false;
+    std::u16string title;
+    std::u16string detail;
+    ui::ImageModel icon;
+    // The page whose favicon should replace `icon`, if any.
+    GURL favicon_url;
+  };
+
+  struct ScoredTab {
+    tabs::TabHandle tab;
+    int score = 0;
+    base::Time last_active;
+  };
+
+  void StartQuery();
+  void RebuildEntries();
+  void RebuildRows();
+  void SetSelectedIndex(std::optional<size_t> index);
+  void ApplyInlineAutocompletion();
+  void OpenEntry(size_t index, WindowOpenDisposition disposition);
+  void OpenMatch(const AutocompleteMatch& match,
+                 WindowOpenDisposition disposition);
+  void OpenNewTabPage();
+  void Dismiss();
+  WindowOpenDisposition DispositionForFlags(int event_flags) const;
+
+  // Open tabs in this profile, most recently used first. The active tab of
+  // this window is skipped.
+  std::vector<ScoredTab> GetTabs(const std::u16string& query) const;
+  Entry CreateTabEntry(tabs::TabInterface* tab) const;
+  Entry CreateMatchEntry(const AutocompleteMatch& match) const;
+  std::string GetEntryKey(const Entry& entry) const;
+  void FetchFavicons();
+  void OnFaviconFetched(size_t index,
+                        int generation,
+                        const favicon_base::FaviconImageResult& result);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const Mode mode_;
+
+  std::unique_ptr<ChromeAutocompleteSchemeClassifier> scheme_classifier_;
+  std::unique_ptr<AutocompleteController> autocomplete_controller_;
+  AutocompleteInput input_;
+
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  raw_ptr<views::View> results_ = nullptr;
+  raw_ptr<views::View> separator_ = nullptr;
+
+  // What the user typed, excluding inline autocompletion.
+  std::u16string user_text_;
+  // Whether the pending edit comes from a delete key.
+  bool deleting_ = false;
+  bool just_deleted_text_ = false;
+  bool user_edited_ = false;
+  bool user_moved_selection_ = false;
+
+  std::vector<Entry> entries_;
+  std::vector<raw_ptr<RowView>> rows_;
+  std::optional<size_t> selected_index_;
+  int generation_ = 0;
+  base::CancelableTaskTracker favicon_tracker_;
+
+  base::WeakPtrFactory<CommandBarView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_VIEW_H_
