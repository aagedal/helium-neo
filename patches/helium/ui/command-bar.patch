+bool IsNewTabPageUrl(const GURL& url) {
+  return url.is_empty() || url.IsAboutBlank() ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          url.host() == chrome::kChromeUINewTabHost);
+}
+
+std::u16string FormatUrlForDisplay(const GURL& url) {
+  return url_formatter::FormatUrl(
+      url,
+      AutocompleteMatch::GetFormatTypes(/*preserve_scheme=*/false,
+                                        /*preserve_subdomain=*/false),
+      base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+}
+
+// Scores how well an open tab matches `terms`. Every term must appear in the
+// tab's title or URL. Prefix matches on title words and host matches count
+// three times as much as other substring matches. Returns 0 for no match.
+int ScoreTab(const std::vector<std::u16string>& terms,
+             const std::u16string& title,
+             const GURL& url) {
+  const std::u16string lower_title = base::i18n::ToLower(title);
+  const std::u16string lower_host =
+      base::i18n::ToLower(base::UTF8ToUTF16(url.host()));
+  const std::u16string lower_url =
+      base::i18n::ToLower(base::UTF8ToUTF16(url.spec()));
+  const std::vector<std::u16string> title_words = base::SplitString(
+      lower_title, u" \t-_|:/.,()[]", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+
+  int score = 0;
+  for (const auto& term : terms) {
+    const bool title_prefix =
+        std::ranges::any_of(title_words, [&](const std::u16string& word) {
+          return word.starts_with(term);
+        });
+    if (title_prefix || lower_host.find(term) != std::u16string::npos) {
+      score += 3;
+    } else if (lower_title.find(term) != std::u16string::npos ||
+               lower_url.find(term) != std::u16string::npos) {
+      score += 1;
+    } else {
+      return 0;
+    }
+  }
+  return score;
+}
