+// A single result row.
+class CommandBarView::RowView : public views::Button {
+  METADATA_HEADER(RowView, views::Button)
+
+ public:
+  RowView(const Entry& entry,
+          PressedCallback pressed,
+          base::RepeatingClosure hovered)
+      : views::Button(std::move(pressed)), hovered_(std::move(hovered)) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+                         views::BoxLayout::Orientation::kHorizontal,
+                         gfx::Insets::VH(8, 12), 12))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kCenter);
+    // The textfield keeps focus; rows are activated with the arrow keys.
+    SetFocusBehavior(FocusBehavior::NEVER);
+
+    icon_ = AddChildView(std::make_unique<views::ImageView>());
+    icon_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+    icon_->SetImage(entry.icon);
+
+    auto* text = AddChildView(std::make_unique<views::BoxLayoutView>());
+    text->SetOrientation(views::BoxLayout::Orientation::kVertical);
+    title_ = text->AddChildView(std::make_unique<views::Label>(entry.title));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    if (!entry.detail.empty()) {
+      detail_ =
+          text->AddChildView(std::make_unique<views::Label>(entry.detail));
+      detail_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      detail_->SetElideBehavior(gfx::ELIDE_MIDDLE);
+      detail_->SetFontList(
+          detail_->font_list().DeriveWithSizeDelta(-1));
+    }
+    static_cast<views::BoxLayout*>(GetLayoutManager())
+        ->SetFlexForView(text, 1);
+
+    if (entry.tab.Get()) {
+      hint_ = AddChildView(std::make_unique<views::Label>(
+          l10n_util::GetStringUTF16(IDS_OMNIBOX_TAB_SUGGEST_HINT)));
+      hint_->SetFontList(hint_->font_list().DeriveWithSizeDelta(-1));
+    }
+
+    GetViewAccessibility().SetName(
+        entry.detail.empty() ? entry.title
+                             : base::StrCat({entry.title, u", ",
+                                             entry.detail}));
+    UpdateColors();
+  }
+
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    UpdateColors();
+  }
+
+  void SetIcon(const ui::ImageModel& icon) { icon_->SetImage(icon); }
+
+  // views::Button:
+  void OnMouseMoved(const ui::MouseEvent& event) override {
+    // Only real pointer movement selects a row, so rows rebuilt under a
+    // resting pointer don't steal the keyboard selection.
+    hovered_.Run();
+    views::Button::OnMouseMoved(event);
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateColors();
+  }
+
+ private:
+  void UpdateColors() {
+    const bool hovered = GetState() == STATE_HOVERED;
+    if (selected_) {
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorOmniboxResultsBackgroundSelected, kRowCornerRadius));
+    } else if (hovered) {
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorOmniboxResultsBackgroundHovered, kRowCornerRadius));
+    } else {
+      SetBackground(nullptr);
+    }
+    title_->SetEnabledColor(selected_ ? kColorOmniboxResultsTextSelected
+                                      : kColorOmniboxText);
+    if (detail_) {
+      detail_->SetEnabledColor(selected_
+                                   ? kColorOmniboxResultsTextDimmedSelected
+                                   : kColorOmniboxResultsTextDimmed);
+    }
+    if (hint_) {
+      hint_->SetEnabledColor(selected_ ? kColorOmniboxResultsUrlSelected
+                                       : kColorOmniboxResultsUrl);
+    }
+  }
+
+  base::RepeatingClosure hovered_;
+  bool selected_ = false;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> detail_ = nullptr;
+  raw_ptr<views::Label> hint_ = nullptr;
+};
