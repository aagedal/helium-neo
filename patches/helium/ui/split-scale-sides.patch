+void SplitLayoutTree::ResizeDividerScalingSides(size_t node,
+                                                size_t index,
+                                                int before_size,
+                                                int total_size,
+                                                int minimum_size) {
+  size_t remaining = node;
+  SplitLayoutNode* container = FindNode(root_, remaining);
+  if (!container || index + 1 >= container->children.size() ||
+      total_size <= 0) {
+    return;
+  }
+  const int count = static_cast<int>(container->children.size());
+  const int before_count = static_cast<int>(index) + 1;
+  const int minimum = std::clamp(minimum_size, 0, total_size / count);
+  const int before =
+      std::clamp(before_size, minimum * before_count,
+                 total_size - minimum * (count - before_count));
+  if (std::abs(before - total_size * before_count / count) <= kSnapDistance) {
+    for (auto& child : container->children) {
+      child.weight = 1;
+    }
+    return;
+  }
+  double before_weight = 0;
+  double total_weight = 0;
+  for (int i = 0; i < count; ++i) {
+    total_weight += container->children[i].weight;
+    if (i < before_count) {
+      before_weight += container->children[i].weight;
+    }
+  }
+  // Keep positive weights even when the window has almost no room left.
+  const double ratio =
+      std::clamp(static_cast<double>(before) / total_size, 0.01, 0.99);
+  for (int i = 0; i < count; ++i) {
+    container->children[i].weight *=
+        i < before_count ? total_weight * ratio / before_weight
+                         : total_weight * (1 - ratio) /
+                               (total_weight - before_weight);
+  }
+}
