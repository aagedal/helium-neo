+// Shows the download overlay once the screenshot is saved, then deletes
+// itself.
+class SavedScreenshotWatcher : public download::DownloadItem::Observer {
+ public:
+  static void Watch(download::DownloadItem* item,
+                    base::WeakPtr<content::WebContents> web_contents) {
+    auto* watcher = new SavedScreenshotWatcher(item, std::move(web_contents));
+    watcher->OnDownloadUpdated(item);
+  }
+
+  SavedScreenshotWatcher(const SavedScreenshotWatcher&) = delete;
+  SavedScreenshotWatcher& operator=(const SavedScreenshotWatcher&) = delete;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    switch (item->GetState()) {
+      case download::DownloadItem::IN_PROGRESS:
+        return;
+      case download::DownloadItem::COMPLETE:
+        if (web_contents_) {
+          if (BrowserView* browser_view = GetBrowserView(web_contents_.get())) {
+            HeliumDownloadOverlay::Show(browser_view, item);
+          }
+        }
+        break;
+      case download::DownloadItem::INTERRUPTED:
+        if (web_contents_) {
+          ShowFailure(web_contents_.get());
+        }
+        break;
+      default:
+        break;
+    }
+    Stop();
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override { Stop(); }
+
+ private:
+  SavedScreenshotWatcher(download::DownloadItem* item,
+                         base::WeakPtr<content::WebContents> web_contents)
+      : item_(item), web_contents_(std::move(web_contents)) {
+    item_->AddObserver(this);
+  }
+  ~SavedScreenshotWatcher() override = default;
+
+  void Stop() {
+    item_->RemoveObserver(this);
+    delete this;
+  }
+
+  const raw_ptr<download::DownloadItem> item_;
+  const base::WeakPtr<content::WebContents> web_contents_;
+};
+
+void DownloadStarted(base::WeakPtr<content::WebContents> web_contents,
+                     const image_editor::ScreenshotCaptureResult& capture,
+                     const std::string& guid,
+                     download::DownloadItem* item,
+                     download::DownloadInterruptReason reason) {
+  if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+    helium::ClearDownloadTargetPath(guid);
+    if (web_contents) {
+      ShowFailure(web_contents.get());
+    }
+    return;
+  }
+  HeliumDownloadOverlay::SetExtraAction(
+      item, kEditIcon,
+      l10n_util::GetStringUTF16(IDS_NEO_CAPTURE_EDIT_METADATA),
+      base::BindRepeating(&EditMetadata, web_contents, capture, guid));
+  SavedScreenshotWatcher::Watch(item, std::move(web_contents));
+}
+
+void BlobReady(base::WeakPtr<content::WebContents> web_contents,
+               const image_editor::ScreenshotCaptureResult& capture,
+               const base::FilePath& path,
+               std::unique_ptr<std::string> bytes,
+               std::unique_ptr<content::BlobHandle> blob) {
+  if (!web_contents) {
+    return;
+  }
+  if (!blob) {
+    ShowFailure(web_contents.get());
+    return;
+  }
+  const GURL url("blob:" + url::Origin::Create(capture.page_url).Serialize() +
+                 "/" + blob->GetUUID());
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+  storage::BlobURLLoaderFactory::Create(
+      blob->PassBlob(), url, remote.InitWithNewPipeAndPassReceiver());
+  auto factory = base::MakeRefCounted<network::WrapperSharedURLLoaderFactory>(
+      std::move(remote));
+  constexpr auto kTrafficAnnotation =
+      net::DefineNetworkTrafficAnnotation("desktop_screenshot_save", R"(
+      semantics {
+        sender: "Screenshot source documentation"
+        description: "Saves a user-selected screenshot and source documentation "
+                     "as a local image or ZIP archive via a browser-created blob."
+        trigger: "User selects an area to capture as a screenshot."
+        data: "Screenshot, page URL and title, times and user-entered source notes."
+        destination: LOCAL
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Only runs when explicitly requested by the user."
+        chrome_policy {
+          DisableScreenshots { DisableScreenshots: true }
+        }
+      })");
+  auto params =
+      content::DownloadRequestUtils::CreateDownloadForWebContentsMainFrame(
+          web_contents.get(), url, kTrafficAnnotation);
+  // A path set on the parameters would make the download temporary, which
+  // keeps it out of the downloads bubble and the overlay.
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  helium::SetDownloadTargetPath(guid, path);
+  params->set_guid(guid);
+  params->set_prompt(false);
+  params->set_callback(
+      base::BindOnce(&DownloadStarted, web_contents, capture, guid));
+  Profile::FromBrowserContext(web_contents->GetBrowserContext())
+      ->GetDownloadManager()
+      ->DownloadUrl(std::move(params), std::move(factory));
+}
+
+void ExportReady(base::WeakPtr<content::WebContents> web_contents,
+                 const image_editor::ScreenshotCaptureResult& capture,
+                 SavedExport result) {
+  if (!web_contents) {
+    return;
+  }
+  if (result.path.empty()) {
+    ShowFailure(web_contents.get());
+    return;
+  }
+  // A blob avoids URL/IPC length limits and the extra base64 copy for large
+  // images. BrowserContext posts the span to IO without owning its bytes, so
+  // keep them in the callback until blob creation finishes.
+  auto bytes = std::make_unique<std::string>(std::move(result.file.bytes));
+  const auto data = base::as_byte_span(*bytes);
+  web_contents->GetBrowserContext()->CreateMemoryBackedBlob(
+      data, result.file.mime_type,
+      base::BindOnce(&BlobReady, web_contents, capture, result.path,
+                     std::move(bytes)));
+}
