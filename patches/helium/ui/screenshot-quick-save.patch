+base::DictValue ScreenshotUnreviewedUserFields(const std::string& captured_by) {
+  base::DictValue user;
+  user.Set("post_permalink", "");
+  user.Set("post_permalink_origin", "not_supplied");
+  user.Set("captured_by", captured_by);
+  user.Set("captured_by_origin",
+           captured_by.empty() ? "not_supplied" : "user_entered");
+  for (const char* field : {"posting_account", "publication_date_text",
+                            "post_text", "alt_text", "notes"}) {
+    user.Set(field, "");
+    user.Set(std::string(field) + "_origin", "not_supplied");
+  }
+  return user;
+}
