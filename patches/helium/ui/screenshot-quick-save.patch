+void QuickSaveScreenshot(content::WebContents* web_contents,
+                         const image_editor::ScreenshotCaptureResult& capture) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  PrefService* prefs = profile->GetPrefs();
+  base::FilePath directory = prefs->GetFilePath(kScreenshotDirectoryPref);
+  if (directory.empty()) {
+    directory = DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          &ExportForFolder,
+          capture.high_precision_available ? capture.high_precision_bitmap
+                                           : *capture.image.ToSkBitmap(),
+          ScreenshotAutomaticFields(capture),
+          ScreenshotUnreviewedUserFields(
+              prefs->GetString(kScreenshotCapturedByPref)),
+          static_cast<ScreenshotFormat>(
+              std::clamp(prefs->GetInteger(kScreenshotFormatPref), 0, 2)),
+          prefs->GetBoolean(kScreenshotBundlePref),
+          prefs->GetBoolean(kScreenshotPreserveHDRPref),
+          static_cast<ScreenshotTextLanguage>(
+              GetScreenshotTextLanguage(prefs)),
+          directory,
+          ScreenshotFilenameStem(capture.page_url, capture.page_title,
+                                 capture.capture_started_at)),
+      base::BindOnce(&ExportReady, web_contents->GetWeakPtr(), capture));
+}
