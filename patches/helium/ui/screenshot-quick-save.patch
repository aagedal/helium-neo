+struct SavedExport {
+  ScreenshotExport file;
+  // A free path for the file, or empty when it could not be exported.
+  base::FilePath path;
+};
+
+SavedExport ExportForFolder(const SkBitmap& bitmap,
+                            base::DictValue automatic,
+                            base::DictValue user,
+                            ScreenshotFormat format,
+                            bool bundle,
+                            bool preserve_hdr,
+                            ScreenshotTextLanguage language,
+                            const base::FilePath& directory,
+                            const std::string& stem) {
+  // Keep HDR content, as the metadata editor does when it finds some.
+  if (preserve_hdr && image_editor::AnalyzeScreenshotColor(bitmap).hdr) {
+    format = ScreenshotFormat::kJpegXL;
+  }
+  SavedExport result;
+  result.file = CreateScreenshotExport(bitmap, std::move(automatic),
+                                       std::move(user), format, bundle,
+                                       preserve_hdr, language);
+  if (!result.file.bytes.empty() && base::CreateDirectory(directory)) {
+    result.path = base::GetUniquePath(directory.Append(
+        base::FilePath::FromUTF8Unsafe(stem + "." + result.file.extension)));
+  }
+  return result;
+}
+
+void ShowFailure(content::WebContents* web_contents) {
+  chrome::ShowWarningMessageBoxAsync(
+      web_contents->GetTopLevelNativeWindow(),
+      l10n_util::GetStringUTF16(IDS_NEO_CAPTURE_TITLE),
+      l10n_util::GetStringUTF16(IDS_NEO_CAPTURE_FAILED));
+}
+
+BrowserView* GetBrowserView(content::WebContents* web_contents) {
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(web_contents);
+  return browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+}
+
+void EditMetadata(base::WeakPtr<content::WebContents> web_contents,
+                  const image_editor::ScreenshotCaptureResult& capture,
+                  const std::string& download_guid) {
+  if (!web_contents) {
+    return;
+  }
+  if (BrowserWindowInterface* browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              web_contents.get())) {
+    SharingHubWindowController::From(browser)->ShowScreenshotCapturedBubble(
+        web_contents.get(), capture, download_guid);
+  }
+}
