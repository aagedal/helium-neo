+  if ([error.domain isEqualToString:kNeoSourceProbeErrorDomain]) {
+    probeCycleFinished_ = YES;
+    [self restartAfterProbeIfReady];
+    return;
+  }
+  skipProbe_ = NO;
+  if (error && [self canRetryOnPrimary:error]) {
+    retriedPrimary_ = YES;
+    preferMirror_ = NO;
+    downloadingFromMirror_ = NO;
+    skipProbe_ = YES;
+    [self updateStatus:VersionUpdater::CHECKING error_string:nil];
+    [updater checkForUpdatesInBackground];
+  } else if (error && [self canRetryOnMirror:error]) {
+    usingMirror_ = YES;
+    downloadingFromMirror_ = NO;
+    [self updateStatus:VersionUpdater::CHECKING error_string:nil];
+    // Start here while Sparkle is idle. Queuing this lets its scheduler reserve
+    // another session first, causing checkForUpdatesInBackground to be ignored.
+    [updater checkForUpdatesInBackground];
+  } else {
+    // The next independent check always tries GitHub first and measures the
+    // hosts again.
+    usingMirror_ = NO;
+    retriedPrimary_ = NO;
+    downloadingFromMirror_ = NO;
+    probedURL_ = nil;
+    preferMirror_ = NO;
+  }
+}
