+namespace {
+// Aborts a check while both download hosts are measured; never shown as a
+// failure. The check is then repeated and downloads from the faster host.
+NSString* const kNeoSourceProbeErrorDomain = @"NeoUpdateSourceProbe";
+// Measure each host by downloading up to this much of the installer...
+constexpr int64_t kNeoProbeBytes = 2 * 1024 * 1024;
+// ...for at most this long. A host that delivers less than kNeoProbeMinBytes
+// in that time counts as failed.
+constexpr NSTimeInterval kNeoProbeSeconds = 8;
+constexpr int64_t kNeoProbeMinBytes = 64 * 1024;
+// GitHub stays the default unless the mirror is clearly faster.
+constexpr double kNeoMirrorAdvantage = 1.5;
+// Fail a download that receives nothing for this long, instead of the default
+// 60 seconds, so the mirror retry starts sooner.
+constexpr NSTimeInterval kNeoDownloadIdleTimeout = 30;
+}  // namespace
+
+// Measures download speed from several URLs in parallel. Each result is in
+// bytes per second, or 0 if the host failed.
+@interface NeoDownloadProbe : NSObject <NSURLSessionDataDelegate>
+- (instancetype)initWithURLs:(NSArray<NSURL*>*)urls
+                  completion:(void (^)(NSArray<NSNumber*>*))completion;
+@end
+
+@implementation NeoDownloadProbe {
+  NSURLSession* session_;
+  NSArray<NSURLSessionTask*>* tasks_;
+  NSMutableArray<NSNumber*>* bytes_;
+  NSMutableArray<NSNumber*>* rates_;
+  NSDate* start_;
+  NSUInteger remaining_;
+  void (^completion_)(NSArray<NSNumber*>*);
+}
+
+- (instancetype)initWithURLs:(NSArray<NSURL*>*)urls
+                  completion:(void (^)(NSArray<NSNumber*>*))completion {
+  if ((self = [super init])) {
+    completion_ = [completion copy];
+    NSURLSessionConfiguration* config =
+        [NSURLSessionConfiguration ephemeralSessionConfiguration];
+    config.timeoutIntervalForRequest = kNeoProbeSeconds;
+    config.timeoutIntervalForResource = kNeoProbeSeconds + 2;
+    config.requestCachePolicy = NSURLRequestReloadIgnoringLocalCacheData;
+    // The session retains this delegate until it is invalidated in -finish.
+    session_ = [NSURLSession sessionWithConfiguration:config
+                                             delegate:self
+                                        delegateQueue:NSOperationQueue.mainQueue];
+    bytes_ = [NSMutableArray array];
+    rates_ = [NSMutableArray array];
+    NSMutableArray<NSURLSessionDataTask*>* tasks = [NSMutableArray array];
+    for (NSURL* url in urls) {
+      NSMutableURLRequest* request = [NSMutableURLRequest requestWithURL:url];
+      [request setValue:[NSString stringWithFormat:@"bytes=0-%lld",
+                                                   kNeoProbeBytes - 1]
+          forHTTPHeaderField:@"Range"];
+      [tasks addObject:[session_ dataTaskWithRequest:request]];
+      [bytes_ addObject:@0];
+      [rates_ addObject:@-1];
+    }
+    tasks_ = tasks;
+    remaining_ = tasks.count;
+    start_ = [NSDate date];
+    for (NSURLSessionDataTask* task in tasks_)
+      [task resume];
+    __weak NeoDownloadProbe* weakSelf = self;
+    dispatch_after(
+        dispatch_time(DISPATCH_TIME_NOW,
+                      (int64_t)(kNeoProbeSeconds * NSEC_PER_SEC)),
+        dispatch_get_main_queue(), ^{
+          NeoDownloadProbe* probe = weakSelf;
+          for (NSUInteger i = 0; probe && i < probe->tasks_.count; ++i)
+            [probe recordTaskAtIndex:i failed:NO];
+        });
+  }
+  return self;
+}
+
+// Records the rate for one host once, and cancels its transfer.
+- (void)recordTaskAtIndex:(NSUInteger)index failed:(BOOL)failed {
+  if (rates_[index].doubleValue >= 0)
+    return;
+  const int64_t bytes = bytes_[index].longLongValue;
+  const double seconds = MAX(-start_.timeIntervalSinceNow, 0.001);
+  rates_[index] = @(failed || bytes < kNeoProbeMinBytes ? 0 : bytes / seconds);
+  [tasks_[index] cancel];
+  if (--remaining_ == 0)
+    [self finish];
+}
+
+- (void)finish {
+  [session_ invalidateAndCancel];
+  auto completion = completion_;
+  completion_ = nil;
+  if (completion)
+    completion([rates_ copy]);
+}
+
+- (void)URLSession:(NSURLSession*)session
+              dataTask:(NSURLSessionDataTask*)task
+    didReceiveResponse:(NSURLResponse*)response
+     completionHandler:
+         (void (^)(NSURLSessionResponseDisposition))completionHandler {
+  NSInteger status = [response isKindOfClass:NSHTTPURLResponse.class]
+                         ? ((NSHTTPURLResponse*)response).statusCode
+                         : 0;
+  const BOOL ok = status == 200 || status == 206;
+  completionHandler(ok ? NSURLSessionResponseAllow
+                       : NSURLSessionResponseCancel);
+  if (!ok) {
+    NSUInteger index = [tasks_ indexOfObject:task];
+    if (index != NSNotFound)
+      [self recordTaskAtIndex:index failed:YES];
+  }
+}
+
+- (void)URLSession:(NSURLSession*)session
+          dataTask:(NSURLSessionDataTask*)task
+    didReceiveData:(NSData*)data {
+  NSUInteger index = [tasks_ indexOfObject:task];
+  if (index == NSNotFound)
+    return;
+  const int64_t bytes = bytes_[index].longLongValue + data.length;
+  bytes_[index] = @(bytes);
+  // A server that ignores Range sends the whole installer; stop at the limit.
+  if (bytes >= kNeoProbeBytes)
+    [self recordTaskAtIndex:index failed:NO];
+}
+
+- (void)URLSession:(NSURLSession*)session
+                    task:(NSURLSessionTask*)task
+    didCompleteWithError:(NSError*)error {
+  NSUInteger index = [tasks_ indexOfObject:task];
+  if (index != NSNotFound)
+    [self recordTaskAtIndex:index failed:error != nil];
+}
+@end
