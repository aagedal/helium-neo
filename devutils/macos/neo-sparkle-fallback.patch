-// Delegated method. Error handler for the Sparkle messages.
+// The mirror copy of the installer that |item| downloads from GitHub, or nil.
+- (NSURL*)mirrorURLForItem:(SUAppcastItem*)item {
+  if (!profile_ || !item.fileURL.lastPathComponent.length)
+    return nil;
+  GURL feed = helium::GetBrowserUpdateURL(*profile_->GetPrefs(), true);
+  if (feed == helium::GetDummyURL() || !feed.is_valid())
+    return nil;
+  GURL mirror =
+      feed.Resolve(base::SysNSStringToUTF8(item.fileURL.lastPathComponent));
+  return mirror.is_valid()
+             ? [NSURL URLWithString:base::SysUTF8ToNSString(mirror.spec())]
+             : nil;
+}
+
+// Before downloading from GitHub, measure GitHub and the mirror once and
+// repeat the check, so the download comes from the faster host. Both hosts
+// serve the same file; Sparkle verifies its signature either way.
+- (BOOL)updater:(SPUUpdater*)updater
+    shouldProceedWithUpdate:(SUAppcastItem*)item
+                updateCheck:(SPUUpdateCheck)updateCheck
+                      error:(NSError* __autoreleasing*)error {
+  if (usingMirror_ || skipProbe_ || [probedURL_ isEqual:item.fileURL])
+    return YES;
+  NSURL* mirror = [self mirrorURLForItem:item];
+  if (!mirror || !item.fileURL)
+    return YES;
+
+  probedURL_ = nil;
+  preferMirror_ = NO;
+  probeUpdater_ = updater;
+  probeCycleFinished_ = NO;
+  NSURL* primary = item.fileURL;
+  __weak SparkleObserver* weakSelf = self;
+  probe_ = [[NeoDownloadProbe alloc]
+      initWithURLs:@[ primary, mirror ]
+        completion:^(NSArray<NSNumber*>* rates) {
+          SparkleObserver* strongSelf = weakSelf;
+          if (strongSelf)
+            [strongSelf probeFinishedForURL:primary rates:rates];
+        }];
+  if (error) {
+    *error = [NSError
+        errorWithDomain:kNeoSourceProbeErrorDomain
+                   code:1
+               userInfo:@{
+                 NSLocalizedDescriptionKey : @"Choosing the fastest download"
+               }];
+  }
+  return NO;
+}
+
+- (void)probeFinishedForURL:(NSURL*)primary rates:(NSArray<NSNumber*>*)rates {
+  probe_ = nil;
+  const double github = rates[0].doubleValue;
+  const double mirror = rates[1].doubleValue;
+  probedURL_ = primary;
+  preferMirror_ = mirror > 0 && mirror > github * kNeoMirrorAdvantage;
+  VLOG(1) << "Update download speed, GitHub: " << github
+          << " B/s, mirror: " << mirror << " B/s";
+  [self restartAfterProbeIfReady];
+}
+
+// Repeat the check once both the measurement and Sparkle's aborted cycle are
+// done, so Sparkle is idle and accepts it.
+- (void)restartAfterProbeIfReady {
+  SPUUpdater* updater = probeUpdater_;
+  if (probe_ || !probeCycleFinished_ || !updater)
+    return;
+  probeUpdater_ = nil;
+  skipProbe_ = YES;
+  [self updateStatus:VersionUpdater::CHECKING error_string:nil];
+  [updater checkForUpdatesInBackground];
+}
+
+- (void)updater:(SPUUpdater*)updater
+    willDownloadUpdate:(SUAppcastItem*)item
+           withRequest:(NSMutableURLRequest*)request {
+  request.timeoutInterval = kNeoDownloadIdleTimeout;
+  downloadingFromMirror_ = NO;
+  if (usingMirror_ || !preferMirror_ || ![probedURL_ isEqual:item.fileURL])
+    return;
